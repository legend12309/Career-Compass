  code_action {
    action_spec {
      create_file {
        instruction: "import {\n  Profile,\n  Skill,\n  Certificate,\n  Application,\n  Resume,\n  RoadmapPlan,\n  CareerResource,\n  InterviewSessionState,\n} from \'../types\';\nimport { CareerRecommendationsOutput, ResumeReviewOutput } from \'../types/ai\';\n\nconst PROFILES_KEY = \'cc_profiles\';\nconst SKILLS_KEY = \'cc_skills\';\nconst CERTS_KEY = \'cc_certificates\';\nconst APPS_KEY = \'cc_applications\';\nconst RESUMES_KEY = \'cc_resumes\';\nconst ROADMAPS_KEY = \'cc_roadmaps\';\nconst RESOURCES_KEY = \'cc_resources\';\nconst CAREER_RECS_KEY = \'cc_career_recommendations\';\nconst RESUME_REVIEWS_KEY = \'cc_resume_reviews\';\nconst INTERVIEW_SESSIONS_KEY = \'cc_interview_sessions\';\n\n// Safe read from localStorage\nfunction readStore<T>(key: string, defaultValue: T): T {\n  try {\n    const raw = localStorage.getItem(key);\n    return raw ? JSON.parse(raw) : defaultValue;\n  } catch (err) {\n    console.error(`Error reading ${key} from storage:`, err);\n    return defaultValue;\n  }\n}\n\n// Safe write to localStorage with explicit QuotaExceededError propagation\nfunction writeStore<T>(key: string, value: T): void {\n  try {\n    localStorage.setItem(key, JSON.stringify(value));\n  } catch (err: unknown) {\n    if (\n      err instanceof DOMException &&\n      (err.name === \'QuotaExceededError\' || err.name === \'NS_ERROR_DOM_QUOTA_REACHED\')\n    ) {\n      throw new Error(\n        \'Browser storage limit reached (approx. 5MB). Please remove older certificate attachments or use a smaller file (<500KB).\'\n      );\n    }\n    throw new Error(\'Failed to save data to browser storage.\');\n  }\n}\n\nconst DEFAULT_RESOURCES: CareerResource[] = [\n  {\n    id: \'res-1\',\n    title: \'NeetCode 150 & Striver SDE Sheet Overview\',\n    category: \'DSA & Coding\',\n    link: \'https://neetcode.io/practice\',\n    description:\n      \'Structured problem set covering arrays, two pointers, trees, graphs, and dynamic programming for campus coding rounds.\',\n    createdAt: \'2026-09-01T10:00:00.000Z\',\n  },\n  {\n    id: \'res-2\',\n    title: \'MDN Web Docs \342\200\224 Modern JavaScript & HTTP Guide\',\n    category: \'Web & Full-Stack\',\n    link: \'https://developer.mozilla.org/en-US/docs/Web/JavaScript\',\n    description:\n      \'Comprehensive reference for closures, event loop, Fetch API, CORS, and browser fundamentals asked in technical interviews.\',\n    createdAt: \'2026-09-05T10:00:00.000Z\',\n  },\n  {\n    id: \'res-3\',\n    title: \'IndiaBIX Quantitative Aptitude & Logical Reasoning\',\n    category: \'Aptitude & Placement\',\n    link: \'https://www.indiabix.com/\',\n    description:\n      \'Practice sets for time & work, permutations, syllogisms, and data interpretation used in initial placement screening tests.\',\n    createdAt: \'2026-09-10T10:00:00.000Z\',\n  },\n  {\n    id: \'res-4\',\n    title: \'Tech Interview Handbook \342\200\224 Resume & Behavioral Guide\',\n    category: \'Resume & HR\',\n    link: \'https://www.techinterviewhandbook.org/resume/\',\n    description:\n      \'Action-verb templates, STAR method behavioral answers, and single-column ATS formatting rules for freshers.\',\n    createdAt: \'2026-09-12T10:00:00.000Z\',\n  },\n];\n\n// Seed data initialization for Demo Student (student-1) and platform resources\nexport function initDbSeed(studentId = \'student-1\'): void {\n  const existingProfiles = readStore<Record<string, Profile>>(PROFILES_KEY, {});\n  if (!existingProfiles[studentId]) {\n    existingProfiles[studentId] = {\n      userId: studentId,\n      education: \'Bachelor of Computer Applications (BCA)\',\n      branch: \'Computer Applications\',\n      year: \'Final Year (Semester 6)\',\n      interests: [\n        \'Full-Stack Web Development\',\n        \'React & TypeScript\',\n        \'Node.js & Express\',\n        \'PostgreSQL & MongoDB\',\n        \'REST APIs & Microservices\',\n      ],\n      careerGoal: \'Full-Stack Software Engineer in high-growth tech firms\',\n      bio: \'Final-year BCA student with a strong foundation in data structures, modern JavaScript/TypeScript, and full-stack web development. Built and deployed 3 academic full-stack projects.\',\n      preferredWorkStyle: \'Hybrid / Collaborative Engineering Team\',\n    };\n    writeStore(PROFILES_KEY, existingProfiles);\n  }\n\n  const existingSkills = readStore<Skill[]>(SKILLS_KEY, []);\n  if (!existingSkills.some((s) => s.userId === studentId)) {\n    const seededSkills: Skill[] = [\n      { id: \'sk-1\', userId: studentId, name: \'JavaScript & TypeScript\', category: \'technical\', level: 4 },\n      { id: \'sk-2\', userId: studentId, name: \'React.js & Tailwind CSS\', category: \'technical\', level: 4 },\n      { id: \'sk-3\', userId: studentId, name: \'Node.js & Express\', category: \'technical\', level: 3 },\n      { id: \'sk-4\', userId: studentId, name: \'SQL & Relational Databases\', category: \'technical\', level: 3 },\n      { id: \'sk-5\', userId: studentId, name: \'Data Structures & Algorithms\', category: \'technical\', level: 3 },\n      { id: \'sk-6\', userId: studentId, name: \'Problem Solving & Debugging\', category: \'soft\', level: 4 },\n      { id: \'sk-7\', userId: studentId, name: \'Technical Communication\', category: \'soft\', level: 4 },\n    ];\n    writeStore(SKILLS_KEY, [...existingSkills, ...seededSkills]);\n  }\n\n  const existingCerts = readStore<Certificate[]>(CERTS_KEY, []);\n  if (!existingCerts.some((c) => c.userId === studentId)) {\n    const seededCerts: Certificate[] = [\n      {\n        id: \'cert-1\',\n        userId: studentId,\n        title: \'Meta Front-End Developer Professional Certificate\',\n        issuer: \'Coursera / Meta\',\n        date: \'2026-05-15\',\n      },\n      {\n        id: \'cert-2\',\n        userId: studentId,\n        title: \'Relational Database & SQL Fundamentals\',\n        issuer: \'NPTEL / IIT Madras\',\n        date: \'2026-02-20\',\n      },\n    ];\n    writeStore(CERTS_KEY, [...existingCerts, ...seededCerts]);\n  }\n\n  const existingResumes = readStore<Record<string, Resume>>(RESUMES_KEY, {});\n  if (!existingResumes[studentId]) {\n    existingResumes[studentId] = {\n      userId: studentId,\n      personal: {\n        name: \'Aryan Sharma\',\n        email: \'student@college.edu\',\n        phone: \'+91 98765 43210\',\n        linkedin: \'linkedin.com/in/aryansharma-bca\',\n        github: \'github.com/aryansharma-dev\',\n        location: \'Bengaluru, Karnataka\',\n      },\n      summary:\n        \'Final-year BCA student specializing in Full-Stack Web Development with hands-on experience building responsive React applications and RESTful Node.js APIs. Solved 200+ algorithmic problems and led the college coding club portal development.\',\n      education: [\n        {\n          degree: \'Bachelor of Computer Applications (BCA)\',\n          institution: \'National Degree College of Computer Science\',\n          startYear: \'2024\',\n          endYear: \'2027\',\n          scoreOrCgpa: \'8.65 CGPA\',\n        },\n        {\n          degree: \'Class XII (CBSE \342\200\224 Computer Science)\',\n          institution: \'Kendriya Vidyalaya\',\n          startYear: \'2022\',\n          endYear: \'2024\',\n          scoreOrCgpa: \'88.4%\',\n        },\n      ],\n      experience: [\n        {\n          role: \'Web Development Intern\',\n          company: \'NexaWave Software Labs\',\n          location: \'Remote\',\n          startDate: \'May 2026\',\n          endDate: \'Jul 2026\',\n          description:\n            \'Built reusable React dashboard components with TypeScript and Tailwind CSS, reducing page load time by 28%. Integrated 12 REST endpoints and wrote unit tests.\',\n        },\n      ],\n      projects: [\n        {\n          title: \'CampusTrack \342\200\224 College Placement & Event Portal\',\n          techStack: [\'React\', \'TypeScript\', \'Node.js\', \'Express\', \'PostgreSQL\'],\n          link: \'github.com/aryansharma-dev/campustrack\',\n          description:\n            \'Developed a role-based placement portal used by 350+ students to register for campus drives, track interview schedules, and download admit cards.\',\n        },\n        {\n          title: \'FinSnap \342\200\224 Personal Expense & Budget Analyzer\',\n          techStack: [\'React\', \'Chart.js\', \'REST API\', \'LocalFirst Storage\'],\n          link: \'github.com/aryansharma-dev/finsnap\',\n          description:\n            \'Created an interactive budget tracker with category filtering, recurring bill alerts, and CSV statement export.\',\n        },\n      ],\n      skills: [\n        \'JavaScript (ES6+)\',\n        \'TypeScript\',\n        \'React.js\',\n        \'Node.js\',\n        \'Express.js\',\n        \'PostgreSQL\',\n        \'MongoDB\',\n        \'Git & GitHub\',\n        \'REST APIs\',\n        \'Tailwind CSS\',\n      ],\n      certifications: [\n        \'Meta Front-End Developer Professional Certificate (2026)\',\n        \'NPTEL Relational Database & SQL Fundamentals \342\200\224 Elite Silver (2026)\',\n      ],\n      lastReviewScore: 82,\n    };\n    writeStore(RESUMES_KEY, existingResumes);\n  }\n\n  const existingApps = readStore<Application[]>(APPS_KEY, []);\n  if (!existingApps.some((a) => a.userId === studentId)) {\n    const seededApps: Application[] = [\n      {\n        id: \'app-1\',\n        userId: studentId,\n        company: \'Zoho Corporation\',\n        role: \'Software Developer (Entry Level)\',\n        type: \'job\',\n        status: \'interview\',\n        appliedDate: \'2026-10-18\',\n        notes: \'Cleared Round 1 aptitude and C/JavaScript coding round. Technical interview scheduled next Tuesday.\',\n      },\n      {\n        id: \'app-2\',\n        userId: studentId,\n        company: \'Freshworks\',\n        role: \'Frontend Engineering Intern\',\n        type: \'internship\',\n        status: \'applied\',\n        appliedDate: \'2026-10-25\',\n        notes: \'Submitted referral application with updated ATS resume.\',\n      },\n      {\n        id: \'app-3\',\n        userId: studentId,\n        company: \'Razorpay\',\n        role: \'Junior Full-Stack Associate\',\n        type: \'job\',\n        status: \'saved\',\n        appliedDate: \'2026-11-02\',\n        notes: \'Tailoring project section to highlight payment and API security before applying.\',\n      },\n      {\n        id: \'app-4\',\n        userId: studentId,\n        company: \'CloudNine Systems\',\n        role: \'React Developer Intern\',\n        type: \'internship\',\n        status: \'offer\',\n        appliedDate: \'2026-09-28\',\n        notes: \'Received 6-month internship offer with \342\202\27125,000/month stipend.\',\n      },\n    ];\n    writeStore(APPS_KEY, [...existingApps, ...seededApps]);\n  }\n\n  const existingResources = readStore<CareerResource[]>(RESOURCES_KEY, []);\n  if (existingResources.length === 0) {\n    writeStore(RESOURCES_KEY, DEFAULT_RESOURCES);\n  }\n}\n\n// Profile API (Scoped to userId)\nexport async function getProfile(userId: string): Promise<Profile | null> {\n  if (!userId) return null;\n  const profiles = readStore<Record<string, Profile>>(PROFILES_KEY, {});\n  return profiles[userId] || null;\n}\n\nexport async function saveProfile(profile: Profile): Promise<Profile> {\n  if (!profile.userId) throw new Error(\'User ID is required to save profile.\');\n  const profiles = readStore<Record<string, Profile>>(PROFILES_KEY, {});\n  profiles[profile.userId] = { ...profile };\n  writeStore(PROFILES_KEY, profiles);\n  return profiles[profile.userId];\n}\n\n// Career Recommendations Cache (Scoped to userId)\nexport async function getLastCareerRecommendations(\n  userId: string\n): Promise<{ data: CareerRecommendationsOutput; updatedAt: string } | null> {\n  if (!userId) return null;\n  const store = readStore<Record<string, { data: CareerRecommendationsOutput; updatedAt: string }>>(\n    CAREER_RECS_KEY,\n    {}\n  );\n  return store[userId] || null;\n}\n\nexport async function saveCareerRecommendations(\n  userId: string,\n  data: CareerRecommendationsOutput\n): Promise<void> {\n  if (!userId) return;\n  const store = readStore<Record<string, { data: CareerRecommendationsOutput; updatedAt: string }>>(\n    CAREER_RECS_KEY,\n    {}\n  );\n  store[userId] = { data, updatedAt: new Date().toISOString() };\n  writeStore(CAREER_RECS_KEY, store);\n}\n\n// Skills API (Scoped to userId)\nexport async function listSkills(userId: string): Promise<Skill[]> {\n  if (!userId) return [];\n  const allSkills = readStore<Skill[]>(SKILLS_KEY, []);\n  return allSkills.filter((s) => s.userId === userId);\n}\n\nexport async function saveSkill(skill: Skill): Promise<Skill> {\n  if (!skill.userId) throw new Error(\'User ID is required.\');\n  const clampedLevel = Math.min(5, Math.max(1, Math.round(Number(skill.level) || 3)));\n  const cleanName = skill.name.trim();\n  if (!cleanName) throw new Error(\'Skill name cannot be empty.\');\n\n  const allSkills = readStore<Skill[]>(SKILLS_KEY, []);\n  const duplicate = allSkills.find(\n    (s) =>\n      s.userId === skill.userId &&\n      s.id !== skill.id &&\n      s.name.trim().toLowerCase() === cleanName.toLowerCase()\n  );\n  if (duplicate) {\n    throw new Error(`You already have \"${cleanName}\" in your skills list.`);\n  }\n\n  const normalized: Skill = { ...skill, name: cleanName, level: clampedLevel };\n  const index = allSkills.findIndex((s) => s.id === skill.id && s.userId === skill.userId);\n  if (index >= 0) {\n    allSkills[index] = normalized;\n  } else {\n    allSkills.push(normalized);\n  }\n  writeStore(SKILLS_KEY, allSkills);\n  return normalized;\n}\n\nexport async function deleteSkill(id: string, userId?: string): Promise<boolean> {\n  const allSkills = readStore<Skill[]>(SKILLS_KEY, []);\n  const filtered = allSkills.filter((s) => !(s.id === id && (!userId || s.userId === userId)));\n  writeStore(SKILLS_KEY, filtered);\n  return filtered.length !== allSkills.length;\n}\n\n// Certificates API (Scoped to userId)\nexport async function listCertificates(userId: string): Promise<Certificate[]> {\n  if (!userId) return [];\n  const allCerts = readStore<Certificate[]>(CERTS_KEY, []);\n  return allCerts.filter((c) => c.userId === userId);\n}\n\nexport async function saveCertificate(cert: Certificate): Promise<Certificate> {\n  if (!cert.userId) throw new Error(\'User ID is required.\');\n  const allCerts = readStore<Certificate[]>(CERTS_KEY, []);\n  const index = allCerts.findIndex((c) => c.id === cert.id && c.userId === cert.userId);\n  if (index >= 0) {\n    allCerts[index] = cert;\n  } else {\n    allCerts.push(cert);\n  }\n  writeStore(CERTS_KEY, allCerts);\n  return cert;\n}\n\nexport async function deleteCertificate(id: string, userId?: string): Promise<boolean> {\n  const allCerts = readStore<Certificate[]>(CERTS_KEY, []);\n  const filtered = allCerts.filter((c) => !(c.id === id && (!userId || c.userId === userId)));\n  writeStore(CERTS_KEY, filtered);\n  return filtered.length !== allCerts.length;\n}\n\n// Applications API (Scoped to userId)\nexport async function listApplications(userId: string): Promise<Application[]> {\n  if (!userId) return [];\n  const allApps = readStore<Application[]>(APPS_KEY, []);\n  return allApps.filter((a) => a.userId === userId);\n}\n\nexport async function saveApplication(app: Application): Promise<Application> {\n  if (!app.userId) throw new Error(\'User ID is required.\');\n  const allApps = readStore<Application[]>(APPS_KEY, []);\n  const index = allApps.findIndex((a) => a.id === app.id && a.userId === app.userId);\n  if (index >= 0) {\n    allApps[index] = app;\n  } else {\n    allApps.push(app);\n  }\n  writeStore(APPS_KEY, allApps);\n  return app;\n}\n\nexport async function deleteApplication(id: string, userId?: string): Promise<boolean> {\n  const allApps = readStore<Application[]>(APPS_KEY, []);\n  const filtered = allApps.filter((a) => !(a.id === id && (!userId || a.userId === userId)));\n  writeStore(APPS_KEY, filtered);\n  return filtered.length !== allApps.length;\n}\n\n// Resume API (Scoped to userId)\nexport async function getResume(userId: string): Promise<Resume | null> {\n  if (!userId) return null;\n  const resumes = readStore<Record<string, Resume>>(RESUMES_KEY, {});\n  return resumes[userId] || null;\n}\n\nexport async function saveResume(resume: Resume): Promise<Resume> {\n  if (!resume.userId) throw new Error(\'User ID is required.\');\n  const resumes = readStore<Record<string, Resume>>(RESUMES_KEY, {});\n  resumes[resume.userId] = resume;\n  writeStore(RESUMES_KEY, resumes);\n  return resume;\n}\n\nexport async function getLastResumeReview(userId: string): Promise<ResumeReviewOutput | null> {\n  if (!userId) return null;\n  const reviews = readStore<Record<string, ResumeReviewOutput>>(RESUME_REVIEWS_KEY, {});\n  return reviews[userId] || null;\n}\n\nexport async function saveResumeReview(userId: string, review: ResumeReviewOutput): Promise<void> {\n  if (!userId) return;\n  const reviews = readStore<Record<string, ResumeReviewOutput>>(RESUME_REVIEWS_KEY, {});\n  reviews[userId] = review;\n  writeStore(RESUME_REVIEWS_KEY, reviews);\n}\n\n// Roadmap API (Scoped to userId)\nexport async function getRoadmap(userId: string): Promise<RoadmapPlan | null> {\n  if (!userId) return null;\n  const roadmaps = readStore<Record<string, RoadmapPlan>>(ROADMAPS_KEY, {});\n  return roadmaps[userId] || null;\n}\n\nexport async function saveRoadmap(plan: RoadmapPlan): Promise<RoadmapPlan> {\n  if (!plan.userId) throw new Error(\'User ID is required.\');\n  const roadmaps = readStore<Record<string, RoadmapPlan>>(ROADMAPS_KEY, {});\n  roadmaps[plan.userId] = plan;\n  writeStore(ROADMAPS_KEY, roadmaps);\n  return plan;\n}\n\n// Interview Session State API (Scoped to userId for mid-session refresh resilience)\nexport async function getInterviewSession(userId: string): Promise<InterviewSessionState | null> {\n  if (!userId) return null;\n  const sessions = readStore<Record<string, InterviewSessionState>>(INTERVIEW_SESSIONS_KEY, {});\n  return sessions[userId] || null;\n}\n\nexport async function saveInterviewSession(session: InterviewSessionState): Promise<void> {\n  if (!session.userId) return;\n  const sessions = readStore<Record<string, InterviewSessionState>>(INTERVIEW_SESSIONS_KEY, {});\n  sessions[session.userId] = session;\n  writeStore(INTERVIEW_SESSIONS_KEY, sessions);\n}\n\nexport async function clearInterviewSession(userId: string): Promise<void> {\n  if (!userId) return;\n  const sessions = readStore<Record<string, InterviewSessionState>>(INTERVIEW_SESSIONS_KEY, {});\n  delete sessions[userId];\n  writeStore(INTERVIEW_SESSIONS_KEY, sessions);\n}\n\n// Career Resources API (Public read for students, Admin write)\nexport async function listCareerResources(): Promise<CareerResource[]> {\n  initDbSeed();\n  return readStore<CareerResource[]>(RESOURCES_KEY, DEFAULT_RESOURCES);\n}\n\nexport async function saveCareerResource(\n  resource: CareerResource,\n  actorRole: string\n): Promise<CareerResource> {\n  if (actorRole !== \'admin\') {\n    throw new Error(\'Unauthorized: Only administrators can add or modify career resources.\');\n  }\n  const resources = readStore<CareerResource[]>(RESOURCES_KEY, DEFAULT_RESOURCES);\n  const idx = resources.findIndex((r) => r.id === resource.id);\n  if (idx >= 0) {\n    resources[idx] = resource;\n  } else {\n    resources.unshift(resource);\n  }\n  writeStore(RESOURCES_KEY, resources);\n  return resource;\n}\n\nexport async function deleteCareerResource(id: string, actorRole: string): Promise<boolean> {\n  if (actorRole !== \'admin\') {\n    throw new Error(\'Unauthorized: Only administrators can delete career resources.\');\n  }\n  const resources = readStore<CareerResource[]>(RESOURCES_KEY, DEFAULT_RESOURCES);\n  const filtered = resources.filter((r) => r.id !== id);\n  writeStore(RESOURCES_KEY, filtered);\n  return filtered.length !== resources.length;\n}\n\n// Platform Statistics for Admin Dashboard\nexport async function getPlatformStats(actorRole: string): Promise<{\n  totalProfiles: number;\n  totalResumes: number;\n  totalSkills: number;\n  totalCertificates: number;\n  totalApplications: number;\n  totalRoadmaps: number;\n  totalResources: number;\n}> {\n  if (actorRole !== \'admin\') {\n    throw new Error(\'Unauthorized: Admin role required to view platform statistics.\');\n  }\n  const profiles = Object.keys(readStore<Record<string, Profile>>(PROFILES_KEY, {})).length;\n  const resumes = Object.keys(readStore<Record<string, Resume>>(RESUMES_KEY, {})).length;\n  const skills = readStore<Skill[]>(SKILLS_KEY, []).length;\n  const certs = readStore<Certificate[]>(CERTS_KEY, []).length;\n  const apps = readStore<Application[]>(APPS_KEY, []).length;\n  const roadmaps = Object.keys(readStore<Record<string, RoadmapPlan>>(ROADMAPS_KEY, {})).length;\n  const resources = readStore<CareerResource[]>(RESOURCES_KEY, DEFAULT_RESOURCES).length;\n\n  return {\n    totalProfiles: profiles,\n    totalResumes: resumes,\n    totalSkills: skills,\n    totalCertificates: certs,\n    totalApplications: apps,\n    totalRoadmaps: roadmaps,\n    totalResources: resources,\n  };\n}\n"
