  code_action {
    action_spec {
      create_file {
        instruction: "import { jsPDF } from \'jspdf\';\nimport { Resume } from \'../types\';\n\n/**\n * Generates a clean, single-column, ATS-friendly A4 PDF resume with selectable text\n * and automatic multi-page overflow protection.\n */\nexport function downloadResumePdf(resume: Resume): string {\n  const doc = new jsPDF({\n    orientation: \'portrait\',\n    unit: \'mm\',\n    format: \'a4\',\n  });\n\n  const pageWidth = doc.internal.pageSize.getWidth(); // 210mm\n  const pageHeight = doc.internal.pageSize.getHeight(); // 297mm\n  const marginX = 16;\n  const marginTop = 16;\n  const marginBottom = 16;\n  const contentWidth = pageWidth - marginX * 2;\n  let y = marginTop;\n\n  const ensureSpace = (neededMm: number) => {\n    if (y + neededMm > pageHeight - marginBottom) {\n      doc.addPage();\n      y = marginTop;\n    }\n  };\n\n  const writeWrappedText = (\n    text: string,\n    fontSize: number,\n    fontStyle: \'normal\' | \'bold\' | \'italic\' = \'normal\',\n    color: [number, number, number] = [15, 23, 42],\n    lineHeightMm = 4.8,\n    indentX = 0\n  ) => {\n    const clean = (text || \'\').trim();\n    if (!clean) return;\n    doc.setFont(\'helvetica\', fontStyle);\n    doc.setFontSize(fontSize);\n    doc.setTextColor(color[0], color[1], color[2]);\n\n    const lines: string[] = doc.splitTextToSize(clean, contentWidth - indentX);\n    for (const line of lines) {\n      ensureSpace(lineHeightMm);\n      doc.text(line, marginX + indentX, y);\n      y += lineHeightMm;\n    }\n  };\n\n  const writeSectionHeading = (title: string) => {\n    ensureSpace(11);\n    y += 2.5;\n    doc.setFont(\'helvetica\', \'bold\');\n    doc.setFontSize(10.5);\n    doc.setTextColor(15, 23, 42);\n    doc.text(title.toUpperCase(), marginX, y);\n    y += 1.8;\n    doc.setDrawColor(203, 213, 225);\n    doc.setLineWidth(0.35);\n    doc.line(marginX, y, pageWidth - marginX, y);\n    y += 4.5;\n  };\n\n  // 1. Header \342\200\224 Personal Info\n  const fullName = resume.personal.name?.trim() || \'Student Name\';\n  doc.setFont(\'helvetica\', \'bold\');\n  doc.setFontSize(18);\n  doc.setTextColor(15, 23, 42);\n  doc.text(fullName, marginX, y);\n  y += 5.5;\n\n  const contactParts = [\n    resume.personal.location,\n    resume.personal.email,\n    resume.personal.phone,\n    resume.personal.linkedin,\n    resume.personal.github,\n  ]\n    .map((p) => (p || \'\').trim())\n    .filter(Boolean);\n\n  if (contactParts.length > 0) {\n    writeWrappedText(contactParts.join(\'  |  \'), 9, \'normal\', [71, 85, 105], 4.2);\n  }\n  y += 2;\n\n  // 2. Professional Summary\n  if (resume.summary?.trim()) {\n    writeSectionHeading(\'Professional Summary\');\n    writeWrappedText(resume.summary, 9.5, \'normal\', [30, 41, 59], 4.6);\n  }\n\n  // 3. Education\n  if (resume.education && resume.education.length > 0) {\n    writeSectionHeading(\'Education\');\n    for (const edu of resume.education) {\n      if (!edu.degree && !edu.institution) continue;\n      ensureSpace(10);\n      doc.setFont(\'helvetica\', \'bold\');\n      doc.setFontSize(10);\n      doc.setTextColor(15, 23, 42);\n      const degreeLine = edu.degree || \'Degree Program\';\n      doc.text(degreeLine, marginX, y);\n\n      const yearRange = [edu.startYear, edu.endYear].filter(Boolean).join(\' - \');\n      if (yearRange) {\n        doc.setFont(\'helvetica\', \'normal\');\n        doc.setFontSize(9);\n        doc.setTextColor(71, 85, 105);\n        doc.text(yearRange, pageWidth - marginX, y, { align: \'right\' });\n      }\n      y += 4.5;\n\n      const instLine = [edu.institution, edu.scoreOrCgpa ? `Score/CGPA: ${edu.scoreOrCgpa}` : \'\']\n        .filter(Boolean)\n        .join(\'  \302\267  \');\n      if (instLine) {\n        writeWrappedText(instLine, 9.2, \'normal\', [51, 65, 85], 4.4);\n      }\n      y += 1.5;\n    }\n  }\n\n  // 4. Technical Skills\n  if (resume.skills && resume.skills.length > 0) {\n    writeSectionHeading(\'Technical & Core Skills\');\n    writeWrappedText(resume.skills.filter(Boolean).join(\'  \302\267  \'), 9.5, \'normal\', [30, 41, 59], 4.6);\n  }\n\n  // 5. Experience / Internships\n  if (resume.experience && resume.experience.length > 0) {\n    writeSectionHeading(\'Experience & Internships\');\n    for (const exp of resume.experience) {\n      if (!exp.role && !exp.company) continue;\n      ensureSpace(12);\n      doc.setFont(\'helvetica\', \'bold\');\n      doc.setFontSize(10);\n      doc.setTextColor(15, 23, 42);\n      const roleHeader = [exp.role, exp.company].filter(Boolean).join(\' \342\200\224 \');\n      doc.text(roleHeader, marginX, y);\n\n      const dateRange = [exp.startDate, exp.endDate].filter(Boolean).join(\' - \');\n      if (dateRange) {\n        doc.setFont(\'helvetica\', \'normal\');\n        doc.setFontSize(9);\n        doc.setTextColor(71, 85, 105);\n        doc.text(dateRange, pageWidth - marginX, y, { align: \'right\' });\n      }\n      y += 4.4;\n\n      if (exp.location) {\n        writeWrappedText(exp.location, 8.8, \'italic\', [100, 116, 139], 4.0);\n      }\n      if (exp.description) {\n        writeWrappedText(exp.description, 9.3, \'normal\', [30, 41, 59], 4.5);\n      }\n      y += 2;\n    }\n  }\n\n  // 6. Academic & Personal Projects\n  if (resume.projects && resume.projects.length > 0) {\n    writeSectionHeading(\'Projects\');\n    for (const proj of resume.projects) {\n      if (!proj.title) continue;\n      ensureSpace(12);\n      const titleWithTech =\n        proj.techStack && proj.techStack.length > 0\n          ? `${proj.title} (${proj.techStack.join(\', \')})`\n          : proj.title;\n\n      writeWrappedText(titleWithTech, 10, \'bold\', [15, 23, 42], 4.5);\n      if (proj.link) {\n        writeWrappedText(`Link: ${proj.link}`, 8.8, \'normal\', [79, 70, 229], 4.0);\n      }\n      if (proj.description) {\n        writeWrappedText(proj.description, 9.3, \'normal\', [30, 41, 59], 4.5);\n      }\n      y += 2;\n    }\n  }\n\n  // 7. Certifications\n  if (resume.certifications && resume.certifications.length > 0) {\n    writeSectionHeading(\'Certifications & Achievements\');\n    for (const cert of resume.certifications.filter(Boolean)) {\n      writeWrappedText(`\342\200\242 ${cert}`, 9.3, \'normal\', [30, 41, 59], 4.5, 2);\n    }\n  }\n\n  const safeFileName =\n    fullName\n      .replace(/[^a-zA-Z0-9_-]+/g, \'_\')\n      .replace(/^_+|_+$/g, \'\') || \'Student\';\n  const fileName = `${safeFileName}_Resume.pdf`;\n  doc.save(fileName);\n  return fileName;\n}\n"
        path {
          absolute_uri: "file:///src/utils/pdfExport.ts"
        }
        overwrite: true
      }
    }
