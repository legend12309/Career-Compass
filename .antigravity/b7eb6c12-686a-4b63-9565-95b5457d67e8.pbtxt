    tool_calls {
      id: "call_8298204120055981235"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useEffect, useState } from \'react\';\\nimport { Link } from \'react-router-dom\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { Profile, Skill, Application, Resume, RoadmapPlan } from \'../types\';\\nimport {\\n  getProfile,\\n  listSkills,\\n  listApplications,\\n  getResume,\\n  getRoadmap,\\n} from \'../services/db\';\\nimport { AppShell } from \'../components/layout/AppShell\';\\nimport {\\n  BarChart,\\n  Bar,\\n  XAxis,\\n  YAxis,\\n  Tooltip,\\n  ResponsiveContainer,\\n  Cell,\\n} from \'recharts\';\\nimport {\\n  Sparkles,\\n  FileText,\\n  MessageSquareCode,\\n  Briefcase,\\n  Award,\\n  Milestone,\\n  Edit3,\\n  ArrowRight,\\n} from \'lucide-react\';\\n\\nexport function DashboardPage() {\\n  const { user } = useAuth();\\n  const [profile, setProfile] = useState<Profile | null>(null);\\n  const [skills, setSkills] = useState<Skill[]>([]);\\n  const [applications, setApplications] = useState<Application[]>([]);\\n  const [resume, setResume] = useState<Resume | null>(null);\\n  const [roadmap, setRoadmap] = useState<RoadmapPlan | null>(null);\\n  const [loading, setLoading] = useState(true);\\n\\n  useEffect(() => {\\n    async function load() {\\n      if (!user) return;\\n      setLoading(true);\\n      try {\\n        const [prof, sk, apps, res, rm] = await Promise.all([\\n          getProfile(user.id),\\n          listSkills(user.id),\\n          listApplications(user.id),\\n          getResume(user.id),\\n          getRoadmap(user.id),\\n        ]);\\n        setProfile(prof);\\n        setSkills(sk);\\n        setApplications(apps);\\n        setResume(res);\\n        setRoadmap(rm);\\n      } catch (err) {\\n        console.error(\'Error loading dashboard metrics:\', err);\\n      } finally {\\n        setLoading(false);\\n      }\\n    }\\n    load();\\n  }, [user]);\\n\\n  // 1. Exact Profile Completion % Calculation\\n  const computeProfileCompletion = (): number => {\\n    if (!profile) return 0;\\n    const checks = [\\n      Boolean(profile.education?.trim()),\\n      Boolean(profile.branch?.trim()),\\n      Boolean(profile.year?.trim()),\\n      (profile.interests?.length || 0) > 0,\\n      Boolean(profile.careerGoal?.trim()),\\n      Boolean(profile.bio?.trim()),\\n    ];\\n    const passed = checks.filter(Boolean).length;\\n    return Math.round((passed / checks.length) * 100);\\n  };\\n\\n  // 2. Exact Roadmap Progress % Calculation\\n  const computeRoadmapPercent = (): number => {\\n    if (!roadmap?.data?.phases) return 0;\\n    const allKeys: string[] = [];\\n    roadmap.data.phases.forEach((ph, pIdx) => {\\n      ph.topics.forEach((t, tIdx) => {\\n        allKeys.push(`${pIdx}-${tIdx}-${t}`);\\n      });\\n    });\\n    if (allKeys.length === 0) return 0;\\n    const done = allKeys.filter((k) => roadmap.completedTopics.includes(k)).length;\\n    return Math.round((done / allKeys.length) * 100);\\n  };\\n\\n  const profileCompletion = computeProfileCompletion();\\n  const roadmapProgress = computeRoadmapPercent();\\n  const resumeScore = resume?.lastReviewScore ?? 0;\\n\\n  const statusData = [\\n    { name: \'Saved\', count: applications.filter((a) => a.status === \'saved\').length, color: \'#64748b\' },\\n    { name: \'Applied\', count: applications.filter((a) => a.status === \'applied\').length, color: \'#4f46e5\' },\\n    { name: \'Interview\', count: applications.filter((a) => a.status === \'interview\').length, color: \'#d97706\' },\\n    { name: \'Offer\', count: applications.filter((a) => a.status === \'offer\').length, color: \'#16a34a\' },\\n    { name: \'Rejected\', count: applications.filter((a) => a.status === \'rejected\').length, color: \'#dc2626\' },\\n  ];\\n\\n  const skillChartData = skills.slice(0, 6).map((s) => ({\\n    name: s.name.length > 16 ? `${s.name.slice(0, 14)}\342\200\246` : s.name,\\n    level: s.level,\\n  }));\\n\\n  return (\\n    <AppShell>\\n      <div className=\\\"space-y-6\\\">\\n        {/* Welcome Header */}\\n        <div className=\\\"p-6 bg-white border border-stone-200 rounded-xl shadow-2xs flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4\\\">\\n          <div>\\n            <div className=\\\"text-xs text-stone-500 mb-1\\\">\\n              BCA Placement & Career Readiness Hub \302\267 <span className=\\\"capitalize\\\">{user?.role}</span>\\n            </div>\\n            <h1 className=\\\"text-xl sm:text-2xl font-bold text-slate-900\\\">\\n              Welcome back, {user?.name}\\n            </h1>\\n            <p className=\\\"text-xs sm:text-sm text-stone-600 mt-1\\\">\\n              Target Goal:{\' \'}\\n              <span className=\\\"font-semibold text-slate-900\\\">\\n                {profile?.careerGoal || \'Not set yet \342\200\224 complete your profile to get started\'}\\n              </span>\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n            <Link\\n              to=\\\"/profile\\\"\\n              className=\\\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-medium text-stone-800 bg-stone-100 hover:bg-stone-200 rounded-lg transition-colors\\\"\\n            >\\n              <Edit3 className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Edit Profile</span>\\n            </Link>\\n            <Link\\n              to=\\\"/recommendations\\\"\\n              className=\\\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors\\\"\\n            >\\n              <Sparkles className=\\\"w-3.5 h-3.5 text-indigo-400\\\" />\\n              <span>AI Career Match</span>\\n            </Link>\\n          </div>\\n        </div>\\n\\n        {/* Onboarding Nudge if Profile < 100% */}\\n        {!loading && profileCompletion < 100 && (\\n          <div className=\\\"p-4 bg-indigo-50/70 border border-indigo-200 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-indigo-950\\\">\\n            <div>\\n              <span className=\\\"font-bold\\\">Onboarding Tip:</span> Your career profile is{\' \'}\\n              <strong className=\\\"tabular-nums\\\">{profileCompletion}%</strong> complete. Adding your bio and career goal improves AI recommendation accuracy.\\n            </div>\\n            <Link\\n              to=\\\"/profile\\\"\\n              className=\\\"inline-flex items-center gap-1 font-semibold text-indigo-700 hover:text-indigo-900 shrink-0\\\"\\n            >\\n              <span>Complete Profile</span>\\n              <ArrowRight className=\\\"w-3.5 h-3.5\\\" />\\n            </Link>\\n          </div>\\n        )}\\n\\n        {/* 5 Key Metric Summary Cards */}\\n        <div className=\\\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4\\\">\\n          <Link\\n            to=\\\"/profile\\\"\\n            className=\\\"p-4 bg-white border border-stone-200 hover:border-stone-300 rounded-xl shadow-2xs space-y-1 transition-colors\\\"\\n          >\\n            <span className=\\\"text-xs text-stone-500\\\">Profile Completion</span>\\n            <p className=\\\"text-2xl font-extrabold text-slate-900 tabular-nums\\\">\\n              {profileCompletion}%\\n            </p>\\n            <span className=\\\"text-[11px] text-indigo-600 font-medium block\\\">\\n              {profile?.year || \'Update degree info\'}\\n            </span>\\n          </Link>\\n\\n          <Link\\n            to=\\\"/skills\\\"\\n            className=\\\"p-4 bg-white border border-stone-200 hover:border-stone-300 rounded-xl shadow-2xs space-y-1 transition-colors\\\"\\n          >\\n            <span className=\\\"text-xs text-stone-500\\\">Skills Tracked</span>\\n            <p className=\\\"text-2xl font-extrabold text-slate-900 tabular-nums\\\">\\n              {skills.length}\\n            </p>\\n            <span className=\\\"text-[11px] text-stone-600 block tabular-nums\\\">\\n              {skills.filter((s) => s.category === \'technical\').length} tech \302\267{\' \'}\\n              {skills.filter((s) => s.category === \'soft\').length} soft\\n            </span>\\n          </Link>\\n\\n          <Link\\n            to=\\\"/resume\\\"\\n            className=\\\"p-4 bg-white border border-stone-200 hover:border-stone-300 rounded-xl shadow-2xs space-y-1 transition-colors\\\"\\n          >\\n            <span className=\\\"text-xs text-stone-500\\\">ATS Resume Score</span>\\n            <p className=\\\"text-2xl font-extrabold text-slate-900 tabular-nums\\\">\\n              {resumeScore > 0 ? `${resumeScore}/100` : \'Unscored\'}\\n            </p>\\n            <span className=\\\"text-[11px] text-indigo-600 font-medium block\\\">\\n              {resumeScore > 0 ? \'Reviewed by AI\' : \'Run AI Review \342\206\222\'}\\n            </span>\\n          </Link>\\n\\n          <Link\\n            to=\\\"/tracker\\\"\\n            className=\\\"p-4 bg-white border border-stone-200 hover:border-stone-300 rounded-xl shadow-2xs space-y-1 transition-colors\\\"\\n          >\\n            <span className=\\\"text-xs text-stone-500\\\">Applications</span>\\n            <p className=\\\"text-2xl font-extrabold text-slate-900 tabular-nums\\\">\\n              {applications.length}\\n            </p>\\n            <span className=\\\"text-[11px] text-emerald-700 font-medium block tabular-nums\\\">\\n              {applications.filter((a) => a.status === \'interview\' || a.status === \'offer\').length}{\' \'}\\n              active interview/offer\\n            </span>\\n          </Link>\\n\\n          <Link\\n            to=\\\"/roadmap\\\"\\n            className=\\\"p-4 bg-white border border-stone-200 hover:border-stone-300 rounded-xl shadow-2xs space-y-1 transition-colors col-span-2 sm:col-span-1\\\"\\n          >\\n            <span className=\\\"text-xs text-stone-500\\\">Roadmap Progress</span>\\n            <p className=\\\"text-2xl font-extrabold text-slate-900 tabular-nums\\\">\\n              {roadmapProgress}%\\n            </p>\\n            <span className=\\\"text-[11px] text-stone-600 block truncate\\\">\\n              {roadmap?.targetRole || \'Generate study plan \342\206\222\'}\\n            </span>\\n          </Link>\\n        </div>\\n\\n        {/* Charts Row (Recharts) */}\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-2 gap-6\\\">\\n          {/* Applications by Status Bar Chart */}\\n          <div className=\\\"p-5 bg-white border border-stone-200 rounded-xl shadow-2xs space-y-4\\\">\\n            <div className=\\\"flex items-center justify-between\\\">\\n              <div>\\n                <h2 className=\\\"text-sm font-bold text-slate-900\\\">Applications by Stage</h2>\\n                <p className=\\\"text-xs text-stone-500\\\">\\n                  Real-time count from your Internship & Job Kanban board\\n                </p>\\n              </div>\\n              <Link\\n                to=\\\"/tracker\\\"\\n                className=\\\"text-xs font-semibold text-indigo-600 hover:text-indigo-800\\\"\\n              >\\n                Open Board \342\206\222\\n              </Link>\\n            </div>\\n\\n            <div className=\\\"h-56 w-full\\\">\\n              <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n                <BarChart data={statusData} margin={{ top: 8, right: 12, left: -16, bottom: 0 }}>\\n                  <XAxis dataKey=\\\"name\\\" tick={{ fontSize: 11, fill: \'#57534e\' }} />\\n                  <YAxis allowDecimals={false} tick={{ fontSize: 11, fill: \'#57534e\' }} />\\n                  <Tooltip\\n                    contentStyle={{\\n                      fontSize: \'12px\',\\n                      borderRadius: \'8px\',\\n                      border: \'1px solid #e7e5e4\',\\n                    }}\\n                  />\\n                  <Bar dataKey=\\\"count\\\" radius={[6, 6, 0, 0]}>\\n                    {statusData.map((entry, index) => (\\n                      <Cell key={`cell-${index}`} fill={entry.color} />\\n                    ))}\\n                  </Bar>\\n                </BarChart>\\n              </ResponsiveContainer>\\n            </div>\\n          </div>\\n\\n          {/* Top Skills Proficiency Chart */}\\n          <div className=\\\"p-5 bg-white border border-stone-200 rounded-xl shadow-2xs space-y-4\\\">\\n            <div className=\\\"flex items-center justify-between\\\">\\n              <div>\\n                <h2 className=\\\"text-sm font-bold text-slate-900\\\">Skill Proficiency Overview</h2>\\n                <p className=\\\"text-xs text-stone-500\\\">Self-assessed ratings (Scale 1 to 5)</p>\\n              </div>\\n              <Link\\n                to=\\\"/skills\\\"\\n                className=\\\"text-xs font-semibold text-indigo-600 hover:text-indigo-800\\\"\\n              >\\n                Manage Skills \342\206\222\\n              </Link>\\n            </div>\\n\\n            {skillChartData.length === 0 ? (\\n              <div className=\\\"h-56 flex flex-col items-center justify-center text-center p-4 bg-stone-50 rounded-lg\\\">\\n                <Award className=\\\"w-6 h-6 text-stone-400 mb-2\\\" />\\n                <p className=\\\"text-xs text-stone-600 mb-2\\\">\\n                  Add skills in the Skill Tracker to visualize your proficiency distribution.\\n                </p>\\n                <Link\\n                  to=\\\"/skills\\\"\\n                  className=\\\"px-3 py-1.5 text-xs font-semibold text-white bg-slate-900 rounded-lg\\\"\\n                >\\n                  Add First Skill\\n                </Link>\\n              </div>\\n            ) : (\\n              <div className=\\\"h-56 w-full\\\">\\n                <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n                  <BarChart\\n                    data={skillChartData}\\n                    margin={{ top: 8, right: 12, left: -16, bottom: 0 }}\\n                  >\\n                    <XAxis dataKey=\\\"name\\\" tick={{ fontSize: 11, fill: \'#57534e\' }} />\\n                    <YAxis domain={[0, 5]} ticks={[0, 1, 2, 3, 4, 5]} tick={{ fontSize: 11, fill: \'#57534e\' }} />\\n                    <Tooltip\\n                      contentStyle={{\\n                        fontSize: \'12px\',\\n                        borderRadius: \'8px\',\\n                        border: \'1px solid #e7e5e4\',\\n                      }}\\n                    />\\n                    <Bar dataKey=\\\"level\\\" fill=\\\"#4f46e5\\\" radius={[6, 6, 0, 0]} />\\n                  </BarChart>\\n                </ResponsiveContainer>\\n              </div>\\n            )}\\n          </div>\\n        </div>\\n\\n        {/* Quick Navigation Grid */}\\n        <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\\\">\\n          <Link\\n            to=\\\"/recommendations\\\"\\n            className=\\\"p-4 bg-white border border-stone-200 hover:border-indigo-300 rounded-xl shadow-2xs transition-colors\\\"\\n          >\\n            <Sparkles className=\\\"w-4 h-4 text-indigo-600 mb-2\\\" />\\n            <h3 className=\\\"text-xs font-bold text-slate-900\\\">1. AI Career Match</h3>\\n            <p className=\\\"text-[11px] text-stone-600 mt-1\\\">\\n              Compare your BCA skills against high-demand tech roles.\\n            </p>\\n          </Link>\\n\\n          <Link\\n            to=\\\"/resume\\\"\\n            className=\\\"p-4 bg-white border border-stone-200 hover:border-indigo-300 rounded-xl shadow-2xs transition-colors\\\"\\n          >\\n            <FileText className=\\\"w-4 h-4 text-indigo-600 mb-2\\\" />\\n            <h3 className=\\\"text-xs font-bold text-slate-900\\\">2. ATS Resume & PDF</h3>\\n            <p className=\\\"text-[11px] text-stone-600 mt-1\\\">\\n              Build your single-column resume, apply AI fixes, and export PDF.\\n            </p>\\n          </Link>\\n\\n          <Link\\n            to=\\\"/interview\\\"\\n            className=\\\"p-4 bg-white border border-stone-200 hover:border-indigo-300 rounded-xl shadow-2xs transition-colors\\\"\\n          >\\n            <MessageSquareCode className=\\\"w-4 h-4 text-indigo-600 mb-2\\\" />\\n            <h3 className=\\\"text-xs font-bold text-slate-900\\\">3. Mock Interview</h3>\\n            <p className=\\\"text-[11px] text-stone-600 mt-1\\\">\\n              Practice 8-question technical & HR placement rounds.\\n            </p>\\n          </Link>\\n\\n          <Link\\n            to=\\\"/roadmap\\\"\\n            className=\\\"p-4 bg-white border border-stone-200 hover:border-indigo-300 rounded-xl shadow-2xs transition-colors\\\"\\n          >\\n            <Milestone className=\\\"w-4 h-4 text-indigo-600 mb-2\\\" />\\n            <h3 className=\\\"text-xs font-bold text-slate-900\\\">4. Learning Roadmap</h3>\\n            <p className=\\\"text-[11px] text-stone-600 mt-1\\\">\\n              Follow weekly topic milestones and portfolio project ideas.\\n            </p>\\n          </Link>\\n        </div>\\n      </div>\\n    </AppShell>\\n  );\\n}\\n\", \"Description\":\"Phase 6 Progress Dashboard with exact metrics and Recharts visualizations\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/DashboardPage.tsx\", \"toolAction\":\"Updating DashboardPage\", \"toolSummary\":\"Update src/pages/DashboardPage.tsx with Recharts and live metrics\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_8298204120055981856"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useEffect, useState, FormEvent } from \'react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { User, CareerResource } from \'../types\';\\nimport { listUsers, toggleUserActiveStatus } from \'../services/auth\';\\nimport {\\n  listCareerResources,\\n  saveCareerResource,\\n  deleteCareerResource,\\n  getPlatformStats,\\n} from \'../services/db\';\\nimport { AppShell } from \'../components/layout/AppShell\';\\nimport {\\n  ShieldCheck,\\n  Search,\\n  Plus,\\n  Trash2,\\n  Edit3,\\n  CheckCircle2,\\n  AlertCircle,\\n  ExternalLink,\\n  UserX,\\n  UserCheck,\\n} from \'lucide-react\';\\n\\nexport function AdminPage() {\\n  const { user } = useAuth();\\n  const [users, setUsers] = useState<User[]>([]);\\n  const [resources, setResources] = useState<CareerResource[]>([]);\\n  const [stats, setStats] = useState({\\n    totalProfiles: 0,\\n    totalResumes: 0,\\n    totalSkills: 0,\\n    totalCertificates: 0,\\n    totalApplications: 0,\\n    totalRoadmaps: 0,\\n    totalResources: 0,\\n  });\\n  const [searchQuery, setSearchQuery] = useState(\'\');\\n  const [loading, setLoading] = useState(true);\\n\\n  // Resource CRUD form state\\n  const [editingResId, setEditingResId] = useState<string | null>(null);\\n  const [resTitle, setResTitle] = useState(\'\');\\n  const [resCategory, setResCategory] = useState<CareerResource[\'category\']>(\'DSA & Coding\');\\n  const [resLink, setResLink] = useState(\'\');\\n  const [resDesc, setResDesc] = useState(\'\');\\n\\n  const [feedback, setFeedback] = useState<{ type: \'success\' | \'error\'; text: string } | null>(null);\\n\\n  useEffect(() => {\\n    async function loadAdminData() {\\n      if (!user || user.role !== \'admin\') return;\\n      setLoading(true);\\n      try {\\n        const [uList, rList, pStats] = await Promise.all([\\n          listUsers(user.role),\\n          listCareerResources(),\\n          getPlatformStats(user.role),\\n        ]);\\n        setUsers(uList);\\n        setResources(rList);\\n        setStats(pStats);\\n      } catch (err) {\\n        console.error(\'Failed to load admin console:\', err);\\n      } finally {\\n        setLoading(false);\\n      }\\n    }\\n    loadAdminData();\\n  }, [user]);\\n\\n  const handleToggleUserActive = async (targetUser: User) => {\\n    if (!user) return;\\n    setFeedback(null);\\n    try {\\n      const updated = await toggleUserActiveStatus(targetUser.id, user);\\n      setUsers((prev) => prev.map((u) => (u.id === updated.id ? updated : u)));\\n      setFeedback({\\n        type: \'success\',\\n        text: `User \\\"${updated.name}\\\" is now ${updated.active !== false ? \'Active\' : \'Deactivated\'}.`,\\n      });\\n    } catch (err: unknown) {\\n      setFeedback({\\n        type: \'error\',\\n        text: err instanceof Error ? err.message : \'Could not change user status.\',\\n      });\\n    }\\n  };\\n\\n  const handleSaveResource = async (e: FormEvent) => {\\n    e.preventDefault();\\n    if (!user) return;\\n    setFeedback(null);\\n\\n    if (!resTitle.trim() || !resLink.trim() || !resDesc.trim()) {\\n      setFeedback({ type: \'error\', text: \'Title, link URL, and description are required.\' });\\n      return;\\n    }\\n\\n    let formattedLink = resLink.trim();\\n    if (!/^https?:\\\\/\\\\//i.test(formattedLink)) {\\n      formattedLink = `https://${formattedLink}`;\\n    }\\n\\n    try {\\n      const saved = await saveCareerResource(\\n        {\\n          id: editingResId || `res-${Date.now()}`,\\n          title: resTitle.trim(),\\n          category: resCategory,\\n          link: formattedLink,\\n          description: resDesc.trim(),\\n          createdAt: new Date().toISOString(),\\n        },\\n        user.role\\n      );\\n\\n      setResources((prev) => {\\n        const exists = prev.some((r) => r.id === saved.id);\\n        return exists ? prev.map((r) => (r.id === saved.id ? saved : r)) : [saved, ...prev];\\n      });\\n\\n      setEditingResId(null);\\n      setResTitle(\'\');\\n      setResLink(\'\');\\n      setResDesc(\'\');\\n      setFeedback({\\n        type: \'success\',\\n        text: editingResId\\n          ? \'Career resource updated and live for students.\'\\n          : \'New career resource published to student portal.\',\\n      });\\n    } catch (err: unknown) {\\n      setFeedback({\\n        type: \'error\',\\n        text: err instanceof Error ? err.message : \'Failed to save resource.\',\\n      });\\n    }\\n  };\\n\\n  const handleDeleteResource = async (id: string) => {\\n    if (!user) return;\\n    try {\\n      await deleteCareerResource(id, user.role);\\n      setResources((prev) => prev.filter((r) => r.id !== id));\\n      setFeedback({ type: \'success\', text: \'Resource deleted.\' });\\n    } catch (err: unknown) {\\n      setFeedback({\\n        type: \'error\',\\n        text: err instanceof Error ? err.message : \'Could not delete resource.\',\\n      });\\n    }\\n  };\\n\\n  const filteredUsers = users.filter((u) => {\\n    const q = searchQuery.trim().toLowerCase();\\n    if (!q) return true;\\n    return (\\n      u.name.toLowerCase().includes(q) ||\\n      u.email.toLowerCase().includes(q) ||\\n      u.role.toLowerCase().includes(q)\\n    );\\n  });\\n\\n  return (\\n    <AppShell>\\n      <div className=\\\"space-y-6\\\">\\n        <div className=\\\"p-6 bg-white border border-stone-200 rounded-xl shadow-2xs flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n          <div className=\\\"flex items-center gap-3\\\">\\n            <div className=\\\"w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center border border-amber-200 shrink-0\\\">\\n              <ShieldCheck className=\\\"w-5 h-5\\\" />\\n            </div>\\n            <div>\\n              <h1 className=\\\"text-xl sm:text-2xl font-bold text-slate-900\\\">\\n                Admin Placement & Content Console\\n              </h1>\\n              <p className=\\\"text-xs text-stone-600 mt-0.5\\\">\\n                Manage student accounts, monitor platform adoption, and publish Career Resources.\\n              </p>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {feedback && (\\n          <div\\n            className={`p-3 rounded-lg border flex items-center gap-2 text-xs ${\\n              feedback.type === \'success\'\\n                ? \'bg-emerald-50 border-emerald-200 text-emerald-900\'\\n                : \'bg-red-50 border-red-200 text-red-900\'\\n            }`}\\n          >\\n            {feedback.type === \'success\' ? (\\n              <CheckCircle2 className=\\\"w-4 h-4 text-emerald-600 shrink-0\\\" />\\n            ) : (\\n              <AlertCircle className=\\\"w-4 h-4 text-red-600 shrink-0\\\" />\\n            )}\\n            <span>{feedback.text}</span>\\n          </div>\\n        )}\\n\\n        {/* Platform Usage Counts */}\\n        <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-4\\\">\\n          <div className=\\\"p-4 bg-white border border-stone-200 rounded-xl shadow-2xs\\\">\\n            <span className=\\\"text-xs text-stone-500\\\">Registered Users</span>\\n            <p className=\\\"text-2xl font-extrabold text-slate-900 tabular-nums mt-0.5\\\">\\n              {users.length}\\n            </p>\\n            <span className=\\\"text-[11px] text-stone-600 tabular-nums\\\">\\n              {users.filter((u) => u.active !== false).length} active \302\267{\' \'}\\n              {users.filter((u) => u.active === false).length} deactivated\\n            </span>\\n          </div>\\n\\n          <div className=\\\"p-4 bg-white border border-stone-200 rounded-xl shadow-2xs\\\">\\n            <span className=\\\"text-xs text-stone-500\\\">Resumes & Profiles</span>\\n            <p className=\\\"text-2xl font-extrabold text-slate-900 tabular-nums mt-0.5\\\">\\n              {stats.totalResumes}\\n            </p>\\n            <span className=\\\"text-[11px] text-stone-600 tabular-nums\\\">\\n              {stats.totalProfiles} career profiles saved\\n            </span>\\n          </div>\\n\\n          <div className=\\\"p-4 bg-white border border-stone-200 rounded-xl shadow-2xs\\\">\\n            <span className=\\\"text-xs text-stone-500\\\">Tracked Applications</span>\\n            <p className=\\\"text-2xl font-extrabold text-slate-900 tabular-nums mt-0.5\\\">\\n              {stats.totalApplications}\\n            </p>\\n            <span className=\\\"text-[11px] text-stone-600 tabular-nums\\\">\\n              {stats.totalSkills} skills logged\\n            </span>\\n          </div>\\n\\n          <div className=\\\"p-4 bg-white border border-stone-200 rounded-xl shadow-2xs\\\">\\n            <span className=\\\"text-xs text-stone-500\\\">Published Resources</span>\\n            <p className=\\\"text-2xl font-extrabold text-slate-900 tabular-nums mt-0.5\\\">\\n              {resources.length}\\n            </p>\\n            <span className=\\\"text-[11px] text-stone-600 tabular-nums\\\">\\n              {stats.totalRoadmaps} active roadmaps\\n            </span>\\n          </div>\\n        </div>\\n\\n        {/* Section 1: Users Table with Search & Deactivate */}\\n        <div className=\\\"bg-white border border-stone-200 rounded-xl shadow-2xs overflow-hidden\\\">\\n          <div className=\\\"p-4 border-b border-stone-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n            <h2 className=\\\"text-sm font-bold text-slate-900\\\">User Accounts ({filteredUsers.length})</h2>\\n            <div className=\\\"relative w-full sm:w-64\\\">\\n              <Search className=\\\"w-3.5 h-3.5 text-stone-400 absolute left-3 top-1/2 -translate-y-1/2\\\" />\\n              <input\\n                type=\\\"text\\\"\\n                value={searchQuery}\\n                onChange={(e) => setSearchQuery(e.target.value)}\\n                placeholder=\\\"Search by name, email, role...\\\"\\n                aria-label=\\\"Search registered users\\\"\\n                className=\\\"w-full pl-8 pr-3 py-1.5 text-xs border border-stone-300 rounded-lg\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <div className=\\\"overflow-x-auto\\\">\\n            <table className=\\\"w-full text-left text-xs\\\">\\n              <thead className=\\\"bg-stone-50 border-b border-stone-200 text-stone-600\\\">\\n                <tr>\\n                  <th className=\\\"py-2.5 px-4 font-semibold\\\">Name</th>\\n                  <th className=\\\"py-2.5 px-4 font-semibold\\\">Email</th>\\n                  <th className=\\\"py-2.5 px-4 font-semibold\\\">Role</th>\\n                  <th className=\\\"py-2.5 px-4 font-semibold\\\">Status</th>\\n                  <th className=\\\"py-2.5 px-4 font-semibold text-right\\\">Action</th>\\n                </tr>\\n              </thead>\\n              <tbody className=\\\"divide-y divide-stone-100\\\">\\n                {loading ? (\\n                  <tr>\\n                    <td colSpan={5} className=\\\"py-6 text-center text-stone-500\\\">\\n                      Loading users...\\n                    </td>\\n                  </tr>\\n                ) : filteredUsers.length === 0 ? (\\n                  <tr>\\n                    <td colSpan={5} className=\\\"py-6 text-center text-stone-500\\\">\\n                      No users match your search filter.\\n                    </td>\\n                  </tr>\\n                ) : (\\n                  filteredUsers.map((u) => {\\n                    const isSelf = u.id === user?.id;\\n                    const isActive = u.active !== false;\\n                    return (\\n                      <tr key={u.id} className=\\\"hover:bg-stone-50/60\\\">\\n                        <td className=\\\"py-3 px-4 font-medium text-slate-900\\\">{u.name}</td>\\n                        <td className=\\\"py-3 px-4 font-mono text-[11px] text-stone-600\\\">{u.email}</td>\\n                        <td className=\\\"py-3 px-4 capitalize text-stone-700\\\">{u.role}</td>\\n                        <td className=\\\"py-3 px-4\\\">\\n                          <span\\n                            className={`font-semibold ${\\n                              isActive ? \'text-emerald-700\' : \'text-red-700\'\\n                            }`}\\n                          >\\n                            {isActive ? \'Active\' : \'Deactivated\'}\\n                          </span>\\n                        </td>\\n                        <td className=\\\"py-3 px-4 text-right\\\">\\n                          {isSelf ? (\\n                            <span className=\\\"text-[11px] text-stone-400\\\">Current Admin</span>\\n                          ) : (\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={() => handleToggleUserActive(u)}\\n                              className={`inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium rounded-md transition-colors ${\\n                                isActive\\n                                  ? \'text-red-700 bg-red-50 hover:bg-red-100\'\\n                                  : \'text-emerald-700 bg-emerald-50 hover:bg-emerald-100\'\\n                              }`}\\n                            >\\n                              {isActive ? (\\n                                <>\\n                                  <UserX className=\\\"w-3 h-3\\\" />\\n                                  <span>Deactivate</span>\\n                                </>\\n                              ) : (\\n                                <>\\n                                  <UserCheck className=\\\"w-3 h-3\\\" />\\n                                  <span>Activate</span>\\n                                </>\\n                              )}\\n                            </button>\\n                          )}\\n                        </td>\\n                      </tr>\\n                    );\\n                  })\\n                )}\\n              </tbody>\\n            </table>\\n          </div>\\n        </div>\\n\\n        {/* Section 2: Career Resources CRUD */}\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\\\">\\n          <form\\n            onSubmit={handleSaveResource}\\n            className=\\\"lg:col-span-5 p-5 bg-white border border-stone-200 rounded-xl shadow-2xs space-y-3.5\\\"\\n          >\\n            <div className=\\\"flex items-center justify-between\\\">\\n              <h2 className=\\\"text-sm font-bold text-slate-900\\\">\\n                {editingResId ? \'Edit Career Resource\' : \'Publish Career Resource\'}\\n              </h2>\\n              {editingResId && (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    setEditingResId(null);\\n                    setResTitle(\'\');\\n                    setResLink(\'\');\\n                    setResDesc(\'\');\\n                  }}\\n                  className=\\\"text-xs text-stone-500 hover:text-stone-900\\\"\\n                >\\n                  Cancel\\n                </button>\\n              )}\\n            </div>\\n\\n            <div>\\n              <label htmlFor=\\\"res-title\\\" className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                Resource Title *\\n              </label>\\n              <input\\n                id=\\\"res-title\\\"\\n                type=\\\"text\\\"\\n                required\\n                value={resTitle}\\n                onChange={(e) => setResTitle(e.target.value)}\\n                placeholder=\\\"e.g. PostgreSQL Official Tutorial\\\"\\n                className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label htmlFor=\\\"res-cat\\\" className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                Category\\n              </label>\\n              <select\\n                id=\\\"res-cat\\\"\\n                value={resCategory}\\n                onChange={(e) =>\\n                  setResCategory(e.target.value as CareerResource[\'category\'])\\n                }\\n                className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg bg-white\\\"\\n              >\\n                <option value=\\\"DSA & Coding\\\">DSA & Coding</option>\\n                <option value=\\\"Web & Full-Stack\\\">Web & Full-Stack</option>\\n                <option value=\\\"Aptitude & Placement\\\">Aptitude & Placement</option>\\n                <option value=\\\"Resume & HR\\\">Resume & HR</option>\\n                <option value=\\\"Cloud & Data\\\">Cloud & Data</option>\\n              </select>\\n            </div>\\n\\n            <div>\\n              <label htmlFor=\\\"res-link\\\" className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                Resource URL *\\n              </label>\\n              <input\\n                id=\\\"res-link\\\"\\n                type=\\\"text\\\"\\n                required\\n                value={resLink}\\n                onChange={(e) => setResLink(e.target.value)}\\n                placeholder=\\\"https://...\\\"\\n                className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label htmlFor=\\\"res-desc\\\" className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                Description *\\n              </label>\\n              <textarea\\n                id=\\\"res-desc\\\"\\n                rows={3}\\n                required\\n                value={resDesc}\\n                onChange={(e) => setResDesc(e.target.value)}\\n                placeholder=\\\"Explain how this resource helps students prepare...\\\"\\n                className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg\\\"\\n              />\\n            </div>\\n\\n            <button\\n              type=\\\"submit\\\"\\n              className=\\\"w-full inline-flex items-center justify-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg\\\"\\n            >\\n              <Plus className=\\\"w-3.5 h-3.5\\\" />\\n              <span>{editingResId ? \'Update Resource\' : \'Publish Resource\'}</span>\\n            </button>\\n          </form>\\n\\n          <div className=\\\"lg:col-span-7 bg-white border border-stone-200 rounded-xl shadow-2xs p-5 space-y-3\\\">\\n            <h2 className=\\\"text-sm font-bold text-slate-900\\\">\\n              Live Career Resources ({resources.length})\\n            </h2>\\n            {resources.length === 0 ? (\\n              <p className=\\\"text-xs text-stone-500 py-4\\\">\\n                No career resources published yet. Use the form on the left to add one.\\n              </p>\\n            ) : (\\n              <div className=\\\"divide-y divide-stone-100\\\">\\n                {resources.map((r) => (\\n                  <div key={r.id} className=\\\"py-3 flex items-start justify-between gap-3\\\">\\n                    <div className=\\\"min-w-0\\\">\\n                      <span className=\\\"text-[11px] font-medium text-indigo-700\\\">\\n                        {r.category}\\n                      </span>\\n                      <p className=\\\"text-xs font-bold text-slate-900\\\">{r.title}</p>\\n                      <p className=\\\"text-xs text-stone-600 mt-0.5\\\">{r.description}</p>\\n                      <a\\n                        href={r.link}\\n                        target=\\\"_blank\\\"\\n                        rel=\\\"noopener noreferrer\\\"\\n                        className=\\\"inline-flex items-center gap-1 text-[11px] text-indigo-600 hover:underline mt-1\\\"\\n                      >\\n                        <span>{r.link}</span>\\n                        <ExternalLink className=\\\"w-2.5 h-2.5\\\" />\\n                      </a>\\n                    </div>\\n                    <div className=\\\"flex items-center gap-1 shrink-0\\\">\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => {\\n                          setEditingResId(r.id);\\n                          setResTitle(r.title);\\n                          setResCategory(r.category);\\n                          setResLink(r.link);\\n                          setResDesc(r.description);\\n                        }}\\n                        className=\\\"p-1.5 text-stone-500 hover:text-slate-900 hover:bg-stone-100 rounded\\\"\\n                        aria-label={`Edit ${r.title}`}\\n                      >\\n                        <Edit3 className=\\\"w-3.5 h-3.5\\\" />\\n                      </button>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => handleDeleteResource(r.id)}\\n                        className=\\\"p-1.5 text-stone-500 hover:text-red-600 hover:bg-red-50 rounded\\\"\\n                        aria-label={`Delete ${r.title}`}\\n                      >\\n                        <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                      </button>\\n                    </div>\\n                  </div>\\n                ))}\\n              </div>\\n            )}\\n          </div>\\n        </div>\\n      </div>\\n    </AppShell>\\n  );\\n}\\n\", \"Description\":\"Phase 7 Admin Console with user search, deactivation enforcement, usage stats, and Career Resources CRUD\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/AdminPage.tsx\", \"toolAction\":\"Updating AdminPage\", \"toolSummary\":\"Update src/pages/AdminPage.tsx (Phase 7)\"}"
      original_name: "write_to_file"
    }
