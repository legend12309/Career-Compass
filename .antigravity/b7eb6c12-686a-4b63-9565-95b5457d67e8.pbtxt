      create_file {
        instruction: "import { useEffect, useState } from \'react\';\nimport { Link } from \'react-router-dom\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { Profile } from \'../types\';\nimport { getProfile } from \'../services/db\';\nimport { AppShell } from \'../components/layout/AppShell\';\nimport {\n  Sparkles,\n  FileText,\n  MessageSquareCode,\n  Briefcase,\n  ArrowRight,\n  GraduationCap,\n  Target,\n  Edit3\n} from \'lucide-react\';\n\nexport function DashboardPage() {\n  const { user } = useAuth();\n  const [profile, setProfile] = useState<Profile | null>(null);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    async function load() {\n      if (!user) return;\n      try {\n        const data = await getProfile(user.id);\n        setProfile(data);\n      } catch (err) {\n        console.error(\'Error fetching dashboard profile:\', err);\n      } finally {\n        setLoading(false);\n      }\n    }\n    load();\n  }, [user]);\n\n  return (\n    <AppShell>\n      <div className=\"space-y-6\">\n        {/* Welcome Greeting */}\n        <div className=\"p-6 bg-white border border-stone-200 rounded-xl shadow-2xs\">\n          <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4\">\n            <div>\n              <div className=\"flex items-center gap-2 text-xs text-stone-600 mb-1\">\n                <span>Academic Session 2026</span>\n                <span aria-hidden=\"true\">\302\267</span>\n                <span className=\"capitalize\">{user?.role} Portal</span>\n              </div>\n              <h1 className=\"text-xl sm:text-2xl font-bold text-slate-900\">\n                Welcome back, {user?.name}\n              </h1>\n              <p className=\"text-xs sm:text-sm text-stone-600 mt-1 max-w-xl\">\n                Here is your current career roadmap status and placement preparation progress.\n              </p>\n            </div>\n\n            <Link\n              to=\"/profile\"\n              className=\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg shadow-xs transition-colors self-start sm:self-auto\"\n            >\n              <Edit3 className=\"w-3.5 h-3.5\" />\n              <span>Update Profile</span>\n            </Link>\n          </div>\n        </div>\n\n        {/* Profile Status Summary */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n          <div className=\"p-5 bg-white border border-stone-200 rounded-xl shadow-2xs space-y-2\">\n            <div className=\"flex items-center gap-2 text-xs font-semibold text-stone-600\">\n              <GraduationCap className=\"w-4 h-4 text-indigo-600\" />\n              <span>Education Track</span>\n            </div>\n            <p className=\"text-sm font-bold text-slate-900\">\n              {profile?.education || \'BCA (Not specified)\'}\n            </p>\n            <p className=\"text-xs text-stone-600\">\n              {profile?.branch || \'Computer Applications\'} \302\267 {profile?.year || \'Current Year\'}\n            </p>\n          </div>\n\n          <div className=\"p-5 bg-white border border-stone-200 rounded-xl shadow-2xs space-y-2\">\n            <div className=\"flex items-center gap-2 text-xs font-semibold text-stone-600\">\n              <Target className=\"w-4 h-4 text-indigo-600\" />\n              <span>Target Career Goal</span>\n            </div>\n            <p className=\"text-sm font-bold text-slate-900 truncate\">\n              {profile?.careerGoal || \'Target role not set yet\'}\n            </p>\n            <p className=\"text-xs text-stone-600\">\n              {profile?.interests?.length || 0} technical focus areas tracked\n            </p>\n          </div>\n\n          <div className=\"p-5 bg-white border border-stone-200 rounded-xl shadow-2xs space-y-2\">\n            <div className=\"flex items-center gap-2 text-xs font-semibold text-stone-600\">\n              <Sparkles className=\"w-4 h-4 text-indigo-600\" />\n              <span>Next Milestone</span>\n            </div>\n            <p className=\"text-sm font-bold text-slate-900\">\n              AI Recommendations (Phase 2)\n            </p>\n            <p className=\"text-xs text-stone-600\">\n              Unlock personalized job role matches once Phase 2 is activated.\n            </p>\n          </div>\n        </div>\n\n        {/* Platform Modules Roadmap Cards */}\n        <div>\n          <h2 className=\"text-sm font-bold text-slate-900 mb-3\">Platform Modules Roadmap</h2>\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n            <div className=\"p-4 bg-white border border-stone-200 rounded-xl\">\n              <div className=\"w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center mb-2.5\">\n                <Sparkles className=\"w-4 h-4\" />\n              </div>\n              <h3 className=\"text-xs font-bold text-slate-900\">AI Career Match</h3>\n              <p className=\"text-[11px] text-stone-600 mt-1\">\n                Generates 3-5 high-fit tech careers with match %, salary estimates & missing skills.\n              </p>\n              <span className=\"inline-block mt-3 text-[10px] text-stone-600 font-medium\">Phase 2 Ready</span>\n            </div>\n\n            <div className=\"p-4 bg-white border border-stone-200 rounded-xl\">\n              <div className=\"w-8 h-8 rounded-lg bg-stone-100 text-stone-700 flex items-center justify-center mb-2.5\">\n                <FileText className=\"w-4 h-4\" />\n              </div>\n              <h3 className=\"text-xs font-bold text-slate-900\">ATS Resume Builder</h3>\n              <p className=\"text-[11px] text-stone-600 mt-1\">\n                Live editor, AI score & improvement suggestions, plus single-column PDF export.\n              </p>\n              <span className=\"inline-block mt-3 text-[10px] text-stone-600 font-medium\">Phase 3</span>\n            </div>\n\n            <div className=\"p-4 bg-white border border-stone-200 rounded-xl\">\n              <div className=\"w-8 h-8 rounded-lg bg-stone-100 text-stone-700 flex items-center justify-center mb-2.5\">\n                <MessageSquareCode className=\"w-4 h-4\" />\n              </div>\n              <h3 className=\"text-xs font-bold text-slate-900\">Mock Interview</h3>\n              <p className=\"text-[11px] text-stone-600 mt-1\">\n                8-question dynamic tech/HR interview practice with instant AI answer evaluations.\n              </p>\n              <span className=\"inline-block mt-3 text-[10px] text-stone-600 font-medium\">Phase 5</span>\n            </div>\n\n            <div className=\"p-4 bg-white border border-stone-200 rounded-xl\">\n              <div className=\"w-8 h-8 rounded-lg bg-stone-100 text-stone-700 flex items-center justify-center mb-2.5\">\n                <Briefcase className=\"w-4 h-4\" />\n              </div>\n              <h3 className=\"text-xs font-bold text-slate-900\">Application Pipeline</h3>\n              <p className=\"text-[11px] text-stone-600 mt-1\">\n                Kanban tracker for saved, applied, interview rounds, and job offers.\n              </p>\n              <span className=\"inline-block mt-3 text-[10px] text-stone-600 font-medium\">Phase 6</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </AppShell>\n  );\n}\n"
