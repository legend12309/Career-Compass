    tool_calls {
      id: "call_10789153289607253384"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { Link } from \'react-router-dom\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { en } from \'../i18n/en\';\\nimport { Navbar } from \'../components/layout/Navbar\';\\nimport {\\n  Compass,\\n  Sparkles,\\n  FileText,\\n  MessageSquareCode,\\n  CheckCircle2,\\n  ArrowRight,\\n  ShieldCheck,\\n  Users,\\n} from \'lucide-react\';\\n\\nexport function LandingPage() {\\n  const { user } = useAuth();\\n\\n  const features = [\\n    {\\n      title: \'Career Ideas Across All Fields\',\\n      description:\\n        \'Explore best-fit, adjacent, and stretch career options matched to your education, field of study, and interests.\',\\n      icon: Sparkles,\\n    },\\n    {\\n      title: \'Clean PDF Resume Builder\',\\n      description:\\n        \'Switch between fresher, experienced, and academic modes. Export a single-column A4 PDF with no photo.\',\\n      icon: FileText,\\n    },\\n    {\\n      title: \'Mock Interview & Viva Practice\',\\n      description:\\n        \'Practice 8 tailored questions at your own pace with helpful AI feedback and sample answers.\',\\n      icon: MessageSquareCode,\\n    },\\n    {\\n      title: \'Opportunities & Learning Roadmap\',\\n      description:\\n        \'Track jobs, internships, exams, scholarships, admissions, and freelance work alongside a weekly study plan.\',\\n      icon: CheckCircle2,\\n    },\\n  ];\\n\\n  return (\\n    <div className=\\\"min-h-screen flex flex-col bg-stone-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100\\\">\\n      <Navbar />\\n\\n      <section className=\\\"flex-1 px-4 sm:px-6 lg:px-8 py-12 md:py-16 max-w-5xl mx-auto flex flex-col justify-center text-center\\\">\\n        <p className=\\\"text-xs font-semibold text-indigo-700 dark:text-indigo-400 tracking-wide mb-4\\\">\\n          {en.landing.badge}\\n        </p>\\n\\n        <h1 className=\\\"text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight max-w-3xl mx-auto leading-tight\\\">\\n          {en.landing.heroTitle}\\n        </h1>\\n\\n        <p className=\\\"mt-5 text-sm sm:text-base text-stone-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed\\\">\\n          {en.landing.heroSubtitle}\\n        </p>\\n\\n        <div className=\\\"mt-8 flex flex-col sm:flex-row items-center justify-center gap-3\\\">\\n          {user ? (\\n            <Link\\n              to={user.role === \'admin\' ? \'/admin\' : \'/dashboard\'}\\n              className=\\\"w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold text-white bg-slate-900 dark:bg-indigo-600 hover:bg-slate-800 dark:hover:bg-indigo-500 rounded-lg transition-colors\\\"\\n            >\\n              <span>Open My Dashboard</span>\\n              <ArrowRight className=\\\"w-4 h-4\\\" />\\n            </Link>\\n          ) : (\\n            <>\\n              <Link\\n                to=\\\"/register\\\"\\n                className=\\\"w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold text-white bg-slate-900 dark:bg-indigo-600 hover:bg-slate-800 dark:hover:bg-indigo-500 rounded-lg transition-colors\\\"\\n              >\\n                <span>Create Free Account</span>\\n                <ArrowRight className=\\\"w-4 h-4\\\" />\\n              </Link>\\n              <Link\\n                to=\\\"/login\\\"\\n                className=\\\"w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-slate-800 dark:text-slate-100 bg-white dark:bg-slate-900 hover:bg-stone-100 dark:hover:bg-slate-800 border border-stone-200 dark:border-slate-800 rounded-lg transition-colors\\\"\\n              >\\n                Try Demo Accounts\\n              </Link>\\n            </>\\n          )}\\n        </div>\\n\\n        {/* Who is this for section */}\\n        <div id=\\\"who-is-this-for\\\" className=\\\"mt-14 text-left\\\">\\n          <div className=\\\"flex items-center gap-2 mb-4\\\">\\n            <Users className=\\\"w-4 h-4 text-indigo-600 dark:text-indigo-400\\\" />\\n            <h2 className=\\\"text-base font-bold text-slate-900 dark:text-slate-100\\\">\\n              {en.landing.whoIsThisForTitle}\\n            </h2>\\n          </div>\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\\\">\\n            {en.landing.whoGroups.map((g) => (\\n              <div\\n                key={g.title}\\n                className=\\\"p-4 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl\\\"\\n              >\\n                <h3 className=\\\"text-xs font-bold text-slate-900 dark:text-slate-100 mb-1\\\">\\n                  {g.title}\\n                </h3>\\n                <p className=\\\"text-xs text-stone-600 dark:text-slate-300 leading-relaxed\\\">\\n                  {g.desc}\\n                </p>\\n              </div>\\n            ))}\\n          </div>\\n        </div>\\n\\n        {/* Features Grid */}\\n        <div id=\\\"features\\\" className=\\\"mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-left\\\">\\n          {features.map((feat) => {\\n            const Icon = feat.icon;\\n            return (\\n              <div\\n                key={feat.title}\\n                className=\\\"p-5 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl\\\"\\n              >\\n                <div className=\\\"w-9 h-9 rounded-lg bg-stone-100 dark:bg-slate-800 flex items-center justify-center mb-3\\\">\\n                  <Icon className=\\\"w-5 h-5 text-indigo-600 dark:text-indigo-400\\\" />\\n                </div>\\n                <h3 className=\\\"text-sm font-bold text-slate-900 dark:text-slate-100 mb-1.5\\\">\\n                  {feat.title}\\n                </h3>\\n                <p className=\\\"text-xs text-stone-600 dark:text-slate-300 leading-relaxed\\\">\\n                  {feat.description}\\n                </p>\\n              </div>\\n            );\\n          })}\\n        </div>\\n\\n        {/* Demo Accounts Box */}\\n        <div className=\\\"mt-12 p-4 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl max-w-lg mx-auto text-left\\\">\\n          <div className=\\\"flex items-center gap-2 text-xs font-semibold text-slate-900 dark:text-slate-100 mb-2\\\">\\n            <ShieldCheck className=\\\"w-4 h-4 text-indigo-600 dark:text-indigo-400\\\" />\\n            <span>Demo Accounts (Labelled &ldquo;demo&rdquo;)</span>\\n          </div>\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-stone-600 dark:text-slate-300\\\">\\n            <div className=\\\"p-2.5 bg-stone-50 dark:bg-slate-950 rounded border border-stone-200 dark:border-slate-800\\\">\\n              <span className=\\\"font-semibold text-slate-900 dark:text-slate-100 block\\\">\\n                Demo User (demo):\\n              </span>\\n              <span className=\\\"font-mono text-[11px] block\\\">demo@careercompass.org</span>\\n              <span className=\\\"font-mono text-[11px]\\\">pass: demo123</span>\\n            </div>\\n            <div className=\\\"p-2.5 bg-stone-50 dark:bg-slate-950 rounded border border-stone-200 dark:border-slate-800\\\">\\n              <span className=\\\"font-semibold text-slate-900 dark:text-slate-100 block\\\">\\n                Demo Admin (demo):\\n              </span>\\n              <span className=\\\"font-mono text-[11px] block\\\">admin@careercompass.org</span>\\n              <span className=\\\"font-mono text-[11px]\\\">pass: admin123</span>\\n            </div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      <footer className=\\\"border-t border-stone-200 dark:border-slate-800 bg-white dark:bg-slate-900 py-6 px-4 text-center text-xs text-stone-600 dark:text-slate-400\\\">\\n        <div className=\\\"flex items-center justify-center gap-2 mb-1\\\">\\n          <Compass className=\\\"w-4 h-4 text-indigo-600 dark:text-indigo-400\\\" />\\n          <span className=\\\"font-bold text-slate-900 dark:text-slate-100\\\">{en.appName}</span>\\n        </div>\\n        <p>{en.tagline}</p>\\n      </footer>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Universal LandingPage explaining who Career Compass is for across all fields and stages\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/LandingPage.tsx\", \"toolAction\":\"Updating LandingPage\", \"toolSummary\":\"Update src/pages/LandingPage.tsx with universal copy and dark mode\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_10789153289607252857"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useState, FormEvent } from \'react\';\\nimport { useNavigate, Link } from \'react-router-dom\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { getSeedCredentials } from \'../services/auth\';\\nimport { en } from \'../i18n/en\';\\nimport { Compass, LogIn, AlertCircle, ArrowRight, UserCheck, ShieldCheck } from \'lucide-react\';\\n\\nexport function LoginPage() {\\n  const navigate = useNavigate();\\n  const { login } = useAuth();\\n\\n  const [email, setEmail] = useState(\'\');\\n  const [password, setPassword] = useState(\'\');\\n  const [error, setError] = useState<string | null>(null);\\n  const [isSubmitting, setIsSubmitting] = useState(false);\\n\\n  const seedUsers = getSeedCredentials();\\n\\n  const redirectAfterLogin = (role: string, onboarded: boolean) => {\\n    if (role === \'admin\') {\\n      navigate(\'/admin\', { replace: true });\\n    } else if (!onboarded) {\\n      navigate(\'/onboarding\', { replace: true });\\n    } else {\\n      navigate(\'/dashboard\', { replace: true });\\n    }\\n  };\\n\\n  const handleSubmit = async (e: FormEvent) => {\\n    e.preventDefault();\\n    setError(null);\\n\\n    if (!email.trim() || !password.trim()) {\\n      setError(\'Please enter both your email and password.\');\\n      return;\\n    }\\n\\n    setIsSubmitting(true);\\n    try {\\n      const loggedUser = await login(email, password);\\n      redirectAfterLogin(loggedUser.role, loggedUser.onboarded);\\n    } catch (err: unknown) {\\n      setError(err instanceof Error ? err.message : \'Sign in failed. Please try again.\');\\n    } finally {\\n      setIsSubmitting(false);\\n    }\\n  };\\n\\n  const handleQuickLogin = async (demoEmail: string, demoPass: string) => {\\n    setError(null);\\n    setIsSubmitting(true);\\n    setEmail(demoEmail);\\n    setPassword(demoPass);\\n    try {\\n      const loggedUser = await login(demoEmail, demoPass);\\n      redirectAfterLogin(loggedUser.role, loggedUser.onboarded);\\n    } catch (err: unknown) {\\n      setError(err instanceof Error ? err.message : \'Demo login failed.\');\\n    } finally {\\n      setIsSubmitting(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-stone-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8\\\">\\n      <div className=\\\"sm:mx-auto sm:w-full sm:max-w-md text-center\\\">\\n        <Link to=\\\"/\\\" className=\\\"inline-flex items-center gap-2 mb-3\\\">\\n          <div className=\\\"w-10 h-10 rounded-xl bg-slate-900 dark:bg-indigo-600 text-white flex items-center justify-center\\\">\\n            <Compass className=\\\"w-6 h-6 text-indigo-300 dark:text-white\\\" />\\n          </div>\\n          <span className=\\\"text-xl font-bold tracking-tight\\\">{en.appName}</span>\\n        </Link>\\n        <h1 className=\\\"text-2xl font-extrabold\\\">Sign in to your account</h1>\\n        <p className=\\\"mt-1 text-xs text-stone-600 dark:text-slate-400\\\">\\n          Continue to your career ideas, resume builder, and learning roadmap\\n        </p>\\n      </div>\\n\\n      <div className=\\\"mt-8 sm:mx-auto sm:w-full sm:max-w-md\\\">\\n        <div className=\\\"bg-white dark:bg-slate-900 py-8 px-6 border border-stone-200 dark:border-slate-800 rounded-xl shadow-xs sm:px-8 space-y-6\\\">\\n          {/* Demo Accounts */}\\n          <div className=\\\"p-3.5 bg-stone-50 dark:bg-slate-950 border border-stone-200 dark:border-slate-800 rounded-lg\\\">\\n            <span className=\\\"text-[11px] font-semibold tracking-wider text-stone-600 dark:text-slate-400 uppercase block mb-2\\\">\\n              Quick Demo Access (demo)\\n            </span>\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2\\\">\\n              {seedUsers.map((seed) => (\\n                <button\\n                  key={seed.email}\\n                  type=\\\"button\\\"\\n                  onClick={() => handleQuickLogin(seed.email, seed.password)}\\n                  disabled={isSubmitting}\\n                  className=\\\"flex flex-col items-start p-2.5 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 hover:border-indigo-400 rounded-md transition-colors text-left disabled:opacity-50\\\"\\n                >\\n                  <div className=\\\"flex items-center gap-1.5 text-xs font-semibold\\\">\\n                    {seed.role === \'admin\' ? (\\n                      <ShieldCheck className=\\\"w-3.5 h-3.5 text-amber-600\\\" />\\n                    ) : (\\n                      <UserCheck className=\\\"w-3.5 h-3.5 text-indigo-600\\\" />\\n                    )}\\n                    <span>{seed.label}</span>\\n                  </div>\\n                  <span className=\\\"text-[10px] text-stone-600 dark:text-slate-400 mt-0.5 truncate w-full\\\">\\n                    {seed.email}\\n                  </span>\\n                  <span className=\\\"text-[10px] text-stone-500 font-mono mt-0.5\\\">\\n                    pass: {seed.password}\\n                  </span>\\n                </button>\\n              ))}\\n            </div>\\n          </div>\\n\\n          {error && (\\n            <div className=\\\"p-3 bg-red-50 dark:bg-red-950/50 border border-red-200 dark:border-red-800 rounded-lg flex items-start gap-2.5 text-xs text-red-800 dark:text-red-200\\\">\\n              <AlertCircle className=\\\"w-4 h-4 shrink-0 text-red-600 dark:text-red-400 mt-0.5\\\" />\\n              <span>{error}</span>\\n            </div>\\n          )}\\n\\n          <form onSubmit={handleSubmit} className=\\\"space-y-4\\\">\\n            <div>\\n              <label htmlFor=\\\"login-email\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                Email Address\\n              </label>\\n              <input\\n                id=\\\"login-email\\\"\\n                type=\\\"email\\\"\\n                required\\n                value={email}\\n                onChange={(e) => setEmail(e.target.value)}\\n                placeholder=\\\"you@example.com\\\"\\n                className=\\\"w-full px-3 py-2.5 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label htmlFor=\\\"login-password\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                Password\\n              </label>\\n              <input\\n                id=\\\"login-password\\\"\\n                type=\\\"password\\\"\\n                required\\n                value={password}\\n                onChange={(e) => setPassword(e.target.value)}\\n                placeholder=\\\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\\\"\\n                className=\\\"w-full px-3 py-2.5 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n              />\\n            </div>\\n\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={isSubmitting}\\n              className=\\\"w-full flex items-center justify-center gap-2 py-2.5 px-4 text-xs font-semibold text-white bg-slate-900 dark:bg-indigo-600 hover:bg-slate-800 dark:hover:bg-indigo-500 rounded-lg transition-colors disabled:opacity-50\\\"\\n            >\\n              <LogIn className=\\\"w-3.5 h-3.5\\\" />\\n              <span>{isSubmitting ? \'Signing in...\' : en.nav.signIn}</span>\\n            </button>\\n          </form>\\n\\n          <div className=\\\"pt-2 text-center text-xs text-stone-600 dark:text-slate-400\\\">\\n            <span>New to {en.appName}? </span>\\n            <Link\\n              to=\\\"/register\\\"\\n              className=\\\"font-semibold text-indigo-600 dark:text-indigo-400 hover:underline inline-flex items-center gap-1\\\"\\n            >\\n              Create an account\\n              <ArrowRight className=\\\"w-3 h-3\\\" />\\n            </Link>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"LoginPage with demo user and demo admin buttons and onboarding redirect\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/LoginPage.tsx\", \"toolAction\":\"Updating LoginPage\", \"toolSummary\":\"Update src/pages/LoginPage.tsx with demo accounts and onboarding redirect\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_10789153289607252330"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useState, FormEvent } from \'react\';\\nimport { useNavigate, Link } from \'react-router-dom\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { en } from \'../i18n/en\';\\nimport { Compass, UserPlus, AlertCircle, Shield } from \'lucide-react\';\\n\\nexport function RegisterPage() {\\n  const navigate = useNavigate();\\n  const { register } = useAuth();\\n\\n  const [name, setName] = useState(\'\');\\n  const [email, setEmail] = useState(\'\');\\n  const [password, setPassword] = useState(\'\');\\n  const [confirmPassword, setConfirmPassword] = useState(\'\');\\n  const [error, setError] = useState<string | null>(null);\\n  const [isSubmitting, setIsSubmitting] = useState(false);\\n\\n  const handleSubmit = async (e: FormEvent) => {\\n    e.preventDefault();\\n    setError(null);\\n\\n    if (name.trim().length < 2) {\\n      setError(\'Please enter your name (at least 2 characters).\');\\n      return;\\n    }\\n    if (!email.trim() || !email.includes(\'@\')) {\\n      setError(\'Please enter a valid email address.\');\\n      return;\\n    }\\n    if (password.length < 6) {\\n      setError(\'Password must be at least 6 characters long.\');\\n      return;\\n    }\\n    if (password !== confirmPassword) {\\n      setError(\'Passwords do not match.\');\\n      return;\\n    }\\n\\n    setIsSubmitting(true);\\n    try {\\n      await register(name, email, password, \'user\');\\n      navigate(\'/onboarding\', { replace: true });\\n    } catch (err: unknown) {\\n      setError(err instanceof Error ? err.message : \'Registration failed. Please try again.\');\\n    } finally {\\n      setIsSubmitting(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-stone-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8\\\">\\n      <div className=\\\"sm:mx-auto sm:w-full sm:max-w-md text-center\\\">\\n        <Link to=\\\"/\\\" className=\\\"inline-flex items-center gap-2 mb-3\\\">\\n          <div className=\\\"w-10 h-10 rounded-xl bg-slate-900 dark:bg-indigo-600 text-white flex items-center justify-center\\\">\\n            <Compass className=\\\"w-6 h-6 text-indigo-300 dark:text-white\\\" />\\n          </div>\\n          <span className=\\\"text-xl font-bold tracking-tight\\\">{en.appName}</span>\\n        </Link>\\n        <h1 className=\\\"text-2xl font-extrabold\\\">Create your free account</h1>\\n        <p className=\\\"mt-1 text-xs text-stone-600 dark:text-slate-400\\\">\\n          Plan your career, build your resume, and track opportunities in any field\\n        </p>\\n      </div>\\n\\n      <div className=\\\"mt-8 sm:mx-auto sm:w-full sm:max-w-md\\\">\\n        <div className=\\\"bg-white dark:bg-slate-900 py-8 px-6 border border-stone-200 dark:border-slate-800 rounded-xl shadow-xs sm:px-8 space-y-5\\\">\\n          {error && (\\n            <div className=\\\"p-3 bg-red-50 dark:bg-red-950/50 border border-red-200 dark:border-red-800 rounded-lg flex items-start gap-2.5 text-xs text-red-800 dark:text-red-200\\\">\\n              <AlertCircle className=\\\"w-4 h-4 shrink-0 text-red-600 mt-0.5\\\" />\\n              <span>{error}</span>\\n            </div>\\n          )}\\n\\n          <form onSubmit={handleSubmit} className=\\\"space-y-4\\\">\\n            <div>\\n              <label htmlFor=\\\"reg-name\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                Your Name *\\n              </label>\\n              <input\\n                id=\\\"reg-name\\\"\\n                type=\\\"text\\\"\\n                maxLength={80}\\n                required\\n                value={name}\\n                onChange={(e) => setName(e.target.value)}\\n                placeholder=\\\"e.g. Priya Nair\\\"\\n                className=\\\"w-full px-3 py-2.5 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label htmlFor=\\\"reg-email\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                Email Address *\\n              </label>\\n              <input\\n                id=\\\"reg-email\\\"\\n                type=\\\"email\\\"\\n                maxLength={120}\\n                required\\n                value={email}\\n                onChange={(e) => setEmail(e.target.value)}\\n                placeholder=\\\"you@example.com\\\"\\n                className=\\\"w-full px-3 py-2.5 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n              <div>\\n                <label htmlFor=\\\"reg-password\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                  Password *\\n                </label>\\n                <input\\n                  id=\\\"reg-password\\\"\\n                  type=\\\"password\\\"\\n                  required\\n                  value={password}\\n                  onChange={(e) => setPassword(e.target.value)}\\n                  placeholder=\\\"At least 6 chars\\\"\\n                  className=\\\"w-full px-3 py-2.5 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label htmlFor=\\\"reg-confirm\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                  Confirm Password *\\n                </label>\\n                <input\\n                  id=\\\"reg-confirm\\\"\\n                  type=\\\"password\\\"\\n                  required\\n                  value={confirmPassword}\\n                  onChange={(e) => setConfirmPassword(e.target.value)}\\n                  placeholder=\\\"Repeat password\\\"\\n                  className=\\\"w-full px-3 py-2.5 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            {/* Privacy First Notice */}\\n            <div className=\\\"p-3 bg-stone-50 dark:bg-slate-950 border border-stone-200 dark:border-slate-800 rounded-lg flex items-start gap-2.5 text-[11px] text-stone-600 dark:text-slate-300 leading-relaxed\\\">\\n              <Shield className=\\\"w-4 h-4 text-indigo-600 dark:text-indigo-400 shrink-0 mt-0.5\\\" />\\n              <span>{en.privacy.signupNote}</span>\\n            </div>\\n\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={isSubmitting}\\n              className=\\\"w-full flex items-center justify-center gap-2 py-2.5 px-4 text-xs font-semibold text-white bg-slate-900 dark:bg-indigo-600 hover:bg-slate-800 dark:hover:bg-indigo-500 rounded-lg transition-colors disabled:opacity-50\\\"\\n            >\\n              <UserPlus className=\\\"w-3.5 h-3.5\\\" />\\n              <span>{isSubmitting ? \'Creating account...\' : \'Create Account\'}</span>\\n            </button>\\n          </form>\\n\\n          <div className=\\\"pt-2 text-center text-xs text-stone-600 dark:text-slate-400\\\">\\n            <span>Already have an account? </span>\\n            <Link to=\\\"/login\\\" className=\\\"font-semibold text-indigo-600 dark:text-indigo-400 hover:underline\\\">\\n              {en.nav.signIn}\\n            </Link>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"RegisterPage with privacy notice, email normalization, and redirect to 3-step onboarding wizard\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/RegisterPage.tsx\", \"toolAction\":\"Updating RegisterPage\", \"toolSummary\":\"Update src/pages/RegisterPage.tsx with privacy note and onboarding flow\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_10789153289607251803"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useState, FormEvent } from \'react\';\\nimport { useNavigate } from \'react-router-dom\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { saveProfile } from \'../services/db\';\\nimport { UserStage } from \'../types\';\\nimport { en } from \'../i18n/en\';\\nimport { Compass, ArrowRight, ArrowLeft, CheckCircle2, AlertCircle, Plus, X } from \'lucide-react\';\\n\\nexport function OnboardingPage() {\\n  const navigate = useNavigate();\\n  const { completeOnboarding } = useAuth();\\n\\n  const [step, setStep] = useState<1 | 2 | 3>(1);\\n  const [currentStatus, setCurrentStatus] = useState<UserStage>(\'undergraduate\');\\n  const [country, setCountry] = useState(\'India\');\\n  const [currency, setCurrency] = useState(\'INR\');\\n\\n  const [educationLevel, setEducationLevel] = useState<string>(en.educationLevels[3]);\\n  const [fieldOfStudy, setFieldOfStudy] = useState(\'Full-Stack Web Development & Software\');\\n  const [experienceYears, setExperienceYears] = useState(0);\\n\\n  const [interests, setInterests] = useState<string[]>([\'Full-Stack Development\']);\\n  const [customInterest, setCustomInterest] = useState(\'\');\\n  const [careerGoal, setCareerGoal] = useState(\'\');\\n  const [bio, setBio] = useState(\'\');\\n\\n  const [error, setError] = useState<string | null>(null);\\n  const [saving, setSaving] = useState(false);\\n\\n  const handleCountryChange = (selectedCountry: string) => {\\n    setCountry(selectedCountry);\\n    const match = en.countries.find((c) => c.country === selectedCountry);\\n    if (match) setCurrency(match.currency);\\n  };\\n\\n  const addInterest = (item: string) => {\\n    const clean = item.trim();\\n    if (!clean || interests.includes(clean)) return;\\n    setInterests([...interests, clean]);\\n    setCustomInterest(\'\');\\n  };\\n\\n  const handleSkip = async () => {\\n    setSaving(true);\\n    try {\\n      await completeOnboarding();\\n      navigate(\'/dashboard\', { replace: true });\\n    } finally {\\n      setSaving(false);\\n    }\\n  };\\n\\n  const handleFinish = async (e: FormEvent) => {\\n    e.preventDefault();\\n    setError(null);\\n\\n    if (interests.length === 0) {\\n      setError(\'Please select or type at least one interest.\');\\n      return;\\n    }\\n    if (!careerGoal.trim()) {\\n      setError(\'Please enter a career goal or target role.\');\\n      return;\\n    }\\n\\n    setSaving(true);\\n    try {\\n      await saveProfile({\\n        currentStatus,\\n        educationLevel: educationLevel.trim(),\\n        fieldOfStudy: fieldOfStudy.trim(),\\n        experienceYears: Number(experienceYears) || 0,\\n        interests,\\n        careerGoal: careerGoal.trim(),\\n        country,\\n        currency,\\n        bio: bio.trim(),\\n      });\\n      await completeOnboarding();\\n      navigate(\'/dashboard\', { replace: true });\\n    } catch (err: unknown) {\\n      setError(err instanceof Error ? err.message : \'Could not save onboarding profile.\');\\n    } finally {\\n      setSaving(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-stone-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 flex flex-col justify-center py-10 px-4 sm:px-6\\\">\\n      <div className=\\\"max-w-xl w-full mx-auto space-y-6\\\">\\n        <div className=\\\"flex items-center justify-between\\\">\\n          <div className=\\\"flex items-center gap-2.5\\\">\\n            <div className=\\\"w-9 h-9 rounded-lg bg-slate-900 dark:bg-indigo-600 text-white flex items-center justify-center\\\">\\n              <Compass className=\\\"w-5 h-5\\\" />\\n            </div>\\n            <div>\\n              <h1 className=\\\"text-lg font-bold\\\">{en.onboarding.title}</h1>\\n              <p className=\\\"text-xs text-stone-600 dark:text-slate-400\\\">{en.onboarding.subtitle}</p>\\n            </div>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleSkip}\\n            disabled={saving}\\n            className=\\\"px-3 py-1.5 text-xs font-medium text-stone-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-stone-200/70 dark:bg-slate-800 rounded-lg whitespace-nowrap shrink-0\\\"\\n          >\\n            {en.onboarding.skipButton}\\n          </button>\\n        </div>\\n\\n        {/* Step Indicator Bar */}\\n        <div className=\\\"grid grid-cols-3 gap-2\\\">\\n          {[1, 2, 3].map((s) => (\\n            <div\\n              key={s}\\n              className={`h-2 rounded-full transition-colors ${\\n                step >= s ? \'bg-indigo-600\' : \'bg-stone-200 dark:bg-slate-800\'\\n              }`}\\n            />\\n          ))}\\n        </div>\\n\\n        {error && (\\n          <div className=\\\"p-3 bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800 rounded-lg flex items-center gap-2 text-xs text-red-800 dark:text-red-200\\\">\\n            <AlertCircle className=\\\"w-4 h-4 shrink-0\\\" />\\n            <span>{error}</span>\\n          </div>\\n        )}\\n\\n        <form\\n          onSubmit={handleFinish}\\n          className=\\\"bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl p-6 shadow-xs space-y-5\\\"\\n        >\\n          {step === 1 && (\\n            <div className=\\\"space-y-4\\\">\\n              <h2 className=\\\"text-sm font-bold\\\">{en.onboarding.step1Title}</h2>\\n\\n              <div>\\n                <label className=\\\"block text-xs font-medium mb-2\\\">\\n                  Select your current stage *\\n                </label>\\n                <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2\\\">\\n                  {en.stages.map((st) => (\\n                    <button\\n                      key={st}\\n                      type=\\\"button\\\"\\n                      onClick={() => setCurrentStatus(st)}\\n                      className={`p-2.5 text-xs rounded-lg border text-left capitalize transition-colors ${\\n                        currentStatus === st\\n                          ? \'bg-indigo-50 dark:bg-indigo-950 border-indigo-600 text-indigo-950 dark:text-indigo-200 font-semibold\'\\n                          : \'border-stone-200 dark:border-slate-800 hover:bg-stone-50 dark:hover:bg-slate-800\'\\n                      }`}\\n                    >\\n                      {st}\\n                    </button>\\n                  ))}\\n                </div>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2\\\">\\n                <div>\\n                  <label htmlFor=\\\"onb-country\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                    Country\\n                  </label>\\n                  <select\\n                    id=\\\"onb-country\\\"\\n                    value={country}\\n                    onChange={(e) => handleCountryChange(e.target.value)}\\n                    className=\\\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n                  >\\n                    {en.countries.map((c) => (\\n                      <option key={c.country} value={c.country}>\\n                        {c.country} ({c.currency})\\n                      </option>\\n                    ))}\\n                  </select>\\n                </div>\\n\\n                <div>\\n                  <label htmlFor=\\\"onb-currency\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                    Preferred Currency\\n                  </label>\\n                  <input\\n                    id=\\\"onb-currency\\\"\\n                    type=\\\"text\\\"\\n                    maxLength={10}\\n                    value={currency}\\n                    onChange={(e) => setCurrency(e.target.value.toUpperCase())}\\n                    className=\\\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              <div className=\\\"flex justify-end pt-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setStep(2)}\\n                  className=\\\"inline-flex items-center gap-1.5 px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 dark:bg-indigo-600 rounded-lg\\\"\\n                >\\n                  <span>Next Step</span>\\n                  <ArrowRight className=\\\"w-3.5 h-3.5\\\" />\\n                </button>\\n              </div>\\n            </div>\\n          )}\\n\\n          {step === 2 && (\\n            <div className=\\\"space-y-4\\\">\\n              <h2 className=\\\"text-sm font-bold\\\">{en.onboarding.step2Title}</h2>\\n\\n              <div>\\n                <label htmlFor=\\\"onb-edu\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                  Education Level *\\n                </label>\\n                <select\\n                  id=\\\"onb-edu\\\"\\n                  value={educationLevel}\\n                  onChange={(e) => setEducationLevel(e.target.value)}\\n                  className=\\\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n                >\\n                  {en.educationLevels.map((lvl) => (\\n                    <option key={lvl} value={lvl}>\\n                      {lvl}\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n\\n              <div>\\n                <label htmlFor=\\\"onb-field\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                  Field of Study or Work *\\n                </label>\\n                <input\\n                  id=\\\"onb-field\\\"\\n                  type=\\\"text\\\"\\n                  required\\n                  value={fieldOfStudy}\\n                  onChange={(e) => setFieldOfStudy(e.target.value)}\\n                  placeholder=\\\"e.g. Commerce, Nursing, Law, Graphic Design, Full-Stack Web\\\"\\n                  className=\\\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n                />\\n                <div className=\\\"flex flex-wrap gap-1.5 mt-2\\\">\\n                  {en.fieldsSuggestions.slice(0, 6).map((f) => (\\n                    <button\\n                      key={f}\\n                      type=\\\"button\\\"\\n                      onClick={() => setFieldOfStudy(f)}\\n                      className=\\\"px-2 py-0.5 text-[11px] bg-stone-100 dark:bg-slate-800 rounded hover:bg-stone-200\\\"\\n                    >\\n                      {f}\\n                    </button>\\n                  ))}\\n                </div>\\n              </div>\\n\\n              <div>\\n                <label htmlFor=\\\"onb-exp\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                  Years of Work Experience (0 if student or fresher)\\n                </label>\\n                <input\\n                  id=\\\"onb-exp\\\"\\n                  type=\\\"number\\\"\\n                  min={0}\\n                  max={60}\\n                  value={experienceYears}\\n                  onChange={(e) => setExperienceYears(Number(e.target.value))}\\n                  className=\\\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg tabular-nums\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-between pt-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setStep(1)}\\n                  className=\\\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-medium bg-stone-100 dark:bg-slate-800 rounded-lg\\\"\\n                >\\n                  <ArrowLeft className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>Back</span>\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    if (!fieldOfStudy.trim()) {\\n                      setError(\'Please enter your field of study or work.\');\\n                      return;\\n                    }\\n                    setError(null);\\n                    setStep(3);\\n                  }}\\n                  className=\\\"inline-flex items-center gap-1.5 px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 dark:bg-indigo-600 rounded-lg\\\"\\n                >\\n                  <span>Next Step</span>\\n                  <ArrowRight className=\\\"w-3.5 h-3.5\\\" />\\n                </button>\\n              </div>\\n            </div>\\n          )}\\n\\n          {step === 3 && (\\n            <div className=\\\"space-y-4\\\">\\n              <h2 className=\\\"text-sm font-bold\\\">{en.onboarding.step3Title}</h2>\\n\\n              <div>\\n                <label className=\\\"block text-xs font-medium mb-1\\\">\\n                  Your Interests ({interests.length}) *\\n                </label>\\n                <div className=\\\"flex flex-wrap gap-1.5 mb-2\\\">\\n                  {interests.map((item) => (\\n                    <span\\n                      key={item}\\n                      className=\\\"inline-flex items-center gap-1 px-2.5 py-1 text-xs bg-indigo-50 dark:bg-indigo-950 text-indigo-950 dark:text-indigo-200 rounded-md\\\"\\n                    >\\n                      <span>{item}</span>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => setInterests(interests.filter((i) => i !== item))}\\n                        aria-label={`Remove ${item}`}\\n                      >\\n                        <X className=\\\"w-3 h-3\\\" />\\n                      </button>\\n                    </span>\\n                  ))}\\n                </div>\\n                <div className=\\\"flex gap-2\\\">\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={customInterest}\\n                    onChange={(e) => setCustomInterest(e.target.value)}\\n                    placeholder=\\\"Type an interest and click Add\\\"\\n                    className=\\\"flex-1 px-3 py-1.5 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n                  />\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => addInterest(customInterest)}\\n                    className=\\\"inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium bg-stone-100 dark:bg-slate-800 rounded-lg\\\"\\n                  >\\n                    <Plus className=\\\"w-3.5 h-3.5\\\" />\\n                    <span>Add</span>\\n                  </button>\\n                </div>\\n                <div className=\\\"flex flex-wrap gap-1.5 mt-2\\\">\\n                  {en.interestsSuggestions\\n                    .filter((s) => !interests.includes(s))\\n                    .map((s) => (\\n                      <button\\n                        key={s}\\n                        type=\\\"button\\\"\\n                        onClick={() => addInterest(s)}\\n                        className=\\\"px-2 py-0.5 text-[11px] bg-stone-100 dark:bg-slate-800 rounded\\\"\\n                      >\\n                        + {s}\\n                      </button>\\n                    ))}\\n                </div>\\n              </div>\\n\\n              <div>\\n                <label htmlFor=\\\"onb-goal\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                  Career Goal or Target Role *\\n                </label>\\n                <input\\n                  id=\\\"onb-goal\\\"\\n                  type=\\\"text\\\"\\n                  required\\n                  value={careerGoal}\\n                  onChange={(e) => setCareerGoal(e.target.value)}\\n                  placeholder=\\\"e.g. Full-Stack Developer, Clinical Nurse, Financial Analyst, Graphic Designer\\\"\\n                  className=\\\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-between pt-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setStep(2)}\\n                  className=\\\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-medium bg-stone-100 dark:bg-slate-800 rounded-lg\\\"\\n                >\\n                  <ArrowLeft className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>Back</span>\\n                </button>\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={saving}\\n                  className=\\\"inline-flex items-center gap-1.5 px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 dark:bg-indigo-600 rounded-lg disabled:opacity-50\\\"\\n                >\\n                  <CheckCircle2 className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>{saving ? \'Saving...\' : \'Complete Setup\'}</span>\\n                </button>\\n              </div>\\n            </div>\\n          )}\\n        </form>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"3-step field-neutral Onboarding Wizard with skip option and session persistence\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/OnboardingPage.tsx\", \"toolAction\":\"Creating OnboardingPage\", \"toolSummary\":\"Create src/pages/OnboardingPage.tsx (3-step wizard)\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_10789153289607251276"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useState, useEffect, FormEvent } from \'react\';\\nimport { useNavigate } from \'react-router-dom\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { UserStage } from \'../types\';\\nimport {\\n  getProfile,\\n  saveProfile,\\n  exportMyDataAsJson,\\n  deleteMyAccountAndAllData,\\n} from \'../services/db\';\\nimport { updateCurrentUserName } from \'../services/auth\';\\nimport { en } from \'../i18n/en\';\\nimport { AppShell } from \'../components/layout/AppShell\';\\nimport {\\n  Save,\\n  CheckCircle2,\\n  AlertCircle,\\n  Plus,\\n  X,\\n  Download,\\n  Trash2,\\n  Shield,\\n} from \'lucide-react\';\\n\\nexport function ProfilePage() {\\n  const { user, refreshUser, logout } = useAuth();\\n  const navigate = useNavigate();\\n\\n  const [name, setName] = useState(user?.name || \'\');\\n  const [currentStatus, setCurrentStatus] = useState<UserStage>(\'undergraduate\');\\n  const [educationLevel, setEducationLevel] = useState<string>(en.educationLevels[3]);\\n  const [fieldOfStudy, setFieldOfStudy] = useState(\'\');\\n  const [experienceYears, setExperienceYears] = useState(0);\\n  const [interests, setInterests] = useState<string[]>([]);\\n  const [customInterest, setCustomInterest] = useState(\'\');\\n  const [careerGoal, setCareerGoal] = useState(\'\');\\n  const [country, setCountry] = useState(\'India\');\\n  const [currency, setCurrency] = useState(\'INR\');\\n  const [bio, setBio] = useState(\'\');\\n\\n  const [loading, setLoading] = useState(true);\\n  const [saving, setSaving] = useState(false);\\n  const [showDeleteModal, setShowDeleteModal] = useState(false);\\n  const [statusMessage, setStatusMessage] = useState<{\\n    type: \'success\' | \'error\';\\n    text: string;\\n  } | null>(null);\\n\\n  useEffect(() => {\\n    async function load() {\\n      setLoading(true);\\n      try {\\n        if (user?.name) setName(user.name);\\n        const data = await getProfile();\\n        if (data) {\\n          setCurrentStatus(data.currentStatus);\\n          setEducationLevel(data.educationLevel);\\n          setFieldOfStudy(data.fieldOfStudy);\\n          setExperienceYears(data.experienceYears);\\n          setInterests(data.interests || []);\\n          setCareerGoal(data.careerGoal);\\n          setCountry(data.country || \'India\');\\n          setCurrency(data.currency || \'INR\');\\n          setBio(data.bio || \'\');\\n        }\\n      } catch (err) {\\n        console.error(\'Error loading profile:\', err);\\n      } finally {\\n        setLoading(false);\\n      }\\n    }\\n    load();\\n  }, [user?.id, user?.name]);\\n\\n  const handleAddInterest = (val: string) => {\\n    const clean = val.trim();\\n    if (!clean || interests.includes(clean)) return;\\n    setInterests([...interests, clean]);\\n    setCustomInterest(\'\');\\n  };\\n\\n  const handleSubmit = async (e: FormEvent) => {\\n    e.preventDefault();\\n    setStatusMessage(null);\\n    setSaving(true);\\n    try {\\n      if (name.trim() && name.trim() !== user?.name) {\\n        await updateCurrentUserName(name.trim());\\n        await refreshUser();\\n      }\\n      await saveProfile({\\n        currentStatus,\\n        educationLevel: educationLevel.trim(),\\n        fieldOfStudy: fieldOfStudy.trim(),\\n        experienceYears: Number(experienceYears) || 0,\\n        interests,\\n        careerGoal: careerGoal.trim(),\\n        country: country.trim(),\\n        currency: currency.trim(),\\n        bio: bio.trim(),\\n      });\\n      setStatusMessage({ type: \'success\', text: \'Your profile has been saved.\' });\\n    } catch (err: unknown) {\\n      setStatusMessage({\\n        type: \'error\',\\n        text: err instanceof Error ? err.message : \'Could not save profile.\',\\n      });\\n    } finally {\\n      setSaving(false);\\n    }\\n  };\\n\\n  const handleExportData = async () => {\\n    try {\\n      const jsonStr = await exportMyDataAsJson();\\n      const blob = new Blob([jsonStr], { type: \'application/json\' });\\n      const url = URL.createObjectURL(blob);\\n      const a = document.createElement(\'a\');\\n      a.href = url;\\n      a.download = `career_compass_data_${new Date().toISOString().slice(0, 10)}.json`;\\n      document.body.appendChild(a);\\n      a.click();\\n      document.body.removeChild(a);\\n      URL.revokeObjectURL(url);\\n      setStatusMessage({ type: \'success\', text: \'Exported all your data as JSON.\' });\\n    } catch (err: unknown) {\\n      setStatusMessage({\\n        type: \'error\',\\n        text: err instanceof Error ? err.message : \'Could not export data.\',\\n      });\\n    }\\n  };\\n\\n  const handleConfirmDeleteAccount = async () => {\\n    try {\\n      await deleteMyAccountAndAllData();\\n      await logout();\\n      navigate(\'/\', { replace: true });\\n    } catch (err: unknown) {\\n      setShowDeleteModal(false);\\n      setStatusMessage({\\n        type: \'error\',\\n        text: err instanceof Error ? err.message : \'Could not delete account.\',\\n      });\\n    }\\n  };\\n\\n  if (loading) {\\n    return (\\n      <AppShell>\\n        <div className=\\\"p-8 text-center text-xs text-stone-500\\\">Loading profile...</div>\\n      </AppShell>\\n    );\\n  }\\n\\n  return (\\n    <AppShell>\\n      <div className=\\\"space-y-6\\\">\\n        <div className=\\\"pb-4 border-b border-stone-200 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n          <div>\\n            <h1 className=\\\"text-xl sm:text-2xl font-bold\\\">{en.nav.profile}</h1>\\n            <p className=\\\"text-xs sm:text-sm text-stone-600 dark:text-slate-400 mt-1\\\">\\n              Manage your career background, interests, and personal data privacy controls.\\n            </p>\\n          </div>\\n          <button\\n            form=\\\"profile-form\\\"\\n            type=\\\"submit\\\"\\n            disabled={saving}\\n            className=\\\"inline-flex items-center gap-1.5 px-4 py-2.5 text-xs font-semibold text-white bg-slate-900 dark:bg-indigo-600 hover:bg-slate-800 rounded-lg self-start sm:self-auto\\\"\\n          >\\n            <Save className=\\\"w-3.5 h-3.5\\\" />\\n            <span>{saving ? \'Saving...\' : \'Save Profile\'}</span>\\n          </button>\\n        </div>\\n\\n        {statusMessage && (\\n          <div\\n            className={`p-3 rounded-lg border flex items-center gap-2 text-xs ${\\n              statusMessage.type === \'success\'\\n                ? \'bg-emerald-50 dark:bg-emerald-950/60 border-emerald-200 dark:border-emerald-800 text-emerald-900 dark:text-emerald-200\'\\n                : \'bg-red-50 dark:bg-red-950/60 border-red-200 dark:border-red-800 text-red-900 dark:text-red-200\'\\n            }`}\\n          >\\n            {statusMessage.type === \'success\' ? (\\n              <CheckCircle2 className=\\\"w-4 h-4 text-emerald-600 shrink-0\\\" />\\n            ) : (\\n              <AlertCircle className=\\\"w-4 h-4 text-red-600 shrink-0\\\" />\\n            )}\\n            <span>{statusMessage.text}</span>\\n          </div>\\n        )}\\n\\n        <form\\n          id=\\\"profile-form\\\"\\n          onSubmit={handleSubmit}\\n          className=\\\"p-6 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl shadow-2xs space-y-5\\\"\\n        >\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\\\">\\n            <div>\\n              <label htmlFor=\\\"prof-name\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                Full Name *\\n              </label>\\n              <input\\n                id=\\\"prof-name\\\"\\n                type=\\\"text\\\"\\n                required\\n                maxLength={80}\\n                value={name}\\n                onChange={(e) => setName(e.target.value)}\\n                className=\\\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label htmlFor=\\\"prof-stage\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                Current Stage *\\n              </label>\\n              <select\\n                id=\\\"prof-stage\\\"\\n                value={currentStatus}\\n                onChange={(e) => setCurrentStatus(e.target.value as UserStage)}\\n                className=\\\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n              >\\n                {en.stages.map((st) => (\\n                  <option key={st} value={st}>\\n                    {st}\\n                  </option>\\n                ))}\\n              </select>\\n            </div>\\n\\n            <div>\\n              <label htmlFor=\\\"prof-exp\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                Experience (Years) *\\n              </label>\\n              <input\\n                id=\\\"prof-exp\\\"\\n                type=\\\"number\\\"\\n                min={0}\\n                max={60}\\n                value={experienceYears}\\n                onChange={(e) => setExperienceYears(Number(e.target.value))}\\n                className=\\\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg tabular-nums\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label htmlFor=\\\"prof-edu\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                Education Level *\\n              </label>\\n              <input\\n                id=\\\"prof-edu\\\"\\n                type=\\\"text\\\"\\n                required\\n                maxLength={150}\\n                value={educationLevel}\\n                onChange={(e) => setEducationLevel(e.target.value)}\\n                className=\\\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label htmlFor=\\\"prof-field\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                Field of Study or Work *\\n              </label>\\n              <input\\n                id=\\\"prof-field\\\"\\n                type=\\\"text\\\"\\n                required\\n                maxLength={150}\\n                value={fieldOfStudy}\\n                onChange={(e) => setFieldOfStudy(e.target.value)}\\n                placeholder=\\\"e.g. Healthcare, Commerce, Arts, Law, Full-Stack Web\\\"\\n                className=\\\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-2 gap-2\\\">\\n              <div>\\n                <label htmlFor=\\\"prof-country\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                  Country *\\n                </label>\\n                <input\\n                  id=\\\"prof-country\\\"\\n                  type=\\\"text\\\"\\n                  required\\n                  value={country}\\n                  onChange={(e) => setCountry(e.target.value)}\\n                  className=\\\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n                />\\n              </div>\\n              <div>\\n                <label htmlFor=\\\"prof-currency\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n                  Currency *\\n                </label>\\n                <input\\n                  id=\\\"prof-currency\\\"\\n                  type=\\\"text\\\"\\n                  required\\n                  maxLength={10}\\n                  value={currency}\\n                  onChange={(e) => setCurrency(e.target.value.toUpperCase())}\\n                  className=\\\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n                />\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Interests */}\\n          <div>\\n            <label className=\\\"block text-xs font-medium mb-1.5\\\">\\n              Interests ({interests.length}) *\\n            </label>\\n            <div className=\\\"flex flex-wrap gap-1.5 mb-2\\\">\\n              {interests.map((item) => (\\n                <span\\n                  key={item}\\n                  className=\\\"inline-flex items-center gap-1 px-2.5 py-1 text-xs bg-stone-100 dark:bg-slate-800 rounded-md\\\"\\n                >\\n                  <span>{item}</span>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => setInterests(interests.filter((i) => i !== item))}\\n                    aria-label={`Remove ${item}`}\\n                  >\\n                    <X className=\\\"w-3 h-3\\\" />\\n                  </button>\\n                </span>\\n              ))}\\n            </div>\\n            <div className=\\\"flex gap-2 max-w-md\\\">\\n              <input\\n                type=\\\"text\\\"\\n                value={customInterest}\\n                onChange={(e) => setCustomInterest(e.target.value)}\\n                placeholder=\\\"Add an interest...\\\"\\n                className=\\\"flex-1 px-3 py-1.5 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n              />\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => handleAddInterest(customInterest)}\\n                className=\\\"inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium bg-stone-100 dark:bg-slate-800 rounded-lg\\\"\\n              >\\n                <Plus className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Add</span>\\n              </button>\\n            </div>\\n          </div>\\n\\n          <div>\\n            <label htmlFor=\\\"prof-goal\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n              Career Goal *\\n            </label>\\n            <input\\n              id=\\\"prof-goal\\\"\\n              type=\\\"text\\\"\\n              required\\n              maxLength={180}\\n              value={careerGoal}\\n              onChange={(e) => setCareerGoal(e.target.value)}\\n              placeholder=\\\"e.g. Full-Stack Developer, Registered Nurse, Chartered Accountant\\\"\\n              className=\\\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n            />\\n          </div>\\n\\n          <div>\\n            <label htmlFor=\\\"prof-bio\\\" className=\\\"block text-xs font-medium mb-1\\\">\\n              Short Summary / Bio\\n            </label>\\n            <textarea\\n              id=\\\"prof-bio\\\"\\n              rows={3}\\n              maxLength={1000}\\n              value={bio}\\n              onChange={(e) => setBio(e.target.value)}\\n              className=\\\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\\\"\\n            />\\n          </div>\\n        </form>\\n\\n        {/* Privacy & Data Ownership Controls */}\\n        <div className=\\\"p-6 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl shadow-2xs space-y-4\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <Shield className=\\\"w-4 h-4 text-indigo-600 dark:text-indigo-400\\\" />\\n            <h2 className=\\\"text-sm font-bold\\\">Data Privacy & Account Controls</h2>\\n          </div>\\n          <p className=\\\"text-xs text-stone-600 dark:text-slate-300\\\">{en.privacy.signupNote}</p>\\n\\n          <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4 pt-2\\\">\\n            <div className=\\\"p-4 bg-stone-50 dark:bg-slate-950 border border-stone-200 dark:border-slate-800 rounded-lg flex flex-col justify-between gap-3\\\">\\n              <div>\\n                <h3 className=\\\"text-xs font-bold\\\">{en.privacy.exportTitle}</h3>\\n                <p className=\\\"text-xs text-stone-600 dark:text-slate-400 mt-1\\\">\\n                  {en.privacy.exportDesc}\\n                </p>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleExportData}\\n                className=\\\"inline-flex items-center justify-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-slate-900 dark:text-white bg-white dark:bg-slate-800 border border-stone-300 dark:border-slate-700 hover:bg-stone-100 rounded-lg self-start\\\"\\n              >\\n                <Download className=\\\"w-3.5 h-3.5\\\" />\\n                <span>{en.privacy.exportTitle}</span>\\n              </button>\\n            </div>\\n\\n            <div className=\\\"p-4 bg-red-50/50 dark:bg-red-950/30 border border-red-200 dark:border-red-900 rounded-lg flex flex-col justify-between gap-3\\\">\\n              <div>\\n                <h3 className=\\\"text-xs font-bold text-red-900 dark:text-red-200\\\">\\n                  {en.privacy.deleteTitle}\\n                </h3>\\n                <p className=\\\"text-xs text-red-800/80 dark:text-red-300 mt-1\\\">\\n                  {en.privacy.deleteDesc}\\n                </p>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setShowDeleteModal(true)}\\n                className=\\\"inline-flex items-center justify-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-white bg-red-600 hover:bg-red-700 rounded-lg self-start\\\"\\n              >\\n                <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                <span>{en.privacy.deleteTitle}</span>\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Delete Account Confirmation Modal */}\\n        {showDeleteModal && (\\n          <div\\n            className=\\\"fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4\\\"\\n            role=\\\"dialog\\\"\\n            aria-modal=\\\"true\\\"\\n            aria-labelledby=\\\"del-acc-title\\\"\\n          >\\n            <div className=\\\"bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl max-w-sm w-full p-5 shadow-lg space-y-4\\\">\\n              <h3 id=\\\"del-acc-title\\\" className=\\\"text-sm font-bold\\\">\\n                {en.privacy.deleteTitle}\\n              </h3>\\n              <p className=\\\"text-xs text-stone-600 dark:text-slate-300 leading-relaxed\\\">\\n                {en.privacy.deleteConfirmPrompt}\\n              </p>\\n              <div className=\\\"flex items-center justify-end gap-2 pt-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setShowDeleteModal(false)}\\n                  className=\\\"px-3 py-1.5 text-xs font-medium bg-stone-100 dark:bg-slate-800 rounded-lg\\\"\\n                >\\n                  Cancel\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={handleConfirmDeleteAccount}\\n                  className=\\\"px-3.5 py-1.5 text-xs font-semibold text-white bg-red-600 hover:bg-red-700 rounded-lg\\\"\\n                >\\n                  Yes, Delete Everything\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n      </div>\\n    </AppShell>\\n  );\\n}\\n\", \"Description\":\"Profile and Privacy page with Zod validation, JSON data export, and full account/data deletion\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/ProfilePage.tsx\", \"toolAction\":\"Updating ProfilePage with privacy controls\", \"toolSummary\":\"Update src/pages/ProfilePage.tsx with JSON export and account deletion\"}"
      original_name: "write_to_file"
    }
