    action_spec {
      create_file {
        instruction: "import { Link } from \'react-router-dom\';\nimport { AppShell } from \'../components/layout/AppShell\';\nimport { Sparkles, ArrowRight, ArrowLeft } from \'lucide-react\';\n\ninterface PhasePlaceholderProps {\n  phaseTitle: string;\n  phaseNumber: number;\n  description: string;\n  features: string[];\n}\n\nexport function PhasePlaceholderPage({\n  phaseTitle,\n  phaseNumber,\n  description,\n  features\n}: PhasePlaceholderProps) {\n  return (\n    <AppShell>\n      <div className=\"max-w-2xl mx-auto py-8\">\n        <div className=\"p-8 bg-white border border-stone-200 rounded-xl shadow-2xs text-center space-y-4\">\n          <div className=\"w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center mx-auto\">\n            <Sparkles className=\"w-6 h-6\" />\n          </div>\n\n          <div>\n            <span className=\"text-xs font-semibold text-indigo-700 tracking-wider uppercase\">\n              Phase {phaseNumber} Module\n            </span>\n            <h1 className=\"text-xl sm:text-2xl font-bold text-slate-900 mt-1\">\n              {phaseTitle}\n            </h1>\n          </div>\n\n          <p className=\"text-xs sm:text-sm text-stone-600 leading-relaxed max-w-lg mx-auto\">\n            {description}\n          </p>\n\n          <div className=\"pt-2 text-left bg-stone-50 border border-stone-200/80 rounded-lg p-4\">\n            <span className=\"text-xs font-bold text-slate-900 block mb-2\">\n              Planned Deliverables in Phase {phaseNumber}:\n            </span>\n            <ul className=\"space-y-1.5 text-xs text-stone-600\">\n              {features.map((feat, i) => (\n                <li key={i} className=\"flex items-center gap-2\">\n                  <div className=\"w-1.5 h-1.5 rounded-full bg-indigo-500\" />\n                  <span>{feat}</span>\n                </li>\n              ))}\n            </ul>\n          </div>\n\n          <div className=\"pt-4 flex flex-col sm:flex-row items-center justify-center gap-3\">\n            <Link\n              to=\"/profile\"\n              className=\"w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors\"\n            >\n              <span>Review Career Profile (Phase 1)</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </Link>\n            <Link\n              to=\"/dashboard\"\n              className=\"w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-2.5 text-xs font-medium text-stone-700 bg-stone-100 hover:bg-stone-200 rounded-lg transition-colors\"\n            >\n              <ArrowLeft className=\"w-3.5 h-3.5\" />\n              <span>Back to Dashboard</span>\n            </Link>\n          </div>\n        </div>\n      </div>\n    </AppShell>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/pages/PhasePlaceholderPage.tsx"
        }
        overwrite: true
      }
    }
