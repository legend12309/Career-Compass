  code_action {
    action_spec {
      create_file {
        instruction: "// AI Service Layer - Contract for Gemini API\n// Provider abstraction to be expanded in Phase 2 with server-side proxy\n\nimport {\n  CareerRecommendationInput,\n  CareerRecommendationsOutput,\n  ResumeReviewOutput,\n  MockInterviewQuestionsOutput,\n  AnswerEvaluationOutput,\n  LearningRoadmapOutput\n} from \'../types/ai\';\n\n/**\n * Generates career recommendations from profile and skills (Phase 2 - Schema A)\n */\nexport async function getCareerRecommendations(\n  _input: CareerRecommendationInput\n): Promise<CareerRecommendationsOutput> {\n  // TODO: Implement with Gemini SDK in Phase 2\n  throw new Error(\'AI Career Recommendations will be enabled in Phase 2.\');\n}\n\n/**\n * Reviews and scores resume content (Phase 3 - Schema B)\n */\nexport async function reviewResume(_resumeData: unknown): Promise<ResumeReviewOutput> {\n  // TODO: Implement with Gemini SDK in Phase 3\n  throw new Error(\'AI Resume Review will be enabled in Phase 3.\');\n}\n\n/**\n * Generates 8 mock interview questions (Phase 5 - Schema C)\n */\nexport async function generateInterviewQuestions(\n  _params: { role: string; difficulty: string; type: \'technical\' | \'hr\' | \'mixed\' }\n): Promise<MockInterviewQuestionsOutput> {\n  // TODO: Implement with Gemini SDK in Phase 5\n  throw new Error(\'Mock Interview Questions generator will be enabled in Phase 5.\');\n}\n\n/**\n * Evaluates a candidate\'s answer during a mock interview (Phase 5 - Schema C)\n */\nexport async function evaluateAnswer(\n  _question: string,\n  _userAnswer: string\n): Promise<AnswerEvaluationOutput> {\n  // TODO: Implement with Gemini SDK in Phase 5\n  throw new Error(\'AI Answer Evaluator will be enabled in Phase 5.\');\n}\n\n/**\n * Generates personalized learning roadmap (Phase 5 - Schema D)\n */\nexport async function generateRoadmap(\n  _params: { targetRole: string; currentSkills: string[]; weeksAvailable: number }\n): Promise<LearningRoadmapOutput> {\n  // TODO: Implement with Gemini SDK in Phase 5\n  throw new Error(\'AI Learning Roadmap generator will be enabled in Phase 5.\');\n}\n"
        path {
          absolute_uri: "file:///src/services/ai.ts"
        }
        overwrite: true
      }
    }
