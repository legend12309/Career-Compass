    tool_calls {
      id: "call_3587438280710801502"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useState, useEffect } from \'react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { Resume } from \'../types\';\\nimport { ResumeReviewOutput, ResumeReviewSuggestion } from \'../types/ai\';\\nimport {\\n  getResume,\\n  saveResume,\\n  getLastResumeReview,\\n  saveResumeReview,\\n  listSkills,\\n  listCertificates,\\n} from \'../services/db\';\\nimport { reviewResume } from \'../services/ai\';\\nimport { downloadResumePdf } from \'../utils/pdfExport\';\\nimport { AppShell } from \'../components/layout/AppShell\';\\nimport { ResumeLivePreview } from \'../components/resume/ResumeLivePreview\';\\nimport {\\n  Download,\\n  Sparkles,\\n  Save,\\n  Plus,\\n  Trash2,\\n  ArrowUp,\\n  ArrowDown,\\n  AlertCircle,\\n  CheckCircle2,\\n  RotateCcw,\\n} from \'lucide-react\';\\n\\nfunction createEmptyResume(userId: string, name = \'\', email = \'\'): Resume {\\n  return {\\n    userId,\\n    personal: {\\n      name,\\n      email,\\n      phone: \'\',\\n      linkedin: \'\',\\n      github: \'\',\\n      location: \'\',\\n    },\\n    summary: \'\',\\n    education: [\\n      {\\n        degree: \'Bachelor of Computer Applications (BCA)\',\\n        institution: \'\',\\n        startYear: \'2024\',\\n        endYear: \'2027\',\\n        scoreOrCgpa: \'\',\\n      },\\n    ],\\n    experience: [],\\n    projects: [],\\n    skills: [],\\n    certifications: [],\\n  };\\n}\\n\\nexport function ResumePage() {\\n  const { user } = useAuth();\\n  const [resume, setResume] = useState<Resume | null>(null);\\n  const [review, setReview] = useState<ResumeReviewOutput | null>(null);\\n  const [appliedSuggestions, setAppliedSuggestions] = useState<Set<string>>(new Set());\\n  const [activeTab, setActiveTab] = useState<\\n    \'personal\' | \'education\' | \'experience\' | \'projects\' | \'skills\'\\n  >(\'personal\');\\n\\n  const [loading, setLoading] = useState(true);\\n  const [saving, setSaving] = useState(false);\\n  const [reviewing, setReviewing] = useState(false);\\n  const [status, setStatus] = useState<{ type: \'success\' | \'error\'; text: string } | null>(null);\\n  const [aiError, setAiError] = useState<string | null>(null);\\n\\n  useEffect(() => {\\n    async function load() {\\n      if (!user) return;\\n      setLoading(true);\\n      try {\\n        const [savedResume, savedReview, userSkills, userCerts] = await Promise.all([\\n          getResume(user.id),\\n          getLastResumeReview(user.id),\\n          listSkills(user.id),\\n          listCertificates(user.id),\\n        ]);\\n\\n        if (savedResume) {\\n          setResume(savedResume);\\n        } else {\\n          const initial = createEmptyResume(user.id, user.name, user.email);\\n          if (userSkills.length > 0) {\\n            initial.skills = userSkills.map((s) => s.name);\\n          }\\n          if (userCerts.length > 0) {\\n            initial.certifications = userCerts.map((c) => `${c.title} \342\200\224 ${c.issuer}`);\\n          }\\n          setResume(initial);\\n        }\\n        if (savedReview) {\\n          setReview(savedReview);\\n        }\\n      } catch (err) {\\n        console.error(\'Failed to load resume:\', err);\\n      } finally {\\n        setLoading(false);\\n      }\\n    }\\n    load();\\n  }, [user]);\\n\\n  const handleSave = async (updatedResume = resume) => {\\n    if (!updatedResume || !user) return;\\n    setSaving(true);\\n    setStatus(null);\\n    try {\\n      const saved = await saveResume(updatedResume);\\n      setResume(saved);\\n      setStatus({ type: \'success\', text: \'Resume saved to your workspace.\' });\\n    } catch (err: unknown) {\\n      setStatus({\\n        type: \'error\',\\n        text: err instanceof Error ? err.message : \'Could not save resume.\',\\n      });\\n    } finally {\\n      setSaving(false);\\n    }\\n  };\\n\\n  const handleDownloadPdf = () => {\\n    if (!resume) return;\\n    if (!resume.personal.name.trim()) {\\n      setStatus({ type: \'error\', text: \'Please enter your Full Name before exporting PDF.\' });\\n      setActiveTab(\'personal\');\\n      return;\\n    }\\n    const fileName = downloadResumePdf(resume);\\n    setStatus({ type: \'success\', text: `Downloaded ATS PDF: ${fileName}` });\\n  };\\n\\n  const handleRunAiReview = async () => {\\n    if (!resume || !user || reviewing) return;\\n    setAiError(null);\\n    setReviewing(true);\\n    try {\\n      const res = await reviewResume(resume);\\n      setReview(res);\\n      setAppliedSuggestions(new Set());\\n      const updated = { ...resume, lastReviewScore: res.score };\\n      setResume(updated);\\n      await Promise.all([saveResume(updated), saveResumeReview(user.id, res)]);\\n    } catch (err: unknown) {\\n      setAiError(\\n        err instanceof Error ? err.message : \'AI Resume Review failed. Please click Retry.\'\\n      );\\n    } finally {\\n      setReviewing(false);\\n    }\\n  };\\n\\n  const handleApplySuggestion = async (sug: ResumeReviewSuggestion, sugKey: string) => {\\n    if (!resume || appliedSuggestions.has(sugKey)) return;\\n    const sec = sug.section.toLowerCase();\\n    const next: Resume = {\\n      ...resume,\\n      education: [...resume.education],\\n      experience: [...resume.experience],\\n      projects: [...resume.projects],\\n      skills: [...resume.skills],\\n      certifications: [...resume.certifications],\\n    };\\n\\n    if (sec.includes(\'summary\')) {\\n      next.summary = sug.improvedText;\\n    } else if (sec.includes(\'experience\') && next.experience.length > 0) {\\n      next.experience[0] = { ...next.experience[0], description: sug.improvedText };\\n    } else if (sec.includes(\'project\') && next.projects.length > 0) {\\n      next.projects[0] = { ...next.projects[0], description: sug.improvedText };\\n    } else if (sec.includes(\'skill\')) {\\n      const extraSkills = sug.improvedText\\n        .split(/[,\302\267|]/)\\n        .map((s) => s.trim())\\n        .filter(Boolean);\\n      const merged = new Set([...next.skills, ...extraSkills]);\\n      next.skills = Array.from(merged);\\n    } else {\\n      next.summary = sug.improvedText;\\n    }\\n\\n    const nextApplied = new Set(appliedSuggestions);\\n    nextApplied.add(sugKey);\\n    setAppliedSuggestions(nextApplied);\\n    setResume(next);\\n    await saveResume(next);\\n    setStatus({ type: \'success\', text: `Applied suggestion to ${sug.section} section.` });\\n  };\\n\\n  const handleAddMissingKeyword = async (keyword: string) => {\\n    if (!resume) return;\\n    if (resume.skills.some((s) => s.toLowerCase() === keyword.toLowerCase())) return;\\n    const next = { ...resume, skills: [...resume.skills, keyword] };\\n    setResume(next);\\n    await saveResume(next);\\n  };\\n\\n  function moveItem<T>(arr: T[], index: number, direction: -1 | 1): T[] {\\n    const target = index + direction;\\n    if (target < 0 || target >= arr.length) return arr;\\n    const copy = [...arr];\\n    const [removed] = copy.splice(index, 1);\\n    copy.splice(target, 0, removed);\\n    return copy;\\n  }\\n\\n  if (loading || !resume) {\\n    return (\\n      <AppShell>\\n        <div className=\\\"p-8 text-center text-xs text-stone-500\\\">Loading Resume Builder...</div>\\n      </AppShell>\\n    );\\n  }\\n\\n  return (\\n    <AppShell>\\n      <div className=\\\"space-y-6\\\">\\n        {/* Header Bar */}\\n        <div className=\\\"pb-4 border-b border-stone-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3\\\">\\n          <div>\\n            <h1 className=\\\"text-xl sm:text-2xl font-bold text-slate-900\\\">\\n              ATS Resume Builder & AI Reviewer\\n            </h1>\\n            <p className=\\\"text-xs sm:text-sm text-stone-600 mt-1\\\">\\n              Edit your single-column resume on the left, preview live on the right, and export to A4 PDF.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-2 shrink-0\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => handleSave()}\\n              disabled={saving}\\n              className=\\\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-medium text-stone-800 bg-white hover:bg-stone-100 border border-stone-200 rounded-lg transition-colors\\\"\\n            >\\n              <Save className=\\\"w-3.5 h-3.5\\\" />\\n              <span>{saving ? \'Saving...\' : \'Save Draft\'}</span>\\n            </button>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={handleRunAiReview}\\n              disabled={reviewing}\\n              className=\\\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-indigo-950 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 rounded-lg transition-colors disabled:opacity-50\\\"\\n            >\\n              <Sparkles className=\\\"w-3.5 h-3.5 text-indigo-600\\\" />\\n              <span>{reviewing ? \'Reviewing...\' : \'AI Review\'}</span>\\n            </button>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={handleDownloadPdf}\\n              className=\\\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors\\\"\\n            >\\n              <Download className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Download PDF</span>\\n            </button>\\n          </div>\\n        </div>\\n\\n        {status && (\\n          <div\\n            className={`p-3 rounded-lg border flex items-center gap-2 text-xs ${\\n              status.type === \'success\'\\n                ? \'bg-emerald-50 border-emerald-200 text-emerald-900\'\\n                : \'bg-red-50 border-red-200 text-red-900\'\\n            }`}\\n          >\\n            {status.type === \'success\' ? (\\n              <CheckCircle2 className=\\\"w-4 h-4 text-emerald-600 shrink-0\\\" />\\n            ) : (\\n              <AlertCircle className=\\\"w-4 h-4 text-red-600 shrink-0\\\" />\\n            )}\\n            <span>{status.text}</span>\\n          </div>\\n        )}\\n\\n        {aiError && (\\n          <div className=\\\"p-4 bg-red-50 border border-red-200 rounded-xl flex items-center justify-between gap-3 text-xs text-red-900\\\">\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <AlertCircle className=\\\"w-4 h-4 text-red-600 shrink-0\\\" />\\n              <span>{aiError}</span>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={handleRunAiReview}\\n              className=\\\"inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-white bg-red-700 hover:bg-red-800 rounded-lg shrink-0\\\"\\n            >\\n              <RotateCcw className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Retry</span>\\n            </button>\\n          </div>\\n        )}\\n\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\\\">\\n          {/* Left Column: Multi-Section Editor */}\\n          <div className=\\\"lg:col-span-6 bg-white border border-stone-200 rounded-xl shadow-2xs p-5 space-y-5\\\">\\n            {/* Section Switcher Tabs */}\\n            <div className=\\\"flex flex-wrap gap-1 p-1 bg-stone-100 rounded-lg\\\">\\n              {(\\n                [\\n                  { id: \'personal\', label: \'Personal & Summary\' },\\n                  { id: \'education\', label: `Education (${resume.education.length})` },\\n                  { id: \'experience\', label: `Experience (${resume.experience.length})` },\\n                  { id: \'projects\', label: `Projects (${resume.projects.length})` },\\n                  { id: \'skills\', label: \'Skills & Certs\' },\\n                ] as const\\n              ).map((tab) => (\\n                <button\\n                  key={tab.id}\\n                  type=\\\"button\\\"\\n                  onClick={() => setActiveTab(tab.id)}\\n                  className={`px-2.5 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 ${\\n                    activeTab === tab.id\\n                      ? \'bg-white text-slate-900 shadow-2xs font-semibold\'\\n                      : \'text-stone-600 hover:text-slate-900\'\\n                  }`}\\n                >\\n                  {tab.label}\\n                </button>\\n              ))}\\n            </div>\\n\\n            {/* Tab 1: Personal & Summary */}\\n            {activeTab === \'personal\' && (\\n              <div className=\\\"space-y-3.5\\\">\\n                <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n                  <div>\\n                    <label className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                      Full Name *\\n                    </label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      value={resume.personal.name}\\n                      onChange={(e) =>\\n                        setResume({\\n                          ...resume,\\n                          personal: { ...resume.personal, name: e.target.value },\\n                        })\\n                      }\\n                      className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg\\\"\\n                    />\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">Email *</label>\\n                    <input\\n                      type=\\\"email\\\"\\n                      value={resume.personal.email}\\n                      onChange={(e) =>\\n                        setResume({\\n                          ...resume,\\n                          personal: { ...resume.personal, email: e.target.value },\\n                        })\\n                      }\\n                      className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg\\\"\\n                    />\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">Phone</label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      value={resume.personal.phone}\\n                      onChange={(e) =>\\n                        setResume({\\n                          ...resume,\\n                          personal: { ...resume.personal, phone: e.target.value },\\n                        })\\n                      }\\n                      className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg\\\"\\n                    />\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                      City / Location\\n                    </label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      value={resume.personal.location}\\n                      onChange={(e) =>\\n                        setResume({\\n                          ...resume,\\n                          personal: { ...resume.personal, location: e.target.value },\\n                        })\\n                      }\\n                      className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg\\\"\\n                    />\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                      LinkedIn Profile\\n                    </label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      value={resume.personal.linkedin}\\n                      onChange={(e) =>\\n                        setResume({\\n                          ...resume,\\n                          personal: { ...resume.personal, linkedin: e.target.value },\\n                        })\\n                      }\\n                      className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg\\\"\\n                    />\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                      GitHub Profile\\n                    </label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      value={resume.personal.github}\\n                      onChange={(e) =>\\n                        setResume({\\n                          ...resume,\\n                          personal: { ...resume.personal, github: e.target.value },\\n                        })\\n                      }\\n                      className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg\\\"\\n                    />\\n                  </div>\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                    Professional Summary\\n                  </label>\\n                  <textarea\\n                    rows={4}\\n                    value={resume.summary}\\n                    onChange={(e) => setResume({ ...resume, summary: e.target.value })}\\n                    placeholder=\\\"Summarize your degree, core technical strengths, and placement objective...\\\"\\n                    className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg\\\"\\n                  />\\n                </div>\\n              </div>\\n            )}\\n\\n            {/* Tab 2: Education */}\\n            {activeTab === \'education\' && (\\n              <div className=\\\"space-y-4\\\">\\n                {resume.education.map((edu, i) => (\\n                  <div\\n                    key={i}\\n                    className=\\\"p-3.5 bg-stone-50 border border-stone-200 rounded-lg space-y-3\\\"\\n                  >\\n                    <div className=\\\"flex items-center justify-between\\\">\\n                      <span className=\\\"text-xs font-bold text-slate-900\\\">\\n                        Education #{i + 1}\\n                      </span>\\n                      <div className=\\\"flex items-center gap-1\\\">\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() =>\\n                            setResume({\\n                              ...resume,\\n                              education: moveItem(resume.education, i, -1),\\n                            })\\n                          }\\n                          disabled={i === 0}\\n                          className=\\\"p-1 text-stone-500 hover:text-slate-900 disabled:opacity-30\\\"\\n                          aria-label=\\\"Move education up\\\"\\n                        >\\n                          <ArrowUp className=\\\"w-3.5 h-3.5\\\" />\\n                        </button>\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() =>\\n                            setResume({\\n                              ...resume,\\n                              education: moveItem(resume.education, i, 1),\\n                            })\\n                          }\\n                          disabled={i === resume.education.length - 1}\\n                          className=\\\"p-1 text-stone-500 hover:text-slate-900 disabled:opacity-30\\\"\\n                          aria-label=\\\"Move education down\\\"\\n                        >\\n                          <ArrowDown className=\\\"w-3.5 h-3.5\\\" />\\n                        </button>\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() =>\\n                            setResume({\\n                              ...resume,\\n                              education: resume.education.filter((_, idx) => idx !== i),\\n                            })\\n                          }\\n                          className=\\\"p-1 text-stone-500 hover:text-red-600\\\"\\n                          aria-label=\\\"Remove education entry\\\"\\n                        >\\n                          <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                        </button>\\n                      </div>\\n                    </div>\\n\\n                    <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\\\">\\n                      <input\\n                        type=\\\"text\\\"\\n                        placeholder=\\\"Degree (e.g. BCA)\\\"\\n                        value={edu.degree}\\n                        onChange={(e) => {\\n                          const next = [...resume.education];\\n                          next[i] = { ...edu, degree: e.target.value };\\n                          setResume({ ...resume, education: next });\\n                        }}\\n                        className=\\\"px-2.5 py-1.5 text-xs bg-white border border-stone-300 rounded\\\"\\n                      />\\n                      <input\\n                        type=\\\"text\\\"\\n                        placeholder=\\\"College / Institution\\\"\\n                        value={edu.institution}\\n                        onChange={(e) => {\\n                          const next = [...resume.education];\\n                          next[i] = { ...edu, institution: e.target.value };\\n                          setResume({ ...resume, education: next });\\n                        }}\\n                        className=\\\"px-2.5 py-1.5 text-xs bg-white border border-stone-300 rounded\\\"\\n                      />\\n                      <div className=\\\"grid grid-cols-2 gap-2\\\">\\n                        <input\\n                          type=\\\"text\\\"\\n                          placeholder=\\\"Start Year\\\"\\n                          value={edu.startYear}\\n                          onChange={(e) => {\\n                            const next = [...resume.education];\\n                            next[i] = { ...edu, startYear: e.target.value };\\n                            setResume({ ...resume, education: next });\\n                          }}\\n                          className=\\\"px-2.5 py-1.5 text-xs bg-white border border-stone-300 rounded\\\"\\n                        />\\n                        <input\\n                          type=\\\"text\\\"\\n                          placeholder=\\\"End Year\\\"\\n                          value={edu.endYear}\\n                          onChange={(e) => {\\n                            const next = [...resume.education];\\n                            next[i] = { ...edu, endYear: e.target.value };\\n                            setResume({ ...resume, education: next });\\n                          }}\\n                          className=\\\"px-2.5 py-1.5 text-xs bg-white border border-stone-300 rounded\\\"\\n                        />\\n                      </div>\\n                      <input\\n                        type=\\\"text\\\"\\n                        placeholder=\\\"CGPA or Percentage (e.g. 8.6 CGPA)\\\"\\n                        value={edu.scoreOrCgpa}\\n                        onChange={(e) => {\\n                          const next = [...resume.education];\\n                          next[i] = { ...edu, scoreOrCgpa: e.target.value };\\n                          setResume({ ...resume, education: next });\\n                        }}\\n                        className=\\\"px-2.5 py-1.5 text-xs bg-white border border-stone-300 rounded\\\"\\n                      />\\n                    </div>\\n                  </div>\\n                ))}\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() =>\\n                    setResume({\\n                      ...resume,\\n                      education: [\\n                        ...resume.education,\\n                        { degree: \'\', institution: \'\', startYear: \'\', endYear: \'\', scoreOrCgpa: \'\' },\\n                      ],\\n                    })\\n                  }\\n                  className=\\\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-900 bg-stone-100 hover:bg-stone-200 rounded-lg\\\"\\n                >\\n                  <Plus className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>Add Education</span>\\n                </button>\\n              </div>\\n            )}\\n\\n            {/* Tab 3: Experience */}\\n            {activeTab === \'experience\' && (\\n              <div className=\\\"space-y-4\\\">\\n                {resume.experience.map((exp, i) => (\\n                  <div\\n                    key={i}\\n                    className=\\\"p-3.5 bg-stone-50 border border-stone-200 rounded-lg space-y-2.5\\\"\\n                  >\\n                    <div className=\\\"flex items-center justify-between\\\">\\n                      <span className=\\\"text-xs font-bold text-slate-900\\\">\\n                        Experience #{i + 1}\\n                      </span>\\n                      <div className=\\\"flex items-center gap-1\\\">\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() =>\\n                            setResume({\\n                              ...resume,\\n                              experience: moveItem(resume.experience, i, -1),\\n                            })\\n                          }\\n                          disabled={i === 0}\\n                          className=\\\"p-1 text-stone-500 hover:text-slate-900 disabled:opacity-30\\\"\\n                        >\\n                          <ArrowUp className=\\\"w-3.5 h-3.5\\\" />\\n                        </button>\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() =>\\n                            setResume({\\n                              ...resume,\\n                              experience: moveItem(resume.experience, i, 1),\\n                            })\\n                          }\\n                          disabled={i === resume.experience.length - 1}\\n                          className=\\\"p-1 text-stone-500 hover:text-slate-900 disabled:opacity-30\\\"\\n                        >\\n                          <ArrowDown className=\\\"w-3.5 h-3.5\\\" />\\n                        </button>\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() =>\\n                            setResume({\\n                              ...resume,\\n                              experience: resume.experience.filter((_, idx) => idx !== i),\\n                            })\\n                          }\\n                          className=\\\"p-1 text-stone-500 hover:text-red-600\\\"\\n                        >\\n                          <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                        </button>\\n                      </div>\\n                    </div>\\n\\n                    <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2\\\">\\n                      <input\\n                        type=\\\"text\\\"\\n                        placeholder=\\\"Role (e.g. Web Dev Intern)\\\"\\n                        value={exp.role}\\n                        onChange={(e) => {\\n                          const next = [...resume.experience];\\n                          next[i] = { ...exp, role: e.target.value };\\n                          setResume({ ...resume, experience: next });\\n                        }}\\n                        className=\\\"px-2.5 py-1.5 text-xs bg-white border border-stone-300 rounded\\\"\\n                      />\\n                      <input\\n                        type=\\\"text\\\"\\n                        placeholder=\\\"Company / Organization\\\"\\n                        value={exp.company}\\n                        onChange={(e) => {\\n                          const next = [...resume.experience];\\n                          next[i] = { ...exp, company: e.target.value };\\n                          setResume({ ...resume, experience: next });\\n                        }}\\n                        className=\\\"px-2.5 py-1.5 text-xs bg-white border border-stone-300 rounded\\\"\\n                      />\\n                      <input\\n                        type=\\\"text\\\"\\n                        placeholder=\\\"Start Date (e.g. May 2026)\\\"\\n                        value={exp.startDate}\\n                        onChange={(e) => {\\n                          const next = [...resume.experience];\\n                          next[i] = { ...exp, startDate: e.target.value };\\n                          setResume({ ...resume, experience: next });\\n                        }}\\n                        className=\\\"px-2.5 py-1.5 text-xs bg-white border border-stone-300 rounded\\\"\\n                      />\\n                      <input\\n                        type=\\\"text\\\"\\n                        placeholder=\\\"End Date (e.g. Jul 2026)\\\"\\n                        value={exp.endDate}\\n                        onChange={(e) => {\\n                          const next = [...resume.experience];\\n                          next[i] = { ...exp, endDate: e.target.value };\\n                          setResume({ ...resume, experience: next });\\n                        }}\\n                        className=\\\"px-2.5 py-1.5 text-xs bg-white border border-stone-300 rounded\\\"\\n                      />\\n                    </div>\\n                    <textarea\\n                      rows={3}\\n                      placeholder=\\\"Describe impact and tech used...\\\"\\n                      value={exp.description}\\n                      onChange={(e) => {\\n                        const next = [...resume.experience];\\n                        next[i] = { ...exp, description: e.target.value };\\n                        setResume({ ...resume, experience: next });\\n                      }}\\n                      className=\\\"w-full px-2.5 py-1.5 text-xs bg-white border border-stone-300 rounded\\\"\\n                    />\\n                  </div>\\n                ))}\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() =>\\n                    setResume({\\n                      ...resume,\\n                      experience: [\\n                        ...resume.experience,\\n                        {\\n                          role: \'\',\\n                          company: \'\',\\n                          location: \'Remote\',\\n                          startDate: \'\',\\n                          endDate: \'\',\\n                          description: \'\',\\n                        },\\n                      ],\\n                    })\\n                  }\\n                  className=\\\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-900 bg-stone-100 hover:bg-stone-200 rounded-lg\\\"\\n                >\\n                  <Plus className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>Add Internship / Experience</span>\\n                </button>\\n              </div>\\n            )}\\n\\n            {/* Tab 4: Projects */}\\n            {activeTab === \'projects\' && (\\n              <div className=\\\"space-y-4\\\">\\n                {resume.projects.map((proj, i) => (\\n                  <div\\n                    key={i}\\n                    className=\\\"p-3.5 bg-stone-50 border border-stone-200 rounded-lg space-y-2.5\\\"\\n                  >\\n                    <div className=\\\"flex items-center justify-between\\\">\\n                      <span className=\\\"text-xs font-bold text-slate-900\\\">Project #{i + 1}</span>\\n                      <div className=\\\"flex items-center gap-1\\\">\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() =>\\n                            setResume({\\n                              ...resume,\\n                              projects: moveItem(resume.projects, i, -1),\\n                            })\\n                          }\\n                          disabled={i === 0}\\n                          className=\\\"p-1 text-stone-500 hover:text-slate-900 disabled:opacity-30\\\"\\n                        >\\n                          <ArrowUp className=\\\"w-3.5 h-3.5\\\" />\\n                        </button>\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() =>\\n                            setResume({\\n                              ...resume,\\n                              projects: moveItem(resume.projects, i, 1),\\n                            })\\n                          }\\n                          disabled={i === resume.projects.length - 1}\\n                          className=\\\"p-1 text-stone-500 hover:text-slate-900 disabled:opacity-30\\\"\\n                        >\\n                          <ArrowDown className=\\\"w-3.5 h-3.5\\\" />\\n                        </button>\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() =>\\n                            setResume({\\n                              ...resume,\\n                              projects: resume.projects.filter((_, idx) => idx !== i),\\n                            })\\n                          }\\n                          className=\\\"p-1 text-stone-500 hover:text-red-600\\\"\\n                        >\\n                          <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                        </button>\\n                      </div>\\n                    </div>\\n\\n                    <input\\n                      type=\\\"text\\\"\\n                      placeholder=\\\"Project Title\\\"\\n                      value={proj.title}\\n                      onChange={(e) => {\\n                        const next = [...resume.projects];\\n                        next[i] = { ...proj, title: e.target.value };\\n                        setResume({ ...resume, projects: next });\\n                      }}\\n                      className=\\\"w-full px-2.5 py-1.5 text-xs bg-white border border-stone-300 rounded\\\"\\n                    />\\n                    <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2\\\">\\n                      <input\\n                        type=\\\"text\\\"\\n                        placeholder=\\\"Tech Stack (comma-separated)\\\"\\n                        value={proj.techStack.join(\', \')}\\n                        onChange={(e) => {\\n                          const next = [...resume.projects];\\n                          next[i] = {\\n                            ...proj,\\n                            techStack: e.target.value\\n                              .split(\',\')\\n                              .map((s) => s.trim())\\n                              .filter(Boolean),\\n                          };\\n                          setResume({ ...resume, projects: next });\\n                        }}\\n                        className=\\\"px-2.5 py-1.5 text-xs bg-white border border-stone-300 rounded\\\"\\n                      />\\n                      <input\\n                        type=\\\"text\\\"\\n                        placeholder=\\\"GitHub / Live Demo Link\\\"\\n                        value={proj.link || \'\'}\\n                        onChange={(e) => {\\n                          const next = [...resume.projects];\\n                          next[i] = { ...proj, link: e.target.value };\\n                          setResume({ ...resume, projects: next });\\n                        }}\\n                        className=\\\"px-2.5 py-1.5 text-xs bg-white border border-stone-300 rounded\\\"\\n                      />\\n                    </div>\\n                    <textarea\\n                      rows={3}\\n                      placeholder=\\\"Describe architecture, features, and measurable outcome...\\\"\\n                      value={proj.description}\\n                      onChange={(e) => {\\n                        const next = [...resume.projects];\\n                        next[i] = { ...proj, description: e.target.value };\\n                        setResume({ ...resume, projects: next });\\n                      }}\\n                      className=\\\"w-full px-2.5 py-1.5 text-xs bg-white border border-stone-300 rounded\\\"\\n                    />\\n                  </div>\\n                ))}\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() =>\\n                    setResume({\\n                      ...resume,\\n                      projects: [\\n                        ...resume.projects,\\n                        { title: \'\', techStack: [], link: \'\', description: \'\' },\\n                      ],\\n                    })\\n                  }\\n                  className=\\\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-900 bg-stone-100 hover:bg-stone-200 rounded-lg\\\"\\n                >\\n                  <Plus className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>Add Project</span>\\n                </button>\\n              </div>\\n            )}\\n\\n            {/* Tab 5: Skills & Certifications */}\\n            {activeTab === \'skills\' && (\\n              <div className=\\\"space-y-4\\\">\\n                <div>\\n                  <label className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                    Skills List (comma-separated)\\n                  </label>\\n                  <textarea\\n                    rows={3}\\n                    value={resume.skills.join(\', \')}\\n                    onChange={(e) =>\\n                      setResume({\\n                        ...resume,\\n                        skills: e.target.value\\n                          .split(\',\')\\n                          .map((s) => s.trim())\\n                          .filter(Boolean),\\n                      })\\n                    }\\n                    placeholder=\\\"JavaScript, TypeScript, React.js, Node.js, SQL, Git\\\"\\n                    className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg\\\"\\n                  />\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                    Certifications & Achievements (one per line)\\n                  </label>\\n                  <textarea\\n                    rows={4}\\n                    value={resume.certifications.join(\'\\\\n\')}\\n                    onChange={(e) =>\\n                      setResume({\\n                        ...resume,\\n                        certifications: e.target.value\\n                          .split(\'\\\\n\')\\n                          .map((s) => s.trim())\\n                          .filter(Boolean),\\n                      })\\n                    }\\n                    placeholder=\\\"Meta Front-End Developer Certificate (2026)&#10;NPTEL Relational Databases \342\200\224 Silver Medal\\\"\\n                    className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg\\\"\\n                  />\\n                </div>\\n              </div>\\n            )}\\n          </div>\\n\\n          {/* Right Column: Live Preview + AI Review Panel */}\\n          <div className=\\\"lg:col-span-6\\\">\\n            <ResumeLivePreview\\n              resume={resume}\\n              review={review}\\n              appliedSuggestions={appliedSuggestions}\\n              onApplySuggestion={handleApplySuggestion}\\n              onAddMissingKeyword={handleAddMissingKeyword}\\n            />\\n          </div>\\n        </div>\\n      </div>\\n    </AppShell>\\n  );\\n}\\n\", \"Description\":\"Phase 3 Resume Builder page with multi-section form, reordering, jsPDF export, and AI Review integration\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/ResumePage.tsx\", \"toolAction\":\"Creating ResumePage\", \"toolSummary\":\"Create src/pages/ResumePage.tsx (Phase 3)\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_3587438280710801805"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useState, useEffect } from \'react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { InterviewSessionState } from \'../types\';\\nimport {\\n  getProfile,\\n  getInterviewSession,\\n  saveInterviewSession,\\n  clearInterviewSession,\\n} from \'../services/db\';\\nimport { generateInterviewQuestions, evaluateAnswer } from \'../services/ai\';\\nimport { AppShell } from \'../components/layout/AppShell\';\\nimport {\\n  MessageSquareCode,\\n  Sparkles,\\n  ArrowRight,\\n  RotateCcw,\\n  AlertCircle,\\n  CheckCircle2,\\n  SkipForward,\\n} from \'lucide-react\';\\n\\nexport function InterviewPage() {\\n  const { user } = useAuth();\\n  const [role, setRole] = useState(\'Full-Stack Software Engineer\');\\n  const [difficulty, setDifficulty] = useState<\'Beginner\' | \'Intermediate\' | \'Advanced\'>(\\n    \'Intermediate\'\\n  );\\n  const [roundType, setRoundType] = useState<\'technical\' | \'hr\' | \'mixed\'>(\'mixed\');\\n\\n  const [session, setSession] = useState<InterviewSessionState | null>(null);\\n  const [currentAnswer, setCurrentAnswer] = useState(\'\');\\n  const [loadingQuestions, setLoadingQuestions] = useState(false);\\n  const [evaluating, setEvaluating] = useState(false);\\n  const [error, setError] = useState<string | null>(null);\\n\\n  useEffect(() => {\\n    async function init() {\\n      if (!user) return;\\n      const [profile, savedSession] = await Promise.all([\\n        getProfile(user.id),\\n        getInterviewSession(user.id),\\n      ]);\\n      if (profile?.careerGoal) {\\n        setRole(profile.careerGoal);\\n      }\\n      if (savedSession && savedSession.questions.length > 0) {\\n        setSession(savedSession);\\n        const activeQ = savedSession.questions[savedSession.currentIndex];\\n        if (activeQ && savedSession.answers[activeQ.id]) {\\n          setCurrentAnswer(savedSession.answers[activeQ.id].userAnswer || \'\');\\n        }\\n      }\\n    }\\n    init();\\n  }, [user]);\\n\\n  const handleStartSession = async () => {\\n    if (!user || loadingQuestions) return;\\n    if (!role.trim()) {\\n      setError(\'Please enter a target job role before starting the interview.\');\\n      return;\\n    }\\n\\n    setError(null);\\n    setLoadingQuestions(true);\\n    try {\\n      const res = await generateInterviewQuestions({\\n        role: role.trim(),\\n        difficulty,\\n        type: roundType,\\n      });\\n\\n      const newSession: InterviewSessionState = {\\n        userId: user.id,\\n        role: role.trim(),\\n        difficulty,\\n        type: roundType,\\n        questions: res.questions,\\n        currentIndex: 0,\\n        answers: {},\\n        completed: false,\\n        updatedAt: new Date().toISOString(),\\n      };\\n      setSession(newSession);\\n      setCurrentAnswer(\'\');\\n      await saveInterviewSession(newSession);\\n    } catch (err: unknown) {\\n      setError(\\n        err instanceof Error\\n          ? err.message\\n          : \'Failed to generate interview questions. Please click Retry.\'\\n      );\\n    } finally {\\n      setLoadingQuestions(false);\\n    }\\n  };\\n\\n  const handleEvaluateAnswer = async () => {\\n    if (!session || evaluating) return;\\n    const currentQ = session.questions[session.currentIndex];\\n    if (!currentQ) return;\\n\\n    const trimmed = currentAnswer.trim();\\n    if (!trimmed) {\\n      setError(\'Please write an answer before submitting, or click Skip Question.\');\\n      return;\\n    }\\n\\n    setError(null);\\n    setEvaluating(true);\\n    try {\\n      const evalResult = await evaluateAnswer(currentQ.question, trimmed);\\n      const updatedSession: InterviewSessionState = {\\n        ...session,\\n        answers: {\\n          ...session.answers,\\n          [currentQ.id]: {\\n            userAnswer: trimmed,\\n            skipped: false,\\n            evaluation: evalResult,\\n          },\\n        },\\n        updatedAt: new Date().toISOString(),\\n      };\\n      setSession(updatedSession);\\n      await saveInterviewSession(updatedSession);\\n    } catch (err: unknown) {\\n      setError(\\n        err instanceof Error ? err.message : \'Failed to evaluate your answer. Please click Retry.\'\\n      );\\n    } finally {\\n      setEvaluating(false);\\n    }\\n  };\\n\\n  const handleSkipQuestion = async () => {\\n    if (!session) return;\\n    const currentQ = session.questions[session.currentIndex];\\n    if (!currentQ) return;\\n\\n    const nextIdx = session.currentIndex + 1;\\n    const isDone = nextIdx >= session.questions.length;\\n    const updatedSession: InterviewSessionState = {\\n      ...session,\\n      currentIndex: isDone ? session.currentIndex : nextIdx,\\n      completed: isDone,\\n      answers: {\\n        ...session.answers,\\n        [currentQ.id]: {\\n          userAnswer: \'\',\\n          skipped: true,\\n          evaluation: {\\n            score: 0,\\n            feedback: \'Question skipped during session.\',\\n            improvedAnswer: currentQ.idealAnswerPoints.join(\' \'),\\n          },\\n        },\\n      },\\n      updatedAt: new Date().toISOString(),\\n    };\\n    setSession(updatedSession);\\n    setCurrentAnswer(\'\');\\n    setError(null);\\n    await saveInterviewSession(updatedSession);\\n  };\\n\\n  const handleNextQuestion = async () => {\\n    if (!session) return;\\n    const nextIdx = session.currentIndex + 1;\\n    if (nextIdx >= session.questions.length) {\\n      const doneSession: InterviewSessionState = {\\n        ...session,\\n        completed: true,\\n        updatedAt: new Date().toISOString(),\\n      };\\n      setSession(doneSession);\\n      await saveInterviewSession(doneSession);\\n    } else {\\n      const nextQ = session.questions[nextIdx];\\n      const nextSession: InterviewSessionState = {\\n        ...session,\\n        currentIndex: nextIdx,\\n        updatedAt: new Date().toISOString(),\\n      };\\n      setSession(nextSession);\\n      setCurrentAnswer(session.answers[nextQ.id]?.userAnswer || \'\');\\n      await saveInterviewSession(nextSession);\\n    }\\n  };\\n\\n  const handleResetSession = async () => {\\n    if (!user) return;\\n    await clearInterviewSession(user.id);\\n    setSession(null);\\n    setCurrentAnswer(\'\');\\n    setError(null);\\n  };\\n\\n  // Compute exact average score across all questions in session\\n  const computeAverageScore = (s: InterviewSessionState): number => {\\n    const totalCount = s.questions.length;\\n    if (totalCount === 0) return 0;\\n    const sum = s.questions.reduce((acc, q) => {\\n      const sc = s.answers[q.id]?.evaluation?.score ?? 0;\\n      return acc + sc;\\n    }, 0);\\n    return Math.round((sum / totalCount) * 10) / 10;\\n  };\\n\\n  const activeQuestion = session ? session.questions[session.currentIndex] : null;\\n  const activeAnswerRecord =\\n    session && activeQuestion ? session.answers[activeQuestion.id] : undefined;\\n\\n  return (\\n    <AppShell>\\n      <div className=\\\"space-y-6\\\">\\n        <div className=\\\"pb-4 border-b border-stone-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3\\\">\\n          <div>\\n            <h1 className=\\\"text-xl sm:text-2xl font-bold text-slate-900\\\">\\n              AI Mock Interview Simulator\\n            </h1>\\n            <p className=\\\"text-xs sm:text-sm text-stone-600 mt-1\\\">\\n              Practice an 8-question placement interview one question at a time with instant AI scoring and model answers.\\n            </p>\\n          </div>\\n          {session && (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={handleResetSession}\\n              className=\\\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-stone-700 bg-white hover:bg-stone-100 border border-stone-200 rounded-lg self-start sm:self-auto\\\"\\n            >\\n              <RotateCcw className=\\\"w-3.5 h-3.5\\\" />\\n              <span>New Session</span>\\n            </button>\\n          )}\\n        </div>\\n\\n        {error && (\\n          <div className=\\\"p-4 bg-red-50 border border-red-200 rounded-xl flex items-center justify-between gap-3 text-xs text-red-900\\\">\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <AlertCircle className=\\\"w-4 h-4 text-red-600 shrink-0\\\" />\\n              <span>{error}</span>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={session ? handleEvaluateAnswer : handleStartSession}\\n              className=\\\"inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-white bg-red-700 hover:bg-red-800 rounded-lg shrink-0\\\"\\n            >\\n              <RotateCcw className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Retry</span>\\n            </button>\\n          </div>\\n        )}\\n\\n        {/* Setup Screen when no active session */}\\n        {!session && (\\n          <div className=\\\"p-6 bg-white border border-stone-200 rounded-xl shadow-2xs max-w-2xl space-y-4\\\">\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <MessageSquareCode className=\\\"w-5 h-5 text-indigo-600\\\" />\\n              <h2 className=\\\"text-sm font-bold text-slate-900\\\">Configure 8-Question Interview</h2>\\n            </div>\\n\\n            <div className=\\\"space-y-3\\\">\\n              <div>\\n                <label htmlFor=\\\"int-role\\\" className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                  Target Role *\\n                </label>\\n                <input\\n                  id=\\\"int-role\\\"\\n                  type=\\\"text\\\"\\n                  value={role}\\n                  onChange={(e) => setRole(e.target.value)}\\n                  placeholder=\\\"e.g. Full-Stack Developer, Data Analyst, QA Engineer\\\"\\n                  className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n                <div>\\n                  <label htmlFor=\\\"int-diff\\\" className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                    Difficulty Level\\n                  </label>\\n                  <select\\n                    id=\\\"int-diff\\\"\\n                    value={difficulty}\\n                    onChange={(e) =>\\n                      setDifficulty(e.target.value as \'Beginner\' | \'Intermediate\' | \'Advanced\')\\n                    }\\n                    className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg bg-white\\\"\\n                  >\\n                    <option value=\\\"Beginner\\\">Beginner (Campus Fresher)</option>\\n                    <option value=\\\"Intermediate\\\">Intermediate (Standard Placement)</option>\\n                    <option value=\\\"Advanced\\\">Advanced (Product Company)</option>\\n                  </select>\\n                </div>\\n\\n                <div>\\n                  <label htmlFor=\\\"int-type\\\" className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                    Round Type\\n                  </label>\\n                  <select\\n                    id=\\\"int-type\\\"\\n                    value={roundType}\\n                    onChange={(e) =>\\n                      setRoundType(e.target.value as \'technical\' | \'hr\' | \'mixed\')\\n                    }\\n                    className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg bg-white\\\"\\n                  >\\n                    <option value=\\\"mixed\\\">Mixed (Technical + HR Behavioral)</option>\\n                    <option value=\\\"technical\\\">Technical Only</option>\\n                    <option value=\\\"hr\\\">HR & Behavioral Only</option>\\n                  </select>\\n                </div>\\n              </div>\\n            </div>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={handleStartSession}\\n              disabled={loadingQuestions}\\n              className=\\\"inline-flex items-center gap-2 px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors disabled:opacity-50\\\"\\n            >\\n              <Sparkles className=\\\"w-3.5 h-3.5 text-indigo-400\\\" />\\n              <span>\\n                {loadingQuestions ? \'Generating 8 Questions...\' : \'Start 8-Question Interview\'}\\n              </span>\\n            </button>\\n          </div>\\n        )}\\n\\n        {/* Active Question View */}\\n        {session && !session.completed && activeQuestion && (\\n          <div className=\\\"p-6 bg-white border border-stone-200 rounded-xl shadow-2xs space-y-5\\\">\\n            <div className=\\\"flex items-center justify-between text-xs text-stone-500 pb-3 border-b border-stone-100\\\">\\n              <span>\\n                Role: <strong className=\\\"text-slate-900\\\">{session.role}</strong> \302\267{\' \'}\\n                {session.difficulty} \302\267 {session.type.toUpperCase()}\\n              </span>\\n              <span className=\\\"font-bold text-indigo-700 tabular-nums\\\">\\n                Question {session.currentIndex + 1} of {session.questions.length}\\n              </span>\\n            </div>\\n\\n            <div>\\n              <span className=\\\"text-[11px] font-semibold uppercase tracking-wider text-stone-500\\\">\\n                {activeQuestion.type} Question\\n              </span>\\n              <h2 className=\\\"text-base sm:text-lg font-bold text-slate-900 mt-1\\\">\\n                {activeQuestion.question}\\n              </h2>\\n            </div>\\n\\n            <div>\\n              <label htmlFor=\\\"candidate-answer\\\" className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                Your Answer\\n              </label>\\n              <textarea\\n                id=\\\"candidate-answer\\\"\\n                rows={5}\\n                disabled={Boolean(activeAnswerRecord?.evaluation)}\\n                value={currentAnswer}\\n                onChange={(e) => setCurrentAnswer(e.target.value)}\\n                placeholder=\\\"Structure your response clearly. Mention core concepts and a practical example...\\\"\\n                className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg disabled:bg-stone-50\\\"\\n              />\\n            </div>\\n\\n            {!activeAnswerRecord?.evaluation ? (\\n              <div className=\\\"flex flex-wrap items-center justify-between gap-3\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={handleSkipQuestion}\\n                  disabled={evaluating}\\n                  className=\\\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-medium text-stone-600 hover:text-slate-900 bg-stone-100 hover:bg-stone-200 rounded-lg\\\"\\n                >\\n                  <SkipForward className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>Skip Question</span>\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={handleEvaluateAnswer}\\n                  disabled={evaluating}\\n                  className=\\\"inline-flex items-center gap-2 px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg disabled:opacity-50\\\"\\n                >\\n                  <Sparkles className=\\\"w-3.5 h-3.5 text-indigo-400\\\" />\\n                  <span>{evaluating ? \'Evaluating Answer...\' : \'Submit & Get AI Feedback\'}</span>\\n                </button>\\n              </div>\\n            ) : (\\n              <div className=\\\"p-4 bg-stone-50 border border-stone-200 rounded-xl space-y-3 text-xs\\\">\\n                <div className=\\\"flex items-center justify-between\\\">\\n                  <span className=\\\"font-bold text-slate-900 flex items-center gap-1.5\\\">\\n                    <CheckCircle2 className=\\\"w-4 h-4 text-emerald-600\\\" />\\n                    AI Evaluation\\n                  </span>\\n                  <span className=\\\"text-sm font-extrabold text-indigo-700 tabular-nums\\\">\\n                    Score: {activeAnswerRecord.evaluation.score} / 10\\n                  </span>\\n                </div>\\n\\n                <p className=\\\"text-stone-700 leading-relaxed\\\">\\n                  <strong className=\\\"text-slate-900\\\">Feedback:</strong>{\' \'}\\n                  {activeAnswerRecord.evaluation.feedback}\\n                </p>\\n\\n                <div className=\\\"p-3 bg-white border border-stone-200 rounded-lg\\\">\\n                  <span className=\\\"font-bold text-slate-900 block mb-1\\\">\\n                    Model Improved Answer:\\n                  </span>\\n                  <p className=\\\"text-stone-700 leading-relaxed\\\">\\n                    {activeAnswerRecord.evaluation.improvedAnswer}\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"pt-2 flex justify-end\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={handleNextQuestion}\\n                    className=\\\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg\\\"\\n                  >\\n                    <span>\\n                      {session.currentIndex + 1 >= session.questions.length\\n                        ? \'View Session Summary\'\\n                        : \'Next Question\'}\\n                    </span>\\n                    <ArrowRight className=\\\"w-3.5 h-3.5\\\" />\\n                  </button>\\n                </div>\\n              </div>\\n            )}\\n          </div>\\n        )}\\n\\n        {/* Session Summary Screen */}\\n        {session && session.completed && (\\n          <div className=\\\"p-6 bg-white border border-stone-200 rounded-xl shadow-2xs space-y-6\\\">\\n            <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-stone-200\\\">\\n              <div>\\n                <span className=\\\"text-xs font-semibold text-emerald-700 uppercase tracking-wider\\\">\\n                  Interview Session Completed\\n                </span>\\n                <h2 className=\\\"text-xl font-bold text-slate-900 mt-0.5\\\">\\n                  Final Average Score: {computeAverageScore(session)} / 10\\n                </h2>\\n                <p className=\\\"text-xs text-stone-600 mt-0.5\\\">\\n                  Role: {session.role} ({session.difficulty} \302\267 {session.type})\\n                </p>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleResetSession}\\n                className=\\\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg self-start\\\"\\n              >\\n                <RotateCcw className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Practice Another Round</span>\\n              </button>\\n            </div>\\n\\n            <div className=\\\"space-y-3\\\">\\n              {session.questions.map((q, idx) => {\\n                const ans = session.answers[q.id];\\n                return (\\n                  <div\\n                    key={q.id}\\n                    className=\\\"p-4 bg-stone-50 border border-stone-200 rounded-lg space-y-2 text-xs\\\"\\n                  >\\n                    <div className=\\\"flex items-start justify-between gap-3\\\">\\n                      <span className=\\\"font-bold text-slate-900\\\">\\n                        Q{idx + 1}. {q.question}\\n                      </span>\\n                      <span className=\\\"font-bold text-indigo-700 tabular-nums shrink-0\\\">\\n                        {ans?.evaluation?.score ?? 0} / 10\\n                      </span>\\n                    </div>\\n                    <p className=\\\"text-stone-600\\\">\\n                      <strong>Your Answer:</strong>{\' \'}\\n                      {ans?.skipped ? \'(Skipped)\' : ans?.userAnswer || \'(No answer)\'}\\n                    </p>\\n                    {ans?.evaluation && (\\n                      <p className=\\\"text-stone-700\\\">\\n                        <strong>Feedback:</strong> {ans.evaluation.feedback}\\n                      </p>\\n                    )}\\n                  </div>\\n                );\\n              })}\\n            </div>\\n          </div>\\n        )}\\n      </div>\\n    </AppShell>\\n  );\\n}\\n\", \"Description\":\"Phase 5 Mock Interview simulator with 8-question session, skip/evaluate handlers, mid-session persistence, and final average score summary\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/InterviewPage.tsx\", \"toolAction\":\"Creating InterviewPage\", \"toolSummary\":\"Create src/pages/InterviewPage.tsx (Phase 5)\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_3587438280710802108"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useState, useEffect, FormEvent } from \'react\';\\nimport { useSearchParams } from \'react-router-dom\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { RoadmapPlan } from \'../types\';\\nimport { getProfile, listSkills, getRoadmap, saveRoadmap } from \'../services/db\';\\nimport { generateRoadmap } from \'../services/ai\';\\nimport { AppShell } from \'../components/layout/AppShell\';\\nimport {\\n  Milestone,\\n  Sparkles,\\n  CheckSquare,\\n  Square,\\n  AlertCircle,\\n  RotateCcw,\\n  BookOpen,\\n  FolderGit2,\\n} from \'lucide-react\';\\n\\nexport function RoadmapPage() {\\n  const { user } = useAuth();\\n  const [searchParams] = useSearchParams();\\n  const roleFromQuery = searchParams.get(\'role\');\\n\\n  const [targetRole, setTargetRole] = useState(roleFromQuery || \'Full-Stack Software Engineer\');\\n  const [skillsInput, setSkillsInput] = useState(\'\');\\n  const [weeksAvailable, setWeeksAvailable] = useState(12);\\n\\n  const [plan, setPlan] = useState<RoadmapPlan | null>(null);\\n  const [loading, setLoading] = useState(true);\\n  const [generating, setGenerating] = useState(false);\\n  const [error, setError] = useState<string | null>(null);\\n  const [confirmOverwrite, setConfirmOverwrite] = useState(false);\\n\\n  useEffect(() => {\\n    async function load() {\\n      if (!user) return;\\n      setLoading(true);\\n      try {\\n        const [profile, skills, savedPlan] = await Promise.all([\\n          getProfile(user.id),\\n          listSkills(user.id),\\n          getRoadmap(user.id),\\n        ]);\\n\\n        if (roleFromQuery) {\\n          setTargetRole(roleFromQuery);\\n        } else if (savedPlan?.targetRole) {\\n          setTargetRole(savedPlan.targetRole);\\n        } else if (profile?.careerGoal) {\\n          setTargetRole(profile.careerGoal);\\n        }\\n\\n        if (skills.length > 0) {\\n          setSkillsInput(skills.map((s) => s.name).join(\', \'));\\n        }\\n\\n        if (savedPlan) {\\n          setPlan(savedPlan);\\n          if (savedPlan.weeksAvailable) {\\n            setWeeksAvailable(savedPlan.weeksAvailable);\\n          }\\n        }\\n      } catch (err) {\\n        console.error(\'Error loading roadmap:\', err);\\n      } finally {\\n        setLoading(false);\\n      }\\n    }\\n    load();\\n  }, [user, roleFromQuery]);\\n\\n  const executeGenerate = async () => {\\n    if (!user || generating) return;\\n    setConfirmOverwrite(false);\\n    setError(null);\\n    setGenerating(true);\\n\\n    try {\\n      const currentSkills = skillsInput\\n        .split(\',\')\\n        .map((s) => s.trim())\\n        .filter(Boolean);\\n\\n      const output = await generateRoadmap({\\n        targetRole: targetRole.trim(),\\n        currentSkills,\\n        weeksAvailable: Number(weeksAvailable) || 12,\\n      });\\n\\n      const newPlan: RoadmapPlan = {\\n        id: `rm-${Date.now()}`,\\n        userId: user.id,\\n        targetRole: targetRole.trim(),\\n        weeksAvailable: Number(weeksAvailable) || 12,\\n        data: output,\\n        completedTopics: [],\\n        createdAt: new Date().toISOString(),\\n      };\\n      const saved = await saveRoadmap(newPlan);\\n      setPlan(saved);\\n    } catch (err: unknown) {\\n      setError(\\n        err instanceof Error\\n          ? err.message\\n          : \'Could not generate learning roadmap. Please click Retry.\'\\n      );\\n    } finally {\\n      setGenerating(false);\\n    }\\n  };\\n\\n  const handleRequestGenerate = (e: FormEvent) => {\\n    e.preventDefault();\\n    if (!targetRole.trim()) {\\n      setError(\'Please enter a target career role.\');\\n      return;\\n    }\\n    // Warn before overwriting saved checkbox progress\\n    if (plan && plan.completedTopics.length > 0) {\\n      setConfirmOverwrite(true);\\n      return;\\n    }\\n    executeGenerate();\\n  };\\n\\n  const toggleTopic = async (topicKey: string) => {\\n    if (!plan) return;\\n    const exists = plan.completedTopics.includes(topicKey);\\n    const updatedTopics = exists\\n      ? plan.completedTopics.filter((t) => t !== topicKey)\\n      : [...plan.completedTopics, topicKey];\\n\\n    const updatedPlan: RoadmapPlan = {\\n      ...plan,\\n      completedTopics: updatedTopics,\\n    };\\n    setPlan(updatedPlan);\\n    await saveRoadmap(updatedPlan);\\n  };\\n\\n  const allTopicKeys: string[] = [];\\n  if (plan?.data?.phases) {\\n    plan.data.phases.forEach((ph, pIdx) => {\\n      ph.topics.forEach((t, tIdx) => {\\n        allTopicKeys.push(`${pIdx}-${tIdx}-${t}`);\\n      });\\n    });\\n  }\\n  const totalTopicsCount = allTopicKeys.length;\\n  const completedCount = plan\\n    ? allTopicKeys.filter((k) => plan.completedTopics.includes(k)).length\\n    : 0;\\n  const progressPercent =\\n    totalTopicsCount > 0 ? Math.round((completedCount / totalTopicsCount) * 100) : 0;\\n\\n  return (\\n    <AppShell>\\n      <div className=\\\"space-y-6\\\">\\n        <div className=\\\"pb-4 border-b border-stone-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3\\\">\\n          <div>\\n            <h1 className=\\\"text-xl sm:text-2xl font-bold text-slate-900\\\">\\n              AI Learning Roadmap\\n            </h1>\\n            <p className=\\\"text-xs sm:text-sm text-stone-600 mt-1\\\">\\n              Generate a week-by-week study timeline and check off topics as you master them.\\n            </p>\\n          </div>\\n          {plan && (\\n            <div className=\\\"text-right\\\">\\n              <span className=\\\"text-sm font-extrabold text-indigo-700 tabular-nums\\\">\\n                {progressPercent}% Completed\\n              </span>\\n              <span className=\\\"block text-[11px] text-stone-500 tabular-nums\\\">\\n                {completedCount} of {totalTopicsCount} topics checked\\n              </span>\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Generator Form */}\\n        <form\\n          onSubmit={handleRequestGenerate}\\n          className=\\\"p-5 bg-white border border-stone-200 rounded-xl shadow-2xs space-y-4\\\"\\n        >\\n          <div className=\\\"grid grid-cols-1 md:grid-cols-12 gap-4\\\">\\n            <div className=\\\"md:col-span-5\\\">\\n              <label htmlFor=\\\"rm-role\\\" className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                Target Career Role *\\n              </label>\\n              <input\\n                id=\\\"rm-role\\\"\\n                type=\\\"text\\\"\\n                required\\n                value={targetRole}\\n                onChange={(e) => setTargetRole(e.target.value)}\\n                placeholder=\\\"e.g. Full-Stack Web Developer\\\"\\n                className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"md:col-span-5\\\">\\n              <label htmlFor=\\\"rm-skills\\\" className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                Current Skills (comma-separated)\\n              </label>\\n              <input\\n                id=\\\"rm-skills\\\"\\n                type=\\\"text\\\"\\n                value={skillsInput}\\n                onChange={(e) => setSkillsInput(e.target.value)}\\n                placeholder=\\\"e.g. HTML, CSS, JavaScript, SQL\\\"\\n                className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"md:col-span-2\\\">\\n              <label htmlFor=\\\"rm-weeks\\\" className=\\\"block text-xs font-medium text-stone-700 mb-1\\\">\\n                Weeks (2\342\200\22352)\\n              </label>\\n              <input\\n                id=\\\"rm-weeks\\\"\\n                type=\\\"number\\\"\\n                min={2}\\n                max={52}\\n                value={weeksAvailable}\\n                onChange={(e) => setWeeksAvailable(Number(e.target.value))}\\n                className=\\\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg tabular-nums\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <div className=\\\"flex justify-end\\\">\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={generating || loading}\\n              className=\\\"inline-flex items-center gap-2 px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors disabled:opacity-50\\\"\\n            >\\n              <Sparkles className=\\\"w-3.5 h-3.5 text-indigo-400\\\" />\\n              <span>{generating ? \'Building Roadmap...\' : \'Generate Learning Roadmap\'}</span>\\n            </button>\\n          </div>\\n        </form>\\n\\n        {error && (\\n          <div className=\\\"p-4 bg-red-50 border border-red-200 rounded-xl flex items-center justify-between gap-3 text-xs text-red-900\\\">\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <AlertCircle className=\\\"w-4 h-4 text-red-600 shrink-0\\\" />\\n              <span>{error}</span>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={executeGenerate}\\n              className=\\\"inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-white bg-red-700 hover:bg-red-800 rounded-lg shrink-0\\\"\\n            >\\n              <RotateCcw className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Retry</span>\\n            </button>\\n          </div>\\n        )}\\n\\n        {/* Vertical Timeline Display */}\\n        {!generating && !plan && !error && (\\n          <div className=\\\"p-10 bg-white border border-stone-200 rounded-xl text-center space-y-2\\\">\\n            <Milestone className=\\\"w-6 h-6 text-indigo-600 mx-auto\\\" />\\n            <h2 className=\\\"text-sm font-bold text-slate-900\\\">No learning roadmap active</h2>\\n            <p className=\\\"text-xs text-stone-600 max-w-md mx-auto\\\">\\n              Enter your target career role above and click{\' \'}\\n              <span className=\\\"font-semibold text-slate-900\\\">Generate Learning Roadmap</span> to create your structured weekly plan.\\n            </p>\\n          </div>\\n        )}\\n\\n        {plan?.data?.phases && (\\n          <div className=\\\"space-y-4\\\">\\n            {/* Overall Progress Bar */}\\n            <div className=\\\"p-4 bg-white border border-stone-200 rounded-xl shadow-2xs space-y-2\\\">\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <span className=\\\"font-bold text-slate-900\\\">\\n                  Roadmap for {plan.targetRole}\\n                </span>\\n                <span className=\\\"font-bold text-indigo-700 tabular-nums\\\">\\n                  {progressPercent}% ({completedCount}/{totalTopicsCount})\\n                </span>\\n              </div>\\n              <div className=\\\"w-full h-2 bg-stone-100 rounded-full overflow-hidden\\\">\\n                <div\\n                  className=\\\"h-full bg-indigo-600 rounded-full transition-all duration-300\\\"\\n                  style={{ width: `${progressPercent}%` }}\\n                />\\n              </div>\\n            </div>\\n\\n            {/* Timeline Phases */}\\n            <div className=\\\"relative pl-6 border-l-2 border-stone-200 space-y-6 ml-3\\\">\\n              {plan.data.phases.map((phase, pIdx) => (\\n                <div\\n                  key={pIdx}\\n                  className=\\\"relative p-5 bg-white border border-stone-200 rounded-xl shadow-2xs space-y-3\\\"\\n                >\\n                  <div className=\\\"absolute -left-[31px] top-6 w-4 h-4 rounded-full bg-indigo-600 border-2 border-white\\\" />\\n\\n                  <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-1\\\">\\n                    <h3 className=\\\"text-sm font-bold text-slate-900\\\">\\n                      0{pIdx + 1}. {phase.title}\\n                    </h3>\\n                    <span className=\\\"text-xs font-semibold text-indigo-700 tabular-nums\\\">\\n                      {phase.weeks}\\n                    </span>\\n                  </div>\\n\\n                  {/* Interactive Checkable Topics */}\\n                  <div className=\\\"space-y-1.5\\\">\\n                    {phase.topics.map((topic, tIdx) => {\\n                      const key = `${pIdx}-${tIdx}-${topic}`;\\n                      const checked = plan.completedTopics.includes(key);\\n                      return (\\n                        <button\\n                          key={key}\\n                          type=\\\"button\\\"\\n                          onClick={() => toggleTopic(key)}\\n                          className={`w-full flex items-center gap-2.5 p-2 rounded-lg text-left text-xs transition-colors ${\\n                            checked\\n                              ? \'bg-emerald-50/70 text-emerald-950 line-through\'\\n                              : \'bg-stone-50 hover:bg-stone-100 text-slate-900\'\\n                          }`}\\n                        >\\n                          {checked ? (\\n                            <CheckSquare className=\\\"w-4 h-4 text-emerald-600 shrink-0\\\" />\\n                          ) : (\\n                            <Square className=\\\"w-4 h-4 text-stone-400 shrink-0\\\" />\\n                          )}\\n                          <span>{topic}</span>\\n                        </button>\\n                      );\\n                    })}\\n                  </div>\\n\\n                  <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-3 pt-2 border-t border-stone-100 text-xs\\\">\\n                    <div className=\\\"p-3 bg-stone-50 rounded-lg space-y-1\\\">\\n                      <span className=\\\"font-bold text-slate-900 flex items-center gap-1.5\\\">\\n                        <FolderGit2 className=\\\"w-3.5 h-3.5 text-indigo-600\\\" />\\n                        Milestone Project Idea\\n                      </span>\\n                      <p className=\\\"text-stone-600\\\">{phase.projectIdea}</p>\\n                    </div>\\n\\n                    <div className=\\\"p-3 bg-stone-50 rounded-lg space-y-1\\\">\\n                      <span className=\\\"font-bold text-slate-900 flex items-center gap-1.5\\\">\\n                        <BookOpen className=\\\"w-3.5 h-3.5 text-indigo-600\\\" />\\n                        Recommended Free Study Sources\\n                      </span>\\n                      <ul className=\\\"space-y-1 text-stone-600\\\">\\n                        {phase.freeResources.map((r, rIdx) => (\\n                          <li key={rIdx}>\\n                            {r.name} \302\267 <span className=\\\"text-stone-500\\\">{r.type}</span>\\n                          </li>\\n                        ))}\\n                      </ul>\\n                    </div>\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* Overwrite Confirmation Modal */}\\n        {confirmOverwrite && (\\n          <div\\n            className=\\\"fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4\\\"\\n            role=\\\"dialog\\\"\\n            aria-modal=\\\"true\\\"\\n            aria-labelledby=\\\"overwrite-modal-title\\\"\\n          >\\n            <div className=\\\"bg-white border border-stone-200 rounded-xl max-w-sm w-full p-5 shadow-lg space-y-4\\\">\\n              <h3 id=\\\"overwrite-modal-title\\\" className=\\\"text-sm font-bold text-slate-900\\\">\\n                Replace Current Roadmap Progress?\\n              </h3>\\n              <p className=\\\"text-xs text-stone-600 leading-relaxed\\\">\\n                You have checked off{\' \'}\\n                <strong className=\\\"text-slate-900\\\">{completedCount} topics</strong> on your current roadmap. Generating a new roadmap will reset this progress.\\n              </p>\\n              <div className=\\\"flex items-center justify-end gap-2 pt-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setConfirmOverwrite(false)}\\n                  className=\\\"px-3 py-1.5 text-xs font-medium text-stone-700 bg-stone-100 hover:bg-stone-200 rounded-lg\\\"\\n                >\\n                  Keep Current\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={executeGenerate}\\n                  className=\\\"px-3.5 py-1.5 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg\\\"\\n                >\\n                  Generate New Roadmap\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n      </div>\\n    </AppShell>\\n  );\\n}\\n\", \"Description\":\"Phase 5 Learning Roadmap page with vertical timeline, interactive checkboxes, persisted completion percentage, and overwrite protection modal\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/RoadmapPage.tsx\", \"toolAction\":\"Creating RoadmapPage\", \"toolSummary\":\"Create src/pages/RoadmapPage.tsx (Phase 5)\"}"
      original_name: "write_to_file"
    }
    thinking_duration {
      seconds: 180
      nanos: 17703824
    }
    stop_reason: STOP_REASON_STOP_PATTERN
    provider_assigned_message_id: "5V_0aq7rB5SFvdIPo7iv6Aw"
  }
