  planner_response {
    tool_calls {
      id: "call_15439294082274167509"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useEffect } from \'react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { getProfile, listSkills, getRoadmap, saveRoadmap } from \'../services/db\';\\nimport { generateRoadmap } from \'../services/ai\';\\nimport { RoadmapPlan } from \'../types\';\\nimport {\\n  Map,\\n  Sparkles,\\n  Loader2,\\n  AlertCircle,\\n  CheckSquare,\\n  Square,\\n  BookOpen,\\n  Lightbulb,\\n} from \'lucide-react\';\\n\\nexport const RoadmapPage: React.FC = () => {\\n  const { user } = useAuth();\\n  const [targetRole, setTargetRole] = useState(\'\');\\n  const [weeksAvailable, setWeeksAvailable] = useState(12);\\n  const [hoursPerWeek, setHoursPerWeek] = useState(10);\\n  const [budget, setBudget] = useState<\'free\' | \'low\' | \'flexible\'>(\'free\');\\n  const [skillNames, setSkillNames] = useState<string[]>([]);\\n  const [roadmap, setRoadmap] = useState<RoadmapPlan | null>(null);\\n  const [isGenerating, setIsGenerating] = useState(false);\\n  const [error, setError] = useState<string | null>(null);\\n\\n  useEffect(() => {\\n    let active = true;\\n    async function load() {\\n      if (!user) return;\\n      const [prof, skills, existingRoadmap] = await Promise.all([\\n        getProfile(),\\n        listSkills(),\\n        getRoadmap(),\\n      ]);\\n      if (!active) return;\\n\\n      setSkillNames(skills.map((s) => s.name));\\n      if (existingRoadmap) {\\n        setRoadmap(existingRoadmap);\\n        setTargetRole(existingRoadmap.targetRole);\\n      } else if (prof?.careerGoal) {\\n        setTargetRole(prof.careerGoal);\\n      }\\n    }\\n    load();\\n    return () => {\\n      active = false;\\n    };\\n  }, [user]);\\n\\n  if (!user) return null;\\n\\n  const handleGenerate = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!targetRole.trim()) {\\n      setError(\'Please enter a target career or goal.\');\\n      return;\\n    }\\n    setError(null);\\n    setIsGenerating(true);\\n    try {\\n      const output = await generateRoadmap({\\n        targetRole: targetRole.trim(),\\n        currentSkills: skillNames,\\n        weeksAvailable: Math.min(52, Math.max(2, Number(weeksAvailable) || 12)),\\n        hoursPerWeek: Math.min(60, Math.max(2, Number(hoursPerWeek) || 10)),\\n        budget,\\n      });\\n\\n      const saved = await saveRoadmap({\\n        id: roadmap?.id || `rm-${Date.now()}`,\\n        targetRole: targetRole.trim(),\\n        data: output,\\n        progress: [],\\n        createdAt: new Date().toISOString(),\\n      });\\n      setRoadmap(saved);\\n    } catch (err: unknown) {\\n      setError(\\n        err instanceof Error ? err.message : \'Could not generate roadmap. Please click Retry.\'\\n      );\\n    } finally {\\n      setIsGenerating(false);\\n    }\\n  };\\n\\n  const toggleTopicKey = async (key: string) => {\\n    if (!roadmap) return;\\n    const exists = roadmap.progress.includes(key);\\n    const nextProgress = exists\\n      ? roadmap.progress.filter((k) => k !== key)\\n      : [...roadmap.progress, key];\\n\\n    const saved = await saveRoadmap({\\n      ...roadmap,\\n      progress: nextProgress,\\n    });\\n    setRoadmap(saved);\\n  };\\n\\n  const totalTopics = roadmap\\n    ? roadmap.data.phases.reduce((acc, p) => acc + p.topics.length, 0)\\n    : 0;\\n  const completedCount = roadmap ? roadmap.progress.length : 0;\\n  const progressPercent =\\n    totalTopics > 0 ? Math.min(100, Math.round((completedCount / totalTopics) * 100)) : 0;\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      <div className=\\\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-5\\\">\\n        <div>\\n          <div className=\\\"flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#1E3A5F] dark:text-amber-400\\\">\\n            <Map className=\\\"w-4 h-4\\\" />\\n            <span>Step-by-Step Study & Practice Plan</span>\\n          </div>\\n          <h1 className=\\\"text-2xl font-bold text-slate-900 dark:text-white mt-1\\\">\\n            AI Learning Roadmap\\n          </h1>\\n          <p className=\\\"text-sm text-slate-600 dark:text-slate-400 mt-0.5\\\">\\n            Build a custom week-by-week plan tailored to your target role, schedule, and budget.\\n          </p>\\n        </div>\\n      </div>\\n\\n      {/* Generator Form */}\\n      <form\\n        onSubmit={handleGenerate}\\n        className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-5 grid grid-cols-1 sm:grid-cols-12 gap-4 items-end\\\"\\n      >\\n        <div className=\\\"sm:col-span-5\\\">\\n          <label className=\\\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1\\\">\\n            Target Role, Exam, or Skill Goal\\n          </label>\\n          <input\\n            type=\\\"text\\\"\\n            value={targetRole}\\n            onChange={(e) => setTargetRole(e.target.value)}\\n            placeholder=\\\"e.g., Full-Stack Developer, Clinical Pharmacist, Financial Analyst\\\"\\n            className=\\\"w-full px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\\\"\\n          />\\n        </div>\\n        <div className=\\\"sm:col-span-2\\\">\\n          <label className=\\\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1\\\">\\n            Weeks Available\\n          </label>\\n          <input\\n            type=\\\"number\\\"\\n            min={2}\\n            max={52}\\n            value={weeksAvailable}\\n            onChange={(e) => setWeeksAvailable(Number(e.target.value))}\\n            className=\\\"w-full px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\\\"\\n          />\\n        </div>\\n        <div className=\\\"sm:col-span-2\\\">\\n          <label className=\\\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1\\\">\\n            Hours / Week\\n          </label>\\n          <input\\n            type=\\\"number\\\"\\n            min={2}\\n            max={60}\\n            value={hoursPerWeek}\\n            onChange={(e) => setHoursPerWeek(Number(e.target.value))}\\n            className=\\\"w-full px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\\\"\\n          />\\n        </div>\\n        <div className=\\\"sm:col-span-3\\\">\\n          <label className=\\\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1\\\">\\n            Resource Budget\\n          </label>\\n          <select\\n            value={budget}\\n            onChange={(e) => setBudget(e.target.value as \'free\' | \'low\' | \'flexible\')}\\n            className=\\\"w-full px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\\\"\\n          >\\n            <option value=\\\"free\\\">100% Free Resources Only</option>\\n            <option value=\\\"low\\\">Low-Cost Books & Courses</option>\\n            <option value=\\\"flexible\\\">Flexible</option>\\n          </select>\\n        </div>\\n\\n        <div className=\\\"sm:col-span-12 flex justify-end\\\">\\n          <button\\n            type=\\\"submit\\\"\\n            disabled={isGenerating}\\n            className=\\\"inline-flex items-center gap-2 px-4 py-2 rounded-md bg-[#1E3A5F] hover:bg-[#162B47] text-white text-xs font-semibold disabled:opacity-60 cursor-pointer\\\"\\n          >\\n            {isGenerating ? (\\n              <>\\n                <Loader2 className=\\\"w-4 h-4 animate-spin\\\" />\\n                Building Roadmap...\\n              </>\\n            ) : (\\n              <>\\n                <Sparkles className=\\\"w-4 h-4\\\" />\\n                {roadmap ? \'Regenerate Learning Plan\' : \'Generate Learning Plan\'}\\n              </>\\n            )}\\n          </button>\\n        </div>\\n      </form>\\n\\n      {error && (\\n        <div className=\\\"bg-red-50 border border-red-200 rounded-lg p-4 flex items-center justify-between gap-3 text-xs text-red-800\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <AlertCircle className=\\\"w-4 h-4 text-red-600 shrink-0\\\" />\\n            <span>{error}</span>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleGenerate}\\n            className=\\\"px-3 py-1 rounded bg-red-600 text-white font-semibold hover:bg-red-700 cursor-pointer\\\"\\n          >\\n            Retry\\n          </button>\\n        </div>\\n      )}\\n\\n      {roadmap && (\\n        <div className=\\\"space-y-5\\\">\\n          {/* Progress Header */}\\n          <div className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-5\\\">\\n            <div className=\\\"flex items-center justify-between mb-2\\\">\\n              <div>\\n                <h2 className=\\\"text-base font-bold text-slate-900 dark:text-white\\\">\\n                  Roadmap for {roadmap.targetRole}\\n                </h2>\\n                <p className=\\\"text-xs text-slate-500\\\">\\n                  {completedCount} of {totalTopics} milestones completed\\n                </p>\\n              </div>\\n              <span className=\\\"text-lg font-bold text-[#1E3A5F] dark:text-amber-400\\\">\\n                {progressPercent}%\\n              </span>\\n            </div>\\n            <div className=\\\"w-full h-2.5 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden\\\">\\n              <div\\n                className=\\\"h-full bg-[#1E3A5F] transition-all duration-300\\\"\\n                style={{ width: `${progressPercent}%` }}\\n              />\\n            </div>\\n          </div>\\n\\n          {/* Phases */}\\n          <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-5\\\">\\n            {roadmap.data.phases.map((phase, pIdx) => (\\n              <div\\n                key={pIdx}\\n                className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-5 flex flex-col justify-between space-y-4\\\"\\n              >\\n                <div className=\\\"space-y-3\\\">\\n                  <div className=\\\"flex items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 pb-2.5\\\">\\n                    <h3 className=\\\"text-sm font-bold text-slate-900 dark:text-white\\\">\\n                      {phase.title}\\n                    </h3>\\n                    <span className=\\\"text-[11px] font-semibold text-[#1E3A5F] dark:text-amber-300 bg-[#1E3A5F]/10 px-2.5 py-0.5 rounded\\\">\\n                      {phase.weeks}\\n                    </span>\\n                  </div>\\n\\n                  {/* Checklist */}\\n                  <div className=\\\"space-y-1.5\\\">\\n                    {phase.topics.map((topic, tIdx) => {\\n                      const key = `${pIdx}::${topic}`;\\n                      const checked = roadmap.progress.includes(key);\\n                      return (\\n                        <button\\n                          key={tIdx}\\n                          type=\\\"button\\\"\\n                          onClick={() => toggleTopicKey(key)}\\n                          className=\\\"w-full text-left flex items-start gap-2.5 p-2 rounded hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors cursor-pointer\\\"\\n                        >\\n                          {checked ? (\\n                            <CheckSquare className=\\\"w-4 h-4 text-emerald-600 shrink-0 mt-0.5\\\" />\\n                          ) : (\\n                            <Square className=\\\"w-4 h-4 text-slate-400 shrink-0 mt-0.5\\\" />\\n                          )}\\n                          <span\\n                            className={`text-xs ${\\n                              checked\\n                                ? \'line-through text-slate-400\'\\n                                : \'text-slate-800 dark:text-slate-200 font-medium\'\\n                            }`}\\n                          >\\n                            {topic}\\n                          </span>\\n                        </button>\\n                      );\\n                    })}\\n                  </div>\\n                </div>\\n\\n                <div className=\\\"space-y-3 pt-3 border-t border-slate-100 dark:border-slate-800 text-xs\\\">\\n                  <div className=\\\"p-3 rounded bg-amber-50/70 dark:bg-amber-950/30 border border-amber-200/80 dark:border-amber-900/50\\\">\\n                    <div className=\\\"flex items-center gap-1.5 font-bold text-amber-950 dark:text-amber-300 mb-1\\\">\\n                      <Lightbulb className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>Hands-On Practice Idea</span>\\n                    </div>\\n                    <p className=\\\"text-amber-900 dark:text-amber-200\\\">{phase.practiceIdea}</p>\\n                  </div>\\n\\n                  {phase.freeResources.length > 0 && (\\n                    <div>\\n                      <div className=\\\"flex items-center gap-1.5 font-bold text-slate-700 dark:text-slate-300 mb-1.5\\\">\\n                        <BookOpen className=\\\"w-3.5 h-3.5\\\" />\\n                        <span>Recommended Study Materials</span>\\n                      </div>\\n                      <ul className=\\\"space-y-1 text-slate-600 dark:text-slate-400\\\">\\n                        {phase.freeResources.map((res, rIdx) => (\\n                          <li key={rIdx} className=\\\"flex items-center justify-between gap-2\\\">\\n                            <span>\342\200\242 {res.name}</span>\\n                            <span className=\\\"text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300\\\">\\n                              {res.type}\\n                            </span>\\n                          </li>\\n                        ))}\\n                      </ul>\\n                    </div>\\n                  )}\\n                </div>\\n              </div>\\n            ))}\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Update RoadmapPage to use session-scoped services, RoadmapPhase.practiceIdea, and RoadmapPlan.progress\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/RoadmapPage.tsx\", \"toolAction\":\"Updating RoadmapPage component\", \"toolSummary\":\"Update RoadmapPage.tsx for universal RoadmapPlan model\"}"
      thinking_signature: "\022\254\002\n\251\002\001i\024}\023\033\306\344\270\211\244\336\025\0021\341m4c\261\376\236\320\b\220\276\327\274\312\211\034\272\253\243P\305\t\276O\177\'K\267e\220h\342)\243,H[ \270\340\345\374l\264V<\271g\350y\202\334\360*\327\301\277d\330D\252\330\316\325\3174\345([!\214y\347\225\n\f\360\n\362\bqS\231\326n\334\365\276\243\330\025z\311\317\n\332|\317N?\2565V8a\310\305\334\230\037\324U\325\377\356\366> \222onc\024\351\256m\226\207\210\342i\330\355\200\3515\260s\240\360\222bF\023{\235\375\3705\222\216\301\273\370x\377v%Pb~\227\016\314\204\214\016\316\031a\246\vW*v!\303\227\271!r\335\207\365\360\311\316\255X\231[\377\301i,\006\325\372\366\272\315N^\037\250\306,\272\024\315!\207\262)\211c)\305b\024\023\246\304\351\266~\304\255 4r\031r\276\311\211\221\271\335\016,\224\330\241z\343\027\021$\264\021\254W\252}\206\'\304\354wRd\235d\344\371\212\274q\302\"\241%(2\214\310\313\246\252\265\323"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_15439294082274167192"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useEffect } from \'react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport {\\n  listOpportunities,\\n  saveOpportunity,\\n  deleteOpportunity,\\n} from \'../services/db\';\\nimport {\\n  Opportunity,\\n  OpportunityType,\\n  OpportunityStatus,\\n} from \'../types\';\\nimport {\\n  Briefcase,\\n  Plus,\\n  Trash2,\\n  Edit2,\\n  Calendar,\\n  AlertTriangle,\\n  Search,\\n} from \'lucide-react\';\\n\\nconst OPPORTUNITY_TYPES: { value: OpportunityType; label: string }[] = [\\n  { value: \'job\', label: \'Job\' },\\n  { value: \'internship\', label: \'Internship / Apprenticeship\' },\\n  { value: \'exam\', label: \'Competitive / Entrance Exam\' },\\n  { value: \'scholarship\', label: \'Scholarship / Fellowship\' },\\n  { value: \'admission\', label: \'Course / University Admission\' },\\n  { value: \'freelance\', label: \'Freelance / Client Project\' },\\n];\\n\\nconst OPPORTUNITY_STATUSES: { value: OpportunityStatus; label: string }[] = [\\n  { value: \'saved\', label: \'Saved\' },\\n  { value: \'applied\', label: \'Applied\' },\\n  { value: \'interview\', label: \'Interview / Exam Stage\' },\\n  { value: \'offer\', label: \'Offer / Selected\' },\\n  { value: \'rejected\', label: \'Not Selected\' },\\n  { value: \'closed\', label: \'Closed\' },\\n];\\n\\nexport const TrackerPage: React.FC = () => {\\n  const { user } = useAuth();\\n  const [items, setItems] = useState<Opportunity[]>([]);\\n  const [filterType, setFilterType] = useState<string>(\'all\');\\n  const [filterStatus, setFilterStatus] = useState<string>(\'all\');\\n  const [searchQuery, setSearchQuery] = useState(\'\');\\n\\n  const [editingId, setEditingId] = useState<string | null>(null);\\n  const [title, setTitle] = useState(\'\');\\n  const [organization, setOrganization] = useState(\'\');\\n  const [type, setType] = useState<OpportunityType>(\'job\');\\n  const [status, setStatus] = useState<OpportunityStatus>(\'saved\');\\n  const [deadline, setDeadline] = useState(\'\');\\n  const [appliedDate, setAppliedDate] = useState(\'\');\\n  const [notes, setNotes] = useState(\'\');\\n  const [error, setError] = useState<string | null>(null);\\n\\n  useEffect(() => {\\n    let active = true;\\n    async function load() {\\n      if (!user) return;\\n      const list = await listOpportunities();\\n      if (active) setItems(list);\\n    }\\n    load();\\n    return () => {\\n      active = false;\\n    };\\n  }, [user]);\\n\\n  if (!user) return null;\\n\\n  const resetForm = () => {\\n    setEditingId(null);\\n    setTitle(\'\');\\n    setOrganization(\'\');\\n    setType(\'job\');\\n    setStatus(\'saved\');\\n    setDeadline(\'\');\\n    setAppliedDate(\'\');\\n    setNotes(\'\');\\n    setError(null);\\n  };\\n\\n  const handleSave = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!title.trim() || !organization.trim()) {\\n      setError(\'Please enter both a title and an organization/institution name.\');\\n      return;\\n    }\\n    setError(null);\\n    const saved = await saveOpportunity({\\n      id: editingId || `opp-${Date.now()}`,\\n      title: title.trim(),\\n      organization: organization.trim(),\\n      type,\\n      status,\\n      deadline,\\n      appliedDate: appliedDate || new Date().toISOString().slice(0, 10),\\n      notes: notes.trim(),\\n    });\\n    const updated = await listOpportunities();\\n    setItems(updated);\\n    if (saved) resetForm();\\n  };\\n\\n  const handleEdit = (opp: Opportunity) => {\\n    setEditingId(opp.id);\\n    setTitle(opp.title);\\n    setOrganization(opp.organization);\\n    setType(opp.type);\\n    setStatus(opp.status);\\n    setDeadline(opp.deadline);\\n    setAppliedDate(opp.appliedDate);\\n    setNotes(opp.notes);\\n  };\\n\\n  const handleQuickStatusChange = async (opp: Opportunity, nextStatus: OpportunityStatus) => {\\n    await saveOpportunity({ ...opp, status: nextStatus });\\n    const updated = await listOpportunities();\\n    setItems(updated);\\n  };\\n\\n  const handleDelete = async (id: string) => {\\n    await deleteOpportunity(id);\\n    const updated = await listOpportunities();\\n    setItems(updated);\\n  };\\n\\n  const isDeadlineSoon = (dateStr: string): boolean => {\\n    if (!dateStr) return false;\\n    const target = new Date(dateStr).getTime();\\n    if (Number.isNaN(target)) return false;\\n    const diffDays = (target - Date.now()) / (1000 * 60 * 60 * 24);\\n    return diffDays >= -1 && diffDays <= 7;\\n  };\\n\\n  const filtered = items.filter((item) => {\\n    if (filterType !== \'all\' && item.type !== filterType) return false;\\n    if (filterStatus !== \'all\' && item.status !== filterStatus) return false;\\n    if (searchQuery.trim()) {\\n      const q = searchQuery.toLowerCase();\\n      return (\\n        item.title.toLowerCase().includes(q) ||\\n        item.organization.toLowerCase().includes(q) ||\\n        item.notes.toLowerCase().includes(q)\\n      );\\n    }\\n    return true;\\n  });\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      <div className=\\\"border-b border-slate-200 dark:border-slate-800 pb-5\\\">\\n        <div className=\\\"flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#1E3A5F] dark:text-amber-400\\\">\\n          <Briefcase className=\\\"w-4 h-4\\\" />\\n          <span>Jobs, Internships, Exams, Scholarships & Admissions</span>\\n        </div>\\n        <h1 className=\\\"text-2xl font-bold text-slate-900 dark:text-white mt-1\\\">\\n          Opportunities Tracker\\n        </h1>\\n        <p className=\\\"text-sm text-slate-600 dark:text-slate-400 mt-0.5\\\">\\n          Keep every application, entrance exam, scholarship, and admission deadline organized in one place.\\n        </p>\\n      </div>\\n\\n      {/* Status Counters */}\\n      <div className=\\\"grid grid-cols-2 sm:grid-cols-6 gap-3\\\">\\n        {OPPORTUNITY_STATUSES.map((st) => {\\n          const count = items.filter((i) => i.status === st.value).length;\\n          return (\\n            <div\\n              key={st.value}\\n              className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-3.5\\\"\\n            >\\n              <span className=\\\"text-[11px] font-semibold uppercase tracking-wider text-slate-500\\\">\\n                {st.label}\\n              </span>\\n              <p className=\\\"text-xl font-bold text-slate-900 dark:text-white mt-1\\\">{count}</p>\\n            </div>\\n          );\\n        })}\\n      </div>\\n\\n      {/* Add / Edit Form */}\\n      <form\\n        onSubmit={handleSave}\\n        className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-5 space-y-4\\\"\\n      >\\n        <div className=\\\"flex items-center justify-between\\\">\\n          <h2 className=\\\"text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider\\\">\\n            {editingId ? \'Edit Opportunity\' : \'Add Opportunity\'}\\n          </h2>\\n          {editingId && (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={resetForm}\\n              className=\\\"text-xs text-slate-500 hover:text-slate-800 cursor-pointer\\\"\\n            >\\n              Cancel Edit\\n            </button>\\n          )}\\n        </div>\\n\\n        {error && <p className=\\\"text-xs text-red-600 font-medium\\\">{error}</p>}\\n\\n        <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-3\\\">\\n          <input\\n            type=\\\"text\\\"\\n            placeholder=\\\"Role, Exam, Scholarship, or Course Title *\\\"\\n            value={title}\\n            onChange={(e) => setTitle(e.target.value)}\\n            className=\\\"px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\\\"\\n          />\\n          <input\\n            type=\\\"text\\\"\\n            placeholder=\\\"Company, Board, University, or Client *\\\"\\n            value={organization}\\n            onChange={(e) => setOrganization(e.target.value)}\\n            className=\\\"px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\\\"\\n          />\\n          <select\\n            value={type}\\n            onChange={(e) => setType(e.target.value as OpportunityType)}\\n            className=\\\"px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\\\"\\n          >\\n            {OPPORTUNITY_TYPES.map((t) => (\\n              <option key={t.value} value={t.value}>\\n                {t.label}\\n              </option>\\n            ))}\\n          </select>\\n          <select\\n            value={status}\\n            onChange={(e) => setStatus(e.target.value as OpportunityStatus)}\\n            className=\\\"px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\\\"\\n          >\\n            {OPPORTUNITY_STATUSES.map((s) => (\\n              <option key={s.value} value={s.value}>\\n                {s.label}\\n              </option>\\n            ))}\\n          </select>\\n          <div>\\n            <label className=\\\"block text-[10px] font-semibold uppercase text-slate-500 mb-0.5\\\">\\n              Deadline Date\\n            </label>\\n            <input\\n              type=\\\"date\\\"\\n              value={deadline}\\n              onChange={(e) => setDeadline(e.target.value)}\\n              className=\\\"w-full px-3 py-1.5 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\\\"\\n            />\\n          </div>\\n          <div>\\n            <label className=\\\"block text-[10px] font-semibold uppercase text-slate-500 mb-0.5\\\">\\n              Applied / Saved Date\\n            </label>\\n            <input\\n              type=\\\"date\\\"\\n              value={appliedDate}\\n              onChange={(e) => setAppliedDate(e.target.value)}\\n              className=\\\"w-full px-3 py-1.5 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\\\"\\n            />\\n          </div>\\n          <input\\n            type=\\\"text\\\"\\n            placeholder=\\\"Notes, exam center, portal link, or next step...\\\"\\n            value={notes}\\n            onChange={(e) => setNotes(e.target.value)}\\n            className=\\\"sm:col-span-2 px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\\\"\\n          />\\n          <button\\n            type=\\\"submit\\\"\\n            className=\\\"inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-md bg-[#1E3A5F] hover:bg-[#162B47] text-white text-xs font-semibold cursor-pointer\\\"\\n          >\\n            <Plus className=\\\"w-4 h-4\\\" />\\n            {editingId ? \'Update Opportunity\' : \'Save Opportunity\'}\\n          </button>\\n        </div>\\n      </form>\\n\\n      {/* Filters */}\\n      <div className=\\\"flex flex-wrap items-center gap-3\\\">\\n        <div className=\\\"relative flex-1 min-w-[200px]\\\">\\n          <Search className=\\\"w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2\\\" />\\n          <input\\n            type=\\\"text\\\"\\n            placeholder=\\\"Search by title, organization, or notes...\\\"\\n            value={searchQuery}\\n            onChange={(e) => setSearchQuery(e.target.value)}\\n            className=\\\"w-full pl-8 pr-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white\\\"\\n          />\\n        </div>\\n        <select\\n          value={filterType}\\n          onChange={(e) => setFilterType(e.target.value)}\\n          className=\\\"px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white\\\"\\n        >\\n          <option value=\\\"all\\\">All Opportunity Types</option>\\n          {OPPORTUNITY_TYPES.map((t) => (\\n            <option key={t.value} value={t.value}>\\n              {t.label}\\n            </option>\\n          ))}\\n        </select>\\n        <select\\n          value={filterStatus}\\n          onChange={(e) => setFilterStatus(e.target.value)}\\n          className=\\\"px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white\\\"\\n        >\\n          <option value=\\\"all\\\">All Statuses</option>\\n          {OPPORTUNITY_STATUSES.map((s) => (\\n            <option key={s.value} value={s.value}>\\n              {s.label}\\n            </option>\\n          ))}\\n        </select>\\n      </div>\\n\\n      {/* List */}\\n      <div className=\\\"space-y-3\\\">\\n        {filtered.length === 0 ? (\\n          <div className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-8 text-center text-xs text-slate-500\\\">\\n            No matching opportunities found. Add a job, internship, exam, scholarship, or admission above.\\n          </div>\\n        ) : (\\n          filtered.map((opp) => {\\n            const urgent =\\n              isDeadlineSoon(opp.deadline) &&\\n              opp.status !== \'offer\' &&\\n              opp.status !== \'rejected\' &&\\n              opp.status !== \'closed\';\\n            return (\\n              <div\\n                key={opp.id}\\n                className=\\\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\"\\n              >\\n                <div className=\\\"space-y-1\\\">\\n                  <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n                    <h3 className=\\\"text-sm font-bold text-slate-900 dark:text-white\\\">\\n                      {opp.title}\\n                    </h3>\\n                    <span className=\\\"text-[11px] font-semibold px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 capitalize\\\">\\n                      {opp.type}\\n                    </span>\\n                    {urgent && (\\n                      <span className=\\\"inline-flex items-center gap-1 text-[11px] font-semibold px-2 py-0.5 rounded bg-amber-100 text-amber-900 border border-amber-300\\\">\\n                        <AlertTriangle className=\\\"w-3 h-3\\\" />\\n                        Due within 7 days ({opp.deadline})\\n                      </span>\\n                    )}\\n                  </div>\\n                  <p className=\\\"text-xs font-medium text-slate-600 dark:text-slate-300\\\">\\n                    {opp.organization}\\n                  </p>\\n                  {opp.notes && (\\n                    <p className=\\\"text-xs text-slate-500 dark:text-slate-400\\\">{opp.notes}</p>\\n                  )}\\n                  <div className=\\\"flex flex-wrap items-center gap-4 text-[11px] text-slate-400 pt-1\\\">\\n                    {opp.deadline && (\\n                      <span className=\\\"inline-flex items-center gap-1\\\">\\n                        <Calendar className=\\\"w-3 h-3\\\" /> Deadline: {opp.deadline}\\n                      </span>\\n                    )}\\n                    {opp.appliedDate && <span>Added: {opp.appliedDate}</span>}\\n                  </div>\\n                </div>\\n\\n                <div className=\\\"flex flex-wrap items-center gap-2 self-start sm:self-center\\\">\\n                  <select\\n                    value={opp.status}\\n                    onChange={(e) =>\\n                      handleQuickStatusChange(opp, e.target.value as OpportunityStatus)\\n                    }\\n                    className=\\\"px-2.5 py-1.5 text-xs font-semibold rounded border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-200\\\"\\n                  >\\n                    {OPPORTUNITY_STATUSES.map((s) => (\\n                      <option key={s.value} value={s.value}>\\n                        {s.label}\\n                      </option>\\n                    ))}\\n                  </select>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => handleEdit(opp)}\\n                    className=\\\"p-1.5 rounded border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer\\\"\\n                    title=\\\"Edit\\\"\\n                  >\\n                    <Edit2 className=\\\"w-3.5 h-3.5\\\" />\\n                  </button>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => handleDelete(opp.id)}\\n                    className=\\\"p-1.5 rounded border border-slate-200 dark:border-slate-700 text-red-600 hover:bg-red-50 dark:hover:bg-red-950/30 cursor-pointer\\\"\\n                    title=\\\"Delete\\\"\\n                  >\\n                    <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                  </button>\\n                </div>\\n              </div>\\n            );\\n          })\\n        )}\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Update TrackerPage to use the universal Opportunity model and session-scoped listOpportunities/saveOpportunity/deleteOpportunity\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/TrackerPage.tsx\", \"toolAction\":\"Updating TrackerPage component\", \"toolSummary\":\"Update TrackerPage.tsx for universal Opportunity model\"}"
      original_name: "write_to_file"
    }
    stop_reason: STOP_REASON_STOP_PATTERN
    provider_assigned_message_id: "YGf0auGJMLe6xN8Pk5KjiQo"
  }
