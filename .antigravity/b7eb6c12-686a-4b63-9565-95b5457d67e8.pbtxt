      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Update index.html meta description to match universal metadata.json\", \"EndLine\":11, \"Instruction\":\"Update description and og:description in index.html\", \"ReplacementContent\":\"    <title>Career Compass \342\200\224 AI Career Guidance & Resume Builder</title>\\n    <meta name=\\\"description\\\" content=\\\"AI-powered career guidance, resume builder, interview preparation, and opportunity tracker for everyone across all fields.\\\" />\\n    <meta property=\\\"og:title\\\" content=\\\"Career Compass \342\200\224 AI Career Guidance & Resume Builder\\\" />\\n    <meta property=\\\"og:description\\\" content=\\\"AI-powered career guidance, resume builder, interview preparation, and opportunity tracker for everyone across all fields.\\\" />\", \"StartLine\":6, \"TargetContent\":\"    <title>Career Compass \342\200\224 AI Career Guidance & Resume Builder</title>\\n    <meta name=\\\"description\\\" content=\\\"AI-powered career guidance, ATS resume builder, mock interview preparation, and placement tracker for college students.\\\" />\\n    <meta property=\\\"og:title\\\" content=\\\"Career Compass \342\200\224 AI Career Guidance & Resume Builder\\\" />\\n    <meta property=\\\"og:description\\\" content=\\\"AI-powered career guidance, ATS resume builder, mock interview preparation, and placement tracker for college students.\\\" />\", \"TargetFile\":\"/index.html\", \"toolAction\":\"Updating index.html meta tags\", \"toolSummary\":\"Update index.html meta description to universal copy\"}"
