      thinking_signature: "\022\271\n\n\266\n\001i\024}\023\222\322\235,\244\224\335\311\273F\343\244\n\344@\367\226B\342\023R\"\261R.\315\215\322\'\000\350\323\307\231\357\241,\247Z7\223\366\177\237zB\033\2246\ribDV\307\235u(\233\242W \215\b\240\347\263\207ub=,!\200\3609\275\304\2445\035\332\b\001\016\204}n\203J$w\377R\355\036d\207q\342\227\202\030#\235\224\266%R%\222\3434\200\364\362\271\257\366\356`\035\274\2360\036\362\006\360!@O\352|\340\245\377M\233z\b\231v7}0\3104\230Q\272f\036\371qA%|\313\357`\024l\3127\215\214G\032`\026$\343\323\377\221=D\276\347\206\2623-9[ys\2314Nm\265\243\360q\b\000F\225\a\265\310\255_\003\265D:?\227\241\177\004`\017\312_\274\r/\300\225q\221\256r\250N\264\332\002\177%{\224u/\255\217\271${)\273\343o+*\376\2600=\360zL\311\301\274\325\323/\217\205\221@\355S\034L\214\270\271\244A8\225j\031\222\307\350\\\367\213\354h\310\237]<,\254\312\005\002\234\235\rz<4v\000\'\232\257\342\310\205j\370\"\276\244\'[\375}\\k\374\255\370#If\017st\253\312%6\177\330\252\214\006Te\000\004_\333\312\024f\224\310P\303\026\355\211\260\b\325\222\254\356\036\032\005\354Q5\243;\220\357\341f\376\023Z\366qyBAg\355vmY\315@\313\020\211D\236\177\247\364&6\274x\256\236p\257\307`\213[Q5\317x,H\335B\307\027\366pH\021.&\016\327\336\3650\255\235\264\207\221\317\225\b)\210\037X\332\304\317\024r/\221\377\2016N\227\b/o\362kD\t\241K\243\245\214qC\342\037[\215 \002\351\213\tP \274\335\245\253\216\'\277\204pl\016\016\332\273\f\'S\204\237QQ:\204*/\376\201\371b\023\311\003\227Q\006\atJ\374\251\337\313&\335g\356O\260H\260{\374\244`\240\177\374\024\364\224\254\302\027\357*\006\257B\2127\227;\003\271\362(\300M\244\275\272\357\244t\r*\366\371\v\207\224G\275\331b\316\244\243\017\351mv/\314);\244\241\036\001\361\267\251\266\363\377\252\211BS\235\353\271\016\f\005\036\372\003\200\355\021,\006\247\327\320P\r\374+\361\327\235\201\260\342\327@\3367Q\347Q\303\306F\213\225\322\b\016{c\361\342\260\354\030t\352.D/\256\203\345\256B\263\232,ER\211\257\225t\216~\177\354\021V&\265*\334\370\006\271\333\377