  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport { useAuth } from \'../context/AuthContext\';\nimport {\n  getResume,\n  saveResume,\n  getLastResumeReview,\n  saveResumeReview,\n  getProfile,\n} from \'../services/db\';\nimport { reviewResume } from \'../services/ai\';\nimport {\n  Resume,\n  ResumeMode,\n  EducationItem,\n  ExperienceItem,\n  ProjectItem,\n  OptionalSection,\n  OptionalSectionType,\n} from \'../types\';\nimport { ResumeReviewOutput, ResumeReviewSuggestion } from \'../types/ai\';\nimport { ResumeLivePreview } from \'../components/resume/ResumeLivePreview\';\nimport { exportResumeToPdf } from \'../utils/pdfExport\';\nimport {\n  FileText,\n  Download,\n  Sparkles,\n  Plus,\n  Trash2,\n  CheckCircle2,\n  AlertCircle,\n  Loader2,\n  Save,\n  Wand2,\n} from \'lucide-react\';\n\nconst EMPTY_RESUME: Omit<Resume, \'userId\'> = {\n  mode: \'fresher\',\n  personal: {\n    name: \'\',\n    email: \'\',\n    phone: \'\',\n    location: \'\',\n    links: [\'\'],\n  },\n  summary: \'\',\n  education: [\n    {\n      degree: \'\',\n      institution: \'\',\n      startYear: \'\',\n      endYear: \'\',\n      scoreOrCgpa: \'\',\n    },\n  ],\n  experience: [],\n  projects: [\n    {\n      title: \'\',\n      techStack: [],\n      link: \'\',\n      description: \'\',\n    },\n  ],\n  skills: [],\n  certifications: [],\n  optionalSections: [],\n};\n\nconst OPTIONAL_SECTION_LABELS: Record<OptionalSectionType, string> = {\n  volunteering: \'Volunteering & Community Work\',\n  languages: \'Spoken & Written Languages\',\n  achievements: \'Awards & Achievements\',\n  publications: \'Publications & Research Papers\',\n  extracurricular: \'Leadership & Extracurriculars\',\n};\n\nexport const ResumePage: React.FC = () => {\n  const { user } = useAuth();\n  const [resume, setResume] = useState<Resume>({\n    ...EMPTY_RESUME,\n    userId: user?.id || \'\',\n  });\n  const [skillsInput, setSkillsInput] = useState(\'\');\n  const [certsInput, setCertsInput] = useState(\'\');\n  const [linksInput, setLinksInput] = useState(\'\');\n  const [review, setReview] = useState<ResumeReviewOutput | null>(null);\n  const [isReviewing, setIsReviewing] = useState(false);\n  const [reviewError, setReviewError] = useState<string | null>(null);\n  const [saveToast, setSaveToast] = useState<string | null>(null);\n  const [appliedIndexes, setAppliedIndexes] = useState<number[]>([]);\n  const [targetRoleHint, setTargetRoleHint] = useState(\'\');\n\n  useEffect(() => {\n    let active = true;\n    async function load() {\n      if (!user) return;\n      const [existing, savedReview, prof] = await Promise.all([\n        getResume(),\n        getLastResumeReview(),\n        getProfile(),\n      ]);\n      if (!active) return;\n\n      if (prof?.careerGoal) {\n        setTargetRoleHint(prof.careerGoal);\n      }\n\n      if (existing) {\n        setResume(existing);\n        setSkillsInput(existing.skills.join(\', \'));\n        setCertsInput(existing.certifications.join(\'\\n\'));\n        setLinksInput((existing.personal.links || []).join(\', \'));\n      } else {\n        const seeded: Resume = {\n          ...EMPTY_RESUME,\n          userId: user.id,\n          personal: {\n            ...EMPTY_RESUME.personal,\n            name: user.name,\n            email: user.email,\n            location: prof?.country || \'\',\n          },\n        };\n        setResume(seeded);\n      }\n      if (savedReview) {\n        setReview(savedReview);\n      }\n    }\n    load();\n    return () => {\n      active = false;\n    };\n  }, [user]);\n\n  if (!user) return null;\n\n  const syncResumeDraft = (\n    draft: Resume,\n    rawSkills = skillsInput,\n    rawCerts = certsInput,\n    rawLinks = linksInput\n  ): Resume => {\n    const parsedSkills = rawSkills\n      .split(\',\')\n      .map((s) => s.trim())\n      .filter(Boolean);\n    const parsedCerts = rawCerts\n      .split(\'\\n\')\n      .map((c) => c.trim())\n      .filter(Boolean);\n    const parsedLinks = rawLinks\n      .split(\',\')\n      .map((l) => l.trim())\n      .filter(Boolean);\n\n    return {\n      ...draft,\n      personal: {\n        ...draft.personal,\n        links: parsedLinks,\n      },\n      skills: parsedSkills,\n      certifications: parsedCerts,\n    };\n  };\n\n  const handleSave = async () => {\n    try {\n      const updated = syncResumeDraft(resume);\n      const saved = await saveResume(updated);\n      setResume(saved);\n      setSaveToast(\'Resume saved.\');\n      setTimeout(() => setSaveToast(null), 2500);\n    } catch (err: unknown) {\n      setReviewError(err instanceof Error ? err.message : \'Failed to save resume.\');\n    }\n  };\n\n  const handleDownloadPdf = async () => {\n    const updated = syncResumeDraft(resume);\n    const saved = await saveResume(updated);\n    setResume(saved);\n    exportResumeToPdf(saved);\n  };\n\n  const handleRunAiReview = async () => {\n    setReviewError(null);\n    const updated = syncResumeDraft(resume);\n    const saved = await saveResume(updated);\n    setResume(saved);\n\n    const hasContent =\n      saved.summary.trim().length > 10 ||\n      saved.education.some((e) => e.degree.trim()) ||\n      saved.projects.some((p) => p.title.trim()) ||\n      saved.experience.some((ex) => ex.role.trim());\n\n    if (!hasContent) {\n      setReviewError(\n        \'Please add a brief summary, education, or at least one project/experience before requesting an AI review.\'\n      );\n      return;\n    }\n\n    setIsReviewing(true);\n    setAppliedIndexes([]);\n    try {\n      const result = await reviewResume(saved, {\n        targetRole: targetRoleHint || \'General Role\',\n        experienceLevel: saved.mode,\n      });\n      setReview(result);\n      await saveResumeReview(result);\n      await saveResume({ ...saved, lastScore: result.score });\n      setResume((prev) => ({ ...prev, lastScore: result.score }));\n    } catch (err: unknown) {\n      setReviewError(\n        err instanceof Error ? err.message : \'Could not complete AI review. Please try again.\'\n      );\n    } finally {\n      setIsReviewing(false);\n    }\n  };\n\n  const handleApplySuggestion = async (suggestion: ResumeReviewSuggestion, idx: number) => {\n    const sec = suggestion.section.toLowerCase();\n    const updated = syncResumeDraft(resume);\n\n    if (sec.includes(\'summary\') || sec.includes(\'objective\') || sec.includes(\'profile\')) {\n      updated.summary = suggestion.improvedText;\n    } else if (sec.includes(\'project\') && updated.projects.length > 0) {\n      updated.projects = updated.projects.map((p, i) =>\n        i === 0 ? { ...p, description: suggestion.improvedText } : p\n      );\n    } else if (sec.includes(\'experience\') && updated.experience.length > 0) {\n      updated.experience = updated.experience.map((e, i) =>\n        i === 0 ? { ...e, description: suggestion.improvedText } : e\n      );\n    } else if (sec.includes(\'skill\')) {\n      const extraSkills = suggestion.improvedText\n        .split(/[,\342\200\242|]/)\n        .map((s) => s.trim())\n        .filter(Boolean);\n      const merged = Array.from(new Set([...updated.skills, ...extraSkills]));\n      updated.skills = merged;\n      setSkillsInput(merged.join(\', \'));\n    } else {\n      updated.summary = updated.summary\n        ? `${updated.summary}\\n${suggestion.improvedText}`\n        : suggestion.improvedText;\n    }\n\n    const saved = await saveResume(updated);\n    setResume(saved);\n    setAppliedIndexes((prev) => [...prev, idx]);\n    setSaveToast(`Applied suggestion to ${suggestion.section}`);\n    setTimeout(() => setSaveToast(null), 2500);\n  };\n\n  const updateEducation = (idx: number, field: keyof EducationItem, value: string) => {\n    const next = [...resume.education];\n    next[idx] = { ...next[idx], [field]: value };\n    setResume({ ...resume, education: next });\n  };\n\n  const updateExperience = (idx: number, field: keyof ExperienceItem, value: string) => {\n    const next = [...resume.experience];\n    next[idx] = { ...next[idx], [field]: value };\n    setResume({ ...resume, experience: next });\n  };\n\n  const updateProject = (idx: number, field: keyof ProjectItem, value: string | string[]) => {\n    const next = [...resume.projects];\n    next[idx] = { ...next[idx], [field]: value };\n    setResume({ ...resume, projects: next });\n  };\n\n  const addOptionalSection = (type: OptionalSectionType) => {\n    if (resume.optionalSections.some((s) => s.type === type)) return;\n    const next: OptionalSection[] = [\n      ...resume.optionalSections,\n      { type, title: OPTIONAL_SECTION_LABELS[type], items: [\'\'] },\n    ];\n    setResume({ ...resume, optionalSections: next });\n  };\n\n  const updateOptionalItems = (type: OptionalSectionType, rawText: string) => {\n    const next = resume.optionalSections.map((sec) =>\n      sec.type === type ? { ...sec, items: rawText.split(\'\\n\') } : sec\n    );\n    setResume({ ...resume, optionalSections: next });\n  };\n\n  const removeOptionalSection = (type: OptionalSectionType) => {\n    setResume({\n      ...resume,\n      optionalSections: resume.optionalSections.filter((s) => s.type !== type),\n    });\n  };\n\n  const liveResume = syncResumeDraft(resume);\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-5\">\n        <div>\n          <div className=\"flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#1E3A5F] dark:text-amber-400\">\n            <FileText className=\"w-4 h-4\" />\n            <span>Single-Column ATS-Safe Builder</span>\n          </div>\n          <h1 className=\"text-2xl font-bold text-slate-900 dark:text-white mt-1\">\n            Resume Builder & AI Review\n          </h1>\n          <p className=\"text-sm text-slate-600 dark:text-slate-400 mt-0.5\">\n            Choose a layout mode for your career stage, preview in real time, and export a clean A4 PDF.\n          </p>\n        </div>\n\n        <div className=\"flex flex-wrap items-center gap-2.5\">\n          {saveToast && (\n            <span className=\"inline-flex items-center gap-1.5 text-xs font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded-md\">\n              <CheckCircle2 className=\"w-3.5 h-3.5\" />\n              {saveToast}\n            </span>\n          )}\n          <button\n            type=\"button\"\n            onClick={handleSave}\n            className=\"inline-flex items-center gap-1.5 px-3.5 py-2 rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-semibold transition-colors cursor-pointer\"\n          >\n            <Save className=\"w-4 h-4\" />\n            Save Draft\n          </button>\n          <button\n            type=\"button\"\n            onClick={handleRunAiReview}\n            disabled={isReviewing}\n            className=\"inline-flex items-center gap-1.5 px-3.5 py-2 rounded-md border border-[#1E3A5F] bg-[#1E3A5F]/5 hover:bg-[#1E3A5F]/10 text-[#1E3A5F] dark:text-amber-300 text-xs font-semibold transition-colors disabled:opacity-60 cursor-pointer\"\n          >\n            {isReviewing ? (\n              <>\n                <Loader2 className=\"w-4 h-4 animate-spin\" />\n                Reviewing...\n              </>\n            ) : (\n              <>\n                <Sparkles className=\"w-4 h-4\" />\n                Review Resume with AI\n              </>\n            )}\n          </button>\n          <button\n            type=\"button\"\n            onClick={handleDownloadPdf}\n            className=\"inline-flex items-center gap-1.5 px-4 py-2 rounded-md bg-[#1E3A5F] hover:bg-[#162B47] text-white text-xs font-semibold transition-colors cursor-pointer\"\n          >\n            <Download className=\"w-4 h-4\" />\n            Download PDF\n          </button>\n        </div>\n      </div>\n\n      {/* Mode Switcher */}\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div>\n          <span className=\"text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400\">\n            Resume Mode\n          </span>\n          <p className=\"text-xs text-slate-600 dark:text-slate-400 mt-0.5\">\n            Automatically orders sections based on what hiring teams look for first.\n          </p>\n        </div>\n        <div className=\"inline-flex rounded-md border border-slate-200 dark:border-slate-700 p-1 bg-slate-50 dark:bg-slate-800/60\">\n          {(\n            [\n              { id: \'fresher\', label: \'Fresher / Entry-Level\' },\n              { id: \'experienced\', label: \'Experienced Professional\' },\n              { id: \'academic\', label: \'Academic / Research CV\' },\n            ] as { id: ResumeMode; label: string }[]\n          ).map((m) => (\n            <button\n              key={m.id}\n              type=\"button\"\n              onClick={() => setResume({ ...resume, mode: m.id })}\n              className={`px-3 py-1.5 rounded text-xs font-semibold transition-colors cursor-pointer ${\n                resume.mode === m.id\n                  ? \'bg-[#1E3A5F] text-white\'\n                  : \'text-slate-600 dark:text-slate-300 hover:text-slate-900\'\n              }`}\n            >\n              {m.label}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {reviewError && (\n        <div className=\"bg-red-50 border border-red-200 rounded-lg p-4 flex items-center justify-between gap-3 text-xs text-red-800\">\n          <div className=\"flex items-center gap-2\">\n            <AlertCircle className=\"w-4 h-4 text-red-600 shrink-0\" />\n            <span>{reviewError}</span>\n          </div>\n          <button\n            type=\"button\"\n            onClick={handleRunAiReview}\n            className=\"px-3 py-1 rounded bg-red-600 text-white font-semibold hover:bg-red-700 cursor-pointer shrink-0\"\n          >\n            Retry\n          </button>\n        </div>\n      )}\n\n      {/* AI Review Drawer */}\n      {review && (\n        <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-5 shadow-xs space-y-4\">\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-4\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-12 h-12 rounded-lg bg-[#1E3A5F] text-white flex flex-col items-center justify-center font-bold\">\n                <span className=\"text-lg leading-none\">{review.score}</span>\n                <span className=\"text-[9px] uppercase tracking-wider opacity-80\">/100</span>\n              </div>\n              <div>\n                <h2 className=\"text-base font-bold text-slate-900 dark:text-white\">\n                  AI Resume Review Scorecard\n                </h2>\n                <p className=\"text-xs text-slate-500\">\n                  Actionable feedback and missing keywords for your target path.\n                </p>\n              </div>\n            </div>\n            {review.keywordsMissing.length > 0 && (\n              <div className=\"flex flex-wrap items-center gap-1.5\">\n                <span className=\"text-[11px] font-semibold text-amber-800 dark:text-amber-300 mr-1\">\n                  Missing Keywords:\n                </span>\n                {review.keywordsMissing.map((kw, i) => (\n                  <span\n                    key={i}\n                    className=\"text-[11px] bg-amber-50 dark:bg-amber-950/50 text-amber-900 dark:text-amber-200 border border-amber-200 dark:border-amber-800 px-2 py-0.5 rounded\"\n                  >\n                    + {kw}\n                  </span>\n                ))}\n              </div>\n            )}\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 text-xs\">\n            <div className=\"bg-emerald-50/60 dark:bg-emerald-950/20 border border-emerald-200 dark:border-emerald-900/50 rounded-md p-3.5\">\n              <h3 className=\"font-bold text-emerald-950 dark:text-emerald-300 uppercase tracking-wider mb-2\">\n                Strengths\n              </h3>\n              <ul className=\"space-y-1 text-emerald-900 dark:text-emerald-200 list-disc list-inside\">\n                {review.strengths.map((s, i) => (\n                  <li key={i}>{s}</li>\n                ))}\n              </ul>\n            </div>\n            <div className=\"bg-amber-50/60 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-900/50 rounded-md p-3.5\">\n              <h3 className=\"font-bold text-amber-950 dark:text-amber-300 uppercase tracking-wider mb-2\">\n                Areas to Improve\n              </h3>\n              <ul className=\"space-y-1 text-amber-900 dark:text-amber-200 list-disc list-inside\">\n                {review.weaknesses.map((w, i) => (\n                  <li key={i}>{w}</li>\n                ))}\n              </ul>\n            </div>\n          </div>\n\n          {review.suggestions.length > 0 && (\n            <div>\n              <h3 className=\"text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2.5\">\n                One-Click Improvements\n              </h3>\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n                {review.suggestions.map((sug, idx) => {\n                  const isApplied = appliedIndexes.includes(idx);\n                  return (\n                    <div\n                      key={idx}\n                      className=\"border border-slate-200 dark:border-slate-800 rounded-md p-3.5 bg-slate-50/60 dark:bg-slate-800/40 flex flex-col justify-between gap-2.5 text-xs\"\n                    >\n                      <div>\n                        <span className=\"inline-block text-[10px] font-bold uppercase tracking-wider text-[#1E3A5F] dark:text-amber-300 bg-[#1E3A5F]/10 px-2 py-0.5 rounded mb-1.5\">\n                          {sug.section}\n                        </span>\n                        <p className=\"text-slate-600 dark:text-slate-400 mb-1.5\">\n                          <strong className=\"text-slate-800 dark:text-slate-200\">Issue:</strong>{\' \'}\n                          {sug.issue}\n                        </p>\n                        <p className=\"text-slate-800 dark:text-slate-200 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded p-2\">\n                          <strong className=\"text-emerald-700 dark:text-emerald-400\">\n                            Suggested Text:\n                          </strong>{\' \'}\n                          {sug.improvedText}\n                        </p>\n                      </div>\n                      <button\n                        type=\"button\"\n                        disabled={isApplied}\n                        onClick={() => handleApplySuggestion(sug, idx)}\n                        className=\"self-start inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-[#1E3A5F] hover:bg-[#162B47] disabled:bg-emerald-700 text-white font-semibold text-xs transition-colors cursor-pointer\"\n                      >\n                        <Wand2 className=\"w-3.5 h-3.5\" />\n                        {isApplied ? \'Applied to Resume\' : \'Apply Suggestion\'}\n                      </button>\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* Split Screen Editor + Live Preview */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n        <div className=\"lg:col-span-6 space-y-5\">\n          {/* Personal Details */}\n          <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-5 space-y-3.5\">\n            <h2 className=\"text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider\">\n              1. Contact Information\n            </h2>\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n              <div>\n                <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1\">\n                  Full Name\n                </label>\n                <input\n                  type=\"text\"\n                  value={resume.personal.name}\n                  onChange={(e) =>\n                    setResume({\n                      ...resume,\n                      personal: { ...resume.personal, name: e.target.value },\n                    })\n                  }\n                  className=\"w-full px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1\">\n                  Email\n                </label>\n                <input\n                  type=\"email\"\n                  value={resume.personal.email}\n                  onChange={(e) =>\n                    setResume({\n                      ...resume,\n                      personal: { ...resume.personal, email: e.target.value },\n                    })\n                  }\n                  className=\"w-full px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1\">\n                  Phone\n                </label>\n                <input\n                  type=\"text\"\n                  value={resume.personal.phone}\n                  onChange={(e) =>\n                    setResume({\n                      ...resume,\n                      personal: { ...resume.personal, phone: e.target.value },\n                    })\n                  }\n                  className=\"w-full px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1\">\n                  City & Country\n                </label>\n                <input\n                  type=\"text\"\n                  value={resume.personal.location}\n                  onChange={(e) =>\n                    setResume({\n                      ...resume,\n                      personal: { ...resume.personal, location: e.target.value },\n                    })\n                  }\n                  className=\"w-full px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                />\n              </div>\n              <div className=\"sm:col-span-2\">\n                <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1\">\n                  Portfolio / Profile Links (comma-separated)\n                </label>\n                <input\n                  type=\"text\"\n                  value={linksInput}\n                  onChange={(e) => setLinksInput(e.target.value)}\n                  placeholder=\"linkedin.com/in/yourname, portfolio.example.com\"\n                  className=\"w-full px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                />\n              </div>\n            </div>\n          </div>\n\n          {/* Summary */}\n          <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-5 space-y-2\">\n            <h2 className=\"text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider\">\n              2. Professional Summary\n            </h2>\n            <textarea\n              rows={3}\n              value={resume.summary}\n              onChange={(e) => setResume({ ...resume, summary: e.target.value })}\n              placeholder=\"Write 2\342\200\2233 clear sentences summarizing your background, strengths, and career goal...\"\n              className=\"w-full px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n            />\n          </div>\n\n          {/* Education */}\n          <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-5 space-y-3\">\n            <div className=\"flex items-center justify-between\">\n              <h2 className=\"text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider\">\n                3. Education\n              </h2>\n              <button\n                type=\"button\"\n                onClick={() =>\n                  setResume({\n                    ...resume,\n                    education: [\n                      ...resume.education,\n                      { degree: \'\', institution: \'\', startYear: \'\', endYear: \'\', scoreOrCgpa: \'\' },\n                    ],\n                  })\n                }\n                className=\"inline-flex items-center gap-1 text-xs font-semibold text-[#1E3A5F] dark:text-amber-400 cursor-pointer\"\n              >\n                <Plus className=\"w-3.5 h-3.5\" /> Add Education\n              </button>\n            </div>\n            {resume.education.map((edu, idx) => (\n              <div\n                key={idx}\n                className=\"p-3.5 rounded-md border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/40 space-y-2.5\"\n              >\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"text-xs font-semibold text-slate-600 dark:text-slate-300\">\n                    Qualification #{idx + 1}\n                  </span>\n                  {resume.education.length > 1 && (\n                    <button\n                      type=\"button\"\n                      onClick={() =>\n                        setResume({\n                          ...resume,\n                          education: resume.education.filter((_, i) => i !== idx),\n                        })\n                      }\n                      className=\"text-red-600 hover:text-red-700 text-xs inline-flex items-center gap-1 cursor-pointer\"\n                    >\n                      <Trash2 className=\"w-3.5 h-3.5\" /> Remove\n                    </button>\n                  )}\n                </div>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\">\n                  <input\n                    type=\"text\"\n                    placeholder=\"Degree / Diploma / School Certificate\"\n                    value={edu.degree}\n                    onChange={(e) => updateEducation(idx, \'degree\', e.target.value)}\n                    className=\"sm:col-span-2 px-3 py-1.5 text-xs rounded border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                  />\n                  <input\n                    type=\"text\"\n                    placeholder=\"Institution / School / University\"\n                    value={edu.institution}\n                    onChange={(e) => updateEducation(idx, \'institution\', e.target.value)}\n                    className=\"sm:col-span-2 px-3 py-1.5 text-xs rounded border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                  />\n                  <input\n                    type=\"text\"\n                    placeholder=\"Start Year\"\n                    value={edu.startYear}\n                    onChange={(e) => updateEducation(idx, \'startYear\', e.target.value)}\n                    className=\"px-3 py-1.5 text-xs rounded border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                  />\n                  <input\n                    type=\"text\"\n                    placeholder=\"End Year\"\n                    value={edu.endYear}\n                    onChange={(e) => updateEducation(idx, \'endYear\', e.target.value)}\n                    className=\"px-3 py-1.5 text-xs rounded border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                  />\n                  <input\n                    type=\"text\"\n                    placeholder=\"Grade / Percentage / CGPA\"\n                    value={edu.scoreOrCgpa}\n                    onChange={(e) => updateEducation(idx, \'scoreOrCgpa\', e.target.value)}\n                    className=\"sm:col-span-2 px-3 py-1.5 text-xs rounded border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                  />\n                </div>\n              </div>\n            ))}\n          </div>\n\n          {/* Experience */}\n          <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-5 space-y-3\">\n            <div className=\"flex items-center justify-between\">\n              <h2 className=\"text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider\">\n                4. Work, Internships & Practical Experience\n              </h2>\n              <button\n                type=\"button\"\n                onClick={() =>\n                  setResume({\n                    ...resume,\n                    experience: [\n                      ...resume.experience,\n                      {\n                        role: \'\',\n                        company: \'\',\n                        location: \'\',\n                        startDate: \'\',\n                        endDate: \'\',\n                        description: \'\',\n                      },\n                    ],\n                  })\n                }\n                className=\"inline-flex items-center gap-1 text-xs font-semibold text-[#1E3A5F] dark:text-amber-400 cursor-pointer\"\n              >\n                <Plus className=\"w-3.5 h-3.5\" /> Add Experience\n              </button>\n            </div>\n            {resume.experience.map((exp, idx) => (\n              <div\n                key={idx}\n                className=\"p-3.5 rounded-md border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/40 space-y-2.5\"\n              >\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"text-xs font-semibold text-slate-600 dark:text-slate-300\">\n                    Role #{idx + 1}\n                  </span>\n                  <button\n                    type=\"button\"\n                    onClick={() =>\n                      setResume({\n                        ...resume,\n                        experience: resume.experience.filter((_, i) => i !== idx),\n                      })\n                    }\n                    className=\"text-red-600 hover:text-red-700 text-xs inline-flex items-center gap-1 cursor-pointer\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" /> Remove\n                  </button>\n                </div>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\">\n                  <input\n                    type=\"text\"\n                    placeholder=\"Role Title\"\n                    value={exp.role}\n                    onChange={(e) => updateExperience(idx, \'role\', e.target.value)}\n                    className=\"px-3 py-1.5 text-xs rounded border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                  />\n                  <input\n                    type=\"text\"\n                    placeholder=\"Organization / Hospital / Firm / Company\"\n                    value={exp.company}\n                    onChange={(e) => updateExperience(idx, \'company\', e.target.value)}\n                    className=\"px-3 py-1.5 text-xs rounded border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                  />\n                  <input\n                    type=\"text\"\n                    placeholder=\"Start Date (e.g., May 2025)\"\n                    value={exp.startDate}\n                    onChange={(e) => updateExperience(idx, \'startDate\', e.target.value)}\n                    className=\"px-3 py-1.5 text-xs rounded border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                  />\n                  <input\n                    type=\"text\"\n                    placeholder=\"End Date (or Present)\"\n                    value={exp.endDate}\n                    onChange={(e) => updateExperience(idx, \'endDate\', e.target.value)}\n                    className=\"px-3 py-1.5 text-xs rounded border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                  />\n                  <textarea\n                    rows={2}\n                    placeholder=\"What did you accomplish? Include numbers or measurable outcomes where possible.\"\n                    value={exp.description}\n                    onChange={(e) => updateExperience(idx, \'description\', e.target.value)}\n                    className=\"sm:col-span-2 px-3 py-1.5 text-xs rounded border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                  />\n                </div>\n              </div>\n            ))}\n          </div>\n\n          {/* Projects */}\n          <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-5 space-y-3\">\n            <div className=\"flex items-center justify-between\">\n              <h2 className=\"text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider\">\n                5. Projects, Case Studies & Research\n              </h2>\n              <button\n                type=\"button\"\n                onClick={() =>\n                  setResume({\n                    ...resume,\n                    projects: [\n                      ...resume.projects,\n                      { title: \'\', techStack: [], link: \'\', description: \'\' },\n                    ],\n                  })\n                }\n                className=\"inline-flex items-center gap-1 text-xs font-semibold text-[#1E3A5F] dark:text-amber-400 cursor-pointer\"\n              >\n                <Plus className=\"w-3.5 h-3.5\" /> Add Project\n              </button>\n            </div>\n            {resume.projects.map((proj, idx) => (\n              <div\n                key={idx}\n                className=\"p-3.5 rounded-md border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/40 space-y-2.5\"\n              >\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"text-xs font-semibold text-slate-600 dark:text-slate-300\">\n                    Project #{idx + 1}\n                  </span>\n                  <button\n                    type=\"button\"\n                    onClick={() =>\n                      setResume({\n                        ...resume,\n                        projects: resume.projects.filter((_, i) => i !== idx),\n                      })\n                    }\n                    className=\"text-red-600 hover:text-red-700 text-xs inline-flex items-center gap-1 cursor-pointer\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" /> Remove\n                  </button>\n                </div>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\">\n                  <input\n                    type=\"text\"\n                    placeholder=\"Project or Case Study Title\"\n                    value={proj.title}\n                    onChange={(e) => updateProject(idx, \'title\', e.target.value)}\n                    className=\"px-3 py-1.5 text-xs rounded border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                  />\n                  <input\n                    type=\"text\"\n                    placeholder=\"Tools, Methods, or Skills Used (comma-separated)\"\n                    value={proj.techStack.join(\', \')}\n                    onChange={(e) =>\n                      updateProject(\n                        idx,\n                        \'techStack\',\n                        e.target.value\n                          .split(\',\')\n                          .map((s) => s.trim())\n                          .filter(Boolean)\n                      )\n                    }\n                    className=\"px-3 py-1.5 text-xs rounded border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                  />\n                  <textarea\n                    rows={2}\n                    placeholder=\"Describe the problem you solved and the result.\"\n                    value={proj.description}\n                    onChange={(e) => updateProject(idx, \'description\', e.target.value)}\n                    className=\"sm:col-span-2 px-3 py-1.5 text-xs rounded border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                  />\n                </div>\n              </div>\n            ))}\n          </div>\n\n          {/* Skills & Certifications */}\n          <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-5 space-y-3\">\n            <h2 className=\"text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider\">\n              6. Skills & Certifications\n            </h2>\n            <div>\n              <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1\">\n                Skills (comma-separated)\n              </label>\n              <input\n                type=\"text\"\n                value={skillsInput}\n                onChange={(e) => setSkillsInput(e.target.value)}\n                placeholder=\"Patient Care, Financial Accounting, React, Public Speaking...\"\n                className=\"w-full px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1\">\n                Certifications & Licenses (one per line)\n              </label>\n              <textarea\n                rows={3}\n                value={certsInput}\n                onChange={(e) => setCertsInput(e.target.value)}\n                placeholder=\"First Aid & CPR Certified (2025)&#10;Full-Stack Web Development Certificate (2026)\"\n                className=\"w-full px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n              />\n            </div>\n          </div>\n\n          {/* Optional Sections */}\n          <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-5 space-y-3\">\n            <h2 className=\"text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider\">\n              7. Optional Sections\n            </h2>\n            <div className=\"flex flex-wrap gap-2\">\n              {(Object.keys(OPTIONAL_SECTION_LABELS) as OptionalSectionType[]).map((type) => {\n                const exists = resume.optionalSections.some((s) => s.type === type);\n                return (\n                  <button\n                    key={type}\n                    type=\"button\"\n                    disabled={exists}\n                    onClick={() => addOptionalSection(type)}\n                    className=\"px-2.5 py-1 rounded border border-slate-300 dark:border-slate-700 text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 disabled:opacity-40 cursor-pointer\"\n                  >\n                    + {OPTIONAL_SECTION_LABELS[type]}\n                  </button>\n                );\n              })}\n            </div>\n\n            {resume.optionalSections.map((sec) => (\n              <div\n                key={sec.type}\n                className=\"p-3.5 rounded-md border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/40 space-y-2\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-xs font-bold text-slate-800 dark:text-slate-200\">\n                    {sec.title}\n                  </span>\n                  <button\n                    type=\"button\"\n                    onClick={() => removeOptionalSection(sec.type)}\n                    className=\"text-xs text-red-600 hover:text-red-700 cursor-pointer\"\n                  >\n                    Remove\n                  </button>\n                </div>\n                <textarea\n                  rows={2}\n                  value={sec.items.join(\'\\n\')}\n                  onChange={(e) => updateOptionalItems(sec.type, e.target.value)}\n                  placeholder=\"Enter one item per line...\"\n                  className=\"w-full px-3 py-1.5 text-xs rounded border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n                />\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Live Preview Column */}\n        <div className=\"lg:col-span-6 lg:sticky lg:top-20 space-y-2\">\n          <div className=\"flex items-center justify-between text-xs text-slate-500 px-1\">\n            <span className=\"font-semibold uppercase tracking-wider\">Live A4 Print Preview</span>\n            <span>Single-Column \342\200\242 ATS-Readable</span>\n          </div>\n          <ResumeLivePreview resume={liveResume} />\n        </div>\n      </div>\n    </div>\n  );\n};\n"
