      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { BrowserRouter, Routes, Route, Navigate } from \'react-router-dom\';\\nimport { AuthProvider } from \'./context/AuthContext\';\\nimport { ProtectedRoute } from \'./components/auth/ProtectedRoute\';\\nimport { AppShell } from \'./components/layout/AppShell\';\\nimport { LandingPage } from \'./pages/LandingPage\';\\nimport { LoginPage } from \'./pages/LoginPage\';\\nimport { RegisterPage } from \'./pages/RegisterPage\';\\nimport { OnboardingPage } from \'./pages/OnboardingPage\';\\nimport { DashboardPage } from \'./pages/DashboardPage\';\\nimport { ProfilePage } from \'./pages/ProfilePage\';\\nimport { RecommendationsPage } from \'./pages/RecommendationsPage\';\\nimport { ResumePage } from \'./pages/ResumePage\';\\nimport { SkillsPage } from \'./pages/SkillsPage\';\\nimport { InterviewPage } from \'./pages/InterviewPage\';\\nimport { RoadmapPage } from \'./pages/RoadmapPage\';\\nimport { TrackerPage } from \'./pages/TrackerPage\';\\nimport { ResourcesPage } from \'./pages/ResourcesPage\';\\nimport { AdminPage } from \'./pages/AdminPage\';\\nimport { NotFoundPage } from \'./pages/NotFoundPage\';\\n\\nexport default function App() {\\n  return (\\n    <AuthProvider>\\n      <BrowserRouter>\\n        <Routes>\\n          {/* Public Routes */}\\n          <Route path=\\\"/\\\" element={<LandingPage />} />\\n          <Route path=\\\"/login\\\" element={<LoginPage />} />\\n          <Route path=\\\"/register\\\" element={<RegisterPage />} />\\n\\n          {/* 2-Minute Onboarding Wizard */}\\n          <Route\\n            path=\\\"/onboarding\\\"\\n            element={\\n              <ProtectedRoute>\\n                <OnboardingPage />\\n              </ProtectedRoute>\\n            }\\n          />\\n\\n          {/* Protected Application Routes */}\\n          <Route\\n            path=\\\"/dashboard\\\"\\n            element={\\n              <ProtectedRoute>\\n                <AppShell>\\n                  <DashboardPage />\\n                </AppShell>\\n              </ProtectedRoute>\\n            }\\n          />\\n          <Route\\n            path=\\\"/profile\\\"\\n            element={\\n              <ProtectedRoute>\\n                <AppShell>\\n                  <ProfilePage />\\n                </AppShell>\\n              </ProtectedRoute>\\n            }\\n          />\\n          <Route\\n            path=\\\"/career-ideas\\\"\\n            element={\\n              <ProtectedRoute>\\n                <AppShell>\\n                  <RecommendationsPage />\\n                </AppShell>\\n              </ProtectedRoute>\\n            }\\n          />\\n          {/* Keep /recommendations as alias to /career-ideas */}\\n          <Route path=\\\"/recommendations\\\" element={<Navigate to=\\\"/career-ideas\\\" replace />} />\\n          <Route\\n            path=\\\"/resume\\\"\\n            element={\\n              <ProtectedRoute>\\n                <AppShell>\\n                  <ResumePage />\\n                </AppShell>\\n              </ProtectedRoute>\\n            }\\n          />\\n          <Route\\n            path=\\\"/skills\\\"\\n            element={\\n              <ProtectedRoute>\\n                <AppShell>\\n                  <SkillsPage />\\n                </AppShell>\\n              </ProtectedRoute>\\n            }\\n          />\\n          <Route\\n            path=\\\"/interview\\\"\\n            element={\\n              <ProtectedRoute>\\n                <AppShell>\\n                  <InterviewPage />\\n                </AppShell>\\n              </ProtectedRoute>\\n            }\\n          />\\n          <Route\\n            path=\\\"/roadmap\\\"\\n            element={\\n              <ProtectedRoute>\\n                <AppShell>\\n                  <RoadmapPage />\\n                </AppShell>\\n              </ProtectedRoute>\\n            }\\n          />\\n          <Route\\n            path=\\\"/opportunities\\\"\\n            element={\\n              <ProtectedRoute>\\n                <AppShell>\\n                  <TrackerPage />\\n                </AppShell>\\n              </ProtectedRoute>\\n            }\\n          />\\n          {/* Keep /tracker as alias to /opportunities */}\\n          <Route path=\\\"/tracker\\\" element={<Navigate to=\\\"/opportunities\\\" replace />} />\\n          <Route\\n            path=\\\"/resources\\\"\\n            element={\\n              <ProtectedRoute>\\n                <AppShell>\\n                  <ResourcesPage />\\n                </AppShell>\\n              </ProtectedRoute>\\n            }\\n          />\\n\\n          {/* Admin-Only Route */}\\n          <Route\\n            path=\\\"/admin\\\"\\n            element={\\n              <ProtectedRoute allowedRole=\\\"admin\\\">\\n                <AppShell>\\n                  <AdminPage />\\n                </AppShell>\\n              </ProtectedRoute>\\n            }\\n          />\\n\\n          {/* 404 Not Found */}\\n          <Route path=\\\"*\\\" element={<NotFoundPage />} />\\n        </Routes>\\n      </BrowserRouter>\\n    </AuthProvider>\\n  );\\n}\\n\", \"Description\":\"Update App.tsx to wire all Section 2 routes (/onboarding, /career-ideas, /opportunities, /admin with allowedRole=\'admin\', and NotFoundPage on *)\", \"Overwrite\":true, \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Updating App.tsx routing table\", \"toolSummary\":\"Update App.tsx with all universal routes and 404 page\"}"
      original_name: "write_to_file"
