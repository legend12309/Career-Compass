  code_action {
    action_spec {
      create_file {
        instruction: "import { useEffect, useState } from \'react\';\nimport { Link } from \'react-router-dom\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { Profile, Skill, Opportunity, Resume, RoadmapPlan } from \'../types\';\nimport {\n  getProfile,\n  listSkills,\n  listOpportunities,\n  getResume,\n  getRoadmap,\n} from \'../services/db\';\nimport { en } from \'../i18n/en\';\nimport { AppShell } from \'../components/layout/AppShell\';\nimport {\n  Sparkles,\n  FileText,\n  MessageSquareCode,\n  Award,\n  Milestone,\n  Briefcase,\n  Edit3,\n  ArrowRight,\n  Compass,\n} from \'lucide-react\';\n\nexport function DashboardPage() {\n  const { user } = useAuth();\n  const [profile, setProfile] = useState<Profile | null>(null);\n  const [skills, setSkills] = useState<Skill[]>([]);\n  const [opportunities, setOpportunities] = useState<Opportunity[]>([]);\n  const [resume, setResume] = useState<Resume | null>(null);\n  const [roadmap, setRoadmap] = useState<RoadmapPlan | null>(null);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    async function load() {\n      if (!user) return;\n      setLoading(true);\n      try {\n        const [prof, sk, opps, res, rm] = await Promise.all([\n          getProfile(),\n          listSkills(),\n          listOpportunities(),\n          getResume(),\n          getRoadmap(),\n        ]);\n        setProfile(prof);\n        setSkills(sk);\n        setOpportunities(opps);\n        setResume(res);\n        setRoadmap(rm);\n      } catch (err) {\n        console.error(\'Error loading dashboard:\', err);\n      } finally {\n        setLoading(false);\n      }\n    }\n    load();\n  }, [user]);\n\n  const computeProfileCompletion = (): number => {\n    if (!profile) return 0;\n    const checks = [\n      Boolean(profile.currentStatus),\n      Boolean(profile.educationLevel?.trim()),\n      Boolean(profile.fieldOfStudy?.trim()),\n      (profile.interests?.length || 0) > 0,\n      Boolean(profile.careerGoal?.trim()),\n      Boolean(profile.bio?.trim()),\n    ];\n    return Math.round((checks.filter(Boolean).length / checks.length) * 100);\n  };\n\n  const computeRoadmapPercent = (): number => {\n    if (!roadmap?.data?.phases) return 0;\n    const allKeys: string[] = [];\n    roadmap.data.phases.forEach((ph, pIdx) => {\n      ph.topics.forEach((t, tIdx) => {\n        allKeys.push(`${pIdx}-${tIdx}-${t}`);\n      });\n    });\n    if (allKeys.length === 0) return 0;\n    const done = allKeys.filter((k) => roadmap.progress.includes(k)).length;\n    return Math.round((done / allKeys.length) * 100);\n  };\n\n  const profileCompletion = computeProfileCompletion();\n  const roadmapProgress = computeRoadmapPercent();\n  const resumeScore = resume?.lastScore ?? 0;\n\n  // Next Best Step recommendation\n  const getNextBestStep = () => {\n    if (profileCompletion < 80) {\n      return {\n        title: \'Finish setting up your profile\',\n        desc: en.onboarding.nudgeBanner,\n        link: \'/profile\',\n        cta: \'Complete Profile\',\n      };\n    }\n    if (skills.length < 3) {\n      return {\n        title: \'Add your top skills\',\n        desc: \'List at least 3 technical, soft, domain, or language skills so AI can match you accurately.\',\n        link: \'/skills\',\n        cta: \'Add Skills\',\n      };\n    }\n    if (resumeScore === 0) {\n      return {\n        title: \'Build and review your resume\',\n        desc: \'Create a clean single-column PDF resume and get instant AI suggestions.\',\n        link: \'/resume\',\n        cta: \'Open Resume Builder\',\n      };\n    }\n    return {\n      title: \'Explore tailored career ideas\',\n      desc: \'See best-fit, adjacent, and stretch roles matched to your field and interests.\',\n      link: \'/career-ideas\',\n      cta: \'Explore Career Ideas\',\n    };\n  };\n\n  const nextStep = getNextBestStep();\n\n  return (\n    <AppShell>\n      <div className=\"space-y-6\">\n        {/* Welcome Header */}\n        <div className=\"p-6 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl shadow-2xs flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n          <div>\n            <p className=\"text-xs text-stone-500 dark:text-slate-400 capitalize\">\n              {profile?.currentStatus || \'Member\'} \302\267 {profile?.fieldOfStudy || \'All Fields\'}\n            </p>\n            <h1 className=\"text-xl sm:text-2xl font-bold mt-0.5\">\n              Welcome, {user?.name}\n            </h1>\n            <p className=\"text-xs sm:text-sm text-stone-600 dark:text-slate-300 mt-1\">\n              Goal:{\' \'}\n              <span className=\"font-semibold\">\n                {profile?.careerGoal || \'Add a career goal in your profile\'}\n              </span>\n            </p>\n          </div>\n\n          <div className=\"flex items-center gap-2 shrink-0\">\n            <Link\n              to=\"/profile\"\n              className=\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-medium bg-stone-100 dark:bg-slate-800 hover:bg-stone-200 rounded-lg transition-colors\"\n            >\n              <Edit3 className=\"w-3.5 h-3.5\" />\n              <span>{en.nav.profile}</span>\n            </Link>\n            <Link\n              to=\"/career-ideas\"\n              className=\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-slate-900 dark:bg-indigo-600 hover:bg-slate-800 rounded-lg transition-colors\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span>{en.nav.careerIdeas}</span>\n            </Link>\n          </div>\n        </div>\n\n        {/* Next Best Step Card */}\n        {!loading && (\n          <div className=\"p-5 bg-indigo-50/80 dark:bg-indigo-950/50 border border-indigo-200 dark:border-indigo-900 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n            <div className=\"flex items-start gap-3\">\n              <div className=\"w-9 h-9 rounded-lg bg-indigo-600 text-white flex items-center justify-center shrink-0\">\n                <Compass className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <span className=\"text-[11px] font-bold uppercase tracking-wider text-indigo-700 dark:text-indigo-300\">\n                  Next Best Step\n                </span>\n                <h2 className=\"text-sm font-bold text-slate-900 dark:text-slate-100\">\n                  {nextStep.title}\n                </h2>\n                <p className=\"text-xs text-stone-600 dark:text-slate-300 mt-0.5\">\n                  {nextStep.desc}\n                </p>\n              </div>\n            </div>\n            <Link\n              to={nextStep.link}\n              className=\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg self-start sm:self-auto whitespace-nowrap shrink-0\"\n            >\n              <span>{nextStep.cta}</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </Link>\n          </div>\n        )}\n\n        {/* Summary Metric Cards */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4\">\n          <Link\n            to=\"/profile\"\n            className=\"p-4 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl shadow-2xs space-y-1\"\n          >\n            <span className=\"text-xs text-stone-500 dark:text-slate-400\">Profile Complete</span>\n            <p className=\"text-2xl font-extrabold tabular-nums\">{profileCompletion}%</p>\n            <span className=\"text-[11px] text-indigo-600 dark:text-indigo-400 font-medium block\">\n              {profile?.country || \'India\'} ({profile?.currency || \'INR\'})\n            </span>\n          </Link>\n\n          <Link\n            to=\"/resume\"\n            className=\"p-4 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl shadow-2xs space-y-1\"\n          >\n            <span className=\"text-xs text-stone-500 dark:text-slate-400\">Resume Score</span>\n            <p className=\"text-2xl font-extrabold tabular-nums\">\n              {resumeScore > 0 ? `${resumeScore}/100` : \'Not scored\'}\n            </p>\n            <span className=\"text-[11px] text-stone-500 dark:text-slate-400 block capitalize\">\n              Mode: {resume?.mode || \'fresher\'}\n            </span>\n          </Link>\n\n          <Link\n            to=\"/skills\"\n            className=\"p-4 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl shadow-2xs space-y-1\"\n          >\n            <span className=\"text-xs text-stone-500 dark:text-slate-400\">Skills Count</span>\n            <p className=\"text-2xl font-extrabold tabular-nums\">{skills.length}</p>\n            <span className=\"text-[11px] text-stone-500 dark:text-slate-400 block\">\n              Across 4 categories\n            </span>\n          </Link>\n\n          <Link\n            to=\"/roadmap\"\n            className=\"p-4 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl shadow-2xs space-y-1\"\n          >\n            <span className=\"text-xs text-stone-500 dark:text-slate-400\">Roadmap Progress</span>\n            <p className=\"text-2xl font-extrabold tabular-nums\">{roadmapProgress}%</p>\n            <span className=\"text-[11px] text-stone-500 dark:text-slate-400 block truncate\">\n              {roadmap?.targetRole || \'Create a study plan\'}\n            </span>\n          </Link>\n\n          <Link\n            to=\"/opportunities\"\n            className=\"p-4 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl shadow-2xs space-y-1 col-span-2 sm:col-span-1\"\n          >\n            <span className=\"text-xs text-stone-500 dark:text-slate-400\">Opportunities</span>\n            <p className=\"text-2xl font-extrabold tabular-nums\">{opportunities.length}</p>\n            <span className=\"text-[11px] text-emerald-700 dark:text-emerald-400 font-medium block tabular-nums\">\n              {opportunities.filter((o) => o.status === \'interview\' || o.status === \'offer\').length}{\' \'}\n              interview / offer\n            </span>\n          </Link>\n        </div>\n\n        {/* Tools Hub */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\">\n          {[\n            {\n              title: en.nav.careerIdeas,\n              desc: \'Get best-fit, adjacent, and stretch career ideas for your field.\',\n              to: \'/career-ideas\',\n              icon: Sparkles,\n            },\n            {\n              title: en.nav.resume,\n              desc: \'Build a fresher, experienced, or academic resume and download A4 PDF.\',\n              to: \'/resume\',\n              icon: FileText,\n            },\n            {\n              title: en.nav.skills,\n              desc: \'Track technical, soft, domain, and language skills and certificates.\',\n              to: \'/skills\',\n              icon: Award,\n            },\n            {\n              title: en.nav.interview,\n              desc: \'Practice 8 mock interview or viva questions with instant feedback.\',\n              to: \'/interview\',\n              icon: MessageSquareCode,\n            },\n            {\n              title: en.nav.roadmap,\n              desc: \'Follow a step-by-step weekly study plan tailored to your schedule.\',\n              to: \'/roadmap\',\n              icon: Milestone,\n            },\n            {\n              title: en.nav.opportunities,\n              desc: \'Track jobs, internships, exams, scholarships, admissions, and freelance work.\',\n              to: \'/opportunities\',\n              icon: Briefcase,\n            },\n          ].map((tool) => {\n            const Icon = tool.icon;\n            return (\n              <Link\n                key={tool.to}\n                to={tool.to}\n                className=\"p-5 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 hover:border-indigo-400 rounded-xl shadow-2xs transition-colors space-y-2\"\n              >\n                <div className=\"w-8 h-8 rounded-lg bg-stone-100 dark:bg-slate-800 flex items-center justify-center\">\n                  <Icon className=\"w-4 h-4 text-indigo-600 dark:text-indigo-400\" />\n                </div>\n                <h3 className=\"text-sm font-bold\">{tool.title}</h3>\n                <p className=\"text-xs text-stone-600 dark:text-slate-400 leading-relaxed\">\n                  {tool.desc}\n                </p>\n              </Link>\n            );\n          })}\n        </div>\n      </div>\n    </AppShell>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/pages/DashboardPage.tsx"
        }
        overwrite: true
      }
    }
