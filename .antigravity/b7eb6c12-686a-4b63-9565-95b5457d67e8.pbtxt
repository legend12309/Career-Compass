    }
    model_api_content_id: "8ad84b35fb49428b99defcbd43464a2d"
  }
  code_action {
    action_spec {
      create_file {
        instruction: "import { useState, useEffect, FormEvent } from \'react\';\nimport { useNavigate } from \'react-router-dom\';\nimport { getProfile, listSkills, getCareerResult, saveCareerResult } from \'../services/db\';\nimport { getCareerIdeas } from \'../services/ai\';\nimport { CareerIdeaItem } from \'../types/ai\';\nimport { AppShell } from \'../components/layout/AppShell\';\nimport {\n  Sparkles,\n  AlertCircle,\n  RotateCcw,\n  Milestone,\n  CheckCircle2,\n  ArrowRight,\n} from \'lucide-react\';\n\nexport function RecommendationsPage() {\n  const navigate = useNavigate();\n\n  const [educationLevel, setEducationLevel] = useState(\'Undergraduate Degree\');\n  const [fieldOfStudy, setFieldOfStudy] = useState(\'Full-Stack Web Development & Software\');\n  const [currentStatus, setCurrentStatus] = useState(\'undergraduate\');\n  const [experienceYears, setExperienceYears] = useState(0);\n  const [interestsInput, setInterestsInput] = useState(\'\');\n  const [skillsInput, setSkillsInput] = useState(\'\');\n  const [preferredWorkStyle, setPreferredWorkStyle] = useState(\'Hybrid or Remote Collaborative Team\');\n  const [country, setCountry] = useState(\'India\');\n  const [currency, setCurrency] = useState(\'INR\');\n\n  const [careers, setCareers] = useState<CareerIdeaItem[]>([]);\n  const [lastUpdated, setLastUpdated] = useState<string | null>(null);\n  const [generating, setGenerating] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => {\n    async function load() {\n      try {\n        const [profile, skills, cached] = await Promise.all([\n          getProfile(),\n          listSkills(),\n          getCareerResult(),\n        ]);\n        if (profile) {\n          setEducationLevel(profile.educationLevel);\n          setFieldOfStudy(profile.fieldOfStudy);\n          setCurrentStatus(profile.currentStatus);\n          setExperienceYears(profile.experienceYears);\n          setInterestsInput((profile.interests || []).join(\', \'));\n          setCountry(profile.country || \'India\');\n          setCurrency(profile.currency || \'INR\');\n          if (profile.preferredWorkStyle) setPreferredWorkStyle(profile.preferredWorkStyle);\n        }\n        if (skills.length > 0) {\n          setSkillsInput(skills.map((s) => s.name).join(\', \'));\n        }\n        if (cached?.data?.careers) {\n          setCareers(cached.data.careers);\n          setLastUpdated(cached.createdAt);\n        }\n      } catch (err) {\n        console.error(\'Error loading career ideas:\', err);\n      }\n    }\n    load();\n  }, []);\n\n  const handleGenerate = async (e?: FormEvent) => {\n    if (e) e.preventDefault();\n    if (generating) return;\n\n    const interests = interestsInput\n      .split(\',\')\n      .map((s) => s.trim())\n      .filter(Boolean);\n    const skills = skillsInput\n      .split(\',\')\n      .map((s) => s.trim())\n      .filter(Boolean);\n\n    if (!fieldOfStudy.trim() || (interests.length === 0 && skills.length === 0)) {\n      setError(\'Please enter your field of study and at least one interest or skill.\');\n      return;\n    }\n\n    setError(null);\n    setGenerating(true);\n    try {\n      const output = await getCareerIdeas({\n        educationLevel,\n        fieldOfStudy,\n        currentStatus,\n        experienceYears,\n        interests,\n        skills,\n        preferredWorkStyle,\n        country,\n        currency,\n      });\n      setCareers(output.careers);\n      const saved = await saveCareerResult(output);\n      setLastUpdated(saved.createdAt);\n    } catch (err: unknown) {\n      setError(err instanceof Error ? err.message : \'Could not load career ideas.\');\n    } finally {\n      setGenerating(false);\n    }\n  };\n\n  return (\n    <AppShell>\n      <div className=\"space-y-6\">\n        <div className=\"pb-4 border-b border-stone-200 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n          <div>\n            <h1 className=\"text-xl sm:text-2xl font-bold\">Career Ideas</h1>\n            <p className=\"text-xs sm:text-sm text-stone-600 dark:text-slate-400 mt-1\">\n              Discover best-fit, adjacent, and stretch career options tailored to your background.\n            </p>\n          </div>\n          {lastUpdated && (\n            <span className=\"text-xs text-stone-500 tabular-nums\">\n              Saved: {new Date(lastUpdated).toLocaleString()}\n            </span>\n          )}\n        </div>\n\n        <form\n          onSubmit={handleGenerate}\n          className=\"p-5 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl space-y-4\"\n        >\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <label htmlFor=\"ci-field\" className=\"block text-xs font-medium mb-1\">\n                Field of Study or Work *\n              </label>\n              <input\n                id=\"ci-field\"\n                type=\"text\"\n                required\n                value={fieldOfStudy}\n                onChange={(e) => setFieldOfStudy(e.target.value)}\n                className=\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\"\n              />\n            </div>\n\n            <div>\n              <label htmlFor=\"ci-edu\" className=\"block text-xs font-medium mb-1\">\n                Education Level *\n              </label>\n              <input\n                id=\"ci-edu\"\n                type=\"text\"\n                required\n                value={educationLevel}\n                onChange={(e) => setEducationLevel(e.target.value)}\n                className=\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\"\n              />\n            </div>\n\n            <div>\n              <label htmlFor=\"ci-interests\" className=\"block text-xs font-medium mb-1\">\n                Interests (comma-separated) *\n              </label>\n              <input\n                id=\"ci-interests\"\n                type=\"text\"\n                value={interestsInput}\n                onChange={(e) => setInterestsInput(e.target.value)}\n                className=\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\"\n              />\n            </div>\n\n            <div>\n              <label htmlFor=\"ci-skills\" className=\"block text-xs font-medium mb-1\">\n                Current Skills (comma-separated) *\n              </label>\n              <input\n                id=\"ci-skills\"\n                type=\"text\"\n                value={skillsInput}\n                onChange={(e) => setSkillsInput(e.target.value)}\n                className=\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\"\n              />\n            </div>\n          </div>\n\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2 border-t border-stone-100 dark:border-slate-800\">\n            <span className=\"text-[11px] text-stone-500\">\n              Match percentages are an AI estimate, not a guarantee. Salaries are approximate ({currency}).\n            </span>\n            <button\n              type=\"submit\"\n              disabled={generating}\n              className=\"inline-flex items-center justify-center gap-2 px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 dark:bg-indigo-600 rounded-lg disabled:opacity-50\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span>{generating ? \'Finding Career Ideas...\' : \'Get Career Ideas\'}</span>\n            </button>\n          </div>\n        </form>\n\n        {error && (\n          <div className=\"p-4 bg-red-50 dark:bg-red-950/60 border border-red-200 rounded-xl flex items-center justify-between gap-3 text-xs text-red-900 dark:text-red-200\">\n            <div className=\"flex items-center gap-2\">\n              <AlertCircle className=\"w-4 h-4 shrink-0\" />\n              <span>{error}</span>\n            </div>\n            <button\n              type=\"button\"\n              onClick={() => handleGenerate()}\n              className=\"inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-white bg-red-700 rounded-lg shrink-0\"\n            >\n              <RotateCcw className=\"w-3.5 h-3.5\" />\n              <span>Retry</span>\n            </button>\n          </div>\n        )}\n\n        {!generating && careers.length > 0 && (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {careers.map((item, idx) => (\n              <div\n                key={`${item.title}-${idx}`}\n                className=\"p-5 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl flex flex-col justify-between space-y-4\"\n              >\n                <div className=\"space-y-3\">\n                  <div className=\"flex items-start justify-between gap-3\">\n                    <div>\n                      <span className=\"text-[11px] font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400\">\n                        {item.category}\n                      </span>\n                      <h3 className=\"text-base font-bold\">{item.title}</h3>\n                      <p className=\"text-xs text-stone-500 mt-0.5\">\n                        {item.approxSalaryRange} \302\267 {item.growthOutlook}\n                      </p>\n                    </div>\n                    <div className=\"text-right shrink-0\">\n                      <span className=\"text-sm font-bold text-indigo-600 dark:text-indigo-400 tabular-nums\">\n                        {item.matchPercent}%\n                      </span>\n                      <span className=\"block text-[10px] text-stone-500\">\n                        AI estimate, not a guarantee\n                      </span>\n                    </div>\n                  </div>\n\n                  <div className=\"w-full h-2 bg-stone-100 dark:bg-slate-800 rounded-full overflow-hidden\">\n                    <div\n                      className=\"h-full bg-indigo-600 rounded-full\"\n                      style={{ width: `${Math.min(100, Math.max(5, item.matchPercent))}%` }}\n                    />\n                  </div>\n\n                  <p className=\"text-xs text-stone-700 dark:text-slate-300 leading-relaxed\">\n                    {item.whyItFits}\n                  </p>\n\n                  <div>\n                    <span className=\"text-[11px] font-semibold block mb-1\">Required Skills:</span>\n                    <p className=\"text-xs text-stone-600 dark:text-slate-400\">\n                      {item.requiredSkills.map((s, i) => (\n                        <span key={s}>\n                          {i > 0 && \' \302\267 \'}\n                          <CheckCircle2 className=\"w-3 h-3 text-emerald-600 inline mr-0.5\" />\n                          {s}\n                        </span>\n                      ))}\n                    </p>\n                  </div>\n\n                  {item.missingSkills.length > 0 && (\n                    <div>\n                      <span className=\"text-[11px] font-semibold block mb-1\">Skills to Learn:</span>\n                      <div className=\"flex flex-wrap gap-1.5\">\n                        {item.missingSkills.map((ms) => (\n                          <span\n                            key={ms}\n                            className=\"px-2 py-0.5 text-[11px] bg-amber-50 dark:bg-amber-950 text-amber-900 dark:text-amber-200 border border-amber-200 dark:border-amber-800 rounded\"\n                          >\n                            + {ms}\n                          </span>\n                        ))}\n                      </div>\n                    </div>\n                  )}\n                </div>\n\n                <button\n                  type=\"button\"\n                  onClick={() => navigate(`/roadmap?role=${encodeURIComponent(item.title)}`)}\n                  className=\"w-full inline-flex items-center justify-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-white bg-slate-900 dark:bg-indigo-600 rounded-lg\"\n                >\n                  <Milestone className=\"w-3.5 h-3.5\" />\n                  <span>Create roadmap</span>\n                  <ArrowRight className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n    </AppShell>\n  );\n}\n"
