    tool_calls {
      id: "call_10562877945688347745"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { User, Role } from \'../types\';\\nimport { initDbSeed } from \'./db\';\\n\\nconst USERS_KEY = \'cc_users\';\\nconst SESSION_KEY = \'cc_auth_session\';\\n\\ninterface StoredUser extends User {\\n  // NOTE: Prototype mock password storage in localStorage.\\n  // In the Express + MongoDB backend phase, passwords will be hashed with bcrypt and never stored client-side.\\n  passwordHash: string;\\n}\\n\\nconst SEED_USERS: StoredUser[] = [\\n  {\\n    id: \'student-1\',\\n    name: \'Aryan Sharma\',\\n    email: \'student@college.edu\',\\n    passwordHash: \'password123\',\\n    role: \'student\',\\n    createdAt: \'2026-08-15T09:00:00.000Z\',\\n    active: true,\\n  },\\n  {\\n    id: \'admin-1\',\\n    name: \'Admin Coordinator\',\\n    email: \'admin@careercompass.io\',\\n    passwordHash: \'admin123\',\\n    role: \'admin\',\\n    createdAt: \'2026-08-01T09:00:00.000Z\',\\n    active: true,\\n  },\\n];\\n\\nfunction initSeedUsers(): StoredUser[] {\\n  try {\\n    const raw = localStorage.getItem(USERS_KEY);\\n    if (!raw) {\\n      localStorage.setItem(USERS_KEY, JSON.stringify(SEED_USERS));\\n      initDbSeed(\'student-1\');\\n      return SEED_USERS;\\n    }\\n    const parsed: StoredUser[] = JSON.parse(raw);\\n    let modified = false;\\n    for (const seed of SEED_USERS) {\\n      const existing = parsed.find((u) => u.email.toLowerCase() === seed.email.toLowerCase());\\n      if (!existing) {\\n        parsed.push(seed);\\n        modified = true;\\n      } else if (existing.active === undefined) {\\n        existing.active = true;\\n        modified = true;\\n      }\\n    }\\n    if (modified) {\\n      localStorage.setItem(USERS_KEY, JSON.stringify(parsed));\\n    }\\n    initDbSeed(\'student-1\');\\n    return parsed;\\n  } catch (err) {\\n    console.error(\'Error initializing seed users:\', err);\\n    return SEED_USERS;\\n  }\\n}\\n\\nexport function getSeedCredentials() {\\n  return [\\n    {\\n      label: \'Demo Student\',\\n      email: \'student@college.edu\',\\n      password: \'password123\',\\n      role: \'student\' as Role,\\n      description: \'Final-year BCA student\',\\n    },\\n    {\\n      label: \'Demo Admin\',\\n      email: \'admin@careercompass.io\',\\n      password: \'admin123\',\\n      role: \'admin\' as Role,\\n      description: \'Placement & Faculty coordinator\',\\n    },\\n  ];\\n}\\n\\nexport async function getCurrentUser(): Promise<User | null> {\\n  const users = initSeedUsers();\\n  try {\\n    const raw = localStorage.getItem(SESSION_KEY);\\n    if (!raw) return null;\\n    const session = JSON.parse(raw);\\n    if (!session?.user?.id) return null;\\n\\n    // Verify user still exists and has not been deactivated\\n    const latestUser = users.find((u) => u.id === session.user.id);\\n    if (!latestUser || latestUser.active === false) {\\n      localStorage.removeItem(SESSION_KEY);\\n      return null;\\n    }\\n\\n    const { passwordHash: _, ...safeUser } = latestUser;\\n    return safeUser;\\n  } catch {\\n    return null;\\n  }\\n}\\n\\nexport async function login(email: string, password: string): Promise<User> {\\n  const users = initSeedUsers();\\n  const normalizedEmail = email.trim().toLowerCase();\\n  const found = users.find((u) => u.email.toLowerCase() === normalizedEmail);\\n\\n  if (!found || found.passwordHash !== password) {\\n    throw new Error(\'Invalid email or password. Please check your credentials.\');\\n  }\\n\\n  if (found.active === false) {\\n    throw new Error(\\n      \'Your account has been deactivated by an administrator. Please contact your placement coordinator.\'\\n    );\\n  }\\n\\n  const { passwordHash: _, ...safeUser } = found;\\n  localStorage.setItem(SESSION_KEY, JSON.stringify({ user: safeUser, token: \'mock-jwt-token\' }));\\n  return safeUser;\\n}\\n\\nexport async function register(\\n  name: string,\\n  email: string,\\n  password: string,\\n  role: Role = \'student\'\\n): Promise<User> {\\n  const users = initSeedUsers();\\n  const cleanName = name.trim();\\n  const normalizedEmail = email.trim().toLowerCase();\\n\\n  if (!cleanName || cleanName.length < 2) {\\n    throw new Error(\'Please enter a valid full name (at least 2 characters).\');\\n  }\\n  if (cleanName.length > 80) {\\n    throw new Error(\'Name cannot exceed 80 characters.\');\\n  }\\n  const emailRegex = /^[^\\\\s@]+@[^\\\\s@]+\\\\.[^\\\\s@]+$/;\\n  if (!emailRegex.test(normalizedEmail)) {\\n    throw new Error(\'Please enter a valid email address.\');\\n  }\\n  if (password.length < 6) {\\n    throw new Error(\'Password must be at least 6 characters long.\');\\n  }\\n\\n  if (users.some((u) => u.email.toLowerCase() === normalizedEmail)) {\\n    throw new Error(\'An account with this email already exists.\');\\n  }\\n\\n  const newUser: StoredUser = {\\n    id: `user-${Date.now()}`,\\n    name: cleanName,\\n    email: normalizedEmail,\\n    passwordHash: password,\\n    role,\\n    createdAt: new Date().toISOString(),\\n    active: true,\\n  };\\n\\n  users.push(newUser);\\n  localStorage.setItem(USERS_KEY, JSON.stringify(users));\\n\\n  const { passwordHash: _, ...safeUser } = newUser;\\n  localStorage.setItem(SESSION_KEY, JSON.stringify({ user: safeUser, token: \'mock-jwt-token\' }));\\n  return safeUser;\\n}\\n\\nexport async function logout(): Promise<void> {\\n  localStorage.removeItem(SESSION_KEY);\\n}\\n\\n// Admin User Management APIs (with strict role and self-lockout checks)\\nexport async function listUsers(actorRole: string): Promise<User[]> {\\n  if (actorRole !== \'admin\') {\\n    throw new Error(\'Unauthorized: Admin role required to list users.\');\\n  }\\n  const users = initSeedUsers();\\n  return users.map(({ passwordHash: _, ...safe }) => safe);\\n}\\n\\nexport async function toggleUserActiveStatus(\\n  targetUserId: string,\\n  actorUser: User\\n): Promise<User> {\\n  if (!actorUser || actorUser.role !== \'admin\') {\\n    throw new Error(\'Unauthorized: Only administrators can activate or deactivate users.\');\\n  }\\n  if (targetUserId === actorUser.id) {\\n    throw new Error(\'Safety lock: You cannot deactivate your own active admin account.\');\\n  }\\n\\n  const users = initSeedUsers();\\n  const idx = users.findIndex((u) => u.id === targetUserId);\\n  if (idx < 0) {\\n    throw new Error(\'Target user not found.\');\\n  }\\n\\n  const target = users[idx];\\n  const willBeActive = target.active === false;\\n\\n  // Prevent deactivating the last active admin\\n  if (!willBeActive && target.role === \'admin\') {\\n    const activeAdmins = users.filter((u) => u.role === \'admin\' && u.active !== false);\\n    if (activeAdmins.length <= 1) {\\n      throw new Error(\'Cannot deactivate the last remaining active administrator.\');\\n    }\\n  }\\n\\n  users[idx] = { ...target, active: willBeActive };\\n  localStorage.setItem(USERS_KEY, JSON.stringify(users));\\n\\n  const { passwordHash: _, ...safe } = users[idx];\\n  return safe;\\n}\\n\", \"Description\":\"Updated auth service with strict validation, account deactivation enforcement, and admin user management methods\", \"Overwrite\":true, \"TargetFile\":\"/src/services/auth.ts\", \"toolAction\":\"Updating auth service\", \"toolSummary\":\"Update src/services/auth.ts with admin and deactivation checks\"}"
      original_name: "write_to_file"
    }
