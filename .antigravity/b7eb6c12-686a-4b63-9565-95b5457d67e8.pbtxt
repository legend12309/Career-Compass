  code_action {
    action_spec {
      create_file {
        instruction: "import {\n  CareerRecommendationInput,\n  CareerRecommendationsOutput,\n  CareerRecommendation,\n  ResumeReviewOutput,\n  ResumeReviewSuggestion,\n  MockInterviewQuestionsOutput,\n  InterviewQuestion,\n  AnswerEvaluationOutput,\n  LearningRoadmapOutput,\n  RoadmapPhase,\n} from \'../types/ai\';\n\n// Track in-flight requests to prevent parallel duplicate submissions\nconst inFlightRequests = new Set<string>();\n\nfunction sanitizeText(str: unknown, maxLen = 1500): string {\n  if (typeof str !== \'string\') return \'\';\n  return str.trim().slice(0, maxLen);\n}\n\nasync function postJsonWithValidation<T>(\n  endpoint: string,\n  payload: unknown,\n  validator: (raw: unknown) => T\n): Promise<T> {\n  if (inFlightRequests.has(endpoint)) {\n    throw new Error(\'A request is already in progress. Please wait for it to finish.\');\n  }\n  inFlightRequests.add(endpoint);\n\n  try {\n    const response = await fetch(endpoint, {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify(payload),\n    });\n\n    let body: unknown;\n    try {\n      body = await response.json();\n    } catch {\n      throw new Error(\'Received a malformed JSON response from the AI service. Please click Retry.\');\n    }\n\n    if (!response.ok) {\n      const errMsg =\n        typeof body === \'object\' && body !== null && \'error\' in body && typeof (body as { error: unknown }).error === \'string\'\n          ? (body as { error: string }).error\n          : `AI service error (HTTP ${response.status}). Please try again.`;\n      throw new Error(errMsg);\n    }\n\n    return validator(body);\n  } catch (err: unknown) {\n    if (err instanceof Error) {\n      throw err;\n    }\n    throw new Error(\'Network error while contacting the AI service. Please check your connection and retry.\');\n  } finally {\n    inFlightRequests.delete(endpoint);\n  }\n}\n\n// Runtime Schema Validators to guarantee UI safety against missing or malformed fields\nexport function validateCareerRecommendations(raw: unknown): CareerRecommendationsOutput {\n  if (!raw || typeof raw !== \'object\' || !Array.isArray((raw as { careers?: unknown }).careers)) {\n    throw new Error(\'AI response is missing the required \"careers\" array.\');\n  }\n  const list = (raw as { careers: unknown[] }).careers;\n  if (list.length === 0) {\n    throw new Error(\'AI returned an empty career recommendations list. Please retry.\');\n  }\n\n  const careers: CareerRecommendation[] = list.slice(0, 5).map((item, idx) => {\n    const obj = (item && typeof item === \'object\' ? item : {}) as Record<string, unknown>;\n    const rawSalary = sanitizeText(obj.approxSalaryRangeINR, 120) || \'Approximate: \342\202\2714L \342\200\223 \342\202\2718L PA\';\n    const approxSalaryRangeINR = rawSalary.toLowerCase().includes(\'approx\')\n      ? rawSalary\n      : `Approximate: ${rawSalary}`;\n\n    return {\n      title: sanitizeText(obj.title, 120) || `Software Role ${idx + 1}`,\n      matchPercent: Math.min(100, Math.max(0, Math.round(Number(obj.matchPercent) || 75))),\n      whyItFits:\n        sanitizeText(obj.whyItFits, 500) ||\n        \'Aligns with your computer applications coursework and technical interests.\',\n      requiredSkills: Array.isArray(obj.requiredSkills)\n        ? obj.requiredSkills.map((s) => sanitizeText(s, 60)).filter(Boolean)\n        : [\'Problem Solving\'],\n      missingSkills: Array.isArray(obj.missingSkills)\n        ? obj.missingSkills.map((s) => sanitizeText(s, 60)).filter(Boolean)\n        : [],\n      approxSalaryRangeINR,\n      growthOutlook: sanitizeText(obj.growthOutlook, 200) || \'Strong demand across entry-level engineering teams.\',\n    };\n  });\n\n  return { careers };\n}\n\nexport function validateResumeReview(raw: unknown): ResumeReviewOutput {\n  if (!raw || typeof raw !== \'object\') {\n    throw new Error(\'Invalid AI resume review response structure.\');\n  }\n  const obj = raw as Record<string, unknown>;\n  const score = Math.min(100, Math.max(0, Math.round(Number(obj.score) || 65)));\n  const strengths = Array.isArray(obj.strengths)\n    ? obj.strengths.map((s) => sanitizeText(s, 250)).filter(Boolean)\n    : [];\n  const weaknesses = Array.isArray(obj.weaknesses)\n    ? obj.weaknesses.map((s) => sanitizeText(s, 250)).filter(Boolean)\n    : [];\n  const atsKeywordsMissing = Array.isArray(obj.atsKeywordsMissing)\n    ? obj.atsKeywordsMissing.map((s) => sanitizeText(s, 80)).filter(Boolean)\n    : [];\n\n  const suggestions: ResumeReviewSuggestion[] = Array.isArray(obj.suggestions)\n    ? obj.suggestions\n        .map((s) => {\n          const item = (s && typeof s === \'object\' ? s : {}) as Record<string, unknown>;\n          return {\n            section: sanitizeText(item.section, 60) || \'summary\',\n            issue: sanitizeText(item.issue, 300) || \'Can be made more impactful with measurable outcomes.\',\n            improvedText: sanitizeText(item.improvedText, 800),\n          };\n        })\n        .filter((s) => Boolean(s.improvedText))\n    : [];\n\n  return {\n    score,\n    strengths: strengths.length > 0 ? strengths : [\'Structured academic background\'],\n    weaknesses: weaknesses.length > 0 ? weaknesses : [\'Add more quantified project metrics\'],\n    suggestions,\n    atsKeywordsMissing,\n  };\n}\n\nexport function validateInterviewQuestions(raw: unknown): MockInterviewQuestionsOutput {\n  if (!raw || typeof raw !== \'object\' || !Array.isArray((raw as { questions?: unknown }).questions)) {\n    throw new Error(\'AI response is missing the \"questions\" array.\');\n  }\n  const rawList = (raw as { questions: unknown[] }).questions;\n  if (rawList.length === 0) {\n    throw new Error(\'AI returned zero interview questions. Please retry.\');\n  }\n\n  const questions: InterviewQuestion[] = rawList.slice(0, 8).map((q, idx) => {\n    const obj = (q && typeof q === \'object\' ? q : {}) as Record<string, unknown>;\n    return {\n      id: sanitizeText(obj.id, 30) || `q-${idx + 1}`,\n      question: sanitizeText(obj.question, 400) || `Explain a core concept in this role (Question ${idx + 1}).`,\n      type: sanitizeText(obj.type, 30) || \'technical\',\n      idealAnswerPoints: Array.isArray(obj.idealAnswerPoints)\n        ? obj.idealAnswerPoints.map((pt) => sanitizeText(pt, 200)).filter(Boolean)\n        : [\'Explain the core principle clearly\', \'Provide a practical project example\'],\n    };\n  });\n\n  return { questions };\n}\n\nexport function validateAnswerEvaluation(raw: unknown): AnswerEvaluationOutput {\n  if (!raw || typeof raw !== \'object\') {\n    throw new Error(\'Invalid answer evaluation response.\');\n  }\n  const obj = raw as Record<string, unknown>;\n  return {\n    score: Math.min(10, Math.max(0, Math.round(Number(obj.score) * 10) / 10 || 5)),\n    feedback: sanitizeText(obj.feedback, 800) || \'Good effort. Structure your explanation with a concrete example.\',\n    improvedAnswer:\n      sanitizeText(obj.improvedAnswer, 1000) ||\n      \'State the concept clearly, explain the trade-offs, and cite a practical implementation.\',\n  };\n}\n\nexport function validateLearningRoadmap(raw: unknown): LearningRoadmapOutput {\n  if (!raw || typeof raw !== \'object\' || !Array.isArray((raw as { phases?: unknown }).phases)) {\n    throw new Error(\'AI response is missing the \"phases\" array.\');\n  }\n  const rawPhases = (raw as { phases: unknown[] }).phases;\n  if (rawPhases.length === 0) {\n    throw new Error(\'AI returned an empty roadmap. Please retry.\');\n  }\n\n  const phases: RoadmapPhase[] = rawPhases.map((p, idx) => {\n    const obj = (p && typeof p === \'object\' ? p : {}) as Record<string, unknown>;\n    return {\n      title: sanitizeText(obj.title, 120) || `Phase ${idx + 1}: Core Foundations`,\n      weeks: sanitizeText(obj.weeks, 50) || `Weeks ${idx * 2 + 1}\342\200\223${(idx + 1) * 2}`,\n      topics: Array.isArray(obj.topics)\n        ? obj.topics.map((t) => sanitizeText(t, 120)).filter(Boolean)\n        : [\'Core Fundamentals & Practice\'],\n      projectIdea:\n        sanitizeText(obj.projectIdea, 300) || \'Build and document a mini module applying these concepts.\',\n      freeResources: Array.isArray(obj.freeResources)\n        ? obj.freeResources\n            .map((r) => {\n              const resObj = (r && typeof r === \'object\' ? r : {}) as Record<string, unknown>;\n              // Strip any accidental URLs to obey rule 3D (\"never fabricated URLs\")\n              const cleanName = sanitizeText(resObj.name, 120).replace(/https?:\\/\\/\\S+/gi, \'\').trim();\n              return {\n                name: cleanName || \'Official Language & Framework Documentation\',\n                type: sanitizeText(resObj.type, 50) || \'Documentation\',\n              };\n            })\n            .filter((r) => Boolean(r.name))\n        : [{ name: \'Official Documentation & Guides\', type: \'Documentation\' }],\n    };\n  });\n\n  return { phases };\n}\n\n/**\n * Schema A: Generates 3-5 career recommendations from student profile & skills\n */\nexport async function getCareerRecommendations(\n  input: CareerRecommendationInput\n): Promise<CareerRecommendationsOutput> {\n  return postJsonWithValidation(\'/api/ai/career-recommendations\', input, validateCareerRecommendations);\n}\n\n/**\n * Schema B: Reviews and scores resume content (0-100) with actionable suggestions\n */\nexport async function reviewResume(resumeData: unknown): Promise<ResumeReviewOutput> {\n  return postJsonWithValidation(\'/api/ai/resume-review\', { resume: resumeData }, validateResumeReview);\n}\n\n/**\n * Schema C (Part 1): Generates 8 mock interview questions\n */\nexport async function generateInterviewQuestions(params: {\n  role: string;\n  difficulty: string;\n  type: \'technical\' | \'hr\' | \'mixed\';\n}): Promise<MockInterviewQuestionsOutput> {\n  return postJsonWithValidation(\'/api/ai/interview-questions\', params, validateInterviewQuestions);\n}\n\n/**\n * Schema C (Part 2): Evaluates a candidate\'s answer during a mock interview\n */\nexport async function evaluateAnswer(\n  question: string,\n  userAnswer: string\n): Promise<AnswerEvaluationOutput> {\n  return postJsonWithValidation(\n    \'/api/ai/interview-evaluate\',\n    { question: sanitizeText(question, 500), userAnswer: sanitizeText(userAnswer, 2500) },\n    validateAnswerEvaluation\n  );\n}\n\n/**\n * Schema D: Generates personalized learning roadmap\n */\nexport async function generateRoadmap(params: {\n  targetRole: string;\n  currentSkills: string[];\n  weeksAvailable: number;\n}): Promise<LearningRoadmapOutput> {\n  return postJsonWithValidation(\'/api/ai/learning-roadmap\', params, validateLearningRoadmap);\n}\n"
        path {
          absolute_uri: "file:///src/services/ai.ts"
        }
        overwrite: true
      }
    }
