        instruction: "export type Role = \'student\' | \'admin\';\n\nexport interface User {\n  id: string;\n  name: string;\n  email: string;\n  role: Role;\n  createdAt: string;\n  active?: boolean;\n}\n\nexport interface Profile {\n  userId: string;\n  education: string;\n  branch: string;\n  year: string;\n  interests: string[];\n  careerGoal: string;\n  bio: string;\n  preferredWorkStyle?: string;\n}\n\nexport interface PersonalInfo {\n  name: string;\n  email: string;\n  phone: string;\n  linkedin: string;\n  github: string;\n  location: string;\n}\n\nexport interface EducationItem {\n  degree: string;\n  institution: string;\n  startYear: string;\n  endYear: string;\n  scoreOrCgpa: string;\n}\n\nexport interface ExperienceItem {\n  role: string;\n  company: string;\n  location: string;\n  startDate: string;\n  endDate: string;\n  description: string;\n}\n\nexport interface ProjectItem {\n  title: string;\n  techStack: string[];\n  link?: string;\n  description: string;\n}\n\nexport interface Resume {\n  userId: string;\n  personal: PersonalInfo;\n  summary: string;\n  education: EducationItem[];\n  experience: ExperienceItem[];\n  projects: ProjectItem[];\n  skills: string[];\n  certifications: string[];\n  lastReviewScore?: number;\n}\n\nexport interface Skill {\n  id: string;\n  userId: string;\n  name: string;\n  category: \'technical\' | \'soft\';\n  level: number; // 1-5\n}\n\nexport interface Certificate {\n  id: string;\n  userId: string;\n  title: string;\n  issuer: string;\n  date: string;\n  fileDataUrl?: string;\n  fileName?: string;\n}\n\nexport type ApplicationStatus = \'saved\' | \'applied\' | \'interview\' | \'offer\' | \'rejected\';\n\nexport interface Application {\n  id: string;\n  userId: string;\n  company: string;\n  role: string;\n  type: \'internship\' | \'job\';\n  status: ApplicationStatus;\n  appliedDate: string;\n  notes: string;\n}\n\nexport interface RoadmapPlan {\n  id: string;\n  userId: string;\n  targetRole: string;\n  weeksAvailable?: number;\n  data: {\n    phases: {\n      title: string;\n      weeks: string;\n      topics: string[];\n      projectIdea: string;\n      freeResources: { name: string; type: string }[];\n    }[];\n  };\n  completedTopics: string[];\n  createdAt: string;\n}\n\nexport interface CareerResource {\n  id: string;\n  title: string;\n  category: \'DSA & Coding\' | \'Web & Full-Stack\' | \'Aptitude & Placement\' | \'Resume & HR\' | \'Cloud & Data\';\n  link: string;\n  description: string;\n  createdAt: string;\n}\n\nexport interface InterviewSessionState {\n  userId: string;\n  role: string;\n  difficulty: \'Beginner\' | \'Intermediate\' | \'Advanced\';\n  type: \'technical\' | \'hr\' | \'mixed\';\n  questions: {\n    id: string;\n    question: string;\n    type: string;\n    idealAnswerPoints: string[];\n  }[];\n  currentIndex: number;\n  answers: Record<\n    string,\n    {\n      userAnswer: string;\n      skipped?: boolean;\n      evaluation?: {\n        score: number;\n        feedback: string;\n        improvedAnswer: string;\n      };\n    }\n  >;\n  completed: boolean;\n  updatedAt: string;\n}\n"
        path {
          absolute_uri: "file:///src/types/index.ts"
        }
        overwrite: true
      }
    }
