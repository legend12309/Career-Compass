        instruction: "import { useState, useEffect, FormEvent } from \'react\';\nimport { useNavigate, Link } from \'react-router-dom\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { getProfile, listSkills, getLastCareerRecommendations, saveCareerRecommendations } from \'../services/db\';\nimport { getCareerRecommendations } from \'../services/ai\';\nimport { CareerRecommendation } from \'../types/ai\';\nimport { AppShell } from \'../components/layout/AppShell\';\nimport {\n  Sparkles,\n  AlertCircle,\n  RotateCcw,\n  Milestone,\n  CheckCircle2,\n  ArrowRight,\n  Info,\n} from \'lucide-react\';\n\nexport function RecommendationsPage() {\n  const { user } = useAuth();\n  const navigate = useNavigate();\n\n  const [education, setEducation] = useState(\'Bachelor of Computer Applications (BCA)\');\n  const [interestsInput, setInterestsInput] = useState(\'\');\n  const [skillsInput, setSkillsInput] = useState(\'\');\n  const [preferredWorkStyle, setPreferredWorkStyle] = useState(\'Hybrid / Collaborative Engineering Team\');\n\n  const [careers, setCareers] = useState<CareerRecommendation[]>([]);\n  const [lastUpdated, setLastUpdated] = useState<string | null>(null);\n  const [loadingInitial, setLoadingInitial] = useState(true);\n  const [generating, setGenerating] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [profileIncomplete, setProfileIncomplete] = useState(false);\n\n  useEffect(() => {\n    async function load() {\n      if (!user) return;\n      setLoadingInitial(true);\n      try {\n        const [profile, skills, cached] = await Promise.all([\n          getProfile(user.id),\n          listSkills(user.id),\n          getLastCareerRecommendations(user.id),\n        ]);\n\n        if (profile) {\n          setEducation(`${profile.education} (${profile.branch}, ${profile.year})`);\n          setInterestsInput((profile.interests || []).join(\', \'));\n          if (profile.preferredWorkStyle) {\n            setPreferredWorkStyle(profile.preferredWorkStyle);\n          }\n          if (!profile.careerGoal || (profile.interests || []).length === 0) {\n            setProfileIncomplete(true);\n          }\n        } else {\n          setProfileIncomplete(true);\n        }\n\n        if (skills.length > 0) {\n          setSkillsInput(skills.map((s) => s.name).join(\', \'));\n        } else if (profile?.interests?.length) {\n          setSkillsInput(profile.interests.slice(0, 3).join(\', \'));\n        }\n\n        if (cached?.data?.careers) {\n          setCareers(cached.data.careers);\n          setLastUpdated(cached.updatedAt);\n        }\n      } catch (err) {\n        console.error(\'Error loading recommendation prerequisites:\', err);\n      } finally {\n        setLoadingInitial(false);\n      }\n    }\n    load();\n  }, [user]);\n\n  const handleGenerate = async (e?: FormEvent) => {\n    if (e) e.preventDefault();\n    if (!user || generating) return;\n\n    const interests = interestsInput\n      .split(\',\')\n      .map((s) => s.trim())\n      .filter(Boolean);\n    const skills = skillsInput\n      .split(\',\')\n      .map((s) => s.trim())\n      .filter(Boolean);\n\n    if (!education.trim()) {\n      setError(\'Please enter your education background before generating recommendations.\');\n      return;\n    }\n    if (interests.length === 0 && skills.length === 0) {\n      setError(\'Please provide at least one interest or technical skill.\');\n      return;\n    }\n\n    setError(null);\n    setGenerating(true);\n\n    try {\n      const result = await getCareerRecommendations({\n        education: education.trim(),\n        interests,\n        skills,\n        preferredWorkStyle: preferredWorkStyle.trim(),\n      });\n      setCareers(result.careers);\n      const nowIso = new Date().toISOString();\n      setLastUpdated(nowIso);\n      await saveCareerRecommendations(user.id, result);\n    } catch (err: unknown) {\n      setError(\n        err instanceof Error\n          ? err.message\n          : \'Could not generate career recommendations. Please check your connection and retry.\'\n      );\n    } finally {\n      setGenerating(false);\n    }\n  };\n\n  return (\n    <AppShell>\n      <div className=\"space-y-6\">\n        <div className=\"pb-4 border-b border-stone-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3\">\n          <div>\n            <h1 className=\"text-xl sm:text-2xl font-bold text-slate-900\">AI Career Recommendations</h1>\n            <p className=\"text-xs sm:text-sm text-stone-600 mt-1\">\n              Discover 3\342\200\2235 tech career tracks tailored to your coursework, skills, and preferred work style.\n            </p>\n          </div>\n          {lastUpdated && (\n            <span className=\"text-xs text-stone-500 tabular-nums\">\n              Last generated: {new Date(lastUpdated).toLocaleString()}\n            </span>\n          )}\n        </div>\n\n        {profileIncomplete && (\n          <div className=\"p-3.5 bg-amber-50/80 border border-amber-200 rounded-xl flex items-center justify-between gap-3 text-xs text-amber-900\">\n            <div className=\"flex items-center gap-2\">\n              <Info className=\"w-4 h-4 text-amber-700 shrink-0\" />\n              <span>\n                Complete your Career Profile and Skill Tracker for sharper, personalized AI recommendations.\n              </span>\n            </div>\n            <Link\n              to=\"/profile\"\n              className=\"font-semibold underline hover:text-amber-950 whitespace-nowrap shrink-0\"\n            >\n              Complete Profile\n            </Link>\n          </div>\n        )}\n\n        {/* Input Form pre-filled from Profile + Skills */}\n        <form\n          onSubmit={handleGenerate}\n          className=\"p-5 bg-white border border-stone-200 rounded-xl shadow-2xs space-y-4\"\n        >\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <label htmlFor=\"rec-edu\" className=\"block text-xs font-medium text-stone-700 mb-1\">\n                Academic Background *\n              </label>\n              <input\n                id=\"rec-edu\"\n                type=\"text\"\n                required\n                value={education}\n                onChange={(e) => setEducation(e.target.value)}\n                className=\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg focus:outline-hidden focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500\"\n              />\n            </div>\n\n            <div>\n              <label htmlFor=\"rec-style\" className=\"block text-xs font-medium text-stone-700 mb-1\">\n                Preferred Work Style\n              </label>\n              <select\n                id=\"rec-style\"\n                value={preferredWorkStyle}\n                onChange={(e) => setPreferredWorkStyle(e.target.value)}\n                className=\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg bg-white focus:outline-hidden focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500\"\n              >\n                <option value=\"Hybrid / Collaborative Engineering Team\">\n                  Hybrid / Collaborative Engineering Team\n                </option>\n                <option value=\"Remote-First Product Team\">Remote-First Product Team</option>\n                <option value=\"On-Site Enterprise / Client Facing\">\n                  On-Site Enterprise / Client Facing\n                </option>\n                <option value=\"Fast-Paced Early Stage Startup\">Fast-Paced Early Stage Startup</option>\n              </select>\n            </div>\n\n            <div>\n              <label htmlFor=\"rec-interests\" className=\"block text-xs font-medium text-stone-700 mb-1\">\n                Career Interests (comma-separated) *\n              </label>\n              <input\n                id=\"rec-interests\"\n                type=\"text\"\n                value={interestsInput}\n                onChange={(e) => setInterestsInput(e.target.value)}\n                placeholder=\"e.g. Full-Stack Web, Backend APIs, Cloud DevOps\"\n                className=\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg focus:outline-hidden focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500\"\n              />\n            </div>\n\n            <div>\n              <label htmlFor=\"rec-skills\" className=\"block text-xs font-medium text-stone-700 mb-1\">\n                Current Skills (comma-separated) *\n              </label>\n              <input\n                id=\"rec-skills\"\n                type=\"text\"\n                value={skillsInput}\n                onChange={(e) => setSkillsInput(e.target.value)}\n                placeholder=\"e.g. JavaScript, React, SQL, Git\"\n                className=\"w-full px-3 py-2 text-xs border border-stone-300 rounded-lg focus:outline-hidden focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500\"\n              />\n            </div>\n          </div>\n\n          <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-2 border-t border-stone-100\">\n            <p className=\"text-[11px] text-stone-500\">\n              Note: Fit percentages and INR salary ranges are approximate AI estimates based on your inputs, not guaranteed placement offers.\n            </p>\n            <button\n              type=\"submit\"\n              disabled={generating || loadingInitial}\n              className=\"inline-flex items-center justify-center gap-2 px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors disabled:opacity-50 whitespace-nowrap shrink-0\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5 text-indigo-400\" />\n              <span>{generating ? \'Analyzing Profile...\' : \'Get Recommendations\'}</span>\n            </button>\n          </div>\n        </form>\n\n        {/* Error State with Retry Button */}\n        {error && (\n          <div className=\"p-4 bg-red-50 border border-red-200 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-red-900\">\n            <div className=\"flex items-start gap-2.5\">\n              <AlertCircle className=\"w-4 h-4 text-red-600 shrink-0 mt-0.5\" />\n              <div>\n                <p className=\"font-semibold\">Failed to load AI career recommendations</p>\n                <p className=\"text-red-700 mt-0.5\">{error}</p>\n              </div>\n            </div>\n            <button\n              type=\"button\"\n              onClick={() => handleGenerate()}\n              disabled={generating}\n              className=\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-white bg-red-700 hover:bg-red-800 rounded-lg transition-colors self-start sm:self-auto shrink-0\"\n            >\n              <RotateCcw className=\"w-3.5 h-3.5\" />\n              <span>Retry</span>\n            </button>\n          </div>\n        )}\n\n        {/* Loading Skeleton */}\n        {generating && (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {[1, 2, 3, 4].map((n) => (\n              <div\n                key={n}\n                className=\"p-5 bg-white border border-stone-200 rounded-xl space-y-3 animate-pulse\"\n              >\n                <div className=\"h-5 bg-stone-200 rounded w-1/2\" />\n                <div className=\"h-2.5 bg-stone-100 rounded w-full\" />\n                <div className=\"h-12 bg-stone-100 rounded w-full\" />\n                <div className=\"h-8 bg-stone-100 rounded w-1/3\" />\n              </div>\n            ))}\n          </div>\n        )}\n\n        {/* Empty State */}\n        {!generating && careers.length === 0 && !error && (\n          <div className=\"p-10 bg-white border border-stone-200 rounded-xl text-center space-y-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center mx-auto\">\n              <Sparkles className=\"w-5 h-5\" />\n            </div>\n            <h2 className=\"text-sm font-bold text-slate-900\">No career recommendations generated yet</h2>\n            <p className=\"text-xs text-stone-600 max-w-md mx-auto\">\n              Review your pre-filled academic interests and skills above, then click{\' \'}\n              <span className=\"font-semibold text-slate-900\">Get Recommendations</span> to discover matching tech roles.\n            </p>\n          </div>\n        )}\n\n        {/* Results Grid */}\n        {!generating && careers.length > 0 && (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {careers.map((item, idx) => (\n              <div\n                key={`${item.title}-${idx}`}\n                className=\"p-5 bg-white border border-stone-200 rounded-xl shadow-2xs flex flex-col justify-between space-y-4\"\n              >\n                <div className=\"space-y-3\">\n                  <div className=\"flex items-start justify-between gap-3\">\n                    <div>\n                      <h3 className=\"text-base font-bold text-slate-900\">{item.title}</h3>\n                      <p className=\"text-xs text-stone-500 mt-0.5\">\n                        {item.approxSalaryRangeINR} \302\267 {item.growthOutlook}\n                      </p>\n                    </div>\n                    <div className=\"text-right shrink-0\">\n                      <span className=\"text-sm font-bold text-indigo-700 tabular-nums\">\n                        {item.matchPercent}%\n                      </span>\n                      <span className=\"block text-[10px] text-stone-500\">Est. Profile Fit</span>\n                    </div>\n                  </div>\n\n                  {/* Match % Progress Bar */}\n                  <div className=\"w-full h-2 bg-stone-100 rounded-full overflow-hidden\">\n                    <div\n                      className=\"h-full bg-indigo-600 rounded-full transition-all duration-300\"\n                      style={{ width: `${Math.min(100, Math.max(5, item.matchPercent))}%` }}\n                    />\n                  </div>\n\n                  <p className=\"text-xs text-stone-700 leading-relaxed\">{item.whyItFits}</p>\n\n                  {/* Required Skills */}\n                  <div>\n                    <span className=\"text-[11px] font-semibold text-stone-700 block mb-1\">\n                      Core Required Skills:\n                    </span>\n                    <p className=\"text-xs text-stone-600\">\n                      {item.requiredSkills.map((s, i) => (\n                        <span key={s}>\n                          {i > 0 && <span className=\"mx-1.5 text-stone-400\">\302\267</span>}\n                          <span className=\"inline-flex items-center gap-1\">\n                            <CheckCircle2 className=\"w-3 h-3 text-emerald-600 inline\" /> {s}\n                          </span>\n                        </span>\n                      ))}\n                    </p>\n                  </div>\n\n                  {/* Missing Skills */}\n                  <div>\n                    <span className=\"text-[11px] font-semibold text-stone-700 block mb-1\">\n                      Skills to Build Next:\n                    </span>\n                    {item.missingSkills.length === 0 ? (\n                      <span className=\"text-xs text-emerald-700\">\n                        You already cover the primary foundational skills!\n                      </span>\n                    ) : (\n                      <div className=\"flex flex-wrap gap-1.5\">\n                        {item.missingSkills.map((ms) => (\n                          <span\n                            key={ms}\n                            className=\"px-2 py-0.5 text-[11px] bg-amber-50 text-amber-900 border border-amber-200 rounded\"\n                          >\n                            + {ms}\n                          </span>\n                        ))}\n                      </div>\n                    )}\n                  </div>\n                </div>\n\n                <div className=\"pt-3 border-t border-stone-100 flex items-center justify-between gap-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() =>\n                      navigate(`/roadmap?role=${encodeURIComponent(item.title)}`)\n                    }\n                    className=\"w-full inline-flex items-center justify-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors\"\n                  >\n                    <Milestone className=\"w-3.5 h-3.5 text-indigo-400\" />\n                    <span>Create roadmap for this</span>\n                    <ArrowRight className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n    </AppShell>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/pages/RecommendationsPage.tsx"
        }
        overwrite: true
      }
    }
