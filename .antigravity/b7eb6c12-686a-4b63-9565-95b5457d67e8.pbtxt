    tool_calls {
      id: "call_14536730566148371841"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"export const en = {\\n  appName: \'Career Compass\',\\n  tagline: \'Clear career guidance, resume building, and skill tracking for every field and stage of life.\',\\n  nav: {\\n    dashboard: \'Dashboard\',\\n    careerIdeas: \'Career Ideas\',\\n    resume: \'Resume Builder\',\\n    skills: \'Skills & Certificates\',\\n    interview: \'Mock Interview\',\\n    roadmap: \'Learning Roadmap\',\\n    opportunities: \'Opportunities\',\\n    resources: \'Resources\',\\n    profile: \'Profile & Privacy\',\\n    admin: \'Admin Dashboard\',\\n    signIn: \'Sign In\',\\n    register: \'Get Started\',\\n    logout: \'Log Out\',\\n    themeLight: \'Light Mode\',\\n    themeDark: \'Dark Mode\',\\n  },\\n  stages: [\\n    \'school (class 9-12)\',\\n    \'undergraduate\',\\n    \'postgraduate\',\\n    \'diploma/vocational\',\\n    \'fresher\',\\n    \'working\',\\n    \'switching careers\',\\n    \'returning after a break\',\\n    \'self-taught\',\\n  ] as const,\\n  educationLevels: [\\n    \'Class 9\342\200\22310 / Secondary School\',\\n    \'Class 11\342\200\22312 / Higher Secondary\',\\n    \'Diploma / Vocational Trade Certificate\',\\n    \'Undergraduate Degree (BA, BCom, BSc, BTech, BBA, LLB, MBBS, etc.)\',\\n    \'Postgraduate Degree (MA, MCom, MSc, MBA, MEd, etc.)\',\\n    \'Doctorate / Research / Fellowship\',\\n    \'Self-Taught / Online Certifications\',\\n  ] as const,\\n  fieldsSuggestions: [\\n    \'Full-Stack Web Development & Software\',\\n    \'Healthcare, Nursing & Public Health\',\\n    \'Commerce, Accounting & Banking\',\\n    \'Education, Teaching & Counseling\',\\n    \'Law, Legal Studies & Public Policy\',\\n    \'Graphic Design, Media & Fine Arts\',\\n    \'Skilled Trades, Electrical & Mechanical\',\\n    \'Agriculture, Food Science & Environment\',\\n    \'Hospitality, Travel & Culinary Arts\',\\n    \'Business Management, Sales & Operations\',\\n  ],\\n  interestsSuggestions: [\\n    \'Full-Stack Development\',\\n    \'Patient Care & Clinical Support\',\\n    \'Financial Analysis & Bookkeeping\',\\n    \'Classroom Teaching & Mentoring\',\\n    \'Visual Design & Storytelling\',\\n    \'Legal Research & Advocacy\',\\n    \'Data & Spreadsheet Analysis\',\\n    \'Hands-on Building & Repair\',\\n    \'Customer Service & Hospitality\',\\n    \'Public Service & Community Work\',\\n  ],\\n  countries: [\\n    { country: \'India\', currency: \'INR\' },\\n    { country: \'United States\', currency: \'USD\' },\\n    { country: \'United Kingdom\', currency: \'GBP\' },\\n    { country: \'European Union\', currency: \'EUR\' },\\n    { country: \'Canada\', currency: \'CAD\' },\\n    { country: \'Australia\', currency: \'AUD\' },\\n    { country: \'Singapore\', currency: \'SGD\' },\\n  ],\\n  landing: {\\n    badge: \'For Students, Graduates, Career Switchers & Professionals Across All Fields\',\\n    heroTitle: \'Find your next career step and build a strong resume\342\200\224whatever your field.\',\\n    heroSubtitle:\\n      \'Whether you are in school, finishing a degree in arts, commerce, science, healthcare, law, or technology, switching fields, or returning after a career break\342\200\224Career Compass helps you plan and move forward.\',\\n    whoIsThisForTitle: \'Built for Every Stage and Every Field\',\\n    whoGroups: [\\n      {\\n        title: \'School & College Learners\',\\n        desc: \'Explore career paths across science, commerce, arts, vocational trades, healthcare, and technology.\',\\n      },\\n      {\\n        title: \'Freshers & Job Seekers\',\\n        desc: \'Build a clean, single-column PDF resume, track skills, and practice interview questions.\',\\n      },\\n      {\\n        title: \'Working Professionals & Switchers\',\\n        desc: \'Spot transferable skills, find adjacent roles, and follow a step-by-step learning plan.\',\\n      },\\n      {\\n        title: \'Returning After a Break\',\\n        desc: \'Refresh your resume, organize applications, and rebuild confidence at your own pace.\',\\n      },\\n    ],\\n  },\\n  privacy: {\\n    signupNote:\\n      \'Privacy commitment: We never ask for your age, gender, religion, caste, marital status, nationality, or photo. You can export all your data as JSON or delete your account at any time from your Profile page.\',\\n    exportTitle: \'Export My Data (JSON)\',\\n    exportDesc: \'Download a complete copy of your profile, skills, certificates, resume, roadmap, and tracked opportunities.\',\\n    deleteTitle: \'Delete My Account and Data\',\\n    deleteDesc: \'Permanently delete your account and all saved records across every tool. This cannot be undone.\',\\n    deleteConfirmPrompt: \'Are you sure you want to permanently delete your account and all associated data?\',\\n  },\\n  onboarding: {\\n    title: \'Welcome to Career Compass\',\\n    subtitle: \'Tell us a little about yourself in 3 quick steps so we can tailor your workspace. You can skip and finish later.\',\\n    step1Title: \'Step 1 of 3: Where are you right now?\',\\n    step2Title: \'Step 2 of 3: Your education and field\',\\n    step3Title: \'Step 3 of 3: Your interests and goal\',\\n    skipButton: \'Skip for now\',\\n    nudgeBanner: \'Complete your profile to get better career ideas and tailored learning plans.\',\\n  },\\n};\\n\", \"Description\":\"Centralized plain-English UI strings in i18n/en.ts with zero domain-biased jargon\", \"Overwrite\":true, \"TargetFile\":\"/src/i18n/en.ts\", \"toolAction\":\"Creating i18n dictionary\", \"toolSummary\":\"Create src/i18n/en.ts with universal plain-English copy\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_14536730566148374324"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { z } from \'zod\';\\n\\nexport type Role = \'user\' | \'admin\';\\n\\nexport type UserStage =\\n  | \'school (class 9-12)\'\\n  | \'undergraduate\'\\n  | \'postgraduate\'\\n  | \'diploma/vocational\'\\n  | \'fresher\'\\n  | \'working\'\\n  | \'switching careers\'\\n  | \'returning after a break\'\\n  | \'self-taught\';\\n\\nexport interface User {\\n  id: string;\\n  name: string;\\n  email: string;\\n  role: Role;\\n  active: boolean;\\n  onboarded: boolean;\\n  createdAt: string;\\n}\\n\\nexport interface Profile {\\n  userId: string;\\n  currentStatus: UserStage;\\n  educationLevel: string;\\n  fieldOfStudy: string;\\n  experienceYears: number;\\n  interests: string[];\\n  careerGoal: string;\\n  country: string;\\n  currency: string;\\n  bio: string;\\n  preferredWorkStyle?: string;\\n}\\n\\nexport const ProfileSchema = z.object({\\n  currentStatus: z.string().min(1, \'Please select your current stage.\'),\\n  educationLevel: z.string().trim().min(2, \'Please enter your education level.\').max(150),\\n  fieldOfStudy: z.string().trim().min(2, \'Please enter your field of study or work.\').max(150),\\n  experienceYears: z.number().min(0, \'Experience cannot be negative.\').max(60),\\n  interests: z.array(z.string().trim().min(1).max(80)).min(1, \'Please add at least one interest.\').max(20),\\n  careerGoal: z.string().trim().min(2, \'Please enter a career goal or target role.\').max(180),\\n  country: z.string().trim().min(2, \'Please select a country.\').max(80),\\n  currency: z.string().trim().min(2, \'Please select a currency.\').max(10),\\n  bio: z.string().trim().max(1000),\\n});\\n\\nexport type ResumeMode = \'fresher\' | \'experienced\' | \'academic\';\\n\\nexport type OptionalSectionType =\\n  | \'volunteering\'\\n  | \'languages\'\\n  | \'achievements\'\\n  | \'publications\'\\n  | \'extracurricular\';\\n\\nexport interface OptionalSection {\\n  type: OptionalSectionType;\\n  title: string;\\n  items: string[];\\n}\\n\\nexport interface PersonalInfo {\\n  name: string;\\n  email: string;\\n  phone: string;\\n  location: string;\\n  links: string[];\\n}\\n\\nexport interface EducationItem {\\n  degree: string;\\n  institution: string;\\n  startYear: string;\\n  endYear: string;\\n  scoreOrCgpa: string;\\n}\\n\\nexport interface ExperienceItem {\\n  role: string;\\n  company: string;\\n  location: string;\\n  startDate: string;\\n  endDate: string;\\n  description: string;\\n}\\n\\nexport interface ProjectItem {\\n  title: string;\\n  techStack: string[];\\n  link?: string;\\n  description: string;\\n}\\n\\nexport interface Resume {\\n  userId: string;\\n  mode: ResumeMode;\\n  personal: PersonalInfo;\\n  summary: string;\\n  education: EducationItem[];\\n  experience: ExperienceItem[];\\n  projects: ProjectItem[];\\n  skills: string[];\\n  certifications: string[];\\n  optionalSections: OptionalSection[];\\n  lastScore?: number;\\n}\\n\\nexport type SkillCategory = \'technical\' | \'soft\' | \'domain\' | \'language\';\\n\\nexport interface Skill {\\n  id: string;\\n  userId: string;\\n  name: string;\\n  category: SkillCategory;\\n  level: number; // 1-5\\n}\\n\\nexport interface Certificate {\\n  id: string;\\n  userId: string;\\n  title: string;\\n  issuer: string;\\n  date: string;\\n  fileDataUrl?: string;\\n  fileName?: string;\\n}\\n\\nexport type OpportunityType =\\n  | \'job\'\\n  | \'internship\'\\n  | \'exam\'\\n  | \'scholarship\'\\n  | \'admission\'\\n  | \'freelance\';\\n\\nexport type OpportunityStatus =\\n  | \'saved\'\\n  | \'applied\'\\n  | \'interview\'\\n  | \'offer\'\\n  | \'rejected\'\\n  | \'closed\';\\n\\nexport interface Opportunity {\\n  id: string;\\n  userId: string;\\n  title: string;\\n  organization: string;\\n  type: OpportunityType;\\n  status: OpportunityStatus;\\n  deadline: string;\\n  appliedDate: string;\\n  notes: string;\\n}\\n\\nexport interface RoadmapPlan {\\n  id: string;\\n  userId: string;\\n  targetRole: string;\\n  data: {\\n    phases: {\\n      title: string;\\n      weeks: string;\\n      topics: string[];\\n      practiceIdea: string;\\n      freeResources: { name: string; type: string }[];\\n    }[];\\n  };\\n  progress: string[]; // checked topic keys\\n  createdAt: string;\\n}\\n\\nexport interface CareerResult {\\n  userId: string;\\n  data: {\\n    careers: {\\n      title: string;\\n      category: \'best-fit\' | \'adjacent\' | \'stretch\';\\n      matchPercent: number;\\n      whyItFits: string;\\n      requiredSkills: string[];\\n      missingSkills: string[];\\n      typicalEntryRoutes: string[];\\n      approxSalaryRange: string;\\n      growthOutlook: string;\\n    }[];\\n  };\\n  createdAt: string;\\n}\\n\\nexport interface Resource {\\n  id: string;\\n  title: string;\\n  category: string;\\n  link: string;\\n  description: string;\\n  createdBy: string;\\n}\\n\\nexport interface InterviewSessionState {\\n  userId: string;\\n  role: string;\\n  field: string;\\n  difficulty: \'Beginner\' | \'Intermediate\' | \'Advanced\';\\n  type: \'technical\' | \'hr\' | \'mixed\' | \'viva\';\\n  questions: {\\n    id: string;\\n    question: string;\\n    type: string;\\n    idealAnswerPoints: string[];\\n  }[];\\n  currentIndex: number;\\n  answers: Record<\\n    string,\\n    {\\n      userAnswer: string;\\n      skipped?: boolean;\\n      evaluation?: {\\n        score: number;\\n        feedback: string;\\n        improvedAnswer: string;\\n      };\\n    }\\n  >;\\n  completed: boolean;\\n  updatedAt: string;\\n}\\n\", \"Description\":\"Exact data models from Section 5 plus Zod validation schemas\", \"Overwrite\":true, \"TargetFile\":\"/src/types/index.ts\", \"toolAction\":\"Updating domain models\", \"toolSummary\":\"Update src/types/index.ts with Section 5 models and Zod schema\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_14536730566148372711"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { z } from \'zod\';\\n\\n// A) Career Ideas\\nexport interface CareerIdeasInput {\\n  educationLevel: string;\\n  fieldOfStudy: string;\\n  currentStatus: string;\\n  experienceYears: number;\\n  interests: string[];\\n  skills: string[];\\n  preferredWorkStyle: string;\\n  country: string;\\n  currency: string;\\n}\\n\\nexport const CareerIdeaItemSchema = z.object({\\n  title: z.string().min(1),\\n  category: z.enum([\'best-fit\', \'adjacent\', \'stretch\']).catch(\'best-fit\'),\\n  matchPercent: z.number().min(0).max(100),\\n  whyItFits: z.string().min(1),\\n  requiredSkills: z.array(z.string()),\\n  missingSkills: z.array(z.string()),\\n  typicalEntryRoutes: z.array(z.string()).default([\'Entry-level role or apprenticeship\']),\\n  approxSalaryRange: z.string().min(1),\\n  growthOutlook: z.string().min(1),\\n});\\n\\nexport const CareerIdeasOutputSchema = z.object({\\n  careers: z.array(CareerIdeaItemSchema).min(1).max(6),\\n});\\n\\nexport type CareerIdeaItem = z.infer<typeof CareerIdeaItemSchema>;\\nexport type CareerIdeasOutput = z.infer<typeof CareerIdeasOutputSchema>;\\n\\n// B) Resume Review\\nexport const ResumeSuggestionSchema = z.object({\\n  section: z.string().min(1),\\n  issue: z.string().min(1),\\n  improvedText: z.string().min(1),\\n});\\n\\nexport const ResumeReviewOutputSchema = z.object({\\n  score: z.number().min(0).max(100),\\n  strengths: z.array(z.string()),\\n  weaknesses: z.array(z.string()),\\n  suggestions: z.array(ResumeSuggestionSchema),\\n  keywordsMissing: z.array(z.string()).default([]),\\n});\\n\\nexport type ResumeReviewSuggestion = z.infer<typeof ResumeSuggestionSchema>;\\nexport type ResumeReviewOutput = z.infer<typeof ResumeReviewOutputSchema>;\\n\\n// C) Mock Interview\\nexport const InterviewQuestionSchema = z.object({\\n  id: z.string().min(1),\\n  question: z.string().min(1),\\n  type: z.string().min(1),\\n  idealAnswerPoints: z.array(z.string()),\\n});\\n\\nexport const MockInterviewQuestionsOutputSchema = z.object({\\n  questions: z.array(InterviewQuestionSchema).min(1).max(8),\\n});\\n\\nexport const AnswerEvaluationOutputSchema = z.object({\\n  score: z.number().min(0).max(10),\\n  feedback: z.string().min(1),\\n  improvedAnswer: z.string().min(1),\\n});\\n\\nexport type InterviewQuestion = z.infer<typeof InterviewQuestionSchema>;\\nexport type MockInterviewQuestionsOutput = z.infer<typeof MockInterviewQuestionsOutputSchema>;\\nexport type AnswerEvaluationOutput = z.infer<typeof AnswerEvaluationOutputSchema>;\\n\\n// D) Learning Roadmap\\nexport const RoadmapResourceSchema = z.object({\\n  name: z.string().min(1),\\n  type: z.string().min(1),\\n});\\n\\nexport const RoadmapPhaseSchema = z.object({\\n  title: z.string().min(1),\\n  weeks: z.string().min(1),\\n  topics: z.array(z.string()),\\n  practiceIdea: z.string().min(1),\\n  freeResources: z.array(RoadmapResourceSchema),\\n});\\n\\nexport const LearningRoadmapOutputSchema = z.object({\\n  phases: z.array(RoadmapPhaseSchema).min(1),\\n});\\n\\nexport type RoadmapPhase = z.infer<typeof RoadmapPhaseSchema>;\\nexport type LearningRoadmapOutput = z.infer<typeof LearningRoadmapOutputSchema>;\\n\", \"Description\":\"Zod schemas and TypeScript types for AI contracts A, B, C, and D\", \"Overwrite\":true, \"TargetFile\":\"/src/types/ai.ts\", \"toolAction\":\"Updating AI schemas with Zod\", \"toolSummary\":\"Update src/types/ai.ts with Zod schemas for A, B, C, and D\"}"
      original_name: "write_to_file"
    }
    thinking_duration {
      seconds: 47
      nanos: 958538882
    }
    stop_reason: STOP_REASON_STOP_PATTERN
    provider_assigned_message_id: "kmP0aoTXG-GP28oP1ZfvMA"
  }
}
