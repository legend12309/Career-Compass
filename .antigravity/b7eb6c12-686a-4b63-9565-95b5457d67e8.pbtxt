  code_action {
    action_spec {
      create_file {
        instruction: "import { useEffect, useState } from \'react\';\nimport { Link } from \'react-router-dom\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { Profile, Skill, Application, Resume, RoadmapPlan } from \'../types\';\nimport {\n  getProfile,\n  listSkills,\n  listApplications,\n  getResume,\n  getRoadmap,\n} from \'../services/db\';\nimport { AppShell } from \'../components/layout/AppShell\';\nimport {\n  BarChart,\n  Bar,\n  XAxis,\n  YAxis,\n  Tooltip,\n  ResponsiveContainer,\n  Cell,\n} from \'recharts\';\nimport {\n  Sparkles,\n  FileText,\n  MessageSquareCode,\n  Briefcase,\n  Award,\n  Milestone,\n  Edit3,\n  ArrowRight,\n} from \'lucide-react\';\n\nexport function DashboardPage() {\n  const { user } = useAuth();\n  const [profile, setProfile] = useState<Profile | null>(null);\n  const [skills, setSkills] = useState<Skill[]>([]);\n  const [applications, setApplications] = useState<Application[]>([]);\n  const [resume, setResume] = useState<Resume | null>(null);\n  const [roadmap, setRoadmap] = useState<RoadmapPlan | null>(null);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    async function load() {\n      if (!user) return;\n      setLoading(true);\n      try {\n        const [prof, sk, apps, res, rm] = await Promise.all([\n          getProfile(user.id),\n          listSkills(user.id),\n          listApplications(user.id),\n          getResume(user.id),\n          getRoadmap(user.id),\n        ]);\n        setProfile(prof);\n        setSkills(sk);\n        setApplications(apps);\n        setResume(res);\n        setRoadmap(rm);\n      } catch (err) {\n        console.error(\'Error loading dashboard metrics:\', err);\n      } finally {\n        setLoading(false);\n      }\n    }\n    load();\n  }, [user]);\n\n  // 1. Exact Profile Completion % Calculation\n  const computeProfileCompletion = (): number => {\n    if (!profile) return 0;\n    const checks = [\n      Boolean(profile.education?.trim()),\n      Boolean(profile.branch?.trim()),\n      Boolean(profile.year?.trim()),\n      (profile.interests?.length || 0) > 0,\n      Boolean(profile.careerGoal?.trim()),\n      Boolean(profile.bio?.trim()),\n    ];\n    const passed = checks.filter(Boolean).length;\n    return Math.round((passed / checks.length) * 100);\n  };\n\n  // 2. Exact Roadmap Progress % Calculation\n  const computeRoadmapPercent = (): number => {\n    if (!roadmap?.data?.phases) return 0;\n    const allKeys: string[] = [];\n    roadmap.data.phases.forEach((ph, pIdx) => {\n      ph.topics.forEach((t, tIdx) => {\n        allKeys.push(`${pIdx}-${tIdx}-${t}`);\n      });\n    });\n    if (allKeys.length === 0) return 0;\n    const done = allKeys.filter((k) => roadmap.completedTopics.includes(k)).length;\n    return Math.round((done / allKeys.length) * 100);\n  };\n\n  const profileCompletion = computeProfileCompletion();\n  const roadmapProgress = computeRoadmapPercent();\n  const resumeScore = resume?.lastReviewScore ?? 0;\n\n  const statusData = [\n    { name: \'Saved\', count: applications.filter((a) => a.status === \'saved\').length, color: \'#64748b\' },\n    { name: \'Applied\', count: applications.filter((a) => a.status === \'applied\').length, color: \'#4f46e5\' },\n    { name: \'Interview\', count: applications.filter((a) => a.status === \'interview\').length, color: \'#d97706\' },\n    { name: \'Offer\', count: applications.filter((a) => a.status === \'offer\').length, color: \'#16a34a\' },\n    { name: \'Rejected\', count: applications.filter((a) => a.status === \'rejected\').length, color: \'#dc2626\' },\n  ];\n\n  const skillChartData = skills.slice(0, 6).map((s) => ({\n    name: s.name.length > 16 ? `${s.name.slice(0, 14)}\342\200\246` : s.name,\n    level: s.level,\n  }));\n\n  return (\n    <AppShell>\n      <div className=\"space-y-6\">\n        {/* Welcome Header */}\n        <div className=\"p-6 bg-white border border-stone-200 rounded-xl shadow-2xs flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4\">\n          <div>\n            <div className=\"text-xs text-stone-500 mb-1\">\n              BCA Placement & Career Readiness Hub \302\267 <span className=\"capitalize\">{user?.role}</span>\n            </div>\n            <h1 className=\"text-xl sm:text-2xl font-bold text-slate-900\">\n              Welcome back, {user?.name}\n            </h1>\n            <p className=\"text-xs sm:text-sm text-stone-600 mt-1\">\n              Target Goal:{\' \'}\n              <span className=\"font-semibold text-slate-900\">\n                {profile?.careerGoal || \'Not set yet \342\200\224 complete your profile to get started\'}\n              </span>\n            </p>\n          </div>\n\n          <div className=\"flex items-center gap-2 shrink-0\">\n            <Link\n              to=\"/profile\"\n              className=\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-medium text-stone-800 bg-stone-100 hover:bg-stone-200 rounded-lg transition-colors\"\n            >\n              <Edit3 className=\"w-3.5 h-3.5\" />\n              <span>Edit Profile</span>\n            </Link>\n            <Link\n              to=\"/recommendations\"\n              className=\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5 text-indigo-400\" />\n              <span>AI Career Match</span>\n            </Link>\n          </div>\n        </div>\n\n        {/* Onboarding Nudge if Profile < 100% */}\n        {!loading && profileCompletion < 100 && (\n          <div className=\"p-4 bg-indigo-50/70 border border-indigo-200 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-indigo-950\">\n            <div>\n              <span className=\"font-bold\">Onboarding Tip:</span> Your career profile is{\' \'}\n              <strong className=\"tabular-nums\">{profileCompletion}%</strong> complete. Adding your bio and career goal improves AI recommendation accuracy.\n            </div>\n            <Link\n              to=\"/profile\"\n              className=\"inline-flex items-center gap-1 font-semibold text-indigo-700 hover:text-indigo-900 shrink-0\"\n            >\n              <span>Complete Profile</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </Link>\n          </div>\n        )}\n\n        {/* 5 Key Metric Summary Cards */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4\">\n          <Link\n            to=\"/profile\"\n            className=\"p-4 bg-white border border-stone-200 hover:border-stone-300 rounded-xl shadow-2xs space-y-1 transition-colors\"\n          >\n            <span className=\"text-xs text-stone-500\">Profile Completion</span>\n            <p className=\"text-2xl font-extrabold text-slate-900 tabular-nums\">\n              {profileCompletion}%\n            </p>\n            <span className=\"text-[11px] text-indigo-600 font-medium block\">\n              {profile?.year || \'Update degree info\'}\n            </span>\n          </Link>\n\n          <Link\n            to=\"/skills\"\n            className=\"p-4 bg-white border border-stone-200 hover:border-stone-300 rounded-xl shadow-2xs space-y-1 transition-colors\"\n          >\n            <span className=\"text-xs text-stone-500\">Skills Tracked</span>\n            <p className=\"text-2xl font-extrabold text-slate-900 tabular-nums\">\n              {skills.length}\n            </p>\n            <span className=\"text-[11px] text-stone-600 block tabular-nums\">\n              {skills.filter((s) => s.category === \'technical\').length} tech \302\267{\' \'}\n              {skills.filter((s) => s.category === \'soft\').length} soft\n            </span>\n          </Link>\n\n          <Link\n            to=\"/resume\"\n            className=\"p-4 bg-white border border-stone-200 hover:border-stone-300 rounded-xl shadow-2xs space-y-1 transition-colors\"\n          >\n            <span className=\"text-xs text-stone-500\">ATS Resume Score</span>\n            <p className=\"text-2xl font-extrabold text-slate-900 tabular-nums\">\n              {resumeScore > 0 ? `${resumeScore}/100` : \'Unscored\'}\n            </p>\n            <span className=\"text-[11px] text-indigo-600 font-medium block\">\n              {resumeScore > 0 ? \'Reviewed by AI\' : \'Run AI Review \342\206\222\'}\n            </span>\n          </Link>\n\n          <Link\n            to=\"/tracker\"\n            className=\"p-4 bg-white border border-stone-200 hover:border-stone-300 rounded-xl shadow-2xs space-y-1 transition-colors\"\n          >\n            <span className=\"text-xs text-stone-500\">Applications</span>\n            <p className=\"text-2xl font-extrabold text-slate-900 tabular-nums\">\n              {applications.length}\n            </p>\n            <span className=\"text-[11px] text-emerald-700 font-medium block tabular-nums\">\n              {applications.filter((a) => a.status === \'interview\' || a.status === \'offer\').length}{\' \'}\n              active interview/offer\n            </span>\n          </Link>\n\n          <Link\n            to=\"/roadmap\"\n            className=\"p-4 bg-white border border-stone-200 hover:border-stone-300 rounded-xl shadow-2xs space-y-1 transition-colors col-span-2 sm:col-span-1\"\n          >\n            <span className=\"text-xs text-stone-500\">Roadmap Progress</span>\n            <p className=\"text-2xl font-extrabold text-slate-900 tabular-nums\">\n              {roadmapProgress}%\n            </p>\n            <span className=\"text-[11px] text-stone-600 block truncate\">\n              {roadmap?.targetRole || \'Generate study plan \342\206\222\'}\n            </span>\n          </Link>\n        </div>\n\n        {/* Charts Row (Recharts) */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n          {/* Applications by Status Bar Chart */}\n          <div className=\"p-5 bg-white border border-stone-200 rounded-xl shadow-2xs space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <h2 className=\"text-sm font-bold text-slate-900\">Applications by Stage</h2>\n                <p className=\"text-xs text-stone-500\">\n                  Real-time count from your Internship & Job Kanban board\n                </p>\n              </div>\n              <Link\n                to=\"/tracker\"\n                className=\"text-xs font-semibold text-indigo-600 hover:text-indigo-800\"\n              >\n                Open Board \342\206\222\n              </Link>\n            </div>\n\n            <div className=\"h-56 w-full\">\n              <ResponsiveContainer width=\"100%\" height=\"100%\">\n                <BarChart data={statusData} margin={{ top: 8, right: 12, left: -16, bottom: 0 }}>\n                  <XAxis dataKey=\"name\" tick={{ fontSize: 11, fill: \'#57534e\' }} />\n                  <YAxis allowDecimals={false} tick={{ fontSize: 11, fill: \'#57534e\' }} />\n                  <Tooltip\n                    contentStyle={{\n                      fontSize: \'12px\',\n                      borderRadius: \'8px\',\n                      border: \'1px solid #e7e5e4\',\n                    }}\n                  />\n                  <Bar dataKey=\"count\" radius={[6, 6, 0, 0]}>\n                    {statusData.map((entry, index) => (\n                      <Cell key={`cell-${index}`} fill={entry.color} />\n                    ))}\n                  </Bar>\n                </BarChart>\n              </ResponsiveContainer>\n            </div>\n          </div>\n\n          {/* Top Skills Proficiency Chart */}\n          <div className=\"p-5 bg-white border border-stone-200 rounded-xl shadow-2xs space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <h2 className=\"text-sm font-bold text-slate-900\">Skill Proficiency Overview</h2>\n                <p className=\"text-xs text-stone-500\">Self-assessed ratings (Scale 1 to 5)</p>\n              </div>\n              <Link\n                to=\"/skills\"\n                className=\"text-xs font-semibold text-indigo-600 hover:text-indigo-800\"\n              >\n                Manage Skills \342\206\222\n              </Link>\n            </div>\n\n            {skillChartData.length === 0 ? (\n              <div className=\"h-56 flex flex-col items-center justify-center text-center p-4 bg-stone-50 rounded-lg\">\n                <Award className=\"w-6 h-6 text-stone-400 mb-2\" />\n                <p className=\"text-xs text-stone-600 mb-2\">\n                  Add skills in the Skill Tracker to visualize your proficiency distribution.\n                </p>\n                <Link\n                  to=\"/skills\"\n                  className=\"px-3 py-1.5 text-xs font-semibold text-white bg-slate-900 rounded-lg\"\n                >\n                  Add First Skill\n                </Link>\n              </div>\n            ) : (\n              <div className=\"h-56 w-full\">\n                <ResponsiveContainer width=\"100%\" height=\"100%\">\n                  <BarChart\n                    data={skillChartData}\n                    margin={{ top: 8, right: 12, left: -16, bottom: 0 }}\n                  >\n                    <XAxis dataKey=\"name\" tick={{ fontSize: 11, fill: \'#57534e\' }} />\n                    <YAxis domain={[0, 5]} ticks={[0, 1, 2, 3, 4, 5]} tick={{ fontSize: 11, fill: \'#57534e\' }} />\n                    <Tooltip\n                      contentStyle={{\n                        fontSize: \'12px\',\n                        borderRadius: \'8px\',\n                        border: \'1px solid #e7e5e4\',\n                      }}\n                    />\n                    <Bar dataKey=\"level\" fill=\"#4f46e5\" radius={[6, 6, 0, 0]} />\n                  </BarChart>\n                </ResponsiveContainer>\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Quick Navigation Grid */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n          <Link\n            to=\"/recommendations\"\n            className=\"p-4 bg-white border border-stone-200 hover:border-indigo-300 rounded-xl shadow-2xs transition-colors\"\n          >\n            <Sparkles className=\"w-4 h-4 text-indigo-600 mb-2\" />\n            <h3 className=\"text-xs font-bold text-slate-900\">1. AI Career Match</h3>\n            <p className=\"text-[11px] text-stone-600 mt-1\">\n              Compare your BCA skills against high-demand tech roles.\n            </p>\n          </Link>\n\n          <Link\n            to=\"/resume\"\n            className=\"p-4 bg-white border border-stone-200 hover:border-indigo-300 rounded-xl shadow-2xs transition-colors\"\n          >\n            <FileText className=\"w-4 h-4 text-indigo-600 mb-2\" />\n            <h3 className=\"text-xs font-bold text-slate-900\">2. ATS Resume & PDF</h3>\n            <p className=\"text-[11px] text-stone-600 mt-1\">\n              Build your single-column resume, apply AI fixes, and export PDF.\n            </p>\n          </Link>\n\n          <Link\n            to=\"/interview\"\n            className=\"p-4 bg-white border border-stone-200 hover:border-indigo-300 rounded-xl shadow-2xs transition-colors\"\n          >\n            <MessageSquareCode className=\"w-4 h-4 text-indigo-600 mb-2\" />\n            <h3 className=\"text-xs font-bold text-slate-900\">3. Mock Interview</h3>\n            <p className=\"text-[11px] text-stone-600 mt-1\">\n              Practice 8-question technical & HR placement rounds.\n            </p>\n          </Link>\n\n          <Link\n            to=\"/roadmap\"\n            className=\"p-4 bg-white border border-stone-200 hover:border-indigo-300 rounded-xl shadow-2xs transition-colors\"\n          >\n            <Milestone className=\"w-4 h-4 text-indigo-600 mb-2\" />\n            <h3 className=\"text-xs font-bold text-slate-900\">4. Learning Roadmap</h3>\n            <p className=\"text-[11px] text-stone-600 mt-1\">\n              Follow weekly topic milestones and portfolio project ideas.\n            </p>\n          </Link>\n        </div>\n      </div>\n    </AppShell>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/pages/DashboardPage.tsx"
        }
        overwrite: true
      }
    }
