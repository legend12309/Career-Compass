  code_action {
    action_spec {
      create_file {
        instruction: "import { z } from \'zod\';\n\nexport type Role = \'user\' | \'admin\';\n\nexport type UserStage =\n  | \'school (class 9-12)\'\n  | \'undergraduate\'\n  | \'postgraduate\'\n  | \'diploma/vocational\'\n  | \'fresher\'\n  | \'working\'\n  | \'switching careers\'\n  | \'returning after a break\'\n  | \'self-taught\';\n\nexport interface User {\n  id: string;\n  name: string;\n  email: string;\n  role: Role;\n  active: boolean;\n  onboarded: boolean;\n  createdAt: string;\n}\n\nexport interface Profile {\n  userId: string;\n  currentStatus: UserStage;\n  educationLevel: string;\n  fieldOfStudy: string;\n  experienceYears: number;\n  interests: string[];\n  careerGoal: string;\n  country: string;\n  currency: string;\n  bio: string;\n  preferredWorkStyle?: string;\n}\n\nexport const ProfileSchema = z.object({\n  currentStatus: z.string().min(1, \'Please select your current stage.\'),\n  educationLevel: z.string().trim().min(2, \'Please enter your education level.\').max(150),\n  fieldOfStudy: z.string().trim().min(2, \'Please enter your field of study or work.\').max(150),\n  experienceYears: z.number().min(0, \'Experience cannot be negative.\').max(60),\n  interests: z.array(z.string().trim().min(1).max(80)).min(1, \'Please add at least one interest.\').max(20),\n  careerGoal: z.string().trim().min(2, \'Please enter a career goal or target role.\').max(180),\n  country: z.string().trim().min(2, \'Please select a country.\').max(80),\n  currency: z.string().trim().min(2, \'Please select a currency.\').max(10),\n  bio: z.string().trim().max(1000),\n});\n\nexport type ResumeMode = \'fresher\' | \'experienced\' | \'academic\';\n\nexport type OptionalSectionType =\n  | \'volunteering\'\n  | \'languages\'\n  | \'achievements\'\n  | \'publications\'\n  | \'extracurricular\';\n\nexport interface OptionalSection {\n  type: OptionalSectionType;\n  title: string;\n  items: string[];\n}\n\nexport interface PersonalInfo {\n  name: string;\n  email: string;\n  phone: string;\n  location: string;\n  links: string[];\n}\n\nexport interface EducationItem {\n  degree: string;\n  institution: string;\n  startYear: string;\n  endYear: string;\n  scoreOrCgpa: string;\n}\n\nexport interface ExperienceItem {\n  role: string;\n  company: string;\n  location: string;\n  startDate: string;\n  endDate: string;\n  description: string;\n}\n\nexport interface ProjectItem {\n  title: string;\n  techStack: string[];\n  link?: string;\n  description: string;\n}\n\nexport interface Resume {\n  userId: string;\n  mode: ResumeMode;\n  personal: PersonalInfo;\n  summary: string;\n  education: EducationItem[];\n  experience: ExperienceItem[];\n  projects: ProjectItem[];\n  skills: string[];\n  certifications: string[];\n  optionalSections: OptionalSection[];\n  lastScore?: number;\n}\n\nexport type SkillCategory = \'technical\' | \'soft\' | \'domain\' | \'language\';\n\nexport interface Skill {\n  id: string;\n  userId: string;\n  name: string;\n  category: SkillCategory;\n  level: number; // 1-5\n}\n\nexport interface Certificate {\n  id: string;\n  userId: string;\n  title: string;\n  issuer: string;\n  date: string;\n  fileDataUrl?: string;\n  fileName?: string;\n}\n\nexport type OpportunityType =\n  | \'job\'\n  | \'internship\'\n  | \'exam\'\n  | \'scholarship\'\n  | \'admission\'\n  | \'freelance\';\n\nexport type OpportunityStatus =\n  | \'saved\'\n  | \'applied\'\n  | \'interview\'\n  | \'offer\'\n  | \'rejected\'\n  | \'closed\';\n\nexport interface Opportunity {\n  id: string;\n  userId: string;\n  title: string;\n  organization: string;\n  type: OpportunityType;\n  status: OpportunityStatus;\n  deadline: string;\n  appliedDate: string;\n  notes: string;\n}\n\nexport interface RoadmapPlan {\n  id: string;\n  userId: string;\n  targetRole: string;\n  data: {\n    phases: {\n      title: string;\n      weeks: string;\n      topics: string[];\n      practiceIdea: string;\n      freeResources: { name: string; type: string }[];\n    }[];\n  };\n  progress: string[]; // checked topic keys\n  createdAt: string;\n}\n\nexport interface CareerResult {\n  userId: string;\n  data: {\n    careers: {\n      title: string;\n      category: \'best-fit\' | \'adjacent\' | \'stretch\';\n      matchPercent: number;\n      whyItFits: string;\n      requiredSkills: string[];\n      missingSkills: string[];\n      typicalEntryRoutes: string[];\n      approxSalaryRange: string;\n      growthOutlook: string;\n    }[];\n  };\n  createdAt: string;\n}\n\nexport interface Resource {\n  id: string;\n  title: string;\n  category: string;\n  link: string;\n  description: string;\n  createdBy: string;\n}\n\nexport interface InterviewSessionState {\n  userId: string;\n  role: string;\n  field: string;\n  difficulty: \'Beginner\' | \'Intermediate\' | \'Advanced\';\n  type: \'technical\' | \'hr\' | \'mixed\' | \'viva\';\n  questions: {\n    id: string;\n    question: string;\n    type: string;\n    idealAnswerPoints: string[];\n  }[];\n  currentIndex: number;\n  answers: Record<\n    string,\n    {\n      userAnswer: string;\n      skipped?: boolean;\n      evaluation?: {\n        score: number;\n        feedback: string;\n        improvedAnswer: string;\n      };\n    }\n  >;\n  completed: boolean;\n  updatedAt: string;\n}\n"
        path {
          absolute_uri: "file:///src/types/index.ts"
        }
        overwrite: true
      }
    }
