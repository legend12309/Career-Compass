  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport { useAuth } from \'../context/AuthContext\';\nimport {\n  getProfile,\n  getInterviewSession,\n  saveInterviewSession,\n  clearInterviewSession,\n} from \'../services/db\';\nimport { generateInterviewQuestions, evaluateAnswer } from \'../services/ai\';\nimport { InterviewSessionState } from \'../types\';\nimport {\n  MessageSquare,\n  Sparkles,\n  Loader2,\n  AlertCircle,\n  CheckCircle2,\n  SkipForward,\n  RotateCcw,\n  Award,\n} from \'lucide-react\';\n\nexport const InterviewPage: React.FC = () => {\n  const { user } = useAuth();\n  const [role, setRole] = useState(\'Full-Stack Developer\');\n  const [field, setField] = useState(\'Software & Web Development\');\n  const [difficulty, setDifficulty] = useState<\'Beginner\' | \'Intermediate\' | \'Advanced\'>(\n    \'Intermediate\'\n  );\n  const [interviewType, setInterviewType] = useState<\'technical\' | \'hr\' | \'mixed\' | \'viva\'>(\n    \'mixed\'\n  );\n  const [session, setSession] = useState<InterviewSessionState | null>(null);\n  const [currentAnswer, setCurrentAnswer] = useState(\'\');\n  const [isGenerating, setIsGenerating] = useState(false);\n  const [isEvaluating, setIsEvaluating] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => {\n    let active = true;\n    async function load() {\n      if (!user) return;\n      const [prof, existingSession] = await Promise.all([\n        getProfile(),\n        getInterviewSession(),\n      ]);\n      if (!active) return;\n\n      if (prof?.careerGoal) setRole(prof.careerGoal);\n      if (prof?.fieldOfStudy) setField(prof.fieldOfStudy);\n\n      if (existingSession) {\n        setSession(existingSession);\n        setRole(existingSession.role);\n        setField(existingSession.field);\n        setDifficulty(existingSession.difficulty);\n        setInterviewType(existingSession.type);\n        const currentQ = existingSession.questions[existingSession.currentIndex];\n        if (currentQ && existingSession.answers[currentQ.id]) {\n          setCurrentAnswer(existingSession.answers[currentQ.id].userAnswer || \'\');\n        }\n      }\n    }\n    load();\n    return () => {\n      active = false;\n    };\n  }, [user]);\n\n  if (!user) return null;\n\n  const handleStartSession = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!role.trim()) {\n      setError(\'Please enter a target role or exam topic.\');\n      return;\n    }\n    setError(null);\n    setIsGenerating(true);\n    try {\n      const output = await generateInterviewQuestions({\n        role: role.trim(),\n        field: field.trim() || \'General\',\n        difficulty,\n        type: interviewType,\n      });\n      const newSession: Omit<InterviewSessionState, \'userId\'> = {\n        role: role.trim(),\n        field: field.trim() || \'General\',\n        difficulty,\n        type: interviewType,\n        questions: output.questions,\n        currentIndex: 0,\n        answers: {},\n        completed: false,\n        updatedAt: new Date().toISOString(),\n      };\n      const saved = await saveInterviewSession(newSession);\n      setSession(saved);\n      setCurrentAnswer(\'\');\n    } catch (err: unknown) {\n      setError(\n        err instanceof Error ? err.message : \'Could not generate questions. Please click Retry.\'\n      );\n    } finally {\n      setIsGenerating(false);\n    }\n  };\n\n  const handleSubmitAnswer = async () => {\n    if (!session) return;\n    const currentQ = session.questions[session.currentIndex];\n    if (!currentQ) return;\n\n    const trimmed = currentAnswer.trim();\n    if (trimmed.length < 5) {\n      setError(\'Please write at least a brief answer before submitting, or click Skip Question.\');\n      return;\n    }\n\n    setError(null);\n    setIsEvaluating(true);\n    try {\n      const evaluation = await evaluateAnswer(currentQ.question, trimmed);\n      const updatedAnswers = {\n        ...session.answers,\n        [currentQ.id]: {\n          userAnswer: trimmed,\n          skipped: false,\n          evaluation,\n        },\n      };\n      const saved = await saveInterviewSession({\n        ...session,\n        answers: updatedAnswers,\n        updatedAt: new Date().toISOString(),\n      });\n      setSession(saved);\n    } catch (err: unknown) {\n      setError(\n        err instanceof Error ? err.message : \'Could not evaluate answer. Please try again.\'\n      );\n    } finally {\n      setIsEvaluating(false);\n    }\n  };\n\n  const handleSkipQuestion = async () => {\n    if (!session) return;\n    const currentQ = session.questions[session.currentIndex];\n    if (!currentQ) return;\n\n    const updatedAnswers = {\n      ...session.answers,\n      [currentQ.id]: {\n        userAnswer: \'\',\n        skipped: true,\n      },\n    };\n    const isLast = session.currentIndex >= session.questions.length - 1;\n    const nextIndex = isLast ? session.currentIndex : session.currentIndex + 1;\n    const saved = await saveInterviewSession({\n      ...session,\n      answers: updatedAnswers,\n      currentIndex: nextIndex,\n      completed: isLast,\n      updatedAt: new Date().toISOString(),\n    });\n    setSession(saved);\n    const nextQ = saved.questions[nextIndex];\n    setCurrentAnswer((nextQ && saved.answers[nextQ.id]?.userAnswer) || \'\');\n  };\n\n  const handleNextQuestion = async () => {\n    if (!session) return;\n    const isLast = session.currentIndex >= session.questions.length - 1;\n    if (isLast) {\n      const saved = await saveInterviewSession({\n        ...session,\n        completed: true,\n        updatedAt: new Date().toISOString(),\n      });\n      setSession(saved);\n      return;\n    }\n    const nextIndex = session.currentIndex + 1;\n    const saved = await saveInterviewSession({\n      ...session,\n      currentIndex: nextIndex,\n      updatedAt: new Date().toISOString(),\n    });\n    setSession(saved);\n    const nextQ = saved.questions[nextIndex];\n    setCurrentAnswer((nextQ && saved.answers[nextQ.id]?.userAnswer) || \'\');\n  };\n\n  const handleReset = async () => {\n    await clearInterviewSession();\n    setSession(null);\n    setCurrentAnswer(\'\');\n    setError(null);\n  };\n\n  const currentQuestion = session ? session.questions[session.currentIndex] : null;\n  const currentRecord =\n    session && currentQuestion ? session.answers[currentQuestion.id] : undefined;\n\n  const answeredEvaluations = session\n    ? Object.values(session.answers).filter((a) => a.evaluation)\n    : [];\n  const averageScore =\n    answeredEvaluations.length > 0\n      ? (\n          answeredEvaluations.reduce((acc, a) => acc + (a.evaluation?.score || 0), 0) /\n          answeredEvaluations.length\n        ).toFixed(1)\n      : \'0.0\';\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-5\">\n        <div>\n          <div className=\"flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#1E3A5F] dark:text-amber-400\">\n            <MessageSquare className=\"w-4 h-4\" />\n            <span>Practice For Any Field</span>\n          </div>\n          <h1 className=\"text-2xl font-bold text-slate-900 dark:text-white mt-1\">\n            Mock Interview & Viva Practice\n          </h1>\n          <p className=\"text-sm text-slate-600 dark:text-slate-400 mt-0.5\">\n            Practice domain, behavioral, mixed, or academic viva questions with instant AI scoring.\n          </p>\n        </div>\n\n        {session && (\n          <button\n            type=\"button\"\n            onClick={handleReset}\n            className=\"self-start inline-flex items-center gap-1.5 px-3.5 py-2 rounded-md border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer\"\n          >\n            <RotateCcw className=\"w-3.5 h-3.5\" />\n            Start New Session\n          </button>\n        )}\n      </div>\n\n      {error && (\n        <div className=\"bg-red-50 border border-red-200 rounded-lg p-4 flex items-center gap-2.5 text-xs text-red-800\">\n          <AlertCircle className=\"w-4 h-4 text-red-600 shrink-0\" />\n          <span>{error}</span>\n        </div>\n      )}\n\n      {!session ? (\n        <form\n          onSubmit={handleStartSession}\n          className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-6 space-y-4 max-w-2xl\"\n        >\n          <h2 className=\"text-base font-bold text-slate-900 dark:text-white\">\n            Configure Practice Session\n          </h2>\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1\">\n                Target Role or Exam Topic\n              </label>\n              <input\n                type=\"text\"\n                value={role}\n                onChange={(e) => setRole(e.target.value)}\n                placeholder=\"e.g., Registered Nurse, Chartered Accountant, Full-Stack Developer\"\n                className=\"w-full px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1\">\n                Field or Subject Area\n              </label>\n              <input\n                type=\"text\"\n                value={field}\n                onChange={(e) => setField(e.target.value)}\n                placeholder=\"e.g., Healthcare, Commerce, Law, Design, Software\"\n                className=\"w-full px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1\">\n                Difficulty Level\n              </label>\n              <select\n                value={difficulty}\n                onChange={(e) =>\n                  setDifficulty(e.target.value as \'Beginner\' | \'Intermediate\' | \'Advanced\')\n                }\n                className=\"w-full px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n              >\n                <option value=\"Beginner\">Beginner / Entry-Level</option>\n                <option value=\"Intermediate\">Intermediate</option>\n                <option value=\"Advanced\">Advanced / Senior</option>\n              </select>\n            </div>\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1\">\n                Question Style\n              </label>\n              <select\n                value={interviewType}\n                onChange={(e) =>\n                  setInterviewType(e.target.value as \'technical\' | \'hr\' | \'mixed\' | \'viva\')\n                }\n                className=\"w-full px-3 py-2 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n              >\n                <option value=\"mixed\">Mixed (Domain + Behavioral)</option>\n                <option value=\"technical\">Domain / Role-Specific</option>\n                <option value=\"hr\">HR & Behavioral</option>\n                <option value=\"viva\">Academic / Oral Viva</option>\n              </select>\n            </div>\n          </div>\n\n          <button\n            type=\"submit\"\n            disabled={isGenerating}\n            className=\"inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-[#1E3A5F] hover:bg-[#162B47] text-white text-xs font-semibold transition-colors disabled:opacity-60 cursor-pointer\"\n          >\n            {isGenerating ? (\n              <>\n                <Loader2 className=\"w-4 h-4 animate-spin\" />\n                Generating 5 Questions...\n              </>\n            ) : (\n              <>\n                <Sparkles className=\"w-4 h-4\" />\n                Start 5-Question Session\n              </>\n            )}\n          </button>\n        </form>\n      ) : session.completed ? (\n        <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-6 space-y-5\">\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-4\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-12 h-12 rounded-lg bg-[#1E3A5F] text-white flex items-center justify-center\">\n                <Award className=\"w-6 h-6\" />\n              </div>\n              <div>\n                <h2 className=\"text-lg font-bold text-slate-900 dark:text-white\">\n                  Session Summary: {session.role}\n                </h2>\n                <p className=\"text-xs text-slate-500\">\n                  Average Score: <strong className=\"text-slate-900 dark:text-white\">{averageScore} / 10</strong> across{\' \'}\n                  {answeredEvaluations.length} evaluated answers\n                </p>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"space-y-4\">\n            {session.questions.map((q, i) => {\n              const ans = session.answers[q.id];\n              return (\n                <div\n                  key={q.id}\n                  className=\"p-4 rounded-md border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 space-y-2 text-xs\"\n                >\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"font-bold text-slate-900 dark:text-white\">\n                      Q{i + 1}: {q.question}\n                    </span>\n                    {ans?.evaluation ? (\n                      <span className=\"px-2 py-0.5 rounded bg-[#1E3A5F] text-white font-semibold\">\n                        {ans.evaluation.score}/10\n                      </span>\n                    ) : (\n                      <span className=\"px-2 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300\">\n                        Skipped\n                      </span>\n                    )}\n                  </div>\n                  {ans?.userAnswer && (\n                    <p className=\"text-slate-600 dark:text-slate-300\">\n                      <strong>Your Answer:</strong> {ans.userAnswer}\n                    </p>\n                  )}\n                  {ans?.evaluation && (\n                    <>\n                      <p className=\"text-slate-700 dark:text-slate-300\">\n                        <strong>Feedback:</strong> {ans.evaluation.feedback}\n                      </p>\n                      <p className=\"text-emerald-800 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900 p-2.5 rounded\">\n                        <strong>Model Answer:</strong> {ans.evaluation.improvedAnswer}\n                      </p>\n                    </>\n                  )}\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      ) : (\n        currentQuestion && (\n          <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-6 space-y-5\">\n            <div className=\"flex items-center justify-between text-xs text-slate-500\">\n              <span className=\"font-bold uppercase tracking-wider text-[#1E3A5F] dark:text-amber-400\">\n                Question {session.currentIndex + 1} of {session.questions.length} ({currentQuestion.type})\n              </span>\n              <span>\n                {session.role} \342\200\242 {session.difficulty}\n              </span>\n            </div>\n\n            <h2 className=\"text-base sm:text-lg font-bold text-slate-900 dark:text-white\">\n              {currentQuestion.question}\n            </h2>\n\n            <textarea\n              rows={5}\n              value={currentAnswer}\n              onChange={(e) => setCurrentAnswer(e.target.value)}\n              disabled={Boolean(currentRecord?.evaluation)}\n              placeholder=\"Write your response clearly as you would explain it in an interview...\"\n              className=\"w-full px-3.5 py-2.5 text-xs rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white\"\n            />\n\n            {!currentRecord?.evaluation ? (\n              <div className=\"flex flex-wrap items-center gap-3\">\n                <button\n                  type=\"button\"\n                  onClick={handleSubmitAnswer}\n                  disabled={isEvaluating}\n                  className=\"inline-flex items-center gap-1.5 px-4 py-2 rounded-md bg-[#1E3A5F] hover:bg-[#162B47] text-white text-xs font-semibold disabled:opacity-60 cursor-pointer\"\n                >\n                  {isEvaluating ? (\n                    <>\n                      <Loader2 className=\"w-4 h-4 animate-spin\" />\n                      Evaluating Answer...\n                    </>\n                  ) : (\n                    <>\n                      <CheckCircle2 className=\"w-4 h-4\" />\n                      Submit Answer for Feedback\n                    </>\n                  )}\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={handleSkipQuestion}\n                  disabled={isEvaluating}\n                  className=\"inline-flex items-center gap-1.5 px-3.5 py-2 rounded-md border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer\"\n                >\n                  <SkipForward className=\"w-3.5 h-3.5\" />\n                  Skip Question\n                </button>\n              </div>\n            ) : (\n              <div className=\"space-y-4 pt-2 border-t border-slate-200 dark:border-slate-800 text-xs\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"px-2.5 py-1 rounded bg-[#1E3A5F] text-white font-bold\">\n                    Score: {currentRecord.evaluation.score} / 10\n                  </span>\n                </div>\n                <div className=\"p-3.5 rounded-md bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 space-y-1.5\">\n                  <h3 className=\"font-bold text-slate-900 dark:text-white\">Coach Feedback</h3>\n                  <p className=\"text-slate-700 dark:text-slate-300\">\n                    {currentRecord.evaluation.feedback}\n                  </p>\n                </div>\n                <div className=\"p-3.5 rounded-md bg-emerald-50/70 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900 space-y-1.5\">\n                  <h3 className=\"font-bold text-emerald-950 dark:text-emerald-300\">\n                    Stronger Sample Answer\n                  </h3>\n                  <p className=\"text-emerald-900 dark:text-emerald-200\">\n                    {currentRecord.evaluation.improvedAnswer}\n                  </p>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={handleNextQuestion}\n                  className=\"inline-flex items-center gap-1.5 px-4 py-2 rounded-md bg-[#1E3A5F] hover:bg-[#162B47] text-white text-xs font-semibold cursor-pointer\"\n                >\n                  {session.currentIndex >= session.questions.length - 1\n                    ? \'Finish & View Scorecard\'\n                    : \'Next Question\'}\n                </button>\n              </div>\n            )}\n          </div>\n        )\n      )}\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/pages/InterviewPage.tsx"
        }
        overwrite: true
      }
    }
