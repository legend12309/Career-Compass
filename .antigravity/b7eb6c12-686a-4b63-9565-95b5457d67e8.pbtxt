  code_action {
    action_spec {
      create_file {
        instruction: "import { useState, useEffect, FormEvent, ChangeEvent } from \'react\';\nimport { Skill, SkillCategory, Certificate } from \'../types\';\nimport {\n  listSkills,\n  saveSkill,\n  deleteSkill,\n  listCertificates,\n  saveCertificate,\n  deleteCertificate,\n} from \'../services/db\';\nimport { AppShell } from \'../components/layout/AppShell\';\nimport {\n  Award,\n  Plus,\n  Trash2,\n  Edit3,\n  CheckCircle2,\n  AlertCircle,\n  FileText,\n  ExternalLink,\n  X,\n} from \'lucide-react\';\n\nconst MAX_CERT_FILE_BYTES = 450 * 1024;\n\nexport function SkillsPage() {\n  const [skills, setSkills] = useState<Skill[]>([]);\n  const [certificates, setCertificates] = useState<Certificate[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  const [editingSkillId, setEditingSkillId] = useState<string | null>(null);\n  const [skillName, setSkillName] = useState(\'\');\n  const [skillCategory, setSkillCategory] = useState<SkillCategory>(\'technical\');\n  const [skillLevel, setSkillLevel] = useState<number>(3);\n\n  const [certTitle, setCertTitle] = useState(\'\');\n  const [certIssuer, setCertIssuer] = useState(\'\');\n  const [certDate, setCertDate] = useState(\'\');\n  const [certFileUrl, setCertFileUrl] = useState<string | undefined>(undefined);\n  const [certFileName, setCertFileName] = useState<string | undefined>(undefined);\n\n  const [confirmDelete, setConfirmDelete] = useState<{\n    type: \'skill\' | \'cert\';\n    id: string;\n    label: string;\n  } | null>(null);\n  const [feedback, setFeedback] = useState<{ type: \'success\' | \'error\'; text: string } | null>(null);\n\n  useEffect(() => {\n    async function load() {\n      setLoading(true);\n      try {\n        const [sk, ct] = await Promise.all([listSkills(), listCertificates()]);\n        setSkills(sk);\n        setCertificates(ct);\n      } catch (err) {\n        console.error(\'Error loading skills:\', err);\n      } finally {\n        setLoading(false);\n      }\n    }\n    load();\n  }, []);\n\n  const handleSaveSkill = async (e: FormEvent) => {\n    e.preventDefault();\n    setFeedback(null);\n    try {\n      const saved = await saveSkill({\n        id: editingSkillId || `sk-${Date.now()}`,\n        name: skillName,\n        category: skillCategory,\n        level: skillLevel,\n      });\n      setSkills((prev) => {\n        const exists = prev.some((s) => s.id === saved.id);\n        return exists ? prev.map((s) => (s.id === saved.id ? saved : s)) : [...prev, saved];\n      });\n      setSkillName(\'\');\n      setSkillLevel(3);\n      setEditingSkillId(null);\n      setFeedback({ type: \'success\', text: \'Skill saved.\' });\n    } catch (err: unknown) {\n      setFeedback({\n        type: \'error\',\n        text: err instanceof Error ? err.message : \'Could not save skill.\',\n      });\n    }\n  };\n\n  const handleFileChange = (e: ChangeEvent<HTMLInputElement>) => {\n    setFeedback(null);\n    const file = e.target.files?.[0];\n    if (!file) {\n      setCertFileUrl(undefined);\n      setCertFileName(undefined);\n      return;\n    }\n    const allowed = [\'application/pdf\', \'image/png\', \'image/jpeg\', \'image/webp\'];\n    if (!allowed.includes(file.type)) {\n      setFeedback({ type: \'error\', text: \'Please select a PDF, PNG, or JPG file.\' });\n      e.target.value = \'\';\n      return;\n    }\n    if (file.size > MAX_CERT_FILE_BYTES) {\n      setFeedback({ type: \'error\', text: \'File is larger than 450KB. Please choose a smaller file.\' });\n      e.target.value = \'\';\n      return;\n    }\n    const reader = new FileReader();\n    reader.onload = () => {\n      if (typeof reader.result === \'string\') {\n        setCertFileUrl(reader.result);\n        setCertFileName(file.name);\n      }\n    };\n    reader.readAsDataURL(file);\n  };\n\n  const handleAddCertificate = async (e: FormEvent) => {\n    e.preventDefault();\n    setFeedback(null);\n    try {\n      const saved = await saveCertificate({\n        id: `cert-${Date.now()}`,\n        title: certTitle,\n        issuer: certIssuer,\n        date: certDate,\n        fileDataUrl: certFileUrl,\n        fileName: certFileName,\n      });\n      setCertificates((prev) => [...prev, saved]);\n      setCertTitle(\'\');\n      setCertIssuer(\'\');\n      setCertDate(\'\');\n      setCertFileUrl(undefined);\n      setCertFileName(undefined);\n      setFeedback({ type: \'success\', text: \'Certificate saved.\' });\n    } catch (err: unknown) {\n      setFeedback({\n        type: \'error\',\n        text: err instanceof Error ? err.message : \'Could not save certificate.\',\n      });\n    }\n  };\n\n  const executeConfirmedDelete = async () => {\n    if (!confirmDelete) return;\n    try {\n      if (confirmDelete.type === \'skill\') {\n        await deleteSkill(confirmDelete.id);\n        setSkills((prev) => prev.filter((s) => s.id !== confirmDelete.id));\n      } else {\n        await deleteCertificate(confirmDelete.id);\n        setCertificates((prev) => prev.filter((c) => c.id !== confirmDelete.id));\n      }\n      setFeedback({ type: \'success\', text: `Deleted \"${confirmDelete.label}\".` });\n    } finally {\n      setConfirmDelete(null);\n    }\n  };\n\n  const groups: { key: SkillCategory; label: string }[] = [\n    { key: \'technical\', label: \'Technical Skills\' },\n    { key: \'domain\', label: \'Domain & Field Skills\' },\n    { key: \'soft\', label: \'Soft & People Skills\' },\n    { key: \'language\', label: \'Languages\' },\n  ];\n\n  return (\n    <AppShell>\n      <div className=\"space-y-6\">\n        <div className=\"pb-4 border-b border-stone-200 dark:border-slate-800\">\n          <h1 className=\"text-xl sm:text-2xl font-bold\">Skills & Certificates</h1>\n          <p className=\"text-xs sm:text-sm text-stone-600 dark:text-slate-400 mt-1\">\n            Track your technical, domain, soft, and language skills (1\342\200\2235) alongside your certificates.\n          </p>\n        </div>\n\n        {feedback && (\n          <div\n            className={`p-3 rounded-lg border flex items-center justify-between gap-2 text-xs ${\n              feedback.type === \'success\'\n                ? \'bg-emerald-50 dark:bg-emerald-950/60 border-emerald-200 text-emerald-900 dark:text-emerald-200\'\n                : \'bg-red-50 dark:bg-red-950/60 border-red-200 text-red-900 dark:text-red-200\'\n            }`}\n          >\n            <div className=\"flex items-center gap-2\">\n              {feedback.type === \'success\' ? (\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n              ) : (\n                <AlertCircle className=\"w-4 h-4 text-red-600 shrink-0\" />\n              )}\n              <span>{feedback.text}</span>\n            </div>\n            <button type=\"button\" onClick={() => setFeedback(null)} aria-label=\"Dismiss\">\n              <X className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        )}\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n          <div className=\"lg:col-span-7 space-y-4\">\n            <form\n              onSubmit={handleSaveSkill}\n              className=\"p-5 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl space-y-4\"\n            >\n              <h2 className=\"text-sm font-bold\">\n                {editingSkillId ? \'Edit Skill\' : \'Add a Skill\'}\n              </h2>\n              <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                <div className=\"sm:col-span-2\">\n                  <label htmlFor=\"sk-name\" className=\"block text-xs font-medium mb-1\">\n                    Skill Name *\n                  </label>\n                  <input\n                    id=\"sk-name\"\n                    type=\"text\"\n                    required\n                    value={skillName}\n                    onChange={(e) => setSkillName(e.target.value)}\n                    placeholder=\"e.g. React, Patient Triage, Bookkeeping, French\"\n                    className=\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\"\n                  />\n                </div>\n                <div>\n                  <label htmlFor=\"sk-cat\" className=\"block text-xs font-medium mb-1\">\n                    Category\n                  </label>\n                  <select\n                    id=\"sk-cat\"\n                    value={skillCategory}\n                    onChange={(e) => setSkillCategory(e.target.value as SkillCategory)}\n                    className=\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\"\n                  >\n                    <option value=\"technical\">Technical</option>\n                    <option value=\"domain\">Domain</option>\n                    <option value=\"soft\">Soft</option>\n                    <option value=\"language\">Language</option>\n                  </select>\n                </div>\n              </div>\n\n              <div>\n                <div className=\"flex justify-between text-xs mb-1\">\n                  <label htmlFor=\"sk-lvl\">Level (1\342\200\2235)</label>\n                  <span className=\"font-bold text-indigo-600 tabular-nums\">Level {skillLevel}/5</span>\n                </div>\n                <input\n                  id=\"sk-lvl\"\n                  type=\"range\"\n                  min={1}\n                  max={5}\n                  value={skillLevel}\n                  onChange={(e) => setSkillLevel(Number(e.target.value))}\n                  className=\"w-full accent-indigo-600\"\n                />\n              </div>\n\n              <button\n                type=\"submit\"\n                className=\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-slate-900 dark:bg-indigo-600 rounded-lg\"\n              >\n                <Plus className=\"w-3.5 h-3.5\" />\n                <span>{editingSkillId ? \'Update Skill\' : \'Add Skill\'}</span>\n              </button>\n            </form>\n\n            {!loading &&\n              groups.map((g) => {\n                const items = skills.filter((s) => s.category === g.key);\n                return (\n                  <div\n                    key={g.key}\n                    className=\"p-5 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl space-y-3\"\n                  >\n                    <h3 className=\"text-xs font-bold uppercase tracking-wider\">\n                      {g.label} ({items.length})\n                    </h3>\n                    {items.length === 0 ? (\n                      <p className=\"text-xs text-stone-500\">No {g.label.toLowerCase()} added yet.</p>\n                    ) : (\n                      <div className=\"divide-y divide-stone-100 dark:divide-slate-800\">\n                        {items.map((sk) => (\n                          <div\n                            key={sk.id}\n                            className=\"py-2 flex items-center justify-between gap-4\"\n                          >\n                            <div className=\"flex-1 min-w-0\">\n                              <div className=\"flex justify-between text-xs mb-1\">\n                                <span className=\"font-semibold truncate\">{sk.name}</span>\n                                <span className=\"text-stone-500 tabular-nums\">{sk.level}/5</span>\n                              </div>\n                              <div className=\"w-full h-1.5 bg-stone-100 dark:bg-slate-800 rounded-full overflow-hidden\">\n                                <div\n                                  className=\"h-full bg-indigo-600 rounded-full\"\n                                  style={{ width: `${(sk.level / 5) * 100}%` }}\n                                />\n                              </div>\n                            </div>\n                            <div className=\"flex items-center gap-1\">\n                              <button\n                                type=\"button\"\n                                onClick={() => {\n                                  setEditingSkillId(sk.id);\n                                  setSkillName(sk.name);\n                                  setSkillCategory(sk.category);\n                                  setSkillLevel(sk.level);\n                                }}\n                                className=\"p-1.5 text-stone-500 hover:text-slate-900\"\n                                aria-label={`Edit ${sk.name}`}\n                              >\n                                <Edit3 className=\"w-3.5 h-3.5\" />\n                              </button>\n                              <button\n                                type=\"button\"\n                                onClick={() =>\n                                  setConfirmDelete({ type: \'skill\', id: sk.id, label: sk.name })\n                                }\n                                className=\"p-1.5 text-stone-500 hover:text-red-600\"\n                                aria-label={`Delete ${sk.name}`}\n                              >\n                                <Trash2 className=\"w-3.5 h-3.5\" />\n                              </button>\n                            </div>\n                          </div>\n                        ))}\n                      </div>\n                    )}\n                  </div>\n                );\n              })}\n          </div>\n\n          <div className=\"lg:col-span-5 space-y-4\">\n            <form\n              onSubmit={handleAddCertificate}\n              className=\"p-5 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl space-y-3.5\"\n            >\n              <div className=\"flex items-center gap-2\">\n                <Award className=\"w-4 h-4 text-indigo-600\" />\n                <h2 className=\"text-sm font-bold\">Add Certificate</h2>\n              </div>\n              <div>\n                <label htmlFor=\"c-title\" className=\"block text-xs font-medium mb-1\">\n                  Title *\n                </label>\n                <input\n                  id=\"c-title\"\n                  type=\"text\"\n                  required\n                  value={certTitle}\n                  onChange={(e) => setCertTitle(e.target.value)}\n                  className=\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\"\n                />\n              </div>\n              <div className=\"grid grid-cols-2 gap-2\">\n                <div>\n                  <label htmlFor=\"c-issuer\" className=\"block text-xs font-medium mb-1\">\n                    Issuer *\n                  </label>\n                  <input\n                    id=\"c-issuer\"\n                    type=\"text\"\n                    required\n                    value={certIssuer}\n                    onChange={(e) => setCertIssuer(e.target.value)}\n                    className=\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\"\n                  />\n                </div>\n                <div>\n                  <label htmlFor=\"c-date\" className=\"block text-xs font-medium mb-1\">\n                    Date *\n                  </label>\n                  <input\n                    id=\"c-date\"\n                    type=\"date\"\n                    required\n                    value={certDate}\n                    onChange={(e) => setCertDate(e.target.value)}\n                    className=\"w-full px-3 py-2 text-xs bg-white dark:bg-slate-950 border border-stone-300 dark:border-slate-700 rounded-lg\"\n                  />\n                </div>\n              </div>\n              <div>\n                <label htmlFor=\"c-file\" className=\"block text-xs font-medium mb-1\">\n                  Optional File (PDF/PNG/JPG, max 450KB)\n                </label>\n                <input\n                  id=\"c-file\"\n                  type=\"file\"\n                  accept=\".pdf,image/png,image/jpeg,image/webp\"\n                  onChange={handleFileChange}\n                  className=\"w-full text-xs\"\n                />\n              </div>\n              <button\n                type=\"submit\"\n                className=\"w-full inline-flex items-center justify-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-slate-900 dark:bg-indigo-600 rounded-lg\"\n              >\n                <Plus className=\"w-3.5 h-3.5\" />\n                <span>Save Certificate</span>\n              </button>\n            </form>\n\n            <div className=\"p-5 bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl space-y-3\">\n              <h3 className=\"text-xs font-bold uppercase tracking-wider\">\n                Certificates ({certificates.length})\n              </h3>\n              {certificates.map((c) => (\n                <div\n                  key={c.id}\n                  className=\"py-2.5 border-b border-stone-100 dark:border-slate-800 last:border-0 flex items-start justify-between gap-2\"\n                >\n                  <div>\n                    <p className=\"text-xs font-bold\">{c.title}</p>\n                    <p className=\"text-[11px] text-stone-500\">\n                      {c.issuer} \302\267 {c.date}\n                    </p>\n                    {c.fileDataUrl && (\n                      <a\n                        href={c.fileDataUrl}\n                        download={c.fileName || `${c.title}.pdf`}\n                        className=\"inline-flex items-center gap-1 text-[11px] text-indigo-600 mt-1\"\n                      >\n                        <FileText className=\"w-3 h-3\" />\n                        <span>Download</span>\n                        <ExternalLink className=\"w-2.5 h-2.5\" />\n                      </a>\n                    )}\n                  </div>\n                  <button\n                    type=\"button\"\n                    onClick={() => setConfirmDelete({ type: \'cert\', id: c.id, label: c.title })}\n                    className=\"p-1 text-stone-500 hover:text-red-600\"\n                    aria-label={`Delete ${c.title}`}\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        {confirmDelete && (\n          <div\n            className=\"fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4\"\n            role=\"dialog\"\n            aria-modal=\"true\"\n          >\n            <div className=\"bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl max-w-sm w-full p-5 space-y-4\">\n              <h3 className=\"text-sm font-bold\">Confirm Deletion</h3>\n              <p className=\"text-xs text-stone-600 dark:text-slate-300\">\n                Delete &ldquo;{confirmDelete.label}&rdquo;?\n              </p>\n              <div className=\"flex justify-end gap-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setConfirmDelete(null)}\n                  className=\"px-3 py-1.5 text-xs bg-stone-100 dark:bg-slate-800 rounded-lg\"\n                >\n                  Cancel\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={executeConfirmedDelete}\n                  className=\"px-3.5 py-1.5 text-xs font-semibold text-white bg-red-600 rounded-lg\"\n                >\n                  Delete\n                </button>\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </AppShell>\n  );\n}\n"
