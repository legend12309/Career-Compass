      arguments_json: "{\"CodeContent\":\"import { useEffect, useState } from \'react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { User } from \'../types\';\\nimport { AppShell } from \'../components/layout/AppShell\';\\nimport { ShieldCheck, Users, GraduationCap, Clock, CheckCircle2 } from \'lucide-react\';\\n\\nexport function AdminPage() {\\n  const { user } = useAuth();\\n  const [allUsers, setAllUsers] = useState<User[]>([]);\\n\\n  useEffect(() => {\\n    try {\\n      const raw = localStorage.getItem(\'cc_users\');\\n      if (raw) {\\n        setAllUsers(JSON.parse(raw));\\n      }\\n    } catch (err) {\\n      console.error(\'Failed to read users for admin:\', err);\\n    }\\n  }, []);\\n\\n  return (\\n    <AppShell>\\n      <div className=\\\"space-y-6\\\">\\n        <div className=\\\"p-6 bg-white border border-stone-200 rounded-xl shadow-2xs\\\">\\n          <div className=\\\"flex items-center gap-3\\\">\\n            <div className=\\\"w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center border border-amber-200\\\">\\n              <ShieldCheck className=\\\"w-5 h-5\\\" />\\n            </div>\\n            <div>\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <h1 className=\\\"text-xl sm:text-2xl font-bold text-slate-900\\\">Admin Console</h1>\\n                <span className=\\\"text-xs text-amber-800 font-medium\\\">\302\267 Restricted Area</span>\\n              </div>\\n              <p className=\\\"text-xs text-stone-600 mt-0.5\\\">\\n                Logged in as <span className=\\\"font-semibold text-slate-900\\\">{user?.name}</span> ({user?.email}).\\n                Full placement management capabilities will be fully enabled in Phase 7.\\n              </p>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Quick Admin Stats */}\\n        <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-4\\\">\\n          <div className=\\\"p-5 bg-white border border-stone-200 rounded-xl shadow-2xs\\\">\\n            <div className=\\\"flex items-center gap-2 text-xs font-semibold text-stone-600 mb-1\\\">\\n              <Users className=\\\"w-4 h-4 text-indigo-600\\\" />\\n              <span>Registered Accounts</span>\\n            </div>\\n            <p className=\\\"text-2xl font-bold text-slate-900 tabular-nums\\\">\\n              {allUsers.length}\\n            </p>\\n            <p className=\\\"text-[11px] text-stone-600 mt-1\\\">\\n              {allUsers.filter((u) => u.role === \'student\').length} students \302\267 {allUsers.filter((u) => u.role === \'admin\').length} admins\\n            </p>\\n          </div>\\n\\n          <div className=\\\"p-5 bg-white border border-stone-200 rounded-xl shadow-2xs\\\">\\n            <div className=\\\"flex items-center gap-2 text-xs font-semibold text-stone-600 mb-1\\\">\\n              <GraduationCap className=\\\"w-4 h-4 text-indigo-600\\\" />\\n              <span>Target Degree Cohort</span>\\n            </div>\\n            <p className=\\\"text-sm font-bold text-slate-900\\\">\\n              BCA (Undergraduate)\\n            </p>\\n            <p className=\\\"text-[11px] text-stone-600 mt-1\\\">\\n              Semesters 1 through 6\\n            </p>\\n          </div>\\n\\n          <div className=\\\"p-5 bg-white border border-stone-200 rounded-xl shadow-2xs\\\">\\n            <div className=\\\"flex items-center gap-2 text-xs font-semibold text-stone-600 mb-1\\\">\\n              <Clock className=\\\"w-4 h-4 text-indigo-600\\\" />\\n              <span>Phase Status</span>\\n            </div>\\n            <p className=\\\"text-sm font-bold text-emerald-700 flex items-center gap-1.5\\\">\\n              <CheckCircle2 className=\\\"w-4 h-4\\\" />\\n              <span>Phase 1 Active</span>\\n            </p>\\n            <p className=\\\"text-[11px] text-stone-600 mt-1\\\">\\n              Auth & Role Guards Verified\\n            </p>\\n          </div>\\n        </div>\\n\\n        {/* User Accounts Table */}\\n        <div className=\\\"bg-white border border-stone-200 rounded-xl shadow-2xs overflow-hidden\\\">\\n          <div className=\\\"p-4 border-b border-stone-200\\\">\\n            <h2 className=\\\"text-xs font-bold text-slate-900 uppercase tracking-wider\\\">\\n              System Registered Users\\n            </h2>\\n          </div>\\n          <div className=\\\"overflow-x-auto\\\">\\n            <table className=\\\"w-full text-left text-xs\\\">\\n              <thead className=\\\"bg-stone-50 border-b border-stone-200 text-stone-600\\\">\\n                <tr>\\n                  <th className=\\\"py-2.5 px-4 font-semibold\\\">User Name</th>\\n                  <th className=\\\"py-2.5 px-4 font-semibold\\\">Email</th>\\n                  <th className=\\\"py-2.5 px-4 font-semibold\\\">Role</th>\\n                  <th className=\\\"py-2.5 px-4 font-semibold\\\">Registered</th>\\n                </tr>\\n              </thead>\\n              <tbody className=\\\"divide-y divide-stone-100\\\">\\n                {allUsers.map((u) => (\\n                  <tr key={u.id} className=\\\"hover:bg-stone-50/50\\\">\\n                    <td className=\\\"py-3 px-4 font-medium text-slate-900\\\">{u.name}</td>\\n                    <td className=\\\"py-3 px-4 font-mono text-[11px] text-stone-600\\\">{u.email}</td>\\n                    <td className=\\\"py-3 px-4\\\">\\n                      <span className={`inline-flex px-2 py-0.5 rounded text-[11px] font-medium ${\\n                        u.role === \'admin\' ? \'bg-amber-100 text-amber-900\' : \'bg-indigo-50 text-indigo-900\'\\n                      }`}>\\n                        {u.role}\\n                      </span>\\n                    </td>\\n                    <td className=\\\"py-3 px-4 text-stone-600 text-[11px]\\\">\\n                      {new Date(u.createdAt).toLocaleDateString()}\\n                    </td>\\n                  </tr>\\n                ))}\\n              </tbody>\\n            </table>\\n          </div>\\n        </div>\\n      </div>\\n    </AppShell>\\n  );\\n}\\n\", \"Description\":\"Admin dashboard showing registered accounts and system overview\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/AdminPage.tsx\", \"toolAction\":\"Creating AdminPage\", \"toolSummary\":\"Create pages/AdminPage.tsx\"}"
      thinking_signature: "\022\204\004\n\201\004\001i\024}\023c\001\026:BOC\331\217\257\337\326_\246\302H<\006\210\373g\306c\254\222\307\315\177J\vf)z)\027\275\033\352\2317\032/\221\316\235\357\024\2628 /\t\201\031\375\033\237\304\257:\025\356\021\372t\335\036\343~\333\335\321\345\031\v\3574\217\305JMb\307\340\2769D\002\254]IiGcr\275M\234\265Oe\360\226\335|,\005\026\a\203w\327\032r\035\240\016\002\361\3001\326\207\222\216\227\257\f\306\377!&\211\031)wm\217\243YPa`\200\312;o\202-\253[\f\034P\'\250\241\a\335\243\025+2\312j\252 \350\351\362\252aW\v\025\006[S\036\310\rt\332_x,\353\304E\310\246\361\020\006\374n\002\266\237\017\275\267\363\241\224\023\273\001\017q\236\261\v\376\376n(Vs\311\331H^(\t[T\366c\206\340\326c\216\364\2226dQm\367\340\031&W\032]\305\033A\214\315\"\337\274C\004\207[\200\317\346\237\377d\251\243+Wf\343\240#xx\235\330\364\005\315\375\273\023\362\306#\351\2142\026\332\270\236\254\026\224\207\026\351c\271\005\276\227\"\027\216b\271\276\320rt\v\350\'\351GJ\302\336\237h\256X\352#\263\367f\357\322ax\366(#B\206\305x\213\306\033\367\263\223\202\273F-=Qd\277\347\352\345N`\271o%b\320c\347\354\177\307F\272\357\210 \006\315h\334P\n\355h\252\243P\020k\202*\253DS4\vCK\215\252\363\365\206\3605\017\003\177\315\005\022\221\034g\036Wh\231(\243\3341Q\324\375\'q\337,\200\250\023\r\334\273T\366\376\356\243& \357\002\311\300\245\255\204\353\340\020\227\372?o\002\307\367\354+\213.H\353-\335a\365C9/G\005\017\354W\r\222\200R\n\354\216\317k\241\275\365\303\330\267\016\337Y\222\254\203.\204v\235\261\215LhLq\037"
