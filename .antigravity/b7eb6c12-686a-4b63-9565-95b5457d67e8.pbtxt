      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Make metadata.json description field-neutral without banned terms\", \"EndLine\":6, \"Instruction\":\"Update description in metadata.json\", \"ReplacementContent\":\"{\\n  \\\"name\\\": \\\"Career Compass\\\",\\n  \\\"description\\\": \\\"AI-powered career guidance, resume builder, interview preparation, and opportunity tracker for everyone across all fields.\\\",\\n  \\\"requestFramePermissions\\\": [],\\n  \\\"majorCapabilities\\\": [\\\"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\\\"]\\n}\", \"StartLine\":1, \"TargetContent\":\"{\\n  \\\"name\\\": \\\"Career Compass\\\",\\n  \\\"description\\\": \\\"AI-powered career guidance, ATS resume builder, mock interview preparation, and placement tracker for college students.\\\",\\n  \\\"requestFramePermissions\\\": [],\\n  \\\"majorCapabilities\\\": [\\\"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\\\"]\\n}\", \"TargetFile\":\"/metadata.json\", \"toolAction\":\"Updating metadata.json\", \"toolSummary\":\"Update metadata.json with universal description\"}"
