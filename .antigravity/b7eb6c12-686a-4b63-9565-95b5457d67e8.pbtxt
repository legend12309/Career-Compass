      arguments_json: "{\"CodeContent\":\"import { Link } from \'react-router-dom\';\\nimport { Navbar } from \'../components/layout/Navbar\';\\nimport { Compass, ArrowLeft } from \'lucide-react\';\\n\\nexport function NotFoundPage() {\\n  return (\\n    <div className=\\\"min-h-screen flex flex-col bg-stone-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100\\\">\\n      <Navbar />\\n      <main className=\\\"flex-1 flex items-center justify-center p-6\\\">\\n        <div className=\\\"max-w-md w-full bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 rounded-xl p-8 text-center space-y-4 shadow-2xs\\\">\\n          <div className=\\\"w-12 h-12 rounded-xl bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mx-auto\\\">\\n            <Compass className=\\\"w-6 h-6\\\" />\\n          </div>\\n          <h1 className=\\\"text-xl font-bold\\\">Page Not Found (404)</h1>\\n          <p className=\\\"text-xs text-stone-600 dark:text-slate-400 leading-relaxed\\\">\\n            We could not find the page you were looking for. Use the button below to head back to your dashboard or home page.\\n          </p>\\n          <Link\\n            to=\\\"/dashboard\\\"\\n            className=\\\"inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-semibold text-white bg-slate-900 dark:bg-indigo-600 hover:bg-slate-800 rounded-lg transition-colors\\\"\\n          >\\n            <ArrowLeft className=\\\"w-4 h-4\\\" />\\n            <span>Back to Safety</span>\\n          </Link>\\n        </div>\\n      </main>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Friendly 404 NotFoundPage for unmatched routes\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/NotFoundPage.tsx\", \"toolAction\":\"Creating NotFoundPage\", \"toolSummary\":\"Create src/pages/NotFoundPage.tsx for friendly 404 route\"}"
