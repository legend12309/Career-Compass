  planner_response {
    thinking: "**Refactoring File Structures**\n\nI\'m currently updating `/src/utils/pdfExport.ts`, `/src/components/resume/ResumeLivePreview.tsx`, and `/src/pages/ResumePage.tsx`. The goal is to align these files with the universal `Resume` model. Specifically, I am focusing on the `mode`, `personal.links`, and `optionalSections` attributes, ensuring consistent data handling across the system. This refactoring will enhance data integrity.\n\n\n"
    tool_calls {
      id: "call_12625463791228995980"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { jsPDF } from \'jspdf\';\\nimport { Resume } from \'../types\';\\n\\nexport function exportResumeToPdf(resume: Resume): void {\\n  const doc = new jsPDF({\\n    orientation: \'portrait\',\\n    unit: \'pt\',\\n    format: \'a4\',\\n  });\\n\\n  const pageWidth = doc.internal.pageSize.getWidth();\\n  const pageHeight = doc.internal.pageSize.getHeight();\\n  const margin = 44;\\n  const contentWidth = pageWidth - margin * 2;\\n  let y = margin;\\n\\n  const ensureSpace = (needed: number) => {\\n    if (y + needed > pageHeight - margin) {\\n      doc.addPage();\\n      y = margin;\\n    }\\n  };\\n\\n  const addSectionHeader = (title: string) => {\\n    ensureSpace(32);\\n    y += 8;\\n    doc.setFont(\'helvetica\', \'bold\');\\n    doc.setFontSize(10.5);\\n    doc.setTextColor(28, 36, 48);\\n    doc.text(title.toUpperCase(), margin, y);\\n    y += 5;\\n    doc.setDrawColor(190, 198, 210);\\n    doc.setLineWidth(0.75);\\n    doc.line(margin, y, pageWidth - margin, y);\\n    y += 13;\\n  };\\n\\n  const addWrappedParagraph = (\\n    text: string,\\n    fontSize = 9.5,\\n    fontStyle: \'normal\' | \'bold\' | \'italic\' = \'normal\',\\n    color: [number, number, number] = [45, 55, 72],\\n    indent = 0\\n  ) => {\\n    if (!text.trim()) return;\\n    doc.setFont(\'helvetica\', fontStyle);\\n    doc.setFontSize(fontSize);\\n    doc.setTextColor(color[0], color[1], color[2]);\\n    const lines: string[] = doc.splitTextToSize(text.trim(), contentWidth - indent);\\n    const lineHeight = fontSize * 1.38;\\n    for (const line of lines) {\\n      ensureSpace(lineHeight + 2);\\n      doc.text(line, margin + indent, y);\\n      y += lineHeight;\\n    }\\n  };\\n\\n  // Header (Single-column ATS-safe, no photos, no icons, no graphics)\\n  doc.setFont(\'helvetica\', \'bold\');\\n  doc.setFontSize(19);\\n  doc.setTextColor(18, 24, 34);\\n  const fullName = resume.personal.name.trim() || \'Your Name\';\\n  doc.text(fullName, margin, y);\\n  y += 16;\\n\\n  const contactParts = [\\n    resume.personal.location,\\n    resume.personal.email,\\n    resume.personal.phone,\\n    ...(resume.personal.links || []),\\n  ]\\n    .map((s) => s?.trim())\\n    .filter(Boolean);\\n\\n  if (contactParts.length > 0) {\\n    addWrappedParagraph(contactParts.join(\'  |  \'), 9, \'normal\', [75, 85, 99]);\\n    y += 4;\\n  }\\n\\n  // Summary\\n  if (resume.summary.trim()) {\\n    addSectionHeader(\'Professional Summary\');\\n    addWrappedParagraph(resume.summary, 9.5, \'normal\', [45, 55, 72]);\\n  }\\n\\n  const renderExperience = () => {\\n    const validExp = resume.experience.filter((e) => e.role.trim() || e.company.trim());\\n    if (validExp.length === 0) return;\\n    addSectionHeader(\'Work & Practical Experience\');\\n    for (const exp of validExp) {\\n      ensureSpace(34);\\n      doc.setFont(\'helvetica\', \'bold\');\\n      doc.setFontSize(10);\\n      doc.setTextColor(22, 28, 36);\\n      const titleLine = [exp.role.trim(), exp.company.trim()].filter(Boolean).join(\' \342\200\224 \');\\n      doc.text(titleLine, margin, y);\\n\\n      const dateAndLoc = [\\n        [exp.startDate.trim(), exp.endDate.trim()].filter(Boolean).join(\' - \'),\\n        exp.location.trim(),\\n      ]\\n        .filter(Boolean)\\n        .join(\' | \');\\n\\n      if (dateAndLoc) {\\n        doc.setFont(\'helvetica\', \'normal\');\\n        doc.setFontSize(9);\\n        doc.setTextColor(95, 105, 120);\\n        doc.text(dateAndLoc, pageWidth - margin, y, { align: \'right\' });\\n      }\\n      y += 13;\\n      if (exp.description.trim()) {\\n        addWrappedParagraph(exp.description, 9.5, \'normal\', [50, 60, 75]);\\n      }\\n      y += 5;\\n    }\\n  };\\n\\n  const renderEducation = () => {\\n    const validEdu = resume.education.filter((e) => e.degree.trim() || e.institution.trim());\\n    if (validEdu.length === 0) return;\\n    addSectionHeader(\'Education\');\\n    for (const edu of validEdu) {\\n      ensureSpace(28);\\n      doc.setFont(\'helvetica\', \'bold\');\\n      doc.setFontSize(10);\\n      doc.setTextColor(22, 28, 36);\\n      doc.text(edu.degree.trim() || \'Qualification\', margin, y);\\n\\n      const years = [edu.startYear.trim(), edu.endYear.trim()].filter(Boolean).join(\' - \');\\n      if (years) {\\n        doc.setFont(\'helvetica\', \'normal\');\\n        doc.setFontSize(9);\\n        doc.setTextColor(95, 105, 120);\\n        doc.text(years, pageWidth - margin, y, { align: \'right\' });\\n      }\\n      y += 13;\\n\\n      const subLine = [\\n        edu.institution.trim(),\\n        edu.scoreOrCgpa.trim() ? `Grade / Score: ${edu.scoreOrCgpa.trim()}` : \'\',\\n      ]\\n        .filter(Boolean)\\n        .join(\'  \342\200\242  \');\\n      if (subLine) {\\n        addWrappedParagraph(subLine, 9.5, \'normal\', [60, 70, 85]);\\n      }\\n      y += 4;\\n    }\\n  };\\n\\n  const renderProjects = () => {\\n    const validProjects = resume.projects.filter((p) => p.title.trim() || p.description.trim());\\n    if (validProjects.length === 0) return;\\n    addSectionHeader(resume.mode === \'academic\' ? \'Research & Key Projects\' : \'Projects & Case Studies\');\\n    for (const proj of validProjects) {\\n      ensureSpace(32);\\n      doc.setFont(\'helvetica\', \'bold\');\\n      doc.setFontSize(10);\\n      doc.setTextColor(22, 28, 36);\\n      const header = [\\n        proj.title.trim() || \'Project\',\\n        proj.techStack.length > 0 ? `(${proj.techStack.join(\', \')})` : \'\',\\n      ]\\n        .filter(Boolean)\\n        .join(\' \');\\n      doc.text(header, margin, y);\\n\\n      if (proj.link?.trim()) {\\n        doc.setFont(\'helvetica\', \'normal\');\\n        doc.setFontSize(8.5);\\n        doc.setTextColor(30, 58, 95);\\n        doc.text(proj.link.trim(), pageWidth - margin, y, { align: \'right\' });\\n      }\\n      y += 13;\\n      if (proj.description.trim()) {\\n        addWrappedParagraph(proj.description, 9.5, \'normal\', [50, 60, 75]);\\n      }\\n      y += 5;\\n    }\\n  };\\n\\n  // Mode-adaptive section order\\n  if (resume.mode === \'experienced\') {\\n    renderExperience();\\n    renderProjects();\\n    renderEducation();\\n  } else if (resume.mode === \'academic\') {\\n    renderEducation();\\n    renderProjects();\\n    renderExperience();\\n  } else {\\n    // fresher default\\n    renderEducation();\\n    renderProjects();\\n    renderExperience();\\n  }\\n\\n  // Skills\\n  const cleanSkills = resume.skills.map((s) => s.trim()).filter(Boolean);\\n  if (cleanSkills.length > 0) {\\n    addSectionHeader(\'Skills & Competencies\');\\n    addWrappedParagraph(cleanSkills.join(\'  \342\200\242  \'), 9.5, \'normal\', [40, 50, 65]);\\n  }\\n\\n  // Certifications\\n  const cleanCerts = resume.certifications.map((c) => c.trim()).filter(Boolean);\\n  if (cleanCerts.length > 0) {\\n    addSectionHeader(\'Certifications & Licenses\');\\n    for (const cert of cleanCerts) {\\n      addWrappedParagraph(`\342\200\242  ${cert}`, 9.5, \'normal\', [45, 55, 72], 4);\\n      y += 2;\\n    }\\n  }\\n\\n  // Optional Sections (Volunteering, Languages, Achievements, Publications, Extracurricular)\\n  for (const sec of resume.optionalSections || []) {\\n    const validItems = sec.items.map((i) => i.trim()).filter(Boolean);\\n    if (validItems.length === 0) continue;\\n    addSectionHeader(sec.title || sec.type);\\n    for (const item of validItems) {\\n      addWrappedParagraph(`\342\200\242  ${item}`, 9.5, \'normal\', [45, 55, 72], 4);\\n      y += 2;\\n    }\\n  }\\n\\n  const safeSlug =\\n    fullName\\n      .toLowerCase()\\n      .replace(/[^a-z0-9]+/g, \'-\')\\n      .replace(/^-|-$/g, \'\') || \'career-compass\';\\n  doc.save(`${safeSlug}-resume.pdf`);\\n}\\n\", \"Description\":\"Update PDF export utility to use the universal Resume model (mode-based ordering, links array, optionalSections, ATS-safe single-column formatting)\", \"Overwrite\":true, \"TargetFile\":\"/src/utils/pdfExport.ts\", \"toolAction\":\"Updating PDF export utility\", \"toolSummary\":\"Update pdfExport.ts for universal Resume model\"}"
      thinking_signature: "\022\344\005\n\341\005\001i\024}\023\244A<E\341\006\255E\220\370\220?\210\262\031\316\0375\256\253v\033\320\230\270a\366\261\335\273\333\367ll\237\305\301\372\321Az\254n\244)u\315=\304X\247\375\201lo\026l\364}\315\346\260#>?\210\177\365q\360\247\032\035\217\320Lby\245\263\201\367\312?{\002\205b\265\020\212\203\246\233\271\231! \036\"\023\205Jt\026\2527?\310>\275\376\026\215\314\372\n\vni\\\022\242\0168\251\t\220\353R\210\256\025I\321\343S\364\235\217\336;_\235\350j\023k\017u#\020o\216\"\323}\035\251aw\234\244\\\377v\235\373\r\252\a^\305\261e^\314\237\233\376jA\3704.\374\256A\3142\301[\031\315H3\215c\377\205\207u`EI\301Y\367\003-\316\001\370\025\\(\207\'n\307\204\002\247\233\320w\277=\rGn\225\300\233`\302\210 \366\212fg\230\272\325\276a\337\210\v=\207\317s\305\334\345PE\254\307\216\023\003\370\202=\366\305f2\r\333\23278\214gB\2643\210\364\340\323\252\001\371\377f\"x}\231er\273xh\204fD\301\307\376\311X.\364Cs\356W\267\324\253nN3\3348\302(X\217\371W\300t6OXL\"\261U\327u1+%\267\024\315\371Hy\324$$t\202\312V`s\202\241\336\253\024\022jJ}\265G\002\031\331\325\255\340\320\306\354\231\237+\255AH\337D\372\177\373|Z\372\321\225\315\2520\345aC\344\027j\211\200\206\347(\\\226s\000;\324\320\301MS\301f\021=\373\337/\361=\276Ve\376\330\371x\375\210E\234\205\226*\307k\252V[;\3546AiE\233\332\343\\\241,\233`n{\341\017\002CrI\v\245\340\343\bS\216<\356\274c\366\225\220\'N\264\237\351y\350Et\3143\300\243\355\227\332\312\235]jP\204\233U%\247\316\27641\207\356\367\355\036@\032\366\220A\2318S\230\235\346\325\t^\002\211\017e\362&\bT\305\314\177\236\250\232\224\307\224\266~\221\266[h^\313\024C\r\037UNwS\a\321\330\220\'a\377\270\250\276mw\325\362`\300 \305\002K\002\035\321\034\032\252bBq\314K\2138z\231V}\265~\242C\226\205\034\322\276\355a\235=\001w\346?\375\237\316\242y\016=Y\033<\rh\317D\f\207s\252\2060\r\271@Lh\ta\260\317\022\241O\251g\2042g\313l1\301\323M&\341\352\316U\022w\257\200\256g^_&\016/\354\267\240k\022\224}\221\312\271\'\214\006\r\b\rz\025]\345t\352\331\3